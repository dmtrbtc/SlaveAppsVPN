package tcpfallback

import (
	"bytes"
	"errors"
	"io"
	"net/netip"
	"testing"

	zerotier "github.com/metacubex/zerotier-go"
)

func TestPacketRecordRoundTrip(t *testing.T) {
	remote := netip.MustParseAddrPort("8.8.8.8:9993")
	packet := []byte("0123456789abcdef")
	record, err := EncodePacket(remote, packet)
	if err != nil {
		t.Fatal(err)
	}
	wantPrefix := []byte{0x17, 0x03, 0x03, 0, 23, 4, 8, 8, 8, 8, 0x27, 0x09}
	if !bytes.Equal(record[:len(wantPrefix)], wantPrefix) {
		t.Fatalf("record prefix = %x", record[:len(wantPrefix)])
	}
	decoded, err := ReadRecord(bytes.NewReader(record))
	if err != nil {
		t.Fatal(err)
	}
	if decoded.Hello || decoded.Remote != remote || !bytes.Equal(decoded.Packet, packet) {
		t.Fatalf("decoded record = remote %s packet %x hello %t", decoded.Remote, decoded.Packet, decoded.Hello)
	}
}

func TestHelloRecord(t *testing.T) {
	want := []byte{
		0x17, 0x03, 0x03, 0, 4,
		zerotier.NodeVersionMajor,
		zerotier.NodeVersionMinor,
		byte(zerotier.NodeVersionRevision >> 8),
		byte(zerotier.NodeVersionRevision),
	}
	hello := HelloRecord()
	if !bytes.Equal(hello, want) {
		t.Fatalf("hello record = %x, want %x", hello, want)
	}
	decoded, err := ReadRecord(bytes.NewReader(hello))
	if err != nil || !decoded.Hello || decoded.Remote.IsValid() || len(decoded.Packet) != 0 {
		t.Fatalf("decoded hello = %+v, %v", decoded, err)
	}
}

func TestRecordValidation(t *testing.T) {
	if _, err := EncodePacket(netip.MustParseAddrPort("[2001:4860:4860::8888]:9993"), []byte("packet")); err == nil {
		t.Fatal("IPv6 outbound endpoint was accepted")
	}
	if _, err := ReadRecord(bytes.NewReader([]byte{0x17, 0x03, 0x03, 0, 0})); err == nil {
		t.Fatal("empty fallback record was accepted")
	}
	if _, err := ReadRecord(bytes.NewReader([]byte{0x17, 0x03, 0x03, 0, 7, 4})); !errors.Is(err, io.ErrUnexpectedEOF) {
		t.Fatalf("truncated fallback record = %v", err)
	}
}
