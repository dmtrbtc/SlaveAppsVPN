package main

import (
	"bytes"
	"context"
	"crypto/rand"
	"encoding/binary"
	"encoding/json"
	"errors"
	"flag"
	"fmt"
	"io"
	"net/netip"
	"time"

	zerotier "github.com/metacubex/zerotier-go"
)

const (
	// defaultPingPayloadSize retains the payload size used by the original
	// ztprobe ICMP command.
	defaultPingPayloadSize = 24
	// maximumPingPayloadSize bounds the CLI before the configured network MTU
	// applies its more precise family-specific limit.
	maximumPingPayloadSize = 65507
)

// runPing joins a network and probes a managed IP with ICMP echo requests.
func runPing(args []string, stdout, stderr io.Writer) (int, error) {
	flags := flag.NewFlagSet("ping", flag.ContinueOnError)
	flags.SetOutput(stderr)
	var options onlineOptions
	addOnlineFlags(flags, &options)
	networkText := flags.String("network", "", "16-digit network ID")
	targetText := flags.String("target", "", "IPv4 or IPv6 destination")
	count := flags.Int("count", 3, "echo requests to send")
	payloadSize := flags.Int("size", defaultPingPayloadSize, "ICMP payload bytes")
	interval := flags.Duration("interval", time.Second, "delay between echo requests")
	peerText := flags.String("peer", "", "expected 10-digit ZeroTier peer address")
	requireDirect := flags.Bool("require-direct", false, "require an active direct path to the expected peer")
	if err := flags.Parse(args); err != nil {
		return exitUsage, err
	}
	networkID, err := parseNetworkOption(*networkText, flags.NArg(), options.timeout)
	if err != nil {
		return exitUsage, err
	}
	target, err := netip.ParseAddr(*targetText)
	if err != nil || target.IsUnspecified() || target.IsMulticast() || *count <= 0 || *count > 65535 ||
		*payloadSize < 0 || *payloadSize > maximumPingPayloadSize || *interval <= 0 {
		return exitUsage, errors.New("ping requires a unicast -target, -count from 1 to 65535, a valid -size, and a positive -interval")
	}
	if *peerText != "" {
		if _, err = zerotier.ParseAddress(*peerText); err != nil {
			return exitUsage, err
		}
	}
	ctx, cancel := context.WithTimeout(context.Background(), options.timeout)
	defer cancel()
	probe, code, err := startNetworkProbe(ctx, options, networkID, target, stdout, stderr)
	if err != nil {
		return code, err
	}
	defer probe.Close()
	result, probeErr := probe.runtime.ping(ctx, probe.network.Config, target, *count, *payloadSize, *interval)
	diagnostic, pathErr := diagnosePath(ctx, probe.runtime.node, probe.network.Config, target, *peerText, *requireDirect)
	result.Path = diagnostic
	if options.json {
		_ = json.NewEncoder(stdout).Encode(result)
	} else {
		fmt.Fprintf(stdout, "node=%s network=%016x target=%s packet-size=%d sent=%d received=%d lost=%d duplicate=%d corrupt=%d min=%s avg=%s max=%s jitter=%s\n",
			probe.runtime.node.Address(), networkID, target, result.PacketSize, result.Sent, result.Received, result.Lost, result.Duplicates, result.Corrupt,
			result.Minimum, result.Average, result.Maximum, result.Jitter)
		for _, reply := range result.Replies {
			fmt.Fprintf(stdout, "reply sequence=%d bytes=%d rtt=%s\n", reply.Sequence, reply.Bytes, reply.RTT)
		}
		printPathDiagnostic(stdout, diagnostic)
	}
	if probeErr != nil {
		return exitProbeFailed, probeErr
	}
	if pathErr != nil {
		return exitProbeFailed, pathErr
	}
	return exitOK, nil
}

// pingReply reports one matching ICMP echo reply to the waiting probe.
type pingReply struct {
	Sequence uint16        `json:"sequence"`
	Bytes    int           `json:"bytes"`
	RTT      time.Duration `json:"rtt"`
}

// pingResult is the stable human-readable and JSON result of one probe.
type pingResult struct {
	Node       string         `json:"node"`
	Network    string         `json:"network"`
	Target     string         `json:"target"`
	PacketSize int            `json:"packet_size"`
	Sent       int            `json:"sent"`
	Received   int            `json:"received"`
	Lost       int            `json:"lost"`
	Duplicates int            `json:"duplicates"`
	Corrupt    int            `json:"corrupt"`
	Minimum    time.Duration  `json:"minimum"`
	Average    time.Duration  `json:"average"`
	Maximum    time.Duration  `json:"maximum"`
	Jitter     time.Duration  `json:"jitter"`
	Replies    []pingReply    `json:"replies"`
	Path       pathDiagnostic `json:"path"`
}

// finish derives aggregate loss and timing values after a ping run.
func (r *pingResult) finish() {
	r.Lost = r.Sent - r.Received
	if len(r.Replies) == 0 {
		return
	}
	minimum, maximum := r.Replies[0].RTT, r.Replies[0].RTT
	var total, jitterTotal time.Duration
	for i, reply := range r.Replies {
		if reply.RTT < minimum {
			minimum = reply.RTT
		}
		if reply.RTT > maximum {
			maximum = reply.RTT
		}
		total += reply.RTT
		if i != 0 {
			delta := reply.RTT - r.Replies[i-1].RTT
			if delta < 0 {
				delta = -delta
			}
			jitterTotal += delta
		}
	}
	r.Minimum, r.Maximum, r.Average = minimum, maximum, total/time.Duration(len(r.Replies))
	if len(r.Replies) > 1 {
		r.Jitter = jitterTotal / time.Duration(len(r.Replies)-1)
	}
}

// ping sends a fixed number of ICMP echo requests and validates matching
// replies, payload integrity, duplicates, timing, and quoted ICMP failures.
func (p *probeRuntime) ping(ctx context.Context, config zerotier.NetworkConfigData, target netip.Addr, count, payloadSize int, interval time.Duration) (result pingResult, err error) {
	result = pingResult{Node: p.node.Address().String(), Network: fmt.Sprintf("%016x", config.NetworkID), Target: target.String()}
	p.linkMu.RLock()
	link := p.link
	p.linkMu.RUnlock()
	if link == nil {
		return result, errors.New("ZeroTier IP link is unavailable")
	}
	source, err := link.SourceFor(target)
	if err != nil {
		return result, err
	}
	headerSize := 28
	if target.Is6() {
		headerSize = 48
	}
	result.PacketSize = headerSize + payloadSize
	if result.PacketSize > int(config.MTU) {
		return result, fmt.Errorf("ICMP packet size %d exceeds network MTU %d", result.PacketSize, config.MTU)
	}
	var randomState [10]byte
	if _, err = io.ReadFull(rand.Reader, randomState[:]); err != nil {
		return result, err
	}
	identifier := binary.BigEndian.Uint16(randomState[:2])
	var token [8]byte
	copy(token[:], randomState[2:])
	sentAt := make(map[uint16]time.Time, count)
	payloads := make(map[uint16][]byte, count)
	received := make(map[uint16]struct{}, count)
	sendProbe := func() error {
		sequence := uint16(result.Sent + 1)
		payload := pingPayload(token, sequence, payloadSize)
		packet := echoRequestWithPayload(source, target, identifier, sequence, payload)
		sentAt[sequence] = time.Now()
		payloads[sequence] = payload
		if err := link.WritePacket(packet); err != nil {
			delete(sentAt, sequence)
			delete(payloads, sequence)
			return err
		}
		result.Sent++
		return nil
	}
	if err = sendProbe(); err != nil {
		return result, err
	}
	ticker := time.NewTicker(interval)
	defer ticker.Stop()
	sendNext := ticker.C
	if count == 1 {
		sendNext = nil
	}
	defer result.finish()
	for result.Received < count {
		select {
		case packet := <-p.packets:
			sequence, payload, state := parseEchoReply(packet, source, target, identifier)
			if state == echoReplyCorrupt {
				result.Corrupt++
				continue
			}
			if state == echoReplyValid {
				sent := sentAt[sequence]
				if sent.IsZero() {
					continue
				}
				if !bytes.Equal(payload, payloads[sequence]) {
					result.Corrupt++
					continue
				}
				if _, exists := received[sequence]; exists {
					result.Duplicates++
					continue
				}
				received[sequence] = struct{}{}
				result.Replies = append(result.Replies, pingReply{Sequence: sequence, Bytes: len(packet), RTT: time.Since(sent)})
				result.Received++
				continue
			}
			if remoteErr, ok := parseProbeICMPError(packet); ok && matchPingICMPError(remoteErr, source, target, identifier, sentAt) {
				return result, remoteErr
			}
		case err := <-p.linkErrs:
			return result, err
		case <-sendNext:
			if err = sendProbe(); err != nil {
				return result, err
			}
			if result.Sent == count {
				sendNext = nil
			}
		case <-ctx.Done():
			return result, fmt.Errorf("received %d of %d echo replies from %s: %w", result.Received, count, target, ctx.Err())
		}
	}
	return result, nil
}

// pingPayload creates a deterministic per-request payload from a random token.
func pingPayload(token [8]byte, sequence uint16, size int) []byte {
	payload := make([]byte, size)
	for i := range payload {
		payload[i] = token[i%len(token)] ^ byte(sequence) ^ byte(sequence>>8) ^ byte(i)
	}
	return payload
}

// echoRequest builds an IPv4 or IPv6 ICMP echo request with the historical
// default payload used by codec tests.
func echoRequest(source, target netip.Addr, identifier, sequence uint16) []byte {
	var token [8]byte
	copy(token[:], "ztprobe!")
	return echoRequestWithPayload(source, target, identifier, sequence, pingPayload(token, sequence, defaultPingPayloadSize))
}

// echoRequestWithPayload builds an IPv4 or IPv6 ICMP echo request.
func echoRequestWithPayload(source, target netip.Addr, identifier, sequence uint16, payload []byte) []byte {
	if source.Is4() {
		packet := make([]byte, 20+8+len(payload))
		packet[0] = 0x45
		binary.BigEndian.PutUint16(packet[2:4], uint16(len(packet)))
		binary.BigEndian.PutUint16(packet[6:8], 0x4000)
		packet[8], packet[9] = 64, icmpv4Protocol
		copy(packet[12:16], source.AsSlice())
		copy(packet[16:20], target.AsSlice())
		binary.BigEndian.PutUint16(packet[10:12], checksum(packet[:20]))
		icmp := packet[20:]
		icmp[0] = 8
		binary.BigEndian.PutUint16(icmp[4:6], identifier)
		binary.BigEndian.PutUint16(icmp[6:8], sequence)
		copy(icmp[8:], payload)
		binary.BigEndian.PutUint16(icmp[2:4], checksum(icmp))
		return packet
	}
	icmp := make([]byte, 8+len(payload))
	icmp[0] = 128
	binary.BigEndian.PutUint16(icmp[4:6], identifier)
	binary.BigEndian.PutUint16(icmp[6:8], sequence)
	copy(icmp[8:], payload)
	binary.BigEndian.PutUint16(icmp[2:4], icmpv6Checksum(source, target, icmp))
	packet := make([]byte, 40+len(icmp))
	packet[0] = 0x60
	binary.BigEndian.PutUint16(packet[4:6], uint16(len(icmp)))
	packet[6], packet[7] = icmpv6Protocol, 64
	copy(packet[8:24], source.AsSlice())
	copy(packet[24:40], target.AsSlice())
	copy(packet[40:], icmp)
	return packet
}

// echoReplyState classifies an inbound packet for one echo probe.
type echoReplyState uint8

const (
	// echoReplyIgnored indicates that the packet does not belong to the probe.
	echoReplyIgnored echoReplyState = iota
	// echoReplyValid indicates a matching reply with valid checksums.
	echoReplyValid
	// echoReplyCorrupt indicates a matching reply with invalid packet integrity.
	echoReplyCorrupt
)

// parseEchoReply validates an echo reply and returns its sequence and payload.
func parseEchoReply(packet []byte, source, target netip.Addr, identifier uint16) (uint16, []byte, echoReplyState) {
	if source.Is4() && target.Is4() {
		if len(packet) < 28 || packet[0]>>4 != 4 || packet[9] != icmpv4Protocol {
			return 0, nil, echoReplyIgnored
		}
		headerLength := int(packet[0]&0x0f) * 4
		totalLength := int(binary.BigEndian.Uint16(packet[2:4]))
		if headerLength < 20 || totalLength < headerLength+8 || totalLength > len(packet) {
			return 0, nil, echoReplyIgnored
		}
		packetSource := netip.AddrFrom4([4]byte(packet[12:16]))
		packetTarget := netip.AddrFrom4([4]byte(packet[16:20]))
		icmp := packet[headerLength:totalLength]
		if packetSource != target || packetTarget != source || icmp[0] != 0 || icmp[1] != 0 || binary.BigEndian.Uint16(icmp[4:6]) != identifier {
			return 0, nil, echoReplyIgnored
		}
		if binary.BigEndian.Uint16(packet[6:8])&0x3fff != 0 || checksum(packet[:headerLength]) != 0 || checksum(icmp) != 0 {
			return binary.BigEndian.Uint16(icmp[6:8]), nil, echoReplyCorrupt
		}
		return binary.BigEndian.Uint16(icmp[6:8]), icmp[8:], echoReplyValid
	}
	packetSource, packetTarget, icmp, ok := ipProtocolPayload(packet, icmpv6Protocol)
	if !ok || !source.Is6() || !target.Is6() || packetSource != target || packetTarget != source || len(icmp) < 8 ||
		icmp[0] != 129 || icmp[1] != 0 || binary.BigEndian.Uint16(icmp[4:6]) != identifier {
		return 0, nil, echoReplyIgnored
	}
	if icmpv6Checksum(packetSource, packetTarget, icmp) != 0 {
		return binary.BigEndian.Uint16(icmp[6:8]), nil, echoReplyCorrupt
	}
	return binary.BigEndian.Uint16(icmp[6:8]), icmp[8:], echoReplyValid
}

// echoReplySequence retains the compact reply parser used by codec tests.
func echoReplySequence(packet []byte, source, target netip.Addr, identifier uint16) (uint16, bool) {
	sequence, _, state := parseEchoReply(packet, source, target, identifier)
	return sequence, state == echoReplyValid
}

// matchPingICMPError verifies that an ICMP error quotes one sent echo request.
func matchPingICMPError(remoteErr probeICMPError, source, target netip.Addr, identifier uint16, sent map[uint16]time.Time) bool {
	protocol := icmpv4Protocol
	requestType := byte(8)
	if source.Is6() {
		protocol, requestType = icmpv6Protocol, 128
	}
	if !remoteErr.Matches(source, target, protocol) || len(remoteErr.QuotedPayload) < 8 || remoteErr.QuotedPayload[0] != requestType ||
		binary.BigEndian.Uint16(remoteErr.QuotedPayload[4:6]) != identifier {
		return false
	}
	return !sent[binary.BigEndian.Uint16(remoteErr.QuotedPayload[6:8])].IsZero()
}

// icmpv6Checksum computes an ICMPv6 checksum including the IPv6 pseudo-header.
func icmpv6Checksum(source, target netip.Addr, payload []byte) uint16 {
	return transportChecksum(source, target, icmpv6Protocol, payload)
}
