func TestRendezvousPunchConfirmsDirectPath(t *testing.T) {
	local, _ := ParseIdentity(knownGoodIdentity)
	root, _ := GenerateIdentity()
	target, _ := GenerateIdentity()
	type wirePacket struct {
		remote netip.AddrPort
		data   []byte
	}
	var sent []wirePacket
	node, err := NewNode(NodeConfig{
		Identity: local,
		Sender: WireSenderFunc(func(_ int64, remote netip.AddrPort, packet []byte) error {
			sent = append(sent, wirePacket{remote: remote, data: append([]byte(nil), packet...)})
			return nil
		}),
	})
	if err != nil {
		t.Fatal(err)
	}
	node.mu.Lock()
	_ = node.addPeerLocked(root, true)
	_ = node.addPeerLocked(target, false)
	node.peers[target.Address()].protocol = ProtocolVersion
	node.mu.Unlock()
	endpoint := netip.MustParseAddrPort("203.0.113.20:29993")
	rendezvous, _ := NewPacket(local.Address(), root.Address(), VerbRendezvous)
	_ = rendezvous.Append(0)
	targetAddress := target.Address().Bytes()
	_ = rendezvous.Append(targetAddress[:]...)
	_ = rendezvous.AppendUint16(endpoint.Port())
	_ = rendezvous.Append(4)
	ip := endpoint.Addr().As4()
	_ = rendezvous.Append(ip[:]...)
	rootKey, _ := root.Agree(local)
	if err = rendezvous.Armor(rootKey[:], true); err != nil {
		t.Fatal(err)
	}
	if err = node.ProcessWirePacket(7, netip.MustParseAddrPort("198.51.100.1:9993"), rendezvous.Bytes(), time.Now()); err != nil {
		t.Fatal(err)
	}
	targetKey, _ := target.Agree(local)
	var probeID uint64
	foundJunk := false
	for _, wire := range sent {
		if wire.remote != endpoint {
			continue
		}
		if len(wire.data) == 4 {
			foundJunk = true
			continue
		}
		packet, parseErr := ParsePacket(wire.data)
		if parseErr == nil && packet.Dearmor(targetKey[:]) == nil && packet.Verb() == VerbEcho {
			probeID = packet.PacketID()
		}
	}
	if !foundJunk || probeID == 0 {
		t.Fatalf("rendezvous did not send NAT-opening junk and authenticated probe: junk=%t probe=%x", foundJunk, probeID)
	}
	reply, _ := NewPacket(local.Address(), target.Address(), VerbOK)
	_ = reply.Append(byte(VerbEcho))
	_ = reply.AppendUint64(probeID)
	if err = reply.Armor(targetKey[:], true); err != nil {
		t.Fatal(err)
	}
	if err = node.ProcessWirePacket(7, endpoint, reply.Bytes(), time.Now()); err != nil {
		t.Fatal(err)
	}
	paths := peerPaths(node, target.Address())
	if len(paths) != 1 || paths[0].LocalSocket != 7 || paths[0].Endpoint != endpoint {
		t.Fatalf("confirmed rendezvous path = %+v", paths)
	}
}

func TestRendezvousInvalidEndpointAndTruncation(t *testing.T) {
	local, root, node, sent := newTestNodeWithPeer(t)
	target, err := GenerateIdentity()
	if err != nil {
		t.Fatal(err)
	}
	node.mu.Lock()
	node.peers[root.Address()].root = true
	if err = node.addPeerLocked(target, false); err != nil {
		node.mu.Unlock()
		t.Fatal(err)
	}
	node.mu.Unlock()
	key, err := local.Agree(root)
	if err != nil {
		t.Fatal(err)
	}
	remote := netip.MustParseAddrPort("198.51.100.64:9993")

	zeroPort, _ := NewPacket(local.Address(), root.Address(), VerbRendezvous)
	_ = zeroPort.Append(0)
	targetAddress := target.Address().Bytes()
	_ = zeroPort.Append(targetAddress[:]...)
	_ = zeroPort.AppendUint16(0)
	_ = zeroPort.Append(4, 203, 0, 113, 64)
	if err = zeroPort.Armor(key[:], true); err != nil {
		t.Fatal(err)
	}
	now := time.Now()
	if err = node.ProcessWirePacket(0, remote, zeroPort.Bytes(), now); err != nil {
		t.Fatalf("zero-port rendezvous: %v", err)
	}
	node.mu.Lock()
	lastReceive := node.peers[root.Address()].lastReceive
	node.peers[root.Address()].lastReceive = time.Time{}
	node.mu.Unlock()
	for _, packet := range *sent {
		if packet.remote.Port() == 0 {
			t.Fatalf("zero-port rendezvous sent a packet to %s", packet.remote)
		}
	}
	if !lastReceive.Equal(now) {
		t.Fatalf("zero-port rendezvous last receive = %v, want %v", lastReceive, now)
	}

	truncated, _ := NewPacket(local.Address(), root.Address(), VerbRendezvous)
	_ = truncated.Append(0)
	if err = truncated.Armor(key[:], true); err != nil {
		t.Fatal(err)
	}
	if err = node.ProcessWirePacket(0, remote, truncated.Bytes(), now.Add(time.Second)); !errors.Is(err, ErrInvalidPacket) {
		t.Fatalf("truncated rendezvous result = %v", err)
	}
	node.mu.Lock()
	lastReceive = node.peers[root.Address()].lastReceive
	node.mu.Unlock()
	if !lastReceive.IsZero() {
		t.Fatalf("truncated rendezvous refreshed root at %v", lastReceive)
	}
}

func TestPushDirectPathsForgetDoesNotDeleteAuthenticatedPath(t *testing.T) {
	identity, remoteIdentity, node, sent := newTestNodeWithPeer(t)
	key, err := remoteIdentity.Agree(identity)
	if err != nil {
		t.Fatal(err)
	}
	wanted := netip.MustParseAddrPort("203.0.113.20:29993")
	now := time.Unix(1700000000, 0)
	node.mu.Lock()
	node.peers[remoteIdentity.Address()].paths[pathKey{localSocket: 0, endpoint: wanted}] = &peerPathState{lastReceive: now}
	node.mu.Unlock()
	packet, _ := NewPacket(identity.Address(), remoteIdentity.Address(), VerbPushDirectPaths)
	_ = packet.AppendUint16(1)
	appendPushedIPv4(packet, 0x01, wanted)
	if err = packet.Armor(key[:], true); err != nil {
		t.Fatal(err)
	}
	if err = node.ProcessWirePacket(0, netip.MustParseAddrPort("198.51.100.1:9993"), packet.Bytes(), now); err != nil {
		t.Fatal(err)
	}
	node.mu.Lock()
	_, retained := node.peers[remoteIdentity.Address()].paths[pathKey{localSocket: 0, endpoint: wanted}]
	node.mu.Unlock()
	if !retained {
		t.Fatal("forget flag deleted an independently authenticated path")
	}
	for _, wirePacket := range *sent {
		if wirePacket.remote == wanted {
			t.Fatal("forget flag probed the advertised path")
		}
	}
}

func TestTrustedPeerReceivesParseableDirectPathPush(t *testing.T) {
	identity, remoteIdentity, node, sent := newTestNodeWithPeer(t)
	const networkID = uint64(0x1234567890abcdef)
	candidate := netip.MustParseAddrPort("192.0.2.50:29993")
	remoteEndpoint := netip.MustParseAddrPort("198.51.100.50:9993")
	now := time.Now()
	node.mu.Lock()
	node.directPaths = func() []netip.AddrPort { return []netip.AddrPort{candidate} }
	network := newNetwork(networkID)
	network.Status = NetworkStatusOK
	network.Config = NetworkConfigData{NetworkID: networkID, Type: NetworkTypePublic}
	node.networks[networkID] = network
	node.markNetworkTrustLocked(network, node.peers[remoteIdentity.Address()], now)
	node.observeAuthenticatedPathLocked(node.peers[remoteIdentity.Address()], 3, remoteEndpoint, VerbOK, now)
	node.mu.Unlock()
	if len(*sent) != 1 {
		t.Fatalf("direct path push packets = %d", len(*sent))
	}
	packet, err := ParsePacket((*sent)[0].data)
	if err != nil {
		t.Fatal(err)
	}
	key, err := identity.Agree(remoteIdentity)
	if err != nil {
		t.Fatal(err)
	}
	if err = packet.Dearmor(key[:]); err != nil {
		t.Fatal(err)
	}
	if err = packet.Uncompress(); err != nil {
		t.Fatal(err)
	}
	payload := packet.Payload()
	if packet.Verb() != VerbPushDirectPaths || len(payload) != 13 || binary.BigEndian.Uint16(payload[:2]) != 1 || payload[2] != 0 || binary.BigEndian.Uint16(payload[3:5]) != 0 || payload[5] != 4 || payload[6] != 6 {
		t.Fatalf("invalid direct path push payload: %x", payload)
	}
	parsed := netip.AddrPortFrom(netip.AddrFrom4([4]byte{payload[7], payload[8], payload[9], payload[10]}), binary.BigEndian.Uint16(payload[11:13]))
	if parsed != candidate {
		t.Fatalf("pushed candidate = %s, want %s", parsed, candidate)
	}
}

func TestEmptyDirectPathPushAttemptIsRateLimited(t *testing.T) {
	_, remote, node, _ := newTestNodeWithPeer(t)
	now := time.Now()
	calls := 0
	node.mu.Lock()
	node.directPaths = func() []netip.AddrPort {
		calls++
		return nil
	}
	peer := node.peers[remote.Address()]
	peer.lastTrustEstablished = now
	node.maybePushDirectPathsLocked(peer, pathKey{}, now, false)
	node.maybePushDirectPathsLocked(peer, pathKey{}, now.Add(time.Second), false)
	lastAttempt := peer.lastDirectPathPushSent
	node.mu.Unlock()
	if calls != 1 || !lastAttempt.Equal(now) {
		t.Fatalf("empty direct path attempts = %d, last = %v", calls, lastAttempt)
	}
}

func TestLowBandwidthKeepsNoPathDirectPushInterval(t *testing.T) {
