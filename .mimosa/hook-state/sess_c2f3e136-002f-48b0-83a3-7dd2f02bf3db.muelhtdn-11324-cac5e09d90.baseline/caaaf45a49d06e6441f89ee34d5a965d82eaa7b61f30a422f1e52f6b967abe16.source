func TestHelloResponseMeasuresDifferentReplyPort(t *testing.T) {
	local, remoteIdentity, node, _ := newTestNodeWithPeer(t)
	requestEndpoint := netip.MustParseAddrPort("198.51.100.43:9993")
	responseEndpoint := netip.MustParseAddrPort("198.51.100.43:29993")
	now := time.Unix(1700000000, 0)
	request, _ := NewPacket(remoteIdentity.Address(), local.Address(), VerbHello)
	reply, _ := NewPacket(local.Address(), remoteIdentity.Address(), VerbOK)
	_ = reply.Append(byte(VerbHello))
	_ = reply.AppendUint64(request.PacketID())
	_ = reply.AppendUint64(uint64(now.Add(-20 * time.Millisecond).UnixMilli()))
	_ = reply.Append(ProtocolVersion, nodeVersionMajor, nodeVersionMinor)
	_ = reply.AppendUint16(nodeVersionRev)

	node.mu.Lock()
	peer := node.peers[remoteIdentity.Address()]
	responsePath := pathKey{localSocket: 1, endpoint: responseEndpoint}
	peer.paths[responsePath] = &peerPathState{lastReceive: now, priority: 1}
	node.pending[request.PacketID()] = pendingRequest{
		verb: VerbHello, peer: remoteIdentity.Address(), sentAt: now.Add(-20 * time.Millisecond),
		path: pathKey{localSocket: 1, endpoint: requestEndpoint},
	}
	err := node.handleOKLocked(1, responseEndpoint, peer, reply, now)
	latency := peer.paths[responsePath].latency
	measured := peer.paths[responsePath].latencyMeasured
	node.mu.Unlock()
	if err != nil {
		t.Fatal(err)
	}
	if latency != 20*time.Millisecond || !measured {
		t.Fatalf("response path latency = %v, measured=%t", latency, measured)
	}
}

func TestBestDirectPeerPathIsStableForEqualQuality(t *testing.T) {
	_, remoteIdentity, node, _ := newTestNodeWithPeer(t)
	now := time.Unix(1700000000, 0)
	first := pathKey{localSocket: 1, endpoint: netip.MustParseAddrPort("192.0.2.10:9993")}
	second := pathKey{localSocket: 2, endpoint: netip.MustParseAddrPort("192.0.2.20:9993")}
	node.mu.Lock()
	peer := node.peers[remoteIdentity.Address()]
	peer.paths[first] = &peerPathState{lastReceive: now, latency: 10 * time.Millisecond, priority: 1}
	peer.paths[second] = &peerPathState{lastReceive: now, latency: 10 * time.Millisecond, priority: 1}
	want := first
	for i := 0; i < 1024; i++ {
		if got := node.bestDirectPeerPathLocked(peer, now); got != want {
			node.mu.Unlock()
			t.Fatalf("equal-quality path changed from %v to %v", want, got)
		}
	}
	node.mu.Unlock()
}

func TestHelloLatencyUsesOfficialMillisecondResolution(t *testing.T) {
	_, remoteIdentity, node, _ := newTestNodeWithPeer(t)
	remote := netip.MustParseAddrPort("198.51.100.42:9993")
	now := time.Unix(1700000000, 2*int64(time.Millisecond)+100*int64(time.Microsecond))
	key := pathKey{localSocket: 1, endpoint: remote}
	node.mu.Lock()
	peer := node.peers[remoteIdentity.Address()]
	peer.paths[key] = &peerPathState{lastReceive: now, priority: 1}
	// The first 200us sample crosses a wall-clock millisecond boundary. The
	// official wire clock therefore records 1ms rather than duration-truncating
	// it to zero.
	node.updatePathLatencyLocked(peer, 1, remote, uint64(now.Add(-200*time.Microsecond).UnixMilli()), now)
	path := peer.paths[key]
	first := path.latency
	node.updatePathLatencyLocked(peer, 1, remote, uint64(now.Add(-50*time.Microsecond).UnixMilli()), now)
	second := path.latency
	quality := pathLatency(path)
	node.mu.Unlock()
	if first != time.Millisecond {
		t.Fatalf("first millisecond latency = %s, want 1ms", first)
	}
	if second != 0 || quality != 0 {
		t.Fatalf("smoothed zero-millisecond latency = %s quality %s", second, quality)
	}
}

func TestUnknownLatencyUsesOfficialWorstValue(t *testing.T) {
	_, remoteIdentity, node, _ := newTestNodeWithPeer(t)
	now := time.Now()
	measured := pathKey{localSocket: 1, endpoint: netip.MustParseAddrPort("198.51.100.43:9993")}
	unknown := pathKey{localSocket: 2, endpoint: netip.MustParseAddrPort("198.51.100.44:9993")}
	node.mu.Lock()
	peer := node.peers[remoteIdentity.Address()]
	peer.paths[measured] = &peerPathState{lastReceive: now, latency: 2 * time.Second, priority: 1}
	peer.paths[unknown] = &peerPathState{lastReceive: now, priority: 1}
	selected := node.bestDirectPeerPathLocked(peer, now)
	node.mu.Unlock()
	if selected != measured {
		t.Fatalf("unknown RTT path selected over measured path: %v", selected)
	}
}

func TestNonBondingSuppressesActiveSameIPDifferentPort(t *testing.T) {
	_, remoteIdentity, node, _ := newTestNodeWithPeer(t)
	now := time.Now()
	first := pathKey{localSocket: 7, endpoint: netip.MustParseAddrPort("198.51.100.45:9993")}
	second := netip.MustParseAddrPort("198.51.100.45:29993")
	node.mu.Lock()
	peer := node.peers[remoteIdentity.Address()]
	peer.paths[first] = &peerPathState{lastReceive: now, priority: 1}
	node.observeAuthenticatedPacketPathLocked(peer, 7, second, VerbOK, 1, 0, now)
	activeCount := len(peer.paths)
	peer.paths[first].lastReceive = now.Add(-peerPathActiveTime)
	node.observeAuthenticatedPacketPathLocked(peer, 7, second, VerbOK, 2, 0, now)
	expiredCount := len(peer.paths)
	node.mu.Unlock()
	if activeCount != 1 || expiredCount != 2 {
		t.Fatalf("same-IP path counts active=%d expired=%d", activeCount, expiredCount)
	}
}

func TestNetworkConfigPushAcknowledgementDespitePersistenceFailure(t *testing.T) {
	identity, err := ParseIdentity(knownGoodIdentity)
	if err != nil {
		t.Fatal(err)
	}
	controller, err := GenerateIdentity()
	if err != nil {
		t.Fatal(err)
	}
	networkID := controller.Address().Uint64()<<24 | 0x1234
	var sent []sentWirePacket
	node, err := NewNode(NodeConfig{
		Identity: identity,
		Store:    failingPutStore{},
		Sender: WireSenderFunc(func(_ int64, remote netip.AddrPort, packet []byte) error {
			sent = append(sent, sentWirePacket{remote: remote, data: append([]byte(nil), packet...)})
			return nil
		}),
	})
	if err != nil {
		t.Fatal(err)
	}
	node.mu.Lock()
	if err := node.addPeerLocked(controller, false); err != nil {
		node.mu.Unlock()
		t.Fatal(err)
	}
	node.networks[networkID] = newNetwork(networkID)
	node.mu.Unlock()

	config := appendTestNetworkConfig(t, networkID, identity.Address())
	key, err := controller.Agree(identity)
	if err != nil {
		t.Fatal(err)
	}
	makePush := func(updateID uint64) *Packet {
		packet, err := NewPacket(identity.Address(), controller.Address(), VerbNetworkConfig)
		if err != nil {
			t.Fatal(err)
		}
		_ = packet.AppendUint64(networkID)
		_ = packet.AppendUint16(uint16(len(config)))
		_ = packet.Append(config...)
		_ = packet.Append(0)
		_ = packet.AppendUint64(updateID)
		_ = packet.AppendUint32(uint32(len(config)))
		_ = packet.AppendUint32(0)
		signature, err := controller.Sign(packet.Payload())
		if err != nil {
			t.Fatal(err)
		}
		_ = packet.Append(1)
		_ = packet.AppendUint16(SignatureSize)
		_ = packet.Append(signature[:]...)
		if err := packet.Armor(key[:], true); err != nil {
			t.Fatal(err)
		}
		return packet
	}
	remote := netip.MustParseAddrPort("203.0.113.30:9993")
	findACK := func(packet *Packet, updateID uint64, start int) bool {
		for _, wirePacket := range sent[start:] {
			if wirePacket.remote != remote {
				continue
			}
			response, err := ParsePacket(wirePacket.data)
			if err != nil || response.Dearmor(key[:]) != nil || response.Verb() != VerbOK {
				continue
			}
			payload := response.Payload()
			if len(payload) == 25 && payload[0] == byte(VerbEcho) && readUint64(payload[1:]) == packet.PacketID() && readUint64(payload[9:]) == networkID && readUint64(payload[17:]) == updateID {
				return true
			}
		}
		return false
	}
	for index, updateID := range []uint64{0x1020304050607080, 0x1020304050607081} {
		packet := makePush(updateID)
		sentBefore := len(sent)
		if err := node.ProcessWirePacket(7, remote, packet.Bytes(), time.Now().Add(time.Duration(index)*time.Millisecond)); err != nil {
			t.Fatal(err)
		}
		if !findACK(packet, updateID, sentBefore) {
			t.Fatalf("NETWORK_CONFIG update %x acknowledgement not found in %d outbound packets", updateID, len(sent)-sentBefore)
		}
	}
	if network, ok := node.Network(networkID); !ok || network.Status != NetworkStatusOK || network.Config.NetworkID != networkID {
		t.Fatalf("network configuration was not applied: ok=%t network=%+v", ok, network)
	}
}

