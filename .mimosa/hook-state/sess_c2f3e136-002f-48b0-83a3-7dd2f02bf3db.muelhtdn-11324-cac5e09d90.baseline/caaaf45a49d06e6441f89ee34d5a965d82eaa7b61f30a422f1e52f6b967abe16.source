	endpoint := netip.MustParseAddrPort("203.0.113.2:29993")

	node.mu.Lock()
	peer := node.peers[remote.Address()]
	peer.pathProbe[pathKey{localSocket: 3, endpoint: endpoint}] = now.Add(-peerPathProbeWindow)
	err := node.sendPathProbeLocked(peer, 3, endpoint, now)
	node.mu.Unlock()

	if err != nil {
		t.Fatal(err)
	}
	if len(*sent) != 0 {
		t.Fatalf("duplicate path probe packets = %d", len(*sent))
	}
}

func TestFailedPathProbeCanRetryImmediately(t *testing.T) {
	_, remote, node, _ := newTestNodeWithPeer(t)
	now := time.Unix(1700000000, 0)
	endpoint := netip.MustParseAddrPort("203.0.113.2:29993")
	wantErr := errors.New("send failed")
	attempts := 0

	node.mu.Lock()
	node.sender = WireSenderFunc(func(_ int64, _ netip.AddrPort, _ []byte) error {
		attempts++
		if attempts == 1 {
			return wantErr
		}
		return nil
	})
	peer := node.peers[remote.Address()]
	peer.protocol = 5
	firstErr := node.sendPathProbeLocked(peer, 3, endpoint, now)
	_, retainedAfterFailure := peer.pathProbe[pathKey{localSocket: 3, endpoint: endpoint}]
	secondErr := node.sendPathProbeLocked(peer, 3, endpoint, now)
	node.mu.Unlock()

	if !errors.Is(firstErr, wantErr) {
		t.Fatalf("first path probe error = %v", firstErr)
	}
	if retainedAfterFailure {
		t.Fatal("failed path probe retained its duplicate-suppression entry")
	}
	if secondErr != nil || attempts != 2 {
		t.Fatalf("immediate retry = %v, attempts = %d", secondErr, attempts)
	}
}

func TestHelloProtocolRange(t *testing.T) {
	tests := []struct {
		name     string
		protocol byte
		accepted bool
	}{
		{name: "below-minimum", protocol: ProtocolVersionMin - 1},
		{name: "minimum", protocol: ProtocolVersionMin, accepted: true},
		{name: "current", protocol: ProtocolVersion, accepted: true},
		{name: "future", protocol: ProtocolVersion + 1, accepted: true},
	}
	for _, test := range tests {
		t.Run(test.name, func(t *testing.T) {
			local, err := ParseIdentity(knownGoodIdentity)
			if err != nil {
				t.Fatal(err)
			}
			remote, err := GenerateIdentity()
			if err != nil {
				t.Fatal(err)
			}
			node, err := NewNode(NodeConfig{
				Identity: local,
				Sender:   WireSenderFunc(func(int64, netip.AddrPort, []byte) error { return nil }),
			})
			if err != nil {
				t.Fatal(err)
			}
			packet, err := NewPacket(local.Address(), remote.Address(), VerbHello)
			if err != nil {
				t.Fatal(err)
			}
			_ = packet.Append(test.protocol, NodeVersionMajor, NodeVersionMinor)
			_ = packet.AppendUint16(NodeVersionRevision)
			_ = packet.AppendUint64(uint64(time.Now().UnixMilli()))
			_ = packet.Append(remote.AppendBinary(nil, false)...)
			key, err := local.Agree(remote)
			if err != nil {
				t.Fatal(err)
			}
			if err = packet.Armor(key[:], false); err != nil {
				t.Fatal(err)
			}
			err = node.ProcessWirePacket(0, netip.MustParseAddrPort("192.0.2.1:9993"), packet.Bytes(), time.Now())
			if test.accepted {
				if err != nil {
					t.Fatal(err)
				}
				node.mu.Lock()
				protocol := node.peers[remote.Address()].protocol
				node.mu.Unlock()
				if protocol != test.protocol {
					t.Fatalf("stored peer protocol = %d, want %d", protocol, test.protocol)
				}
			} else if !errors.Is(err, ErrInvalidPacket) {
				t.Fatalf("protocol %d error = %v, want ErrInvalidPacket", test.protocol, err)
			}
		})
	}
}

func TestNetworkSpecialistIsContactedThroughRoot(t *testing.T) {
	_, specialist, node, sent := newTestNodeWithPeer(t)
	const networkID = uint64(0x1234567890abcdef)
	network := newNetwork(networkID)
	network.Status = NetworkStatusOK
	network.Config = NetworkConfigData{
		NetworkID: networkID,
		Specialists: []uint64{
			specialistTypeNetworkRelay | specialist.Address().Uint64(),
		},
	}
	now := time.Now()
	activateTestRootPath(t, node, now)
	node.mu.Lock()
	node.contactNetworkSpecialistsLocked(network, now)
	first := len(*sent)
	node.contactNetworkSpecialistsLocked(network, now.Add(rootContactPeriod))
	second := len(*sent)
	node.mu.Unlock()
	if first != 1 || second != 2 {
		t.Fatalf("specialist contact packets first=%d second=%d", first, second)
	}
	packet, err := ParsePacket((*sent)[0].data)
	if err != nil {
		t.Fatal(err)
	}
	if packet.Destination() != specialist.Address() {
		t.Fatalf("specialist HELLO destination = %s", packet.Destination())
	}
}

func TestRootFullHelloProbesKnownPathAndMissingAddressFamily(t *testing.T) {
	local, err := GenerateIdentity()
	if err != nil {
		t.Fatal(err)
	}
	root, err := GenerateIdentity()
	if err != nil {
		t.Fatal(err)
	}
	stableV4 := netip.MustParseAddrPort("192.0.2.10:9993")
	stableV6 := netip.MustParseAddrPort("[2001:db8::10]:9993")
	knownV4 := netip.MustParseAddrPort("198.51.100.10:9993")
	planet := World{
		Type: WorldTypePlanet, ID: 1, Timestamp: 1, UpdatesMustBeSignedBy: root.PublicKey(),
		Roots: []WorldRoot{{Identity: root, Endpoints: []netip.AddrPort{stableV4, stableV6}}},
	}
	var sent []sentWirePacket
	node, err := NewNode(NodeConfig{
		Identity: local, Planet: &planet,
		Sender: WireSenderFunc(func(_ int64, endpoint netip.AddrPort, packet []byte) error {
			sent = append(sent, sentWirePacket{remote: endpoint, data: append([]byte(nil), packet...)})
			return nil
		}),
	})
	if err != nil {
		t.Fatal(err)
	}
	now := time.Unix(1700000000, 0)
	node.mu.Lock()
	peer := node.peers[root.Address()]
	peer.lastReceive = now
	peer.lastFullHello = now.Add(-rootPathPingPeriod - time.Second)
	peer.paths[pathKey{localSocket: 7, endpoint: knownV4}] = &peerPathState{lastReceive: now, lastSend: now, priority: 1}
	node.lastRootContact = now.Add(-rootContactPeriod)
	node.mu.Unlock()

	node.ProcessBackgroundTasks(now)
	foundKnownV4, foundStableV4, foundStableV6 := false, false, false
	for _, packet := range sent {
		foundKnownV4 = foundKnownV4 || packet.remote == knownV4
		foundStableV4 = foundStableV4 || packet.remote == stableV4
		foundStableV6 = foundStableV6 || packet.remote == stableV6
	}
	if !foundKnownV4 || foundStableV4 || !foundStableV6 {
		t.Fatalf("root HELLO destinations known-v4=%t stable-v4=%t stable-v6=%t", foundKnownV4, foundStableV4, foundStableV6)
	}
}

func TestRootKnownStalePathUsesOfficialRoleGate(t *testing.T) {
	local, err := GenerateIdentity()
	if err != nil {
		t.Fatal(err)
	}
	root, err := GenerateIdentity()
	if err != nil {
		t.Fatal(err)
	}
	stable := netip.MustParseAddrPort("192.0.2.10:9993")
	planet := World{
		Type: WorldTypePlanet, ID: 1, Timestamp: 1, UpdatesMustBeSignedBy: root.PublicKey(),
		Roots: []WorldRoot{{Identity: root, Endpoints: []netip.AddrPort{stable}}},
	}
	var sent int
	node, err := NewNode(NodeConfig{
		Identity: local, Planet: &planet,
		Sender: WireSenderFunc(func(_ int64, _ netip.AddrPort, _ []byte) error {
			sent++
			return nil
		}),
	})
	if err != nil {
		t.Fatal(err)
	}
	now := time.Unix(1700000000, 0)
	node.mu.Lock()
	peer := node.peers[root.Address()]
	peer.lastReceive = now
	peer.lastFullHello = now.Add(-rootPathPingPeriod / 2)
	peer.paths[pathKey{localSocket: 7, endpoint: stable}] = &peerPathState{
		lastReceive: now.Add(-peerPathActiveTime - time.Second), priority: 1,
	}
	node.lastRootContact = now.Add(-rootContactPeriod)
	node.mu.Unlock()

	node.ProcessBackgroundTasks(now)
	if sent != 0 {
		t.Fatalf("root with a retained path was contacted %d times before its role gate expired", sent)
	}
}

func TestNetworkSpecialistDirectPathIsKeptAliveWithoutNetworkTraffic(t *testing.T) {
	_, specialist, node, sent := newTestNodeWithPeer(t)
	const networkID = uint64(0x1234567890abcdef)
	endpoint := netip.MustParseAddrPort("198.51.100.54:9993")
	network := newNetwork(networkID)
	network.Status = NetworkStatusOK
	network.Config = NetworkConfigData{
		NetworkID:   networkID,
		Specialists: []uint64{specialistTypeNetworkRelay | specialist.Address().Uint64()},
	}
	now := time.Now()
	node.mu.Lock()
	peer := node.peers[specialist.Address()]
	peer.protocol = ProtocolVersion
	peer.lastReceive = now
	peer.lastFullHello = now.Add(-2*peerPathPingPeriod - time.Second)
	lastProbe := now.Add(-peerPathPingPeriod)
	peer.paths[pathKey{localSocket: 4, endpoint: endpoint}] = &peerPathState{
		lastReceive: now, lastSend: lastProbe, lastProbe: lastProbe, priority: 1,
	}
	node.contactNetworkSpecialistsLocked(network, now)
	got := peer.paths[pathKey{localSocket: 4, endpoint: endpoint}].lastProbe
	node.mu.Unlock()
	if !got.Equal(now) {
		t.Fatalf("specialist direct path probe = %v, want %v", got, now)
	}
	peerPackets := 0
	for _, packet := range *sent {
		if packet.remote == endpoint {
			peerPackets++
		}
	}
	if peerPackets != 1 {
		t.Fatalf("specialist direct path packets = %d, want 1", peerPackets)
	}
}

