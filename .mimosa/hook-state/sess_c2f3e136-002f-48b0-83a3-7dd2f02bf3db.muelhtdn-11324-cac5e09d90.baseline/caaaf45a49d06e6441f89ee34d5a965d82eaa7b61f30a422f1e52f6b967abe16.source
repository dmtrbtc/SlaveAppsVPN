}

func TestEchoRateLimitStateIsBoundedAndExpires(t *testing.T) {
	local, remote, node, _ := newTestNodeWithPeer(t)
	key, err := remote.Agree(local)
	if err != nil {
		t.Fatal(err)
	}
	packet, _ := NewPacket(local.Address(), remote.Address(), VerbEcho)
	if err = packet.Armor(key[:], true); err != nil {
		t.Fatal(err)
	}
	now := time.Now()
	for port := 10000; port < 10000+maxPeerPaths+1; port++ {
		if err = node.ProcessWirePacket(0, netip.AddrPortFrom(netip.MustParseAddr("198.51.100.46"), uint16(port)), packet.Bytes(), now); err != nil {
			t.Fatal(err)
		}
	}
	node.mu.Lock()
	peer := node.peers[remote.Address()]
	count := len(peer.lastEchoRequest)
	node.mu.Unlock()
	if count != maxPeerPaths {
		t.Fatalf("echo rate-limit entries = %d, want %d", count, maxPeerPaths)
	}

	node.ProcessBackgroundTasks(now.Add(peerGeneralRateLimit))
	node.mu.Lock()
	count = len(peer.lastEchoRequest)
	node.mu.Unlock()
	if count != 0 {
		t.Fatalf("expired echo rate-limit entries = %d", count)
	}
}

func TestBackgroundRemovesUnusedMulticastGatherState(t *testing.T) {
	_, remote, node, _ := newTestNodeWithPeer(t)
	const networkID = uint64(0x1234567890abcdef)
	now := time.Now()
	unused := MulticastGroup{MAC: NewMAC(0x01005e000001)}
	active := MulticastGroup{MAC: NewMAC(0x01005e000002)}
	node.mu.Lock()
	network := newNetwork(networkID)
	network.Status = NetworkStatusOK
	network.Config = NetworkConfigData{NetworkID: networkID, Type: NetworkTypePublic}
	network.LastConfigRequest = now
	network.LastConfigReceive = now
	network.lastMulticastGather[unused] = now
	network.lastMulticastGather[active] = now
	network.multicast[active] = map[Address]time.Time{remote.Address(): now}
	node.networks[networkID] = network
	node.mu.Unlock()

	node.ProcessBackgroundTasks(now)
	node.mu.Lock()
	_, unusedKept := network.lastMulticastGather[unused]
	_, activeKept := network.lastMulticastGather[active]
	node.mu.Unlock()
	if unusedKept || !activeKept {
		t.Fatalf("multicast gather cleanup kept unused=%t active=%t", unusedKept, activeKept)
	}
}

func TestWhoisOKRequiresCurrentRoot(t *testing.T) {
	identity, remoteIdentity, node, _ := newTestNodeWithPeer(t)
	discovered, err := GenerateIdentity()
	if err != nil {
		t.Fatal(err)
	}
	packet, _ := NewPacket(identity.Address(), remoteIdentity.Address(), VerbOK)
	const requestID = uint64(0x0102030405060708)
	_ = packet.Append(byte(VerbWhois))
	_ = packet.AppendUint64(requestID)
	_ = packet.Append(discovered.AppendBinary(nil, false)...)

	node.mu.Lock()
	peer := node.peers[remoteIdentity.Address()]
	peer.root = false
	node.pending[requestID] = pendingRequest{verb: VerbWhois, peer: remoteIdentity.Address(), sentAt: time.Now()}
	err = node.handleOKLocked(0, netip.MustParseAddrPort("203.0.113.44:9993"), peer, packet, time.Now())
	_, learned := node.peers[discovered.Address()]
	_, pending := node.pending[requestID]
	node.mu.Unlock()

	if err != nil {
		t.Fatal(err)
	}
	if learned {
		t.Fatal("WHOIS response from a former root added a peer")
	}
	if pending {
		t.Fatal("ignored WHOIS response retained its pending request")
	}
}

