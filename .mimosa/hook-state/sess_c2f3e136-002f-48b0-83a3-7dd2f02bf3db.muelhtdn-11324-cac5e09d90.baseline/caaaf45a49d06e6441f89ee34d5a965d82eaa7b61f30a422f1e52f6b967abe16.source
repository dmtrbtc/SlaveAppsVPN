func TestPushDirectPathsOnlyStartsProbe(t *testing.T) {
	identity, err := ParseIdentity(knownGoodIdentity)
	if err != nil {
		t.Fatal(err)
	}
	remoteIdentity, err := GenerateIdentity()
	if err != nil {
		t.Fatal(err)
	}
	var sent []sentWirePacket
	node, err := NewNode(NodeConfig{
		Identity: identity,
		Sender: WireSenderFunc(func(_ int64, remote netip.AddrPort, packet []byte) error {
			sent = append(sent, sentWirePacket{remote: remote, data: append([]byte(nil), packet...)})
			return nil
		}),
	})
	if err != nil {
		t.Fatal(err)
	}
	node.mu.Lock()
	if err := node.addPeerLocked(remoteIdentity, false); err != nil {
		node.mu.Unlock()
		t.Fatal(err)
	}
	node.mu.Unlock()
	key, err := remoteIdentity.Agree(identity)
	if err != nil {
		t.Fatal(err)
	}
	packet, _ := NewPacket(identity.Address(), remoteIdentity.Address(), VerbPushDirectPaths)
	_ = packet.AppendUint16(1)
	_ = packet.Append(0)
	_ = packet.AppendUint16(0)
	_ = packet.Append(4, 6, 203, 0, 113, 20)
	_ = packet.AppendUint16(29993)
	if err := packet.Armor(key[:], true); err != nil {
		t.Fatal(err)
	}
	incoming := netip.MustParseAddrPort("198.51.100.1:9993")
	if err := node.ProcessWirePacket(0, incoming, packet.Bytes(), time.Unix(1700000000, 0)); err != nil {
		t.Fatal(err)
	}
	if paths := peerPaths(node, remoteIdentity.Address()); len(paths) != 0 {
		t.Fatalf("pushed endpoint was trusted without confirmation: %+v", paths)
	}
	wanted := netip.MustParseAddrPort("203.0.113.20:29993")
	found := false
	for _, packet := range sent {
		if packet.remote == wanted {
			found = true
			break
		}
	}
	if !found {
		t.Fatalf("pushed endpoint was not probed: sent=%+v", sent)
	}
}

func TestPushDirectPathsDoesNotReprobeUnexpiredAuthenticatedPath(t *testing.T) {
	_, remote, node, sent := newTestNodeWithPeer(t)
	now := time.Unix(1700000000, 0)
	endpoint := netip.MustParseAddrPort("203.0.113.21:29993")
	packet, err := NewPacket(node.Address(), remote.Address(), VerbPushDirectPaths)
	if err != nil {
		t.Fatal(err)
	}
	_ = packet.AppendUint16(1)
	appendPushedIPv4(packet, 0, endpoint)

	node.mu.Lock()
	peer := node.peers[remote.Address()]
	stalePhysicalReceive := now.Add(-peerPathActiveTime - time.Second)
	node.addPeerPathLocked(peer, pathKey{localSocket: 3, endpoint: endpoint}, &peerPathState{lastReceive: stalePhysicalReceive}, stalePhysicalReceive)
	err = node.handlePushDirectPathsLocked(3, netip.MustParseAddrPort("198.51.100.1:9993"), peer, packet, now)
	node.mu.Unlock()
	if err != nil {
		t.Fatal(err)
	}
	if len(*sent) != 0 {
		t.Fatalf("unexpired authenticated path was reprobed %d times", len(*sent))
	}
}

func TestPathProbeProtocolCompatibility(t *testing.T) {
	tests := []struct {
		name       string
		protocol   uint8
		major      uint8
		minor      uint8
		revision   uint16
		wantVerb   Verb
		wantCipher Cipher
	}{
		{name: "unknown", wantVerb: VerbHello, wantCipher: CipherSuiteC25519Poly1305None},
		{name: "protocol-4", protocol: 4, wantVerb: VerbHello, wantCipher: CipherSuiteC25519Poly1305None},
		{name: "protocol-5", protocol: 5, wantVerb: VerbEcho, wantCipher: CipherSuiteC25519Poly1305Salsa2012},
		{name: "protocol-11", protocol: 11, wantVerb: VerbEcho, wantCipher: CipherSuiteC25519Poly1305Salsa2012},
		{name: "protocol-12", protocol: 12, wantVerb: VerbEcho, wantCipher: CipherSuiteAESGMACSIV},
		{name: "protocol-13", protocol: 13, wantVerb: VerbEcho, wantCipher: CipherSuiteAESGMACSIV},
		{name: "one-1.1.0", protocol: 13, major: 1, minor: 1, wantVerb: VerbHello, wantCipher: CipherSuiteC25519Poly1305None},
	}
	for _, test := range tests {
		t.Run(test.name, func(t *testing.T) {
			identity, remote, node, sent := newTestNodeWithPeer(t)
			endpoint := netip.MustParseAddrPort("203.0.113.21:29993")
			node.mu.Lock()
			peer := node.peers[remote.Address()]
			peer.protocol, peer.major, peer.minor, peer.revision = test.protocol, test.major, test.minor, test.revision
			err := node.sendPathProbeLocked(peer, 3, endpoint, time.Now())
			node.mu.Unlock()
			if err != nil {
				t.Fatal(err)
			}
			if len(*sent) != 1 {
				t.Fatalf("path probe packets = %d", len(*sent))
			}
			packet, err := ParsePacket((*sent)[0].data)
			if err != nil {
				t.Fatal(err)
			}
			if packet.Cipher() != test.wantCipher {
				t.Fatalf("path probe cipher = %d, want %d", packet.Cipher(), test.wantCipher)
			}
			key, err := identity.Agree(remote)
			if err != nil {
				t.Fatal(err)
			}
			if err = packet.Dearmor(key[:]); err != nil {
				t.Fatal(err)
			}
			if packet.Verb() != test.wantVerb {
				t.Fatalf("path probe verb = %d, want %d", packet.Verb(), test.wantVerb)
			}
		})
	}
}

func TestPushDirectPathsAcceptsMoreThanPeerPathCapacity(t *testing.T) {
	_, remote, node, sent := newTestNodeWithPeer(t)
	packet, _ := NewPacket(node.Address(), remote.Address(), VerbPushDirectPaths)
	const count = maxPeerPaths + 1
	_ = packet.AppendUint16(count)
	for port := 20000; port < 20000+count; port++ {
		appendPushedIPv4(packet, 0, netip.AddrPortFrom(netip.MustParseAddr("203.0.113.1"), uint16(port)))
	}

	node.mu.Lock()
	peer := node.peers[remote.Address()]
	err := node.handlePushDirectPathsLocked(3, netip.MustParseAddrPort("198.51.100.1:9993"), peer, packet, time.Now())
	node.mu.Unlock()

	if err != nil {
		t.Fatal(err)
	}
	if len(*sent) != maxPushedPathsPerScopeAndFamily {
		t.Fatalf("path probes = %d, want per-scope limit %d", len(*sent), maxPushedPathsPerScopeAndFamily)
	}
}

func TestClusterRedirectsBypassOrdinaryScopeLimitAndUseHello(t *testing.T) {
	identity, remote, node, sent := newTestNodeWithPeer(t)
	packet, err := NewPacket(identity.Address(), remote.Address(), VerbPushDirectPaths)
	if err != nil {
		t.Fatal(err)
	}
	const count = maxPushedPathsPerScopeAndFamily + 1
	_ = packet.AppendUint16(count)
	for port := 20000; port < 20000+count; port++ {
		appendPushedIPv4(packet, 0x02, netip.AddrPortFrom(netip.MustParseAddr("203.0.113.1"), uint16(port)))
	}
	node.mu.Lock()
	peer := node.peers[remote.Address()]
	peer.protocol = ProtocolVersion
	err = node.handlePushDirectPathsLocked(3, netip.MustParseAddrPort("198.51.100.1:9993"), peer, packet, time.Now())
	node.mu.Unlock()
	if err != nil {
		t.Fatal(err)
	}
	if len(*sent) != count {
		t.Fatalf("cluster redirect probes = %d, want %d", len(*sent), count)
	}
	key, err := identity.Agree(remote)
	if err != nil {
		t.Fatal(err)
	}
	for _, wire := range *sent {
		probe, parseErr := ParsePacket(wire.data)
		if parseErr != nil || probe.Dearmor(key[:]) != nil || probe.Verb() != VerbHello {
			t.Fatalf("cluster redirect probe to %s is not a HELLO", wire.remote)
		}
	}
}

func TestExpiredPathProbesDoNotExhaustCapacity(t *testing.T) {
	_, remote, node, sent := newTestNodeWithPeer(t)
	now := time.Unix(1700000000, 0)

	node.mu.Lock()
	peer := node.peers[remote.Address()]
	for port := 20000; port < 20000+maxPeerPaths; port++ {
		key := pathKey{localSocket: 3, endpoint: netip.AddrPortFrom(netip.MustParseAddr("203.0.113.1"), uint16(port))}
		peer.pathProbe[key] = now.Add(-peerPathProbeWindow - time.Millisecond)
	}
	endpoint := netip.MustParseAddrPort("203.0.113.2:29993")
	err := node.sendPathProbeLocked(peer, 3, endpoint, now)
	_, probing := peer.pathProbe[pathKey{localSocket: 3, endpoint: endpoint}]
	probeCount := len(peer.pathProbe)
	node.mu.Unlock()

	if err != nil {
		t.Fatal(err)
	}
	if !probing || probeCount != 1 {
		t.Fatalf("path probes = %d, new endpoint present = %t", probeCount, probing)
	}
	if len(*sent) != 1 || (*sent)[0].remote != endpoint {
		t.Fatalf("sent path probes = %+v", *sent)
	}
}

func TestRecentPathProbeSuppressesDuplicate(t *testing.T) {
	_, remote, node, sent := newTestNodeWithPeer(t)
