func TestDeniedPrivateFramesDoNotLearnOrRefreshPaths(t *testing.T) {
	identity, remote, node, _ := newTestNodeWithPeer(t)
	key, err := identity.Agree(remote)
	if err != nil {
		t.Fatal(err)
	}
	const networkID = uint64(0x1234567890abcdef)
	node.mu.Lock()
	network := newNetwork(networkID)
	network.Status = NetworkStatusOK
	network.Config = NetworkConfigData{NetworkID: networkID, Type: NetworkTypePrivate, MTU: DefaultNetworkMTU}
	node.networks[networkID] = network
	node.mu.Unlock()

	for i, verb := range []Verb{VerbFrame, VerbExtFrame, VerbMulticastFrame} {
		packet, packetErr := NewPacket(identity.Address(), remote.Address(), verb)
		if packetErr != nil {
			t.Fatal(packetErr)
		}
		_ = packet.AppendUint64(networkID)
		switch verb {
		case VerbFrame:
			_ = packet.AppendUint16(EtherTypeIPv4)
			_ = packet.Append(1)
		default:
			_ = packet.Append(0)
		}
		if packetErr = packet.Armor(key[:], true); packetErr != nil {
			t.Fatal(packetErr)
		}
		endpoint := netip.AddrPortFrom(netip.MustParseAddr("198.51.100.54"), uint16(9993+i))
		if packetErr = node.ProcessWirePacket(0, endpoint, packet.Bytes(), time.Now()); packetErr != nil {
			t.Fatalf("verb %d: %v", verb, packetErr)
		}
	}
	node.mu.Lock()
	peer := node.peers[remote.Address()]
	lastReceive := peer.lastReceive
	pathCount := len(peer.paths)
	node.mu.Unlock()
	if !lastReceive.IsZero() || pathCount != 0 {
		t.Fatalf("denied frames changed receive state: last=%v paths=%d", lastReceive, pathCount)
	}
}

