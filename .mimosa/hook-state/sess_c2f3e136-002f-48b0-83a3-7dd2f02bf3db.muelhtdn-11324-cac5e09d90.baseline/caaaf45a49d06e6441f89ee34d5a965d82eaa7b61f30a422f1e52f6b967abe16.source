func TestMalformedHelloOKDoesNotChangePeerVersion(t *testing.T) {
	local, remote, node, _ := newTestNodeWithPeer(t)
	const requestID = uint64(0x0102030405060708)
	now := time.Now()
	packet, _ := NewPacket(local.Address(), remote.Address(), VerbOK)
	_ = packet.Append(byte(VerbHello))
	_ = packet.AppendUint64(requestID)
	_ = packet.AppendUint64(uint64(now.UnixMilli()))
	_ = packet.Append(ProtocolVersion, NodeVersionMajor, NodeVersionMinor)
	_ = packet.AppendUint16(NodeVersionRevision)
	_ = packet.Append(4) // Truncated IPv4 surface address.

	node.mu.Lock()
	peer := node.peers[remote.Address()]
	peer.protocol, peer.major, peer.minor, peer.revision = 11, 1, 4, 8
	node.pending[requestID] = pendingRequest{verb: VerbHello, peer: remote.Address(), sentAt: now}
	err := node.handleOKLocked(0, netip.MustParseAddrPort("203.0.113.44:9993"), peer, packet, now)
	protocol, major, minor, revision := peer.protocol, peer.major, peer.minor, peer.revision
	_, pending := node.pending[requestID]
	node.mu.Unlock()

	if !errors.Is(err, ErrInvalidPacket) {
		t.Fatalf("malformed HELLO response error = %v", err)
	}
	if protocol != 11 || major != 1 || minor != 4 || revision != 8 {
		t.Fatalf("malformed HELLO response changed peer version to %d.%d.%d protocol %d", major, minor, revision, protocol)
	}
	if !pending {
		t.Fatal("malformed HELLO response consumed the pending request")
	}
}

func TestHelloOKLearnsEveryRespondingLocalSocket(t *testing.T) {
	local, remote, node, _ := newTestNodeWithPeer(t)
	const requestID = uint64(0x0102030405060708)
	now := time.Now()
	reply, _ := NewPacket(local.Address(), remote.Address(), VerbOK)
	_ = reply.Append(byte(VerbHello))
	_ = reply.AppendUint64(requestID)
	_ = reply.AppendUint64(uint64(now.UnixMilli()))
	_ = reply.Append(ProtocolVersion, NodeVersionMajor, NodeVersionMinor)
	_ = reply.AppendUint16(NodeVersionRevision)
	endpoints := []netip.AddrPort{
		netip.MustParseAddrPort("198.51.100.44:9993"),
		netip.MustParseAddrPort("198.51.100.45:9993"),
	}

	node.mu.Lock()
	peer := node.peers[remote.Address()]
	node.pending[requestID] = pendingRequest{
		verb: VerbHello, peer: remote.Address(), sentAt: now,
		path: pathKey{localSocket: AnyLocalSocket, endpoint: endpoints[0]},
	}
	for index, endpoint := range endpoints {
		if err := node.handleOKLocked(int64(index), endpoint, peer, reply, now.Add(time.Duration(index)*time.Millisecond)); err != nil {
			node.mu.Unlock()
			t.Fatal(err)
		}
	}
	_, pending := node.pending[requestID]
	pathCount := len(peer.paths)
	node.mu.Unlock()
	if !pending || pathCount != len(endpoints) {
		t.Fatalf("HELLO responses left pending=%t paths=%d", pending, pathCount)
	}

	node.ProcessBackgroundTasks(now.Add(31 * time.Second))
	node.mu.Lock()
	_, pending = node.pending[requestID]
	node.mu.Unlock()
	if pending {
		t.Fatal("expired HELLO request remained pending")
	}
}

func TestPendingRequestCapacityReplacesNextRingEntry(t *testing.T) {
	identity, err := GenerateIdentity()
	if err != nil {
		t.Fatal(err)
	}
	node, err := NewNode(NodeConfig{
		Identity: identity,
		Sender:   WireSenderFunc(func(int64, netip.AddrPort, []byte) error { return nil }),
	})
	if err != nil {
		t.Fatal(err)
	}
	now := time.Now()
	node.mu.Lock()
	for packetID := uint64(1); packetID <= maxPendingRequests; packetID++ {
		if err = node.addPendingLocked(packetID, pendingRequest{verb: VerbEcho, sentAt: now.Add(time.Duration(packetID))}); err != nil {
			node.mu.Unlock()
			t.Fatal(err)
		}
	}
	const replacementID = uint64(maxPendingRequests + 1)
	err = node.addPendingLocked(replacementID, pendingRequest{verb: VerbHello, sentAt: now.Add(time.Second)})
	_, replacedPresent := node.pending[1]
	_, replacementPresent := node.pending[replacementID]
	count := len(node.pending)
	node.mu.Unlock()
	if err != nil {
		t.Fatal(err)
	}
	if count != maxPendingRequests || replacedPresent || !replacementPresent {
		t.Fatalf("pending replacement: count=%d replaced=%t replacement=%t", count, replacedPresent, replacementPresent)
	}
}

func TestMovePendingPacketIDUpdatesRingSlot(t *testing.T) {
	identity, err := GenerateIdentity()
	if err != nil {
		t.Fatal(err)
	}
	node, err := NewNode(NodeConfig{
		Identity: identity,
		Sender:   WireSenderFunc(func(int64, netip.AddrPort, []byte) error { return nil }),
	})
	if err != nil {
		t.Fatal(err)
	}
	const oldPacketID = uint64(0x1020304050607080)
	const newPacketID = uint64(0x8070605040302010)
	node.mu.Lock()
	err = node.addPendingLocked(oldPacketID, pendingRequest{verb: VerbEcho, sentAt: time.Now()})
	if err == nil {
		err = node.movePendingPacketIDLocked(oldPacketID, newPacketID)
	}
	request, moved := node.pending[newPacketID]
	_, oldPresent := node.pending[oldPacketID]
	slot := node.pendingSlots[request.slot]
	node.deletePendingLocked(newPacketID)
	clearedSlot := node.pendingSlots[request.slot]
	node.mu.Unlock()
	if err != nil {
		t.Fatal(err)
	}
	if !moved || oldPresent || slot.packetID != newPacketID || slot.generation != request.generation {
		t.Fatalf("moved request=%+v found=%t old=%t slot=%+v", request, moved, oldPresent, slot)
	}
	if clearedSlot != (pendingRequestSlot{}) {
		t.Fatalf("deleted request retained ring slot %+v", clearedSlot)
	}
}

