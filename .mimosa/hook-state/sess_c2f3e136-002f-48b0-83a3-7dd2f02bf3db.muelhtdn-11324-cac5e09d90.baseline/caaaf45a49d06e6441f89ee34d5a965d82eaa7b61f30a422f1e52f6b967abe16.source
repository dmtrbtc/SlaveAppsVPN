package zerotier

import (
	"bytes"
	"context"
	"encoding/binary"
	"errors"
	"net/netip"
	"runtime"
	"sync"
	"testing"
	"time"
)

type sentWirePacket struct {
	remote netip.AddrPort
	data   []byte
}

type failingPutStore struct{}

func (failingPutStore) Get(string) ([]byte, error) { return nil, ErrStateNotFound }
func (failingPutStore) Put(string, []byte) error   { return errors.New("state store is read-only") }
func (failingPutStore) Delete(string) error        { return errors.New("state store is read-only") }

type failingGetStore struct{}

func (failingGetStore) Get(string) ([]byte, error) { return nil, errors.New("state unavailable") }
func (failingGetStore) Put(string, []byte) error   { return nil }
func (failingGetStore) Delete(string) error        { return nil }

func TestTrustedPhysicalPathValidation(t *testing.T) {
	local, err := GenerateIdentity()
	if err != nil {
		t.Fatal(err)
	}
	remote, err := GenerateIdentity()
	if err != nil {
		t.Fatal(err)
	}
	const trustedPathID = uint64(0x1122334455667788)
	physicalNetwork := netip.MustParsePrefix("192.0.2.0/24")
	var messages []UserMessage
	node, err := NewNode(NodeConfig{
		Identity:      local,
		Sender:        WireSenderFunc(func(int64, netip.AddrPort, []byte) error { return nil }),
		PhysicalPaths: []PhysicalPathConfig{{Network: physicalNetwork, TrustedPathID: trustedPathID}},
		OnUserMessage: func(message UserMessage) { messages = append(messages, message) },
	})
	if err != nil {
		t.Fatal(err)
	}
	node.mu.Lock()
	if err = node.addPeerLocked(remote, false); err != nil {
		node.mu.Unlock()
		t.Fatal(err)
	}
	node.mu.Unlock()

	newMessage := func(id uint64) []byte {
		packet, packetErr := NewPacket(local.Address(), remote.Address(), VerbUserMessage)
		if packetErr != nil {
			t.Fatal(packetErr)
		}
		_ = packet.AppendUint64(7)
		_ = packet.Append([]byte("trusted")...)
		packet.SetTrusted(id)
		return packet.Bytes()
	}
	matchingEndpoint := netip.MustParseAddrPort("192.0.2.10:9993")
	if err = node.ProcessWirePacket(0, matchingEndpoint, newMessage(trustedPathID), time.Now()); err != nil {
		t.Fatal(err)
	}
	if len(messages) != 1 || string(messages[0].Data) != "trusted" {
		t.Fatalf("trusted message callback = %+v", messages)
	}
	if err = node.ProcessWirePacket(0, matchingEndpoint, newMessage(trustedPathID+1), time.Now()); !errors.Is(err, ErrInvalidPacket) {
		t.Fatalf("wrong trusted path ID error = %v", err)
	}
	outsideEndpoint := netip.MustParseAddrPort("198.51.100.10:9993")
	if err = node.ProcessWirePacket(0, outsideEndpoint, newMessage(trustedPathID), time.Now()); !errors.Is(err, ErrInvalidPacket) {
		t.Fatalf("outside trusted prefix error = %v", err)
	}
	node.physicalPaths = []PhysicalPathConfig{{Network: physicalNetwork, MTU: 1200}}
	if node.inboundPathTrustedLocked(matchingEndpoint, 0) {
		t.Fatal("an MTU-only physical path accepted trusted cipher ID zero")
	}
}

func TestUntrustedUnknownPeerIsRejectedBeforeIdentityLookup(t *testing.T) {
	local, err := GenerateIdentity()
	if err != nil {
		t.Fatal(err)
	}
	remote, err := GenerateIdentity()
	if err != nil {
		t.Fatal(err)
	}
	const trustedPathID = uint64(0x1122334455667788)
	node, err := NewNode(NodeConfig{
		Identity:      local,
		Sender:        WireSenderFunc(func(int64, netip.AddrPort, []byte) error { return nil }),
		PhysicalPaths: []PhysicalPathConfig{{Network: netip.MustParsePrefix("192.0.2.0/24"), TrustedPathID: trustedPathID}},
	})
	if err != nil {
		t.Fatal(err)
	}
	defer node.Close()

	packet, err := NewPacket(local.Address(), remote.Address(), VerbUserMessage)
	if err != nil {
		t.Fatal(err)
	}
	packet.SetTrusted(trustedPathID + 1)
	err = node.ProcessWirePacket(3, netip.MustParseAddrPort("192.0.2.10:9993"), packet.Bytes(), time.Now())
	if !errors.Is(err, ErrInvalidPacket) {
		t.Fatalf("untrusted unknown peer error = %v", err)
	}
	node.mu.Lock()
	queued := node.pendingIncomingCountLocked()
	_, requested := node.pendingWhois[remote.Address()]
	node.mu.Unlock()
	if queued != 0 || requested {
		t.Fatalf("untrusted packet reached identity lookup: queued=%d requested=%t", queued, requested)
	}
}

func TestTrustedUnknownPeerRetainsAuthenticationForRetry(t *testing.T) {
	local, err := GenerateIdentity()
	if err != nil {
		t.Fatal(err)
	}
	remote, err := GenerateIdentity()
	if err != nil {
		t.Fatal(err)
	}
	const trustedPathID = uint64(0x1122334455667788)
	node, err := NewNode(NodeConfig{
		Identity:      local,
		Sender:        WireSenderFunc(func(int64, netip.AddrPort, []byte) error { return nil }),
		PhysicalPaths: []PhysicalPathConfig{{Network: netip.MustParsePrefix("192.0.2.0/24"), TrustedPathID: trustedPathID}},
	})
	if err != nil {
		t.Fatal(err)
	}
	defer node.Close()

	packet, err := NewPacket(local.Address(), remote.Address(), VerbUserMessage)
	if err != nil {
		t.Fatal(err)
	}
	packet.SetTrusted(trustedPathID)
	err = node.ProcessWirePacket(3, netip.MustParseAddrPort("192.0.2.10:9993"), packet.Bytes(), time.Now())
	if !errors.Is(err, ErrUnknownPeer) {
		t.Fatalf("trusted unknown peer error = %v", err)
	}
	node.mu.Lock()
	pending := node.pendingIncoming[remote.Address()]
	node.mu.Unlock()
	if len(pending) != 1 || !pending[0].authenticated {
		t.Fatalf("trusted retry state = %+v", pending)
	}
}

func TestPhysicalPathMTUOverridesDefault(t *testing.T) {
	local, err := GenerateIdentity()
	if err != nil {
		t.Fatal(err)
	}
	remote, err := GenerateIdentity()
	if err != nil {
		t.Fatal(err)
	}
	endpoint := netip.MustParseAddrPort("192.0.2.10:9993")
	var packets [][]byte
	node, err := NewNode(NodeConfig{
		Identity:      local,
		PhysicalMTU:   1200,
		PhysicalPaths: []PhysicalPathConfig{{Network: netip.MustParsePrefix("192.0.2.0/24"), MTU: 600}},
		Sender: WireSenderFunc(func(_ int64, _ netip.AddrPort, packet []byte) error {
			packets = append(packets, append([]byte(nil), packet...))
			return nil
		}),
	})
	if err != nil {
		t.Fatal(err)
	}
	node.mu.Lock()
	if err = node.addPeerLocked(remote, false); err != nil {
		node.mu.Unlock()
		t.Fatal(err)
	}
	peer := node.peers[remote.Address()]
	packet, err := NewPacket(remote.Address(), local.Address(), VerbUserMessage)
	if err == nil {
		err = packet.Append(make([]byte, 900)...)
	}
	if err == nil {
		err = node.sendPacketViaPathLocked(peer, packet, true, pathKey{endpoint: endpoint}, false)
	}
	node.mu.Unlock()
	if err != nil {
		t.Fatal(err)
	}
	if len(packets) < 2 {
		t.Fatalf("physical path MTU produced %d packets", len(packets))
	}
	for _, wire := range packets {
		if len(wire) > 600 {
			t.Fatalf("wire fragment length = %d, want <= 600", len(wire))
		}
	}
}

func TestExtendedHelloFragmentFlagIncludesEphemeralKey(t *testing.T) {
	local, err := ParseIdentity(knownGoodIdentity)
	if err != nil {
		t.Fatal(err)
	}
	planet, err := DefaultPlanet()
	if err != nil {
		t.Fatal(err)
	}
	remote := planet.Roots[0]
	var packets [][]byte
	node, err := NewNode(NodeConfig{
		Identity:    local,
		PhysicalMTU: MinPhysicalMTU,
		Sender: WireSenderFunc(func(_ int64, _ netip.AddrPort, packet []byte) error {
			packets = append(packets, append([]byte(nil), packet...))
			return nil
		}),
	})
	if err != nil {
		t.Fatal(err)
	}
	packet, err := NewPacket(remote.Identity.Address(), local.Address(), VerbHello)
	if err == nil {
		err = packet.Append(make([]byte, 500-PacketMinSize)...)
	}
	node.mu.Lock()
	if err == nil {
		err = node.sendPacketViaPathLocked(node.peers[remote.Identity.Address()], packet, false, pathKey{endpoint: remote.Endpoints[0]}, true)
	}
	node.mu.Unlock()
	if err != nil {
		t.Fatal(err)
	}
	if len(packets) != 2 {
		t.Fatalf("extended HELLO produced %d wire packets, want 2", len(packets))
	}
	if packets[0][PacketFlagsOffset]&FlagFragmented == 0 {
		t.Fatal("extended HELLO head does not advertise its trailing fragment")
	}
	if len(packets[0]) > MinPhysicalMTU || len(packets[1]) > MinPhysicalMTU {
		t.Fatalf("extended HELLO fragment lengths = %d, %d", len(packets[0]), len(packets[1]))
	}
}

func TestPhysicalAndPeerPathConfiguration(t *testing.T) {
	local, err := GenerateIdentity()
	if err != nil {
		t.Fatal(err)
	}
	remote, err := GenerateIdentity()
	if err != nil {
		t.Fatal(err)
	}
	hint := netip.MustParseAddrPort("203.0.113.20:29993")
	physicalBlocked := netip.MustParseAddrPort("192.0.2.1:9993")
	peerBlocked := netip.MustParseAddrPort("198.51.100.1:9993")
	var sent []sentWirePacket
	node, err := NewNode(NodeConfig{
		Identity: local,
		Sender: WireSenderFunc(func(_ int64, endpoint netip.AddrPort, packet []byte) error {
			sent = append(sent, sentWirePacket{remote: endpoint, data: append([]byte(nil), packet...)})
			return nil
		}),
		PhysicalPaths: []PhysicalPathConfig{{Network: netip.MustParsePrefix("192.0.2.0/24"), Blacklist: true}},
		PeerPaths: []PeerPathConfig{{
			Address:   remote.Address(),
			Try:       []netip.AddrPort{physicalBlocked, peerBlocked, hint},
			Blacklist: []netip.Prefix{netip.MustParsePrefix("198.51.100.0/24")},
		}},
	})
	if err != nil {
		t.Fatal(err)
	}
	node.mu.Lock()
	if err = node.addPeerLocked(remote, false); err != nil {
		node.mu.Unlock()
		t.Fatal(err)
	}
	peer := node.peers[remote.Address()]
	if node.pathAllowedLocked(peer, physicalBlocked) {
		node.mu.Unlock()
		t.Fatal("globally blacklisted path was allowed")
	}
	if node.pathAllowedLocked(peer, peerBlocked) {
		node.mu.Unlock()
		t.Fatal("peer-specific blacklisted path was allowed")
	}
	if !node.pathAllowedLocked(peer, hint) {
		node.mu.Unlock()
		t.Fatal("peer path hint was not allowed")
	}
	node.tryMemorizedPathsLocked(peer, time.Now())
	node.mu.Unlock()
	if len(sent) != 1 || sent[0].remote != hint {
		t.Fatalf("memorized path probes = %+v", sent)
	}
}

// TestPeersReportsCompletePathDiagnostics verifies the public snapshot fields
// used by ztprobe direct-path assertions.
func TestPeersReportsCompletePathDiagnostics(t *testing.T) {
	local, err := GenerateIdentity()
	if err != nil {
		t.Fatal(err)
	}
	remote, err := GenerateIdentity()
	if err != nil {
		t.Fatal(err)
	}
	const trustedPathID = uint64(0x1122334455667788)
	endpoint := netip.MustParseAddrPort("192.0.2.10:9993")
	node, err := NewNode(NodeConfig{
		Identity:      local,
		Sender:        WireSenderFunc(func(int64, netip.AddrPort, []byte) error { return nil }),
		PhysicalPaths: []PhysicalPathConfig{{Network: netip.MustParsePrefix("192.0.2.0/24"), TrustedPathID: trustedPathID}},
	})
	if err != nil {
		t.Fatal(err)
	}
	defer node.Close()
	now := time.Now()
	node.mu.Lock()
	if err = node.addPeerLocked(remote, false); err != nil {
		node.mu.Unlock()
		t.Fatal(err)
	}
	peer := node.peers[remote.Address()]
	peer.protocol, peer.major, peer.minor, peer.revision = ProtocolVersion, 1, 16, 2
	peer.paths[pathKey{localSocket: 7, endpoint: endpoint}] = &peerPathState{
		lastSend: now.Add(-time.Second), lastReceive: now, priority: 3,
		latency: 5 * time.Millisecond, jitter: time.Millisecond, loss: 0.1, packetError: 0.02,
	}
	node.mu.Unlock()
	var status *PeerStatus
	for _, candidate := range node.Peers() {
		if candidate.Address == remote.Address() {
			copy := candidate
			status = &copy
			break
		}
	}
	if status == nil || status.Protocol != ProtocolVersion || status.VersionMajor != 1 || status.VersionMinor != 16 || status.VersionRevision != 2 || len(status.Paths) != 1 {
		t.Fatalf("peer status = %+v", status)
	}
	path := status.Paths[0]
	if !path.Active || !path.Preferred || path.Priority != 3 || path.TrustedPathID != trustedPathID || path.LastSend.IsZero() || path.PacketError != 0.02 {
		t.Fatalf("peer path = %+v", path)
	}
}

// TestEventTypeString verifies stable names for every public event type.
func TestEventTypeString(t *testing.T) {
	for _, test := range []struct {
		typ  EventType
		name string
	}{
		{EventNodeUp, "node-up"},
		{EventNodeOnline, "node-online"},
		{EventNodeOffline, "node-offline"},
		{EventNodeDown, "node-down"},
		{EventNodeIdentityCollision, "node-identity-collision"},
		{EventNetworkConfigPending, "network-config-pending"},
		{EventNetworkConfigReady, "network-config-ready"},
		{EventNetworkConfigChanged, "network-config-changed"},
		{EventNetworkAccessDenied, "network-access-denied"},
		{EventNetworkNotFound, "network-not-found"},
		{EventNetworkAuthenticationRequired, "network-authentication-required"},
		{EventNetworkLeft, "network-left"},
		{EventPeerIdentityLearned, "peer-identity-learned"},
		{EventPeerPathLearned, "peer-path-learned"},
		{EventPeerRouteChanged, "peer-route-changed"},
		{EventLocalSurfaceChanged, "local-surface-changed"},
	} {
		if name := test.typ.String(); name != test.name {
			t.Fatalf("EventType(%d).String() = %q, want %q", test.typ, name, test.name)
		}
	}
	if name := EventType(255).String(); name != "event(255)" {
		t.Fatalf("unknown EventType.String() = %q", name)
	}
	if PeerRouteDirect.String() != "direct" || PeerRoute(255).String() != "peer-route(255)" {
		t.Fatalf("unexpected PeerRoute strings: %q %q", PeerRouteDirect, PeerRoute(255))
	}
	if PeerRoleMoon.String() != "moon" || PeerRole(255).String() != "peer-role(255)" {
		t.Fatalf("unexpected PeerRole strings: %q %q", PeerRoleMoon, PeerRole(255))
	}
}

// TestNodeLifecycleEventOrdering verifies the official UP/DOWN boundaries and
// that initialization precedes peer discovery callbacks.
func TestNodeLifecycleEventOrdering(t *testing.T) {
	identity, err := GenerateIdentity()
	if err != nil {
		t.Fatal(err)
	}
	var events []Event
	node, err := NewNode(NodeConfig{
		Identity: identity,
		Sender:   WireSenderFunc(func(int64, netip.AddrPort, []byte) error { return nil }),
		OnEvent:  func(event Event) { events = append(events, event) },
	})
	if err != nil {
		t.Fatal(err)
	}
	if len(events) < 2 || events[0].Type != EventNodeUp {
		t.Fatalf("initial events = %+v", events)
	}
	for _, event := range events[1:] {
		if event.Type != EventPeerIdentityLearned || event.PeerRole != PeerRolePlanet {
			t.Fatalf("event after node-up = %+v", event)
		}
	}
	for _, event := range events {
		if event.NodeAddress != identity.Address() {
			t.Fatalf("event node address = %s, want %s: %+v", event.NodeAddress, identity.Address(), event)
		}
	}
	if err = node.Close(); err != nil {
		t.Fatal(err)
	}
	if events[len(events)-1].Type != EventNodeDown {
		t.Fatalf("final event = %+v", events[len(events)-1])
	}
	count := len(events)
	if err = node.Close(); err != nil || len(events) != count {
		t.Fatalf("second Close error=%v events=%+v", err, events)
	}
}

func TestNodeCallbacksFollowStateOrderAndAllowReentry(t *testing.T) {
	events := make(chan EventType, 3)
	firstStarted := make(chan struct{})
	releaseFirst := make(chan struct{})
	firstDone := make(chan struct{})
	node := &Node{identity: Identity{address: NewAddress(0x12345)}}
	node.onEvent = func(event Event) {
		events <- event.Type
		if event.Type != EventNodeOnline {
			return
		}
		close(firstStarted)
		<-releaseFirst
		node.mu.Lock()
		node.emitLocked(Event{Type: EventPeerPathLearned})
		node.unlockAndRunCallbacks()
	}
	go func() {
		node.mu.Lock()
		node.emitLocked(Event{Type: EventNodeOnline})
		node.unlockAndRunCallbacks()
		close(firstDone)
	}()
	<-firstStarted
	if event := <-events; event != EventNodeOnline {
		t.Fatalf("first callback = %v", event)
	}

	node.mu.Lock()
	node.emitLocked(Event{Type: EventNodeOffline})
	node.unlockAndRunCallbacks()
	select {
	case event := <-events:
		t.Fatalf("callback %v overtook the blocked first batch", event)
	default:
	}
	close(releaseFirst)
	if event := <-events; event != EventNodeOffline {
		t.Fatalf("second callback = %v", event)
	}
	if event := <-events; event != EventPeerPathLearned {
		t.Fatalf("reentrant callback = %v", event)
	}
	select {
	case <-firstDone:
	case <-time.After(time.Second):
		t.Fatal("callback dispatcher did not finish")
	}
}

func TestNodeCallbackPanicDoesNotPoisonDispatcher(t *testing.T) {
	var events []EventType
	node := &Node{identity: Identity{address: NewAddress(0x12345)}}
	node.onEvent = func(event Event) {
		events = append(events, event.Type)
		if event.Type == EventNodeOnline {
			panic("callback failure")
		}
	}

	var recovered any
	func() {
		defer func() { recovered = recover() }()
		node.mu.Lock()
		node.emitLocked(Event{Type: EventNodeOnline})
		node.emitLocked(Event{Type: EventNodeOffline})
		node.unlockAndRunCallbacks()
	}()
	if recovered == nil {
		t.Fatal("callback panic did not propagate")
	}
	node.mu.Lock()
	running := node.callbackRunning
	queuedBatches := len(node.callbackBatches)
	queuedCallbacks := 0
	if queuedBatches != 0 {
		queuedCallbacks = len(node.callbackBatches[0])
	}
	node.mu.Unlock()
	if running || queuedBatches != 1 || queuedCallbacks != 1 {
		t.Fatalf("dispatcher after panic: running=%t batches=%d callbacks=%d", running, queuedBatches, queuedCallbacks)
	}

	node.mu.Lock()
	node.emitLocked(Event{Type: EventNodeDown})
	node.unlockAndRunCallbacks()
	want := []EventType{EventNodeOnline, EventNodeOffline, EventNodeDown}
	if len(events) != len(want) {
		t.Fatalf("events after recovery = %v, want %v", events, want)
	}
	for i := range want {
		if events[i] != want[i] {
			t.Fatalf("events after recovery = %v, want %v", events, want)
		}
	}
}

func TestNodeCallbackTerminationTransfersQueuedBatch(t *testing.T) {
	terminations := map[string]func(){
		"panic":  func() { panic("callback failure") },
		"goexit": runtime.Goexit,
	}
	for name, terminate := range terminations {
		t.Run(name, func(t *testing.T) {
			started := make(chan struct{})
			release := make(chan struct{})
			terminated := make(chan struct{})
			delivered := make(chan EventType, 1)
			node := &Node{identity: Identity{address: NewAddress(0x12345)}}
			node.onEvent = func(event Event) {
				if event.Type == EventNodeOnline {
					close(started)
					<-release
					terminate()
					return
				}
				delivered <- event.Type
			}

			go func() {
				defer close(terminated)
				defer func() { _ = recover() }()
				node.mu.Lock()
				node.emitLocked(Event{Type: EventNodeOnline})
				node.unlockAndRunCallbacks()
			}()
			<-started
			node.mu.Lock()
			node.emitLocked(Event{Type: EventNodeOffline})
			node.unlockAndRunCallbacks()
			close(release)
			select {
			case <-terminated:
			case <-time.After(time.Second):
				t.Fatal("terminating callback did not release its protocol worker")
			}
			select {
			case event := <-delivered:
				if event != EventNodeOffline {
					t.Fatalf("transferred callback = %v", event)
				}
			case <-time.After(time.Second):
				t.Fatal("concurrently queued callback was stranded")
			}
		})
	}
}

func TestDataCallbackDoesNotWaitForBlockedStateCallback(t *testing.T) {
	stateStarted := make(chan struct{})
	releaseState := make(chan struct{})
	stateDone := make(chan struct{})
	frames := make(chan Frame, 1)
	node := &Node{identity: Identity{address: NewAddress(0x12345)}}
	node.onEvent = func(Event) {
		close(stateStarted)
		<-releaseState
	}
	node.onFrame = func(frame Frame) { frames <- frame }

	go func() {
		node.mu.Lock()
		node.emitLocked(Event{Type: EventNodeOnline})
		node.unlockAndRunCallbacks()
		close(stateDone)
	}()
	<-stateStarted
	want := Frame{NetworkID: 0x1234, EtherType: 0x0800, Payload: []byte{1, 2, 3}}
	node.mu.Lock()
	node.deliverFrameLocked(want)
	node.unlockAndRunCallbacks()
	select {
	case got := <-frames:
		if got.NetworkID != want.NetworkID || got.EtherType != want.EtherType || !bytes.Equal(got.Payload, want.Payload) {
			t.Fatalf("frame callback = %+v, want %+v", got, want)
		}
	case <-time.After(time.Second):
		t.Fatal("frame callback waited behind blocked state callback")
	}
	close(releaseState)
	select {
	case <-stateDone:
	case <-time.After(time.Second):
		t.Fatal("state callback dispatcher did not finish")
	}
}

func TestEventMatchesNodeState(t *testing.T) {
	const networkID = uint64(0x1234)
	authentication := NetworkAuthenticationInfo{Version: 1, AuthenticationURL: "https://auth.example/login"}
	node := &Node{networks: map[uint64]*Network{}}
	if (Event{Type: EventNodeOnline}).MatchesNodeState(nil) {
		t.Fatal("event matched a nil node")
	}
	if !(Event{Type: EventNodeOnline}).MatchesNodeState(node) {
		t.Fatal("non-network event did not match")
	}
	if !(Event{Type: EventNetworkConfigPending, NetworkID: networkID}).MatchesNodeState(node) {
		t.Fatal("non-authoritative network event did not match")
	}
	if (Event{Type: EventNetworkConfigReady, NetworkID: networkID}).MatchesNodeState(node) {
		t.Fatal("ready event matched an absent network")
	}

	tests := []struct {
		name           string
		event          Event
		status         NetworkStatus
		authentication NetworkAuthenticationInfo
		want           bool
	}{
		{name: "ready", event: Event{Type: EventNetworkConfigReady, NetworkID: networkID}, status: NetworkStatusOK, want: true},
		{name: "changed", event: Event{Type: EventNetworkConfigChanged, NetworkID: networkID}, status: NetworkStatusOK, want: true},
		{name: "denied", event: Event{Type: EventNetworkAccessDenied, NetworkID: networkID}, status: NetworkStatusAccessDenied, want: true},
		{name: "not found", event: Event{Type: EventNetworkNotFound, NetworkID: networkID}, status: NetworkStatusNotFound, want: true},
		{name: "authentication", event: Event{Type: EventNetworkAuthenticationRequired, NetworkID: networkID, Authentication: authentication}, status: NetworkStatusAuthenticationRequired, authentication: authentication, want: true},
		{name: "authentication changed", event: Event{Type: EventNetworkAuthenticationRequired, NetworkID: networkID, Authentication: authentication}, status: NetworkStatusAuthenticationRequired, authentication: NetworkAuthenticationInfo{Version: 1, AuthenticationURL: "https://auth.example/new"}},
		{name: "superseded", event: Event{Type: EventNetworkAccessDenied, NetworkID: networkID}, status: NetworkStatusOK},
	}
	for _, test := range tests {
		t.Run(test.name, func(t *testing.T) {
			node.networks[networkID] = &Network{ID: networkID, Status: test.status, Authentication: test.authentication}
			if got := test.event.MatchesNodeState(node); got != test.want {
				t.Fatalf("MatchesNodeState() = %t, want %t", got, test.want)
			}
		})
	}
	delete(node.networks, networkID)
	if !(Event{Type: EventNetworkLeft, NetworkID: networkID}).MatchesNodeState(node) {
		t.Fatal("left event did not match an absent network")
	}
	node.networks[networkID] = &Network{ID: networkID}
	if (Event{Type: EventNetworkLeft, NetworkID: networkID}).MatchesNodeState(node) {
		t.Fatal("left event matched a joined network")
	}
}

// TestPeerPathAndRouteEventsAreStateTransitions verifies authentication,
// successful-send, and route-mode deduplication boundaries.
func TestPeerPathAndRouteEventsAreStateTransitions(t *testing.T) {
	local, err := GenerateIdentity()
	if err != nil {
		t.Fatal(err)
	}
	remote, err := GenerateIdentity()
	if err != nil {
		t.Fatal(err)
	}
	var events []Event
	node, err := NewNode(NodeConfig{
		Identity: local,
		Sender:   WireSenderFunc(func(int64, netip.AddrPort, []byte) error { return nil }),
		OnEvent:  func(event Event) { events = append(events, event) },
	})
	if err != nil {
		t.Fatal(err)
	}
	defer node.Close()
	events = nil
	node.mu.Lock()
	if err = node.addPeerLocked(remote, false); err != nil {
		node.mu.Unlock()
		t.Fatal(err)
	}
	node.unlockAndRunCallbacks()
	events = nil
	endpoint := netip.MustParseAddrPort("198.51.100.20:9993")
	now := time.Now()
	activateTestRootPath(t, node, now)
	node.mu.Lock()
	peer := node.peers[remote.Address()]
	node.observeAuthenticatedPacketPathLocked(peer, 0, endpoint, VerbOK, 1, 0x1234, now)
	node.unlockAndRunCallbacks()
	if len(events) != 1 || events[0].Type != EventPeerPathLearned || events[0].PeerAddress != remote.Address() || events[0].PeerRole != PeerRoleLeaf || events[0].Endpoint != endpoint || events[0].PathCount != 1 {
		t.Fatalf("learned path events = %+v", events)
	}
	node.mu.Lock()
	node.observeAuthenticatedPacketPathLocked(peer, 0, endpoint, VerbFrame, 2, 0x1234, now.Add(time.Second))
	node.unlockAndRunCallbacks()
	if len(events) != 1 {
		t.Fatalf("known path emitted another event: %+v", events)
	}
	sendFrame := func() error {
		packet, packetErr := NewPacket(remote.Address(), local.Address(), VerbFrame)
		if packetErr != nil {
			return packetErr
		}
		node.mu.Lock()
		sendErr := node.sendPacketLocked(peer, packet, true)
		node.unlockAndRunCallbacks()
		return sendErr
	}
	node.mu.Lock()
	sender := node.sender
	node.sender = WireSenderFunc(func(int64, netip.AddrPort, []byte) error { return errors.New("send failed") })
	node.mu.Unlock()
	if err = sendFrame(); err == nil {
		t.Fatal("failed frame send reported success")
	}
	if len(events) != 1 {
		t.Fatalf("failed frame send emitted a route event: %+v", events)
	}
	node.mu.Lock()
	node.sender = sender
	node.mu.Unlock()
	if err = sendFrame(); err != nil {
		t.Fatal(err)
	}
	if err = sendFrame(); err != nil {
		t.Fatal(err)
	}
	node.mu.Lock()
	node.deletePeerPathLocked(peer, pathKey{localSocket: 0, endpoint: endpoint})
	node.mu.Unlock()
	if err = sendFrame(); err != nil {
		t.Fatal(err)
	}
	node.mu.Lock()
	peer.paths[pathKey{localSocket: 0, endpoint: endpoint}] = &peerPathState{lastReceive: now.Add(2 * time.Second), priority: 1}
	node.mu.Unlock()
	if err = sendFrame(); err != nil {
		t.Fatal(err)
	}
	if len(events) != 4 || events[1].Type != EventPeerRouteChanged || events[1].Route != PeerRouteDirect || events[1].Endpoint != endpoint || events[2].Type != EventPeerRouteChanged || events[2].Route != PeerRouteRelayed || events[2].Endpoint.IsValid() || events[3].Type != EventPeerRouteChanged || events[3].Route != PeerRouteDirect {
		t.Fatalf("peer route events = %+v", events)
	}
}

func TestPeerRouteEventCoalescesToLatestState(t *testing.T) {
	local, err := GenerateIdentity()
	if err != nil {
		t.Fatal(err)
	}
	remote, err := GenerateIdentity()
	if err != nil {
		t.Fatal(err)
	}
	var events []Event
	node, err := NewNode(NodeConfig{
		Identity: local,
		Sender:   WireSenderFunc(func(int64, netip.AddrPort, []byte) error { return nil }),
		OnEvent:  func(event Event) { events = append(events, event) },
	})
	if err != nil {
		t.Fatal(err)
	}
	defer node.Close()
	now := time.Now()
	node.mu.Lock()
	if err = node.addPeerLocked(remote, false); err != nil {
		node.mu.Unlock()
		t.Fatal(err)
	}
	peer := node.peers[remote.Address()]
	peer.lastReceive = now
	node.lastRootContact = now
	node.unlockAndRunCallbacks()
	events = nil

	first := netip.MustParseAddrPort("198.51.100.21:9993")
	second := netip.MustParseAddrPort("198.51.100.22:9993")
	latest := netip.MustParseAddrPort("198.51.100.23:9993")
	node.mu.Lock()
	node.observePeerUserRouteLocked(peer, true, first, 1, now)
	node.unlockAndRunCallbacks()
	node.mu.Lock()
	node.observePeerUserRouteLocked(peer, true, second, 1, now.Add(100*time.Millisecond))
	node.observePeerUserRouteLocked(peer, true, latest, 1, now.Add(200*time.Millisecond))
	node.unlockAndRunCallbacks()
	if len(events) != 1 || events[0].Endpoint != first {
		t.Fatalf("events before coalescing deadline = %+v", events)
	}

	wantDeadline := now.Add(peerRouteReportInterval)
	next := node.ProcessBackgroundTasks(wantDeadline.Add(-time.Nanosecond))
	if !next.Equal(wantDeadline) {
		t.Fatalf("next background deadline = %v, want %v", next, wantDeadline)
	}
	if len(events) != 1 {
		t.Fatalf("early coalesced events = %+v", events)
	}
	node.ProcessBackgroundTasks(wantDeadline)
	if len(events) != 2 || events[1].Type != EventPeerRouteChanged || events[1].Route != PeerRouteDirect || events[1].Endpoint != latest || events[1].PathCount != 1 {
		t.Fatalf("coalesced route events = %+v", events)
	}

	node.mu.Lock()
	node.observePeerUserRouteLocked(peer, true, second, 1, wantDeadline.Add(100*time.Millisecond))
	node.observePeerUserRouteLocked(peer, true, latest, 1, wantDeadline.Add(200*time.Millisecond))
	pendingRoute := peer.pendingUserRoute
	node.unlockAndRunCallbacks()
	if pendingRoute != PeerRouteUnknown {
		t.Fatalf("restored route retained pending state %v", pendingRoute)
	}
	node.ProcessBackgroundTasks(wantDeadline.Add(peerRouteReportInterval))
	if len(events) != 2 {
		t.Fatalf("restored route emitted a coalesced event: %+v", events)
	}
}

// TestLocalSurfaceChangeEventMatchesPathReset verifies that only a recent,
// changed trusted report emits an event and invalidates matching paths.
func TestLocalSurfaceChangeEventMatchesPathReset(t *testing.T) {
	identity, err := GenerateIdentity()
	if err != nil {
		t.Fatal(err)
	}
	var events []Event
	node, err := NewNode(NodeConfig{
		Identity: identity,
		Sender:   WireSenderFunc(func(int64, netip.AddrPort, []byte) error { return nil }),
		OnEvent:  func(event Event) { events = append(events, event) },
	})
	if err != nil {
		t.Fatal(err)
	}
	defer node.Close()
	events = nil
	remote := netip.MustParseAddrPort("198.51.100.30:9993")
	previous := netip.MustParseAddrPort("203.0.113.10:40000")
	current := netip.MustParseAddrPort("203.0.113.11:40001")
	path := pathKey{localSocket: 0, endpoint: remote}
	first := time.Now()
	node.mu.Lock()
	var reporter *peer
	for _, candidate := range node.peers {
		if candidate.root {
			reporter = candidate
			break
		}
	}
	if reporter == nil {
		node.mu.Unlock()
		t.Fatal("default planet has no root peer")
	}
	reporter.paths[path] = &peerPathState{lastReceive: first, priority: 1}
	node.observeSurfaceLocked(reporter, 0, remote, previous, first)
	node.observeSurfaceLocked(reporter, 0, remote, previous, first.Add(time.Minute))
	node.observeSurfaceLocked(reporter, 0, remote, current, first.Add(2*time.Minute))
	node.unlockAndRunCallbacks()
	if len(events) != 1 {
		t.Fatalf("surface events = %+v", events)
	}
	event := events[0]
	if event.Type != EventLocalSurfaceChanged || event.ReporterAddress != reporter.identity.Address() || event.PeerRole != PeerRolePlanet || event.PreviousEndpoint != previous || event.Endpoint != current || event.PathCount != 1 {
		t.Fatalf("surface event = %+v", event)
	}
	node.mu.Lock()
	reset := reporter.paths[path].lastReceive.IsZero()
	node.mu.Unlock()
	if !reset {
		t.Fatal("surface event was emitted without invalidating the matching path")
	}
}

func TestFullHelloLocalSocketMatchesOfficialLowBandwidthPolicy(t *testing.T) {
	local, err := GenerateIdentity()
	if err != nil {
		t.Fatal(err)
	}
	remote, err := GenerateIdentity()
	if err != nil {
		t.Fatal(err)
	}
	endpoint := netip.MustParseAddrPort("192.0.2.10:9993")
	for _, test := range []struct {
		name         string
		lowBandwidth bool
		wantSocket   int64
	}{
		{name: "normal", wantSocket: AnyLocalSocket},
		{name: "low-bandwidth", lowBandwidth: true, wantSocket: 7},
	} {
		t.Run(test.name, func(t *testing.T) {
			var sentSocket int64
			node, nodeErr := NewNode(NodeConfig{
				Identity:     local,
				LowBandwidth: test.lowBandwidth,
				Sender: WireSenderFunc(func(localSocket int64, _ netip.AddrPort, _ []byte) error {
					sentSocket = localSocket
					return nil
				}),
			})
			if nodeErr != nil {
				t.Fatal(nodeErr)
			}
			now := time.Now()
			path := pathKey{localSocket: 7, endpoint: endpoint}
			node.mu.Lock()
			if nodeErr = node.addPeerLocked(remote, false); nodeErr == nil {
				node.peers[remote.Address()].paths[path] = &peerPathState{lastReceive: now}
				nodeErr = node.sendHelloAtPathLocked(remote.Address(), path, now)
			}
			lastSend := node.peers[remote.Address()].paths[path].lastSend
			node.mu.Unlock()
			if nodeErr != nil {
				t.Fatal(nodeErr)
			}
			if sentSocket != test.wantSocket {
				t.Fatalf("HELLO local socket = %d, want %d", sentSocket, test.wantSocket)
			}
			if lastSend.IsZero() {
				t.Fatal("HELLO did not update the originating path send time")
			}
		})
	}
}

