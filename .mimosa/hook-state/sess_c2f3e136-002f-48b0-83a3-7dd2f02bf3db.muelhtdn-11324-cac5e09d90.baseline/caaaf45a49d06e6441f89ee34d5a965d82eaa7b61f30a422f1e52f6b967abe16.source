func TestBondControlPacketsDoNotLearnOrRefreshPaths(t *testing.T) {
	identity, remote, node, sent := newTestNodeWithPeer(t)
	key, err := identity.Agree(remote)
	if err != nil {
		t.Fatal(err)
	}
	verbs := []Verb{VerbACK, VerbQoSMeasurement, VerbPathNegotiation}
	for i, verb := range verbs {
		packet, packetErr := NewPacket(identity.Address(), remote.Address(), verb)
		if packetErr != nil {
			t.Fatal(packetErr)
		}
		switch verb {
		case VerbQoSMeasurement:
			_ = packet.Append(make([]byte, 10)...)
		case VerbPathNegotiation:
			_ = packet.AppendUint16(1)
		}
		if packetErr = packet.Armor(key[:], true); packetErr != nil {
			t.Fatal(packetErr)
		}
		endpoint := netip.AddrPortFrom(netip.MustParseAddr("198.51.100.53"), uint16(9993+i))
		if packetErr = node.ProcessWirePacket(0, endpoint, packet.Bytes(), time.Now()); packetErr != nil {
			t.Fatalf("verb %d: %v", verb, packetErr)
		}
	}
	node.mu.Lock()
	peer := node.peers[remote.Address()]
	lastReceive := peer.lastReceive
	pathCount := len(peer.paths)
	node.mu.Unlock()
	if !lastReceive.IsZero() || pathCount != 0 || len(*sent) != 0 {
		t.Fatalf("bond control packets changed receive state: last=%v paths=%d probes=%d", lastReceive, pathCount, len(*sent))
	}
}

