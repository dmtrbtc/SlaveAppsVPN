func TestHelloIdentityCollisionDoesNotRequireValidCollidingIdentity(t *testing.T) {
	local, _ := ParseIdentity(knownGoodIdentity)
	remote, _ := GenerateIdentity()
	node, err := NewNode(NodeConfig{
		Identity: local,
		Sender:   WireSenderFunc(func(int64, netip.AddrPort, []byte) error { return nil }),
	})
	if err != nil {
		t.Fatal(err)
	}
	node.mu.Lock()
	if err = node.addPeerLocked(remote, false); err != nil {
		node.mu.Unlock()
		t.Fatal(err)
	}
	node.mu.Unlock()
	collision := remote
	collision.public[0] ^= 0x80
	packet, _ := NewPacket(local.Address(), collision.Address(), VerbHello)
	_ = packet.Append(ProtocolVersion, nodeVersionMajor, nodeVersionMinor)
	_ = packet.AppendUint16(nodeVersionRev)
	_ = packet.AppendUint64(uint64(time.Now().UnixMilli()))
	_ = packet.Append(collision.AppendBinary(nil, false)...)
	key, err := local.Agree(collision)
	if err != nil {
		t.Fatal(err)
	}
	if err = packet.Armor(key[:], false); err != nil {
		t.Fatal(err)
	}
	err = node.ProcessWirePacket(0, netip.MustParseAddrPort("192.0.2.1:9993"), packet.Bytes(), time.Now())
	if !errors.Is(err, ErrIdentityCollision) {
		t.Fatalf("collision HELLO error = %v, want ErrIdentityCollision", err)
	}
}

func TestHelloCommitsPeerVersionBeforeReplayingQueuedPackets(t *testing.T) {
	local, err := GenerateIdentity()
	if err != nil {
		t.Fatal(err)
	}
	remote, err := GenerateIdentity()
	if err != nil {
		t.Fatal(err)
	}
	key, err := remote.Agree(local)
	if err != nil {
		t.Fatal(err)
	}
	var sent [][]byte
	node, err := NewNode(NodeConfig{
		Identity: local,
		Sender: WireSenderFunc(func(_ int64, _ netip.AddrPort, packet []byte) error {
			sent = append(sent, append([]byte(nil), packet...))
			return nil
		}),
	})
	if err != nil {
		t.Fatal(err)
	}
	endpoint := netip.MustParseAddrPort("192.0.2.40:9993")
	now := time.Now()
	echo, err := NewPacket(local.Address(), remote.Address(), VerbEcho)
	if err == nil {
		err = echo.ArmorAES(key[:])
	}
	if err != nil {
		t.Fatal(err)
	}
	if err = node.ProcessWirePacket(4, endpoint, echo.Bytes(), now); !errors.Is(err, ErrUnknownPeer) {
		t.Fatalf("unknown peer ECHO error = %v", err)
	}

	hello, err := NewPacket(local.Address(), remote.Address(), VerbHello)
	if err == nil {
		err = hello.Append(ProtocolVersion, NodeVersionMajor, NodeVersionMinor)
	}
	if err == nil {
		err = hello.AppendUint16(NodeVersionRevision)
	}
	if err == nil {
		err = hello.AppendUint64(uint64(now.UnixMilli()))
	}
	if err == nil {
		err = hello.Append(remote.AppendBinary(nil, false)...)
	}
	if err == nil {
		err = hello.Armor(key[:], false)
	}
	if err != nil {
		t.Fatal(err)
	}
	if err = node.ProcessWirePacket(4, endpoint, hello.Bytes(), now.Add(time.Millisecond)); err != nil {
		t.Fatal(err)
	}
	foundEchoReply := false
	for _, wire := range sent {
		packet, parseErr := ParsePacket(wire)
		if parseErr != nil || packet.Cipher() != CipherSuiteAESGMACSIV || packet.Dearmor(key[:]) != nil {
			continue
		}
		payload := packet.Payload()
		if packet.Verb() == VerbOK && len(payload) >= 1 && Verb(payload[0]) == VerbEcho {
			foundEchoReply = true
			break
		}
	}
	if !foundEchoReply {
		t.Fatal("queued ECHO was replayed before protocol-12 armor became available")
	}
}

func TestEncryptedHelloConfirmsUnknownPath(t *testing.T) {
	localIdentity, _ := GenerateIdentity()
	remoteIdentity, _ := GenerateIdentity()
	var hello []byte
	remote, err := NewNode(NodeConfig{
		Identity:       remoteIdentity,
		EncryptedHello: true,
		Sender: WireSenderFunc(func(_ int64, _ netip.AddrPort, packet []byte) error {
			hello = append([]byte(nil), packet...)
			return nil
		}),
	})
	if err != nil {
		t.Fatal(err)
	}
	local, err := NewNode(NodeConfig{
		Identity: localIdentity,
		Sender:   WireSenderFunc(func(int64, netip.AddrPort, []byte) error { return nil }),
	})
	if err != nil {
		t.Fatal(err)
	}
	remote.mu.Lock()
	if err = remote.addPeerLocked(localIdentity, false); err != nil {
		remote.mu.Unlock()
		t.Fatal(err)
	}
	remote.peers[localIdentity.Address()].protocol = ProtocolVersion
	endpoint := netip.MustParseAddrPort("192.0.2.20:9993")
	err = remote.sendHelloLocked(localIdentity.Address(), endpoint, time.Now())
	remote.mu.Unlock()
	if err != nil {
		t.Fatal(err)
	}
	local.mu.Lock()
	if err = local.addPeerLocked(remoteIdentity, false); err != nil {
		local.mu.Unlock()
		t.Fatal(err)
	}
	local.mu.Unlock()
	if err = local.ProcessWirePacket(7, endpoint, hello, time.Now()); err != nil {
		t.Fatal(err)
	}
	path := pathKey{localSocket: 7, endpoint: endpoint}
	local.mu.Lock()
	_, probing := local.peers[remoteIdentity.Address()].pathProbe[path]
	local.mu.Unlock()
	if !probing {
		t.Fatal("encrypted HELLO did not start authenticated path confirmation")
	}
}

func TestUnknownPathRequiresAuthenticatedOK(t *testing.T) {
	identity, err := ParseIdentity(knownGoodIdentity)
	if err != nil {
		t.Fatal(err)
	}
	remoteIdentity, err := GenerateIdentity()
	if err != nil {
		t.Fatal(err)
	}
	var sent [][]byte
	node, err := NewNode(NodeConfig{
		Identity: identity,
		Sender: WireSenderFunc(func(_ int64, _ netip.AddrPort, packet []byte) error {
			sent = append(sent, append([]byte(nil), packet...))
			return nil
		}),
	})
	if err != nil {
		t.Fatal(err)
	}
	node.mu.Lock()
	if err := node.addPeerLocked(remoteIdentity, false); err != nil {
		node.mu.Unlock()
		t.Fatal(err)
	}
	node.peers[remoteIdentity.Address()].protocol = ProtocolVersion
	node.mu.Unlock()
	key, err := remoteIdentity.Agree(identity)
	if err != nil {
		t.Fatal(err)
	}
	endpoint := netip.MustParseAddrPort("203.0.113.10:9993")
	now := time.Unix(1700000000, 0)
	echo, _ := NewPacket(identity.Address(), remoteIdentity.Address(), VerbEcho)
	if err := echo.Armor(key[:], true); err != nil {
		t.Fatal(err)
	}
	if err := node.ProcessWirePacket(0, endpoint, echo.Bytes(), now); err != nil {
		t.Fatal(err)
	}
	if paths := peerPaths(node, remoteIdentity.Address()); len(paths) != 0 {
		t.Fatalf("unconfirmed path was learned from ECHO: %+v", paths)
	}
	node.mu.Lock()
	var probeID uint64
	for packetID, request := range node.pending {
		if request.verb == VerbHello && request.path.endpoint == endpoint {
			probeID = packetID
			break
		}
	}
	node.mu.Unlock()
	if probeID == 0 {
		t.Fatal("unknown path did not start a full HELLO confirmation")
	}
	confirmationCount := 0
	for _, wire := range sent {
		probe, parseErr := ParsePacket(wire)
		if parseErr != nil || probe.Dearmor(key[:]) != nil {
			continue
		}
		if probe.Verb() == VerbHello && probe.PacketID() == probeID {
			confirmationCount++
		}
	}
	if confirmationCount != 1 {
		t.Fatalf("full HELLO confirmations = %d, sent packets = %d", confirmationCount, len(sent))
	}
	okPacket, _ := NewPacket(identity.Address(), remoteIdentity.Address(), VerbOK)
	_ = okPacket.Append(byte(VerbHello))
	_ = okPacket.AppendUint64(probeID)
	_ = okPacket.AppendUint64(uint64(now.UnixMilli()))
	_ = okPacket.Append(ProtocolVersion, nodeVersionMajor, nodeVersionMinor)
	_ = okPacket.AppendUint16(nodeVersionRev)
	if err := okPacket.Armor(key[:], true); err != nil {
		t.Fatal(err)
	}
	if err := node.ProcessWirePacket(0, endpoint, okPacket.Bytes(), now.Add(time.Millisecond)); err != nil {
		t.Fatal(err)
	}
	paths := peerPaths(node, remoteIdentity.Address())
	if len(paths) != 1 || paths[0].Endpoint != endpoint {
		t.Fatalf("authenticated OK did not confirm path: %+v", paths)
	}
}

