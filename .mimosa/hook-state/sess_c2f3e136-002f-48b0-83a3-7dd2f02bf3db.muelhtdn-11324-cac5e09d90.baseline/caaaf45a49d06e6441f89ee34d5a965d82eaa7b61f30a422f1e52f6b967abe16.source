func TestPhysicalReceiveRestoresOfficialPathQuality(t *testing.T) {
	_, remote, node, _ := newTestNodeWithPeer(t)
	now := time.Unix(1700000000, 0)
	refreshed := pathKey{localSocket: 5, endpoint: netip.MustParseAddrPort("198.51.100.85:9993")}
	steady := pathKey{localSocket: 6, endpoint: netip.MustParseAddrPort("198.51.100.86:9993")}
	staleAt := now.Add(-peerPathActiveTime)
	node.mu.Lock()
	peer := node.peers[remote.Address()]
	node.addPeerPathLocked(peer, refreshed, &peerPathState{lastReceive: staleAt, latency: time.Millisecond, priority: 1}, staleAt)
	node.addPeerPathLocked(peer, steady, &peerPathState{lastReceive: now, latency: 10 * time.Millisecond, priority: 1}, now)
	before := node.bestDirectPeerPathLocked(peer, now)
	node.mu.Unlock()
	if before != steady {
		t.Fatalf("path before physical receive = %v, want %v", before, steady)
	}

	_ = node.ProcessWirePacket(refreshed.localSocket, refreshed.endpoint, []byte{1, 2, 3}, now)
	node.mu.Lock()
	after := node.bestDirectPeerPathLocked(peer, now)
	node.mu.Unlock()
	if after != refreshed {
		t.Fatalf("path after physical receive = %v, want %v", after, refreshed)
	}
}

func TestWirePathActivityReferencesFollowPeerPaths(t *testing.T) {
	local, err := GenerateIdentity()
	if err != nil {
		t.Fatal(err)
	}
	first, err := GenerateIdentity()
	if err != nil {
		t.Fatal(err)
	}
	second, err := GenerateIdentity()
	if err != nil {
		t.Fatal(err)
	}
	node, err := NewNode(NodeConfig{Identity: local, Sender: WireSenderFunc(func(int64, netip.AddrPort, []byte) error { return nil })})
	if err != nil {
		t.Fatal(err)
	}
	defer node.Close()
	now := time.Now()
	key := pathKey{localSocket: 7, endpoint: netip.MustParseAddrPort("198.51.100.87:9993")}
	node.mu.Lock()
	if err = node.addPeerLocked(first, false); err == nil {
		err = node.addPeerLocked(second, false)
	}
	if err != nil {
		node.mu.Unlock()
		t.Fatal(err)
	}
	node.addPeerPathLocked(node.peers[first.Address()], key, &peerPathState{lastReceive: now}, now)
	node.addPeerPathLocked(node.peers[second.Address()], key, &peerPathState{lastReceive: now}, now)
	value, loaded := node.wirePaths.Load(key)
	if !loaded || value.(*wirePathActivity).references != 2 {
		node.mu.Unlock()
		t.Fatalf("shared wire path = %v, loaded=%t", value, loaded)
	}
	node.removePeerLocked(first.Address())
	value, loaded = node.wirePaths.Load(key)
	if !loaded || value.(*wirePathActivity).references != 1 {
		node.mu.Unlock()
		t.Fatalf("wire path after first removal = %v, loaded=%t", value, loaded)
	}
	node.removePeerLocked(second.Address())
	_, loaded = node.wirePaths.Load(key)
	node.mu.Unlock()
	if loaded {
		t.Fatal("wire path activity survived its final peer path")
	}
}

