func TestPushDirectPathsLimitsEachScopeAndFamily(t *testing.T) {
	identity, remoteIdentity, node, sent := newTestNodeWithPeer(t)
	key, err := remoteIdentity.Agree(identity)
	if err != nil {
		t.Fatal(err)
	}
	packet, _ := NewPacket(identity.Address(), remoteIdentity.Address(), VerbPushDirectPaths)
	_ = packet.AppendUint16(10)
	for i := 1; i <= 10; i++ {
		appendPushedIPv4(packet, 0, netip.AddrPortFrom(netip.AddrFrom4([4]byte{203, 0, 113, byte(i)}), uint16(20000+i)))
	}
	if err := packet.Armor(key[:], true); err != nil {
		t.Fatal(err)
	}
	if err := node.ProcessWirePacket(0, netip.MustParseAddrPort("198.51.100.1:9993"), packet.Bytes(), time.Now()); err != nil {
		t.Fatal(err)
	}
	probes := 0
	for _, wirePacket := range *sent {
		if wirePacket.remote.Addr().Is4() && wirePacket.remote.Port() >= 20001 && wirePacket.remote.Port() <= 20010 {
			probes++
		}
	}
	if probes != maxPushedPathsPerScopeAndFamily {
		t.Fatalf("pushed IPv4 probes = %d, want %d", probes, maxPushedPathsPerScopeAndFamily)
	}
}

func TestPathScopeMatchesZeroTierOne(t *testing.T) {
	for address, want := range map[string]int{
		"8.8.8.8":           4,
		"6.1.2.3":           3,
		"10.1.2.3":          7,
		"100.64.1.2":        7,
		"192.0.2.1":         7,
		"198.18.0.1":        7,
		"203.0.113.1":       7,
		"240.0.0.1":         3,
		"127.0.0.1":         0,
		"169.254.1.2":       0,
		"fd00::1":           7,
		"2001:4860:4860::8": 4,
		"2001:470::1":       0,
		"fe80::1":           0,
	} {
		if got := pathScope(netip.MustParseAddr(address)); got != want {
			t.Errorf("pathScope(%s) = %d, want %d", address, got, want)
		}
	}
	if !IsGlobalPhysicalAddress(netip.MustParseAddr("2001:470::1")) {
		t.Fatal("HE tunnel address lost its global IP scope")
	}
	if IsGlobalPhysicalAddress(netip.MustParseAddr("192.0.2.1")) {
		t.Fatal("ZeroTier-private documentation address was treated as global")
	}
}

func TestPeerPathMaintenanceAndEviction(t *testing.T) {
	_, remoteIdentity, node, sent := newTestNodeWithPeer(t)
	now := time.Now()
	expired := netip.MustParseAddrPort("203.0.113.1:9993")
	active := netip.MustParseAddrPort("203.0.113.2:9993")

	node.mu.Lock()
	peer := node.peers[remoteIdentity.Address()]
	peer.lastReceive = now
	peer.lastNontrivialReceive = now
	peer.paths[pathKey{localSocket: 0, endpoint: expired}] = &peerPathState{lastReceive: now.Add(-peerPathExpiration)}
	peer.paths[pathKey{localSocket: 0, endpoint: active}] = &peerPathState{lastReceive: now.Add(-time.Second), lastProbe: now.Add(-peerPathPingPeriod)}
	node.lastRootContact = now
	node.mu.Unlock()

	node.ProcessBackgroundTasks(now)
	paths := peerPaths(node, remoteIdentity.Address())
	if len(paths) != 1 || paths[0].Endpoint != active {
		t.Fatalf("paths after maintenance = %+v", paths)
	}
	foundKeepalive := false
	for _, wirePacket := range *sent {
		if wirePacket.remote == active {
			foundKeepalive = true
		}
	}
	if !foundKeepalive {
		t.Fatal("active peer path did not receive its periodic authenticated probe")
	}

	node.mu.Lock()
	peer.paths = make(map[pathKey]*peerPathState)
	for i := 0; i < maxPeerPaths; i++ {
		endpoint := netip.AddrPortFrom(netip.AddrFrom4([4]byte{203, 0, byte(i / 250), byte(i%250 + 1)}), uint16(10000+i))
		peer.paths[pathKey{localSocket: 0, endpoint: endpoint}] = &peerPathState{lastReceive: now.Add(time.Duration(i) * time.Millisecond)}
	}
	newEndpoint := netip.MustParseAddrPort("198.51.100.200:29993")
	node.observeAuthenticatedPathLocked(peer, 0, newEndpoint, VerbOK, now.Add(time.Second))
	pathCount := len(peer.paths)
	_, oldestPresent := peer.paths[pathKey{localSocket: 0, endpoint: netip.MustParseAddrPort("203.0.0.1:10000")}]
	_, newestPresent := peer.paths[pathKey{localSocket: 0, endpoint: newEndpoint}]
	node.mu.Unlock()
	if pathCount != maxPeerPaths || oldestPresent || !newestPresent {
		t.Fatalf("path eviction: count=%d oldest=%t newest=%t", pathCount, oldestPresent, newestPresent)
	}
}

func TestFullFreshPathSetRejectsNewPath(t *testing.T) {
	_, remoteIdentity, node, _ := newTestNodeWithPeer(t)
	now := time.Now()
	node.mu.Lock()
	peer := node.peers[remoteIdentity.Address()]
	for i := 0; i < maxPeerPaths; i++ {
		endpoint := netip.AddrPortFrom(netip.AddrFrom4([4]byte{203, 0, byte(i / 250), byte(i%250 + 1)}), uint16(10000+i))
		node.addPeerPathLocked(peer, pathKey{endpoint: endpoint}, &peerPathState{lastReceive: now, priority: 1}, now)
	}
	newEndpoint := netip.MustParseAddrPort("198.51.100.200:29993")
	node.observeAuthenticatedPathLocked(peer, 0, newEndpoint, VerbOK, now)
	pathCount := len(peer.paths)
	_, learned := peer.paths[pathKey{endpoint: newEndpoint}]
	node.mu.Unlock()
	if pathCount != maxPeerPaths || learned {
		t.Fatalf("fresh full path set: count=%d learned=%t", pathCount, learned)
	}
}

func TestEqualAgePathEvictionIsStable(t *testing.T) {
	_, remoteIdentity, node, _ := newTestNodeWithPeer(t)
	now := time.Now()
	first := pathKey{localSocket: 1, endpoint: netip.MustParseAddrPort("198.51.100.10:9993")}
	second := pathKey{localSocket: 2, endpoint: netip.MustParseAddrPort("198.51.100.20:9993")}
	node.mu.Lock()
	peer := node.peers[remoteIdentity.Address()]
	peer.paths[first] = &peerPathState{lastReceive: now.Add(-time.Second)}
	peer.paths[second] = &peerPathState{lastReceive: now.Add(-time.Second)}
	evicted := node.evictOldestPathLocked(peer, now)
	_, firstPresent := peer.paths[first]
	_, secondPresent := peer.paths[second]
	node.mu.Unlock()
	if !evicted || firstPresent || !secondPresent {
		t.Fatalf("equal-age eviction: evicted=%t first=%t second=%t", evicted, firstPresent, secondPresent)
	}
}

func TestStaleDirectPathRemainsUsableUntilExpiration(t *testing.T) {
	_, remoteIdentity, node, _ := newTestNodeWithPeer(t)
	now := time.Now()
	path := pathKey{localSocket: 1, endpoint: netip.MustParseAddrPort("198.51.100.80:9993")}
	node.mu.Lock()
	peer := node.peers[remoteIdentity.Address()]
	peer.paths[path] = &peerPathState{lastReceive: now.Add(-30 * time.Second), latency: time.Millisecond, priority: 1}
	selected := node.bestDirectPeerPathLocked(peer, now)
	node.mu.Unlock()
	if selected != path {
		t.Fatalf("stale-but-unexpired path = %+v, want %+v", selected, path)
	}
}

func TestAuthenticatedPathIsNotRecheckedAfterLearning(t *testing.T) {
	_, remoteIdentity, node, _ := newTestNodeWithPeer(t)
	now := time.Now()
	endpoint := netip.MustParseAddrPort("198.51.100.81:9993")
	allow, checks := true, 0
	node.mu.Lock()
	node.pathCheck = func(Address, int64, netip.AddrPort) bool {
		checks++
		return allow
	}
	peer := node.peers[remoteIdentity.Address()]
	node.observeAuthenticatedPacketPathLocked(peer, 1, endpoint, VerbOK, 1, 0, now)
	allow = false
	selected := node.bestDirectPeerPathLocked(peer, now)
	probeErr := node.sendPathProbeLocked(peer, 1, endpoint, now.Add(peerPathPingPeriod))
	node.mu.Unlock()
	if probeErr != nil {
		t.Fatal(probeErr)
	}
	want := pathKey{localSocket: 1, endpoint: endpoint}
	if selected != want {
		t.Fatalf("authenticated path = %v, want %v", selected, want)
	}
	peers := node.Peers()
	if checks != 1 {
		t.Fatalf("path checks = %d, want one check while learning", checks)
	}
	var remoteStatus *PeerStatus
	for index := range peers {
		if peers[index].Address == remoteIdentity.Address() {
			remoteStatus = &peers[index]
			break
		}
	}
	if remoteStatus == nil || len(remoteStatus.Paths) != 1 || !remoteStatus.Paths[0].Active {
		t.Fatalf("authenticated path diagnostics = %+v", remoteStatus)
	}
}

