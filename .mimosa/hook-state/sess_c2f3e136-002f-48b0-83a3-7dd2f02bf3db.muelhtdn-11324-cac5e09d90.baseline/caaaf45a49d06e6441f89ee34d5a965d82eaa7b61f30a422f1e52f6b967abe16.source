func TestPeerCacheLazilyRestoresOfficialPeerState(t *testing.T) {
	local, err := ParseIdentity(knownGoodIdentity)
	if err != nil {
		t.Fatal(err)
	}
	remote, err := GenerateIdentity()
	if err != nil {
		t.Fatal(err)
	}
	store := NewMemoryStore()
	now := time.Now()
	var sent []sentWirePacket
	newNode := func() *Node {
		node, nodeErr := NewNode(NodeConfig{
			Identity: local,
			Store:    store,
			Sender: WireSenderFunc(func(_ int64, remote netip.AddrPort, packet []byte) error {
				sent = append(sent, sentWirePacket{remote: remote, data: append([]byte(nil), packet...)})
				return nil
			}),
		})
		if nodeErr != nil {
			t.Fatal(nodeErr)
		}
		return node
	}
	node := newNode()
	endpoint := netip.MustParseAddrPort("198.51.100.30:9993")
	expiredEndpoint := netip.MustParseAddrPort("198.51.100.31:9993")
	node.mu.Lock()
	if err = node.addPeerLocked(remote, false); err != nil {
		node.mu.Unlock()
		t.Fatal(err)
	}
	peer := node.peers[remote.Address()]
	peer.lastReceive = now
	peer.protocol, peer.major, peer.minor, peer.revision = 13, 1, 16, 2
	peer.paths[pathKey{localSocket: 7, endpoint: endpoint}] = &peerPathState{lastReceive: now, latency: 12 * time.Millisecond, priority: 3}
	peer.paths[pathKey{localSocket: 8, endpoint: expiredEndpoint}] = &peerPathState{lastReceive: now.Add(-peerPathExpiration), latency: time.Second, priority: 1}
	node.savePeerCacheLocked()
	node.mu.Unlock()
	data := store.data[peerCacheName(remote.Address())]
	if len(data) == 0 || data[0] != 2 {
		t.Fatalf("official peer cache was not written: %x", data)
	}
	expected := []byte{2}
	expected = remote.AppendBinary(expected, false)
	expected = binary.BigEndian.AppendUint16(expected, 13)
	expected = binary.BigEndian.AppendUint16(expected, 1)
	expected = binary.BigEndian.AppendUint16(expected, 16)
	expected = binary.BigEndian.AppendUint16(expected, 2)
	expected = binary.BigEndian.AppendUint16(expected, 2)
	expected = appendInetAddress(expected, endpoint)
	expected = appendInetAddress(expected, expiredEndpoint)
	if !bytes.Equal(data, expected) {
		t.Fatalf("peer cache = %x, want official v2 layout %x", data, expected)
	}
	if _, exists := store.data["peers.d/cache"]; exists {
		t.Fatal("legacy aggregate peer cache was written")
	}

	sent = nil
	restored := newNode()
	restored.mu.Lock()
	peer = restored.peers[remote.Address()]
	restored.mu.Unlock()
	if peer != nil {
		t.Fatal("peer cache was eagerly scanned")
	}
	if identity, ok := restored.PeerIdentity(remote.Address()); !ok || identity.PublicString() != remote.PublicString() {
		t.Fatal("cached peer identity was not restored on demand")
	}
	restored.mu.Lock()
	peer = restored.peers[remote.Address()]
	if peer == nil {
		restored.mu.Unlock()
		t.Fatal("cached peer identity was not restored")
	}
	pathCount := len(peer.paths)
	protocol, revision := peer.protocol, peer.revision
	restored.mu.Unlock()
	if pathCount != 0 || protocol != 13 || revision != 2 {
		t.Fatalf("restored peer state: paths=%d protocol=%d revision=%d", pathCount, protocol, revision)
	}
	if len(sent) != 2 || sent[0].remote != endpoint || sent[1].remote != expiredEndpoint {
		t.Fatalf("cached path probes = %+v, want [%s %s]", sent, endpoint, expiredEndpoint)
	}
}

func TestPeerCachePersistsOnCloseInsteadOfPeriodicTraffic(t *testing.T) {
	local, err := ParseIdentity(knownGoodIdentity)
	if err != nil {
		t.Fatal(err)
	}
	remote, err := GenerateIdentity()
	if err != nil {
		t.Fatal(err)
	}
	store := NewMemoryStore()
	node, err := NewNode(NodeConfig{
		Identity: local,
		Store:    store,
		Sender:   WireSenderFunc(func(int64, netip.AddrPort, []byte) error { return nil }),
	})
	if err != nil {
		t.Fatal(err)
	}
	now := time.Now()
	node.mu.Lock()
	if err = node.addPeerLocked(remote, false); err != nil {
		node.mu.Unlock()
		t.Fatal(err)
	}
	peer := node.peers[remote.Address()]
	peer.lastReceive = now
	peer.protocol, peer.major, peer.minor, peer.revision = 13, 1, 16, 2
	peer.paths[pathKey{localSocket: 7, endpoint: netip.MustParseAddrPort("198.51.100.30:9993")}] = &peerPathState{lastReceive: now}
	node.mu.Unlock()

	node.ProcessBackgroundTasks(now.Add(2 * time.Minute))
	if _, exists := store.data[peerCacheName(remote.Address())]; exists {
		t.Fatal("active peer was persisted by periodic traffic maintenance")
	}
	if err = node.Close(); err != nil {
		t.Fatal(err)
	}
	if _, exists := store.data[peerCacheName(remote.Address())]; !exists {
		t.Fatal("active peer was not persisted during node shutdown")
	}
}

func TestFragmentAssemblyUsesHeadPath(t *testing.T) {
	identity, err := ParseIdentity(knownGoodIdentity)
	if err != nil {
		t.Fatal(err)
	}
	node, err := NewNode(NodeConfig{Identity: identity, Sender: WireSenderFunc(func(int64, netip.AddrPort, []byte) error { return nil })})
	if err != nil {
		t.Fatal(err)
	}
	head := make([]byte, PacketMinSize)
	binary.BigEndian.PutUint64(head, 0x0102030405060708)
	destination := identity.Address().Bytes()
	copy(head[PacketDestOffset:PacketSourceOffset], destination[:])
	head[PacketFlagsOffset] = FlagFragmented
	fragment := make([]byte, 17)
	copy(fragment[:8], head[:8])
	copy(fragment[8:13], destination[:])
	fragment[13] = 0xff
	fragment[14] = 0x21
	fragment[16] = 0xaa
	headRemote := netip.MustParseAddrPort("198.51.100.10:9993")
	fragmentRemote := netip.MustParseAddrPort("203.0.113.20:9993")
	fragmentTime := time.Now()
	headTime := fragmentTime.Add(time.Second)
	if _, complete, err := node.reassembleWirePacket(9, fragmentRemote, fragment, fragmentTime); err != nil || complete {
		t.Fatalf("fragment first: complete=%t err=%v", complete, err)
	}
	assembled, complete, err := node.reassembleWirePacket(7, headRemote, head, headTime)
	if err != nil || !complete {
		t.Fatalf("assembly: complete=%t err=%v", complete, err)
	}
	if assembled.localSocket != 7 || assembled.remote != headRemote || !assembled.receivedAt.Equal(headTime) {
		t.Fatalf("assembly origin = (%d, %s, %v), want head (%d, %s, %v)", assembled.localSocket, assembled.remote, assembled.receivedAt, 7, headRemote, headTime)
	}
}

func TestIncompleteFragmentDoesNotWaitForProtocolState(t *testing.T) {
	identity, err := ParseIdentity(knownGoodIdentity)
	if err != nil {
		t.Fatal(err)
	}
	node, err := NewNode(NodeConfig{Identity: identity, Sender: WireSenderFunc(func(int64, netip.AddrPort, []byte) error { return nil })})
	if err != nil {
		t.Fatal(err)
	}
	fragment := make([]byte, FragmentHeaderSize+1)
	binary.BigEndian.PutUint64(fragment, 0x0102030405060708)
	destination := identity.Address().Bytes()
	copy(fragment[8:13], destination[:])
	fragment[13], fragment[14] = 0xff, 0x21

	node.mu.Lock()
	result := make(chan error, 1)
	go func() {
		result <- node.ProcessWirePacket(1, netip.MustParseAddrPort("198.51.100.1:9993"), fragment, time.Now())
	}()
	select {
	case processErr := <-result:
		node.mu.Unlock()
		if processErr != nil {
			t.Fatal(processErr)
		}
	case <-time.After(2 * time.Second):
		node.mu.Unlock()
		<-result
		t.Fatal("incomplete fragment waited for protocol-state lock")
	}
}

func TestFragmentAssemblyCloseRace(t *testing.T) {
	identity, err := ParseIdentity(knownGoodIdentity)
	if err != nil {
		t.Fatal(err)
	}
	node, err := NewNode(NodeConfig{Identity: identity, Sender: WireSenderFunc(func(int64, netip.AddrPort, []byte) error { return nil })})
	if err != nil {
		t.Fatal(err)
	}
	destination := identity.Address().Bytes()
	remote := netip.MustParseAddrPort("198.51.100.1:9993")
	start := make(chan struct{})
	var workers sync.WaitGroup
	for worker := 0; worker < 8; worker++ {
		workers.Add(1)
		go func(worker int) {
			defer workers.Done()
			<-start
			for index := 0; index < 256; index++ {
				packetID := uint64(worker+1)<<32 | uint64(index+1)
				fragment := make([]byte, FragmentHeaderSize+1)
				binary.BigEndian.PutUint64(fragment, packetID)
				copy(fragment[8:13], destination[:])
				fragment[13], fragment[14] = 0xff, 0x21
				if _, _, reassembleErr := node.reassembleWirePacket(int64(worker), remote, fragment, time.Now()); reassembleErr != nil && !errors.Is(reassembleErr, ErrNodeClosed) {
					t.Errorf("reassemble fragment: %v", reassembleErr)
					return
				}
			}
		}(worker)
	}
	close(start)
	if err = node.Close(); err != nil {
		t.Fatal(err)
	}
	workers.Wait()
	node.fragmentMu.Lock()
	assemblies := len(node.fragments)
	node.fragmentMu.Unlock()
	if assemblies != 0 {
		t.Fatalf("assemblies after Close = %d", assemblies)
	}
}

func TestFragmentAssemblyRejectsForeignHead(t *testing.T) {
	identity, err := ParseIdentity(knownGoodIdentity)
	if err != nil {
		t.Fatal(err)
	}
	node, err := NewNode(NodeConfig{Identity: identity, Sender: WireSenderFunc(func(int64, netip.AddrPort, []byte) error { return nil })})
	if err != nil {
		t.Fatal(err)
	}
	head := make([]byte, PacketMinSize)
	binary.BigEndian.PutUint64(head, 1)
	foreign := NewAddress(identity.Address().Uint64() + 1).Bytes()
	copy(head[PacketDestOffset:PacketSourceOffset], foreign[:])
	head[PacketFlagsOffset] = FlagFragmented

	_, complete, err := node.reassembleWirePacket(0, netip.MustParseAddrPort("198.51.100.1:9993"), head, time.Now())
	node.fragmentMu.Lock()
	assemblies := len(node.fragments)
	node.fragmentMu.Unlock()
	if !errors.Is(err, ErrInvalidPacket) || complete || assemblies != 0 {
		t.Fatalf("foreign fragmented head: complete=%t assemblies=%d err=%v", complete, assemblies, err)
	}
}

func TestFragmentAssemblyIgnoresDuplicates(t *testing.T) {
	identity, err := ParseIdentity(knownGoodIdentity)
	if err != nil {
		t.Fatal(err)
	}
	node, err := NewNode(NodeConfig{Identity: identity, Sender: WireSenderFunc(func(int64, netip.AddrPort, []byte) error { return nil })})
	if err != nil {
		t.Fatal(err)
	}
	const packetID = uint64(0x0102030405060708)
	destination := identity.Address().Bytes()
	fragment := make([]byte, 17)
	binary.BigEndian.PutUint64(fragment, packetID)
	copy(fragment[8:13], destination[:])
	fragment[13], fragment[14], fragment[16] = 0xff, 0x31, 0xaa
	duplicateFragment := append([]byte(nil), fragment...)
	duplicateFragment[16] = 0xbb
	lastFragment := append([]byte(nil), fragment...)
	lastFragment[14], lastFragment[16] = 0x32, 0xcc
	head := make([]byte, PacketMinSize)
	binary.BigEndian.PutUint64(head, packetID)
	copy(head[PacketDestOffset:PacketSourceOffset], destination[:])
	head[PacketFlagsOffset], head[PacketVerbOffset] = FlagFragmented, byte(VerbFrame)
	duplicateHead := append([]byte(nil), head...)
	duplicateHead[PacketVerbOffset] = byte(VerbUserMessage)
	now := time.Now()

	_, _, _ = node.reassembleWirePacket(1, netip.MustParseAddrPort("198.51.100.1:9993"), fragment, now)
	_, _, _ = node.reassembleWirePacket(1, netip.MustParseAddrPort("198.51.100.1:9993"), duplicateFragment, now.Add(time.Second))
	_, _, _ = node.reassembleWirePacket(2, netip.MustParseAddrPort("198.51.100.2:9993"), head, now.Add(2*time.Second))
	_, _, _ = node.reassembleWirePacket(3, netip.MustParseAddrPort("198.51.100.3:9993"), duplicateHead, now.Add(3*time.Second))
	assembled, complete, err := node.reassembleWirePacket(4, netip.MustParseAddrPort("198.51.100.4:9993"), lastFragment, now.Add(4*time.Second))
	if err != nil || !complete {
		t.Fatalf("duplicate assembly: complete=%t err=%v", complete, err)
	}
	if assembled.data[PacketVerbOffset] != byte(VerbFrame) || assembled.data[len(head)] != 0xaa || assembled.data[len(assembled.data)-1] != 0xcc {
		t.Fatalf("duplicate data replaced first arrival: verb=%d first=%x tail=%x", assembled.data[PacketVerbOffset], assembled.data[len(head)], assembled.data[len(assembled.data)-1])
	}
	if !assembled.receivedAt.Equal(now.Add(2*time.Second)) || assembled.localSocket != 2 {
		t.Fatalf("duplicate refreshed assembly: received=%v socket=%d", assembled.receivedAt, assembled.localSocket)
	}
}

func TestFragmentAssemblyOverwritesOldestSlot(t *testing.T) {
	identity, err := ParseIdentity(knownGoodIdentity)
	if err != nil {
		t.Fatal(err)
	}
	node, err := NewNode(NodeConfig{Identity: identity, Sender: WireSenderFunc(func(int64, netip.AddrPort, []byte) error { return nil })})
	if err != nil {
		t.Fatal(err)
	}
	destination := identity.Address().Bytes()
	makeFragment := func(packetID uint64) []byte {
		fragment := make([]byte, 17)
		binary.BigEndian.PutUint64(fragment, packetID)
		copy(fragment[8:13], destination[:])
		fragment[13], fragment[14] = 0xff, 0x21
		return fragment
	}
	now := time.Now()
	for packetID := uint64(1); packetID <= maxFragmentAssemblies+1; packetID++ {
		if _, complete, reassembleErr := node.reassembleWirePacket(0, netip.MustParseAddrPort("198.51.100.1:9993"), makeFragment(packetID), now); reassembleErr != nil || complete {
			t.Fatalf("fragment %d: complete=%t err=%v", packetID, complete, reassembleErr)
		}
	}
	node.fragmentMu.Lock()
	_, firstPresent := node.fragments[1]
	_, newestPresent := node.fragments[maxFragmentAssemblies+1]
	count := len(node.fragments)
	node.fragmentMu.Unlock()
	if count != maxFragmentAssemblies || firstPresent || !newestPresent {
		t.Fatalf("fragment ring: count=%d first=%t newest=%t", count, firstPresent, newestPresent)
	}
}

func TestHelloLatencyUsesResponsePath(t *testing.T) {
	_, remoteIdentity, node, _ := newTestNodeWithPeer(t)
	remote := netip.MustParseAddrPort("198.51.100.40:9993")
	now := time.Now()
	node.mu.Lock()
	peer := node.peers[remoteIdentity.Address()]
	peer.paths[pathKey{localSocket: 1, endpoint: remote}] = &peerPathState{lastReceive: now, priority: 1}
	node.updatePathLatencyLocked(peer, 1, remote, uint64(now.Add(-20*time.Millisecond).UnixMilli()), now)
	latency := peer.paths[pathKey{localSocket: 1, endpoint: remote}].latency
	node.mu.Unlock()
	if latency != 20*time.Millisecond {
		t.Fatalf("latency = %v", latency)
	}
}

func TestHelloLatencyUsesOfficialSmoothing(t *testing.T) {
	_, remoteIdentity, node, _ := newTestNodeWithPeer(t)
