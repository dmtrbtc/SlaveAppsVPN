func TestPhysicalReceiveDoesNotAuthenticatePeerPath(t *testing.T) {
	_, remote, node, _ := newTestNodeWithPeer(t)
	now := time.Now().Truncate(time.Millisecond)
	key := pathKey{localSocket: 5, endpoint: netip.MustParseAddrPort("198.51.100.84:9993")}
	authenticatedAt := now.Add(-time.Minute)
	node.mu.Lock()
	peer := node.peers[remote.Address()]
	peer.lastReceive = authenticatedAt
	node.addPeerPathLocked(peer, key, &peerPathState{lastReceive: authenticatedAt, priority: 1}, authenticatedAt)
	node.mu.Unlock()

	err := node.ProcessWirePacket(key.localSocket, key.endpoint, []byte{1, 2, 3}, now)
	if !errors.Is(err, ErrInvalidPacket) {
		t.Fatalf("invalid physical packet error = %v", err)
	}
	node.mu.Lock()
	path := peer.paths[key]
	peerLastReceive := peer.lastReceive
	pathLastReceive := path.lastReceive
	physicalAge := wirePathAge(path, now)
	node.mu.Unlock()
	if !peerLastReceive.Equal(authenticatedAt) || !pathLastReceive.Equal(authenticatedAt) {
		t.Fatalf("physical packet authenticated state: peer=%v path=%v", peerLastReceive, pathLastReceive)
	}
	if physicalAge != 0 {
		t.Fatalf("physical receive age = %v, want zero", physicalAge)
	}
	paths := peerPaths(node, remote.Address())
	if len(paths) != 1 || !paths[0].LastReceive.Equal(now) || !paths[0].Active {
		t.Fatalf("physical path diagnostics = %+v", paths)
	}
}

