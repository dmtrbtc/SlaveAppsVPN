func TestNetworkConfigRequestAcceptsMultipleOKChunks(t *testing.T) {
	identity, _ := ParseIdentity(knownGoodIdentity)
	controller, _ := GenerateIdentity()
	networkID := controller.Address().Uint64()<<24 | 0x1234
	node, err := NewNode(NodeConfig{Identity: identity, Sender: WireSenderFunc(func(int64, netip.AddrPort, []byte) error { return nil })})
	if err != nil {
		t.Fatal(err)
	}
	const requestID = uint64(0x0102030405060708)
	const updateID = uint64(0x8877665544332211)
	now := time.Now()
	node.mu.Lock()
	_ = node.addPeerLocked(controller, false)
	node.networks[networkID] = newNetwork(networkID)
	node.pending[requestID] = pendingRequest{verb: VerbNetworkConfigRequest, peer: controller.Address(), networkID: networkID, sentAt: now}
	node.mu.Unlock()
	config := appendTestNetworkConfig(t, networkID, identity.Address())
	split := len(config) / 2
	key, err := controller.Agree(identity)
	if err != nil {
		t.Fatal(err)
	}
	makeChunk := func(index int, chunk []byte) []byte {
		packet, err := NewPacket(identity.Address(), controller.Address(), VerbOK)
		if err != nil {
			t.Fatal(err)
		}
		_ = packet.Append(byte(VerbNetworkConfigRequest))
		_ = packet.AppendUint64(requestID)
		signedAt := len(packet.Payload())
		_ = packet.AppendUint64(networkID)
		_ = packet.AppendUint16(uint16(len(chunk)))
		_ = packet.Append(chunk...)
		_ = packet.Append(0)
		_ = packet.AppendUint64(updateID)
		_ = packet.AppendUint32(uint32(len(config)))
		_ = packet.AppendUint32(uint32(index))
		signature, err := controller.Sign(packet.Payload()[signedAt:])
		if err != nil {
			t.Fatal(err)
		}
		_ = packet.Append(1)
		_ = packet.AppendUint16(SignatureSize)
		_ = packet.Append(signature[:]...)
		if err = packet.Armor(key[:], true); err != nil {
			t.Fatal(err)
		}
		return append([]byte(nil), packet.Bytes()...)
	}
	remote := netip.MustParseAddrPort("203.0.113.31:9993")
	if err = node.ProcessWirePacket(0, remote, makeChunk(0, config[:split]), now); err != nil {
		t.Fatal(err)
	}
	node.mu.Lock()
	_, pendingAfterFirst := node.pending[requestID]
	statusAfterFirst := node.networks[networkID].Status
	node.mu.Unlock()
	if !pendingAfterFirst || statusAfterFirst == NetworkStatusOK {
		t.Fatalf("first chunk consumed request: pending=%t status=%d", pendingAfterFirst, statusAfterFirst)
	}
	if err = node.ProcessWirePacket(0, remote, makeChunk(split, config[split:]), now.Add(time.Millisecond)); err != nil {
		t.Fatal(err)
	}
	node.mu.Lock()
	_, pendingAfterSecond := node.pending[requestID]
	applied := node.networks[networkID].Status == NetworkStatusOK && node.networks[networkID].Config.NetworkID == networkID
	node.mu.Unlock()
	if pendingAfterSecond || !applied {
		t.Fatalf("multi-chunk config: pending=%t applied=%t", pendingAfterSecond, applied)
	}
}

func TestJoinRestoresCachedNetworkConfig(t *testing.T) {
	identity, err := ParseIdentity(knownGoodIdentity)
	if err != nil {
		t.Fatal(err)
	}
	controller, err := GenerateIdentity()
	if err != nil {
		t.Fatal(err)
	}
	networkID := controller.Address().Uint64()<<24 | 0x1234
	store := NewMemoryStore()
	config := appendTestNetworkConfig(t, networkID, identity.Address())
	if err := store.Put(networkStateName(networkID), config); err != nil {
		t.Fatal(err)
	}
	var restored NetworkConfigData
	var eventReentered bool
	var configReentered bool
	var node *Node
	node, err = NewNode(NodeConfig{
		Identity: identity,
		Store:    store,
		Sender:   WireSenderFunc(func(int64, netip.AddrPort, []byte) error { return nil }),
		OnNetworkConfig: func(config NetworkConfigData) {
			_, configReentered = node.Network(config.NetworkID)
			restored = config
		},
		OnEvent: func(event Event) {
			if event.Type == EventNetworkConfigPending {
				_, eventReentered = node.Network(event.NetworkID)
			}
		},
	})
	if err != nil {
		t.Fatal(err)
	}
	if err := node.Join(networkID); err != nil {
		t.Fatal(err)
	}
	network, ok := node.Network(networkID)
	if !ok || network.Status != NetworkStatusOK || restored.NetworkID != networkID || !eventReentered || !configReentered {
		t.Fatalf("cached config was not restored outside the node lock: ok=%t event=%t config=%t network=%+v restored=%+v", ok, eventReentered, configReentered, network, restored)
	}
}

func TestNetworkConfigCallbackCannotMutateNodeState(t *testing.T) {
	identity, err := ParseIdentity(knownGoodIdentity)
	if err != nil {
		t.Fatal(err)
	}
	controller, err := GenerateIdentity()
	if err != nil {
		t.Fatal(err)
	}
	networkID := controller.Address().Uint64()<<24 | 0x1234
	store := NewMemoryStore()
	config := appendTestNetworkConfig(t, networkID, identity.Address())
	assigned := appendInetAddress(nil, netip.AddrPortFrom(netip.MustParseAddr("192.0.2.10"), 24))
	config, err = appendDictionaryEntry(config, "I", assigned)
	if err != nil {
		t.Fatal(err)
	}
	config, err = appendDictionaryEntry(config, "R", []byte{ruleActionAccept, 0})
	if err != nil {
		t.Fatal(err)
	}
	original := append([]byte(nil), config...)
	if err = store.Put(networkStateName(networkID), config); err != nil {
		t.Fatal(err)
	}
	node, err := NewNode(NodeConfig{
		Identity: identity,
		Store:    store,
		Sender:   WireSenderFunc(func(int64, netip.AddrPort, []byte) error { return nil }),
		OnNetworkConfig: func(callback NetworkConfigData) {
			callback.Assigned[0] = netip.MustParsePrefix("198.51.100.1/24")
			callback.Rules[0].Type = ruleActionDrop
			callback.RulesRaw[0] ^= 0xff
			callback.Raw[0] ^= 0xff
		},
	})
	if err != nil {
		t.Fatal(err)
	}
	if err = node.Join(networkID); err != nil {
		t.Fatal(err)
	}
	network, ok := node.Network(networkID)
	if !ok || len(network.Config.Assigned) != 1 || network.Config.Assigned[0] != netip.MustParsePrefix("192.0.2.10/24") {
		t.Fatalf("callback mutated assigned addresses: %+v", network.Config.Assigned)
	}
	if len(network.Config.Rules) != 1 || network.Config.Rules[0].Type != ruleActionAccept || !bytes.Equal(network.Config.Raw, original) {
		t.Fatal("callback mutated rules or raw network configuration")
	}
}

func TestPeriodicNetworkConfigRequestCarriesCurrentVersion(t *testing.T) {
	identity, err := ParseIdentity(knownGoodIdentity)
	if err != nil {
		t.Fatal(err)
	}
	controller, err := GenerateIdentity()
	if err != nil {
		t.Fatal(err)
	}
	networkID := controller.Address().Uint64()<<24 | 0x1234
	var sent []sentWirePacket
	node, err := NewNode(NodeConfig{
		Identity: identity,
		Sender: WireSenderFunc(func(_ int64, remote netip.AddrPort, packet []byte) error {
			sent = append(sent, sentWirePacket{remote: remote, data: append([]byte(nil), packet...)})
			return nil
		}),
	})
	if err != nil {
		t.Fatal(err)
	}
	config, err := ParseNetworkConfig(appendTestNetworkConfig(t, networkID, identity.Address()))
	if err != nil {
		t.Fatal(err)
	}
	now := time.Now()
	node.mu.Lock()
	if err := node.addPeerLocked(controller, false); err != nil {
		node.mu.Unlock()
		t.Fatal(err)
	}
	network := newNetwork(networkID)
	network.Status = NetworkStatusOK
	network.Config = config
	network.LastConfigRequest = now.Add(-networkConfigRefreshPeriod)
	// A restored disk configuration has no receive timestamp, but the official
	// request still advertises its known revision and timestamp.
	node.networks[networkID] = network
	node.lastRootContact = now.Add(-rootContactPeriod)
	node.mu.Unlock()
	activateTestRootPath(t, node, now)
	node.ProcessBackgroundTasks(now)

	key, err := controller.Agree(identity)
	if err != nil {
		t.Fatal(err)
	}
	found := false
	for _, wirePacket := range sent {
		request, err := ParsePacket(wirePacket.data)
		if err != nil || request.Destination() != controller.Address() || request.Dearmor(key[:]) != nil || request.Verb() != VerbNetworkConfigRequest {
			continue
		}
		if err := request.Uncompress(); err != nil {
			t.Fatal(err)
		}
		payload := request.Payload()
		if len(payload) < 26 {
			t.Fatalf("short network config request payload: %d", len(payload))
		}
		metadataLength := int(payload[8])<<8 | int(payload[9])
		versionOffset := 10 + metadataLength
		if len(payload)-versionOffset < 16 {
			t.Fatalf("network config request metadata overruns payload: %d", metadataLength)
		}
		if readUint64(payload[versionOffset:]) != testConfigRevision || readUint64(payload[versionOffset+8:]) != testConfigTimestamp {
			t.Fatalf("request version = revision %x timestamp %x", readUint64(payload[versionOffset:]), readUint64(payload[versionOffset+8:]))
		}
		found = true
	}
	if !found {
		t.Fatal("periodic network configuration request was not sent")
	}
	node.mu.Lock()
	requestedAt := node.networks[networkID].LastConfigRequest
	node.mu.Unlock()
	if !requestedAt.Equal(now) {
		t.Fatalf("last config request = %v, want %v", requestedAt, now)
	}
}

func TestNetworkConfigRetriesWhileAwaitingResponse(t *testing.T) {
	identity, err := ParseIdentity(knownGoodIdentity)
	if err != nil {
		t.Fatal(err)
	}
	controller, err := GenerateIdentity()
	if err != nil {
		t.Fatal(err)
	}
	networkID := controller.Address().Uint64()<<24 | 0x1234
	node, err := NewNode(NodeConfig{
		Identity: identity,
		Sender:   WireSenderFunc(func(int64, netip.AddrPort, []byte) error { return nil }),
	})
	if err != nil {
		t.Fatal(err)
	}
	now := time.Now()
	node.mu.Lock()
	if err := node.addPeerLocked(controller, false); err != nil {
		node.mu.Unlock()
		t.Fatal(err)
	}
	network := newNetwork(networkID)
	network.Status = NetworkStatusOK
	network.Config = NetworkConfigData{NetworkID: networkID}
	network.LastConfigRequest = now.Add(-networkConfigRetryPeriod)
	node.networks[networkID] = network
	node.lastRootContact = now.Add(-rootContactPeriod)
	node.mu.Unlock()
	node.ProcessBackgroundTasks(now)
	node.mu.Lock()
	requestedAt := network.LastConfigRequest
	node.mu.Unlock()
	if !requestedAt.Equal(now) {
		t.Fatalf("unanswered config request was not retried: got %v want %v", requestedAt, now)
	}
}

func TestBestPeerPathUsesOfficialQualityPriorityWeight(t *testing.T) {
	_, remoteIdentity, node, _ := newTestNodeWithPeer(t)
	now := time.Unix(1700000000, 0)
	fast := pathKey{localSocket: 1, endpoint: netip.MustParseAddrPort("192.0.2.1:9993")}
	slowPriority := pathKey{localSocket: 2, endpoint: netip.MustParseAddrPort("192.0.2.2:9993")}
	node.mu.Lock()
	peer := node.peers[remoteIdentity.Address()]
	peer.paths[fast] = &peerPathState{lastReceive: now, latency: 10 * time.Millisecond, priority: 1}
	peer.paths[slowPriority] = &peerPathState{lastReceive: now, latency: 100 * time.Millisecond, priority: 2}
	selected := node.bestPeerPathLocked(peer, now)
	node.mu.Unlock()
	if selected != fast {
		t.Fatalf("selected path %v, want lower quality score %v", selected, fast)
	}
}

func TestBestPeerPathUsesExpiredDirectPathOnlyWithoutUpstream(t *testing.T) {
	_, remoteIdentity, node, _ := newTestNodeWithPeer(t)
	now := time.Now()
	expired := pathKey{localSocket: 1, endpoint: netip.MustParseAddrPort("198.51.100.150:9993")}
	node.mu.Lock()
	peer := node.peers[remoteIdentity.Address()]
	peer.paths[expired] = &peerPathState{lastReceive: now.Add(-peerPathExpiration), latency: time.Millisecond, priority: 1}
	var upstream pathKey
	for _, candidate := range node.peers {
		if !candidate.root {
			continue
		}
		upstream = pathKey{localSocket: 2, endpoint: netip.MustParseAddrPort("198.51.100.151:9993")}
		candidate.paths[upstream] = &peerPathState{lastReceive: now, latency: time.Millisecond, priority: 1}
		candidate.lastReceive = now
		break
	}
	if !upstream.endpoint.IsValid() {
		node.mu.Unlock()
		t.Fatal("test node has no planet root")
	}
	withUpstream := node.bestPeerPathLocked(peer, now)
	for _, candidate := range node.peers {
		if candidate.root {
			candidate.paths = make(map[pathKey]*peerPathState)
		}
	}
	withoutUpstream := node.bestPeerPathLocked(peer, now)
	node.mu.Unlock()
	if withUpstream != upstream {
		t.Fatalf("path with upstream = %v, want %v", withUpstream, upstream)
	}
	if withoutUpstream != expired {
		t.Fatalf("path without upstream = %v, want expired fallback %v", withoutUpstream, expired)
	}
}

func TestNetworkWithLocalControllerIsNotFound(t *testing.T) {
	identity, _ := GenerateIdentity()
	var notFound bool
	node, err := NewNode(NodeConfig{
		Identity: identity,
		Sender:   WireSenderFunc(func(int64, netip.AddrPort, []byte) error { return nil }),
		OnEvent: func(event Event) {
			notFound = notFound || event.Type == EventNetworkNotFound
		},
	})
	if err != nil {
		t.Fatal(err)
	}
	networkID := identity.Address().Uint64()<<24 | 1
	if err = node.Join(networkID); err != nil {
		t.Fatal(err)
	}
	network, loaded := node.Network(networkID)
	if !loaded || network.Status != NetworkStatusNotFound || !notFound {
		t.Fatalf("local controller network status=%d loaded=%t event=%t", network.Status, loaded, notFound)
	}
}

func TestOptionalWorldCacheReadFailuresAreIgnored(t *testing.T) {
	identity, _ := GenerateIdentity()
	node, err := NewNode(NodeConfig{
		Identity: identity,
		Store:    failingGetStore{},
		Sender:   WireSenderFunc(func(int64, netip.AddrPort, []byte) error { return nil }),
	})
	if err != nil {
		t.Fatalf("optional planet cache prevented startup: %v", err)
	}
	seed, _ := GenerateIdentity()
	const worldID = uint64(0x0123456789abcdef)
	if err = node.Orbit(worldID, seed.Address()); err != nil {
		t.Fatalf("optional moon cache prevented orbit: %v", err)
	}
	node.mu.Lock()
	wanted := node.moonSeeds[worldID]
	node.mu.Unlock()
	if wanted != seed.Address() {
		t.Fatalf("moon seed = %s, want %s", wanted, seed.Address())
	}
}

func newTestNodeWithPeer(t *testing.T) (Identity, Identity, *Node, *[]sentWirePacket) {
	t.Helper()
	identity, err := ParseIdentity(knownGoodIdentity)
	if err != nil {
		t.Fatal(err)
	}
	remoteIdentity, err := GenerateIdentity()
	if err != nil {
		t.Fatal(err)
	}
	sent := new([]sentWirePacket)
	node, err := NewNode(NodeConfig{
		Identity: identity,
		Sender: WireSenderFunc(func(_ int64, remote netip.AddrPort, packet []byte) error {
			*sent = append(*sent, sentWirePacket{remote: remote, data: append([]byte(nil), packet...)})
			return nil
		}),
	})
	if err != nil {
		t.Fatal(err)
	}
	node.mu.Lock()
	if err := node.addPeerLocked(remoteIdentity, false); err != nil {
		node.mu.Unlock()
		t.Fatal(err)
	}
	node.mu.Unlock()
	return identity, remoteIdentity, node, sent
}

func appendPushedIPv4(packet *Packet, flags byte, endpoint netip.AddrPort) {
	address := endpoint.Addr().As4()
	_ = packet.Append(flags)
	_ = packet.AppendUint16(0)
	_ = packet.Append(4, 6)
	_ = packet.Append(address[:]...)
	_ = packet.AppendUint16(endpoint.Port())
}

func appendTestNetworkConfig(t *testing.T, networkID uint64, member Address) []byte {
	t.Helper()
	var config []byte
	var err error
	for _, entry := range []struct {
		key   string
		value uint64
	}{
		{key: "v", value: networkConfigVersion},
		{key: "nwid", value: networkID},
		{key: "id", value: member.Uint64()},
		{key: "t", value: uint64(NetworkTypePublic)},
		{key: "mtu", value: 2800},
		{key: "r", value: testConfigRevision},
		{key: "ts", value: testConfigTimestamp},
	} {
		config, err = appendDictionaryUint(config, entry.key, entry.value)
		if err != nil {
			t.Fatal(err)
		}
	}
	return config
}

const (
	testConfigRevision  = uint64(0x1122334455667788)
	testConfigTimestamp = uint64(0x8877665544332211)
)

func readUint64(value []byte) uint64 {
	return uint64(value[0])<<56 | uint64(value[1])<<48 | uint64(value[2])<<40 | uint64(value[3])<<32 |
		uint64(value[4])<<24 | uint64(value[5])<<16 | uint64(value[6])<<8 | uint64(value[7])
}

func peerPaths(node *Node, address Address) []PeerPath {
	for _, peer := range node.Peers() {
		if peer.Address == address {
			return peer.Paths
		}
	}
	return nil
}

func activateTestRootPath(t *testing.T, node *Node, now time.Time) netip.AddrPort {
	t.Helper()
	node.mu.Lock()
	defer node.mu.Unlock()
	for _, root := range node.planet.Roots {
		peer := node.peers[root.Identity.Address()]
		if peer == nil || len(root.Endpoints) == 0 {
			continue
		}
		endpoint := root.Endpoints[0]
		peer.lastReceive = now
		node.addPeerPathLocked(peer, pathKey{localSocket: 3, endpoint: endpoint}, &peerPathState{lastReceive: now, latency: time.Millisecond, priority: 1}, now)
		return endpoint
	}
	t.Fatal("planet has no usable root endpoint")
	return netip.AddrPort{}
}
