	}
}

func TestRelayedSendRefreshesPhysicalRootPath(t *testing.T) {
	local, err := GenerateIdentity()
	if err != nil {
		t.Fatal(err)
	}
	rootIdentity, err := GenerateIdentity()
	if err != nil {
		t.Fatal(err)
	}
	leafIdentity, err := GenerateIdentity()
	if err != nil {
		t.Fatal(err)
	}
	node, err := NewNode(NodeConfig{Identity: local, Sender: WireSenderFunc(func(int64, netip.AddrPort, []byte) error { return nil })})
	if err != nil {
		t.Fatal(err)
	}
	now := time.Now()
	rootPath := pathKey{localSocket: 4, endpoint: netip.MustParseAddrPort("198.51.100.89:9993")}
	node.mu.Lock()
	if err = node.addPeerLocked(rootIdentity, true); err == nil {
		err = node.addPeerLocked(leafIdentity, false)
	}
	if err != nil {
		node.mu.Unlock()
		t.Fatal(err)
	}
	root := node.peers[rootIdentity.Address()]
	leaf := node.peers[leafIdentity.Address()]
	node.addPeerPathLocked(root, rootPath, &peerPathState{lastReceive: now, priority: 1}, now)
	packet, err := NewPacket(leafIdentity.Address(), local.Address(), VerbUserMessage)
	if err == nil {
		err = node.sendPacketViaPathLocked(leaf, packet, true, rootPath, false)
	}
	lastSend := wirePathLastSend(root.paths[rootPath])
	node.mu.Unlock()
	if err != nil {
		t.Fatal(err)
	}
	if lastSend.IsZero() {
		t.Fatal("relayed output did not refresh the physical root path")
	}
}

