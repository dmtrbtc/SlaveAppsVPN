func TestLowBandwidthScalesPeerPathHeartbeat(t *testing.T) {
	_, remoteIdentity, node, sent := newTestNodeWithPeer(t)
	now := time.Now()
	endpoint := netip.MustParseAddrPort("198.51.100.52:9993")
	node.mu.Lock()
	node.lowBandwidth = true
	node.lastRootContact = now
	peer := node.peers[remoteIdentity.Address()]
	peer.lastReceive = now
	peer.lastNontrivialReceive = now
	peer.lastFullHello = now
	lastProbe := now.Add(-peerPathPingPeriod)
	peer.paths[pathKey{localSocket: 0, endpoint: endpoint}] = &peerPathState{lastReceive: now, lastSend: lastProbe, lastProbe: lastProbe, priority: 1}
	node.mu.Unlock()
	node.ProcessBackgroundTasks(now)
	node.mu.Lock()
	got := peer.paths[pathKey{localSocket: 0, endpoint: endpoint}].lastProbe
	node.mu.Unlock()
	if !got.Equal(lastProbe) || len(*sent) != 0 {
		t.Fatalf("early low-bandwidth path heartbeat = %v, packets=%d", got, len(*sent))
	}
	want := now.Add(5 * rootContactPeriod)
	node.ProcessBackgroundTasks(want)
	node.mu.Lock()
	got = peer.paths[pathKey{localSocket: 0, endpoint: endpoint}].lastProbe
	node.mu.Unlock()
	peerPackets := 0
	for _, packet := range *sent {
		if packet.remote == endpoint {
			peerPackets++
		}
	}
	if !got.Equal(want) || peerPackets != 1 {
		t.Fatalf("low-bandwidth path heartbeat = %v, peer packets=%d, want %v/1", got, peerPackets, want)
	}
}

func TestLowBandwidthSkipsPeriodicMulticastAnnouncements(t *testing.T) {
	_, remoteIdentity, node, sent := newTestNodeWithPeer(t)
	const networkID = uint64(0x1234567890abcdef)
	now := time.Now()
	node.mu.Lock()
	node.lowBandwidth = true
	node.lastRootContact = now.Add(-5 * rootContactPeriod)
	peer := node.peers[remoteIdentity.Address()]
	peer.lastReceive = now
	network := newNetwork(networkID)
	network.Status = NetworkStatusOK
	network.Config = NetworkConfigData{NetworkID: networkID, Type: NetworkTypePublic}
	network.LastConfigRequest = now
	network.LastConfigReceive = now
	network.associated[remoteIdentity.Address()] = now
	network.multicastSubscriptions[MulticastGroup{MAC: NewMAC(0x01005e000001)}] = struct{}{}
	node.networks[networkID] = network
	node.mu.Unlock()

	node.ProcessBackgroundTasks(now)
	for _, wirePacket := range *sent {
		packet, err := ParsePacket(wirePacket.data)
		if err == nil && packet.Destination() == remoteIdentity.Address() && packet.Verb() == VerbMulticastLike {
			t.Fatal("low-bandwidth background task sent a periodic multicast announcement")
		}
	}
}

func TestInactivePeerDoesNotReceivePathHeartbeat(t *testing.T) {
	_, remoteIdentity, node, sent := newTestNodeWithPeer(t)
	now := time.Now()
	endpoint := netip.MustParseAddrPort("198.51.100.53:9993")
	node.mu.Lock()
	peer := node.peers[remoteIdentity.Address()]
	peer.lastReceive = now
	peer.lastFullHello = now
	lastProbe := now.Add(-peerPathPingPeriod)
	peer.paths[pathKey{localSocket: 0, endpoint: endpoint}] = &peerPathState{lastReceive: now, lastSend: lastProbe, lastProbe: lastProbe, priority: 1}
	node.lastRootContact = now.Add(-rootContactPeriod)
	if !peer.lastNontrivialReceive.IsZero() || node.bondingPolicyForPeerLocked(peer) != BondingNone {
		t.Fatalf("inactive peer setup: last nontrivial=%v bonding=%v", peer.lastNontrivialReceive, node.bondingPolicyForPeerLocked(peer))
	}
	node.mu.Unlock()

	node.ProcessBackgroundTasks(now)
	node.mu.Lock()
	got := peer.paths[pathKey{localSocket: 0, endpoint: endpoint}].lastProbe
	node.mu.Unlock()
	peerPackets := 0
	for _, packet := range *sent {
		if packet.remote == endpoint {
			peerPackets++
		}
	}
	if !got.Equal(lastProbe) || peerPackets != 0 {
		t.Fatalf("inactive peer heartbeat = %v, peer packets=%d", got, peerPackets)
	}
}

