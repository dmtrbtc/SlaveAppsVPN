func TestRootIdentityCollisionErrorIsFatal(t *testing.T) {
	identity, err := ParseIdentity(knownGoodIdentity)
	if err != nil {
		t.Fatal(err)
	}
	var fatal Event
	node, err := NewNode(NodeConfig{
		Identity: identity,
		Sender:   WireSenderFunc(func(int64, netip.AddrPort, []byte) error { return nil }),
		OnEvent: func(event Event) {
			if event.Type == EventNodeIdentityCollision {
				fatal = event
			}
		},
	})
	if err != nil {
		t.Fatal(err)
	}
	node.mu.Lock()
	var root *peer
	for _, candidate := range node.peers {
		if candidate.root {
			root = candidate
			break
		}
	}
	if root == nil {
		node.mu.Unlock()
		t.Fatal("default planet has no root")
	}
	packet, _ := NewPacket(identity.Address(), root.identity.Address(), VerbError)
	_ = packet.Append(byte(VerbHello))
	_ = packet.AppendUint64(0x0102030405060708)
	_ = packet.Append(0x04)
	err = node.handleErrorLocked(root, packet, time.Now())
	node.unlockAndRunCallbacks()
	if !errors.Is(err, ErrIdentityCollision) || fatal.Type != EventNodeIdentityCollision || fatal.NodeAddress != identity.Address() {
		t.Fatalf("collision error=%v event=%+v", err, fatal)
	}
}

func TestUserMessageAndRemoteTraceCallbacks(t *testing.T) {
	local, _ := ParseIdentity(knownGoodIdentity)
	remote, _ := GenerateIdentity()
	var message UserMessage
	var traces []RemoteTrace
	var node *Node
	node, err := NewNode(NodeConfig{
		Identity: local,
		Sender:   WireSenderFunc(func(int64, netip.AddrPort, []byte) error { return nil }),
		OnUserMessage: func(value UserMessage) {
			_ = node.Peers()
			message = value
		},
		OnRemoteTrace: func(value RemoteTrace) {
			_ = node.Peers()
			traces = append(traces, value)
		},
	})
	if err != nil {
		t.Fatal(err)
	}
	node.mu.Lock()
	_ = node.addPeerLocked(remote, false)
	node.mu.Unlock()
	key, _ := remote.Agree(local)
	userPacket, _ := NewPacket(local.Address(), remote.Address(), VerbUserMessage)
	_ = userPacket.AppendUint64(0x123456789abcdef0)
	_ = userPacket.Append([]byte("payload")...)
	_ = userPacket.Armor(key[:], true)
	if err = node.ProcessWirePacket(0, netip.MustParseAddrPort("198.51.100.40:9993"), userPacket.Bytes(), time.Now()); err != nil {
		t.Fatal(err)
	}
	tracePacket, _ := NewPacket(local.Address(), remote.Address(), VerbRemoteTrace)
	_ = tracePacket.Append([]byte("first\x00second\x00unterminated")...)
	_ = tracePacket.Armor(key[:], true)
	if err = node.ProcessWirePacket(0, netip.MustParseAddrPort("198.51.100.40:9993"), tracePacket.Bytes(), time.Now()); err != nil {
		t.Fatal(err)
	}
	if message.Origin != remote.Address() || message.TypeID != 0x123456789abcdef0 || string(message.Data) != "payload" || len(traces) != 2 || traces[0].Data != "first" || traces[1].Data != "second" {
		t.Fatalf("message=%+v traces=%+v", message, traces)
	}
}

func TestUnknownUserMessageRetriesWhoisAndFlushesWhenPeerIsLearned(t *testing.T) {
	local, err := ParseIdentity(knownGoodIdentity)
	if err != nil {
		t.Fatal(err)
	}
	remote, err := GenerateIdentity()
	if err != nil {
		t.Fatal(err)
	}
	var sent []sentWirePacket
	node, err := NewNode(NodeConfig{
		Identity: local,
		Sender: WireSenderFunc(func(_ int64, endpoint netip.AddrPort, packet []byte) error {
			sent = append(sent, sentWirePacket{remote: endpoint, data: append([]byte(nil), packet...)})
			return nil
		}),
	})
	if err != nil {
		t.Fatal(err)
	}
	rootEndpoint := activateTestRootPath(t, node, time.Now())
	if err = node.SendUserMessage(remote.Address(), 0x123456789abcdef0, []byte("queued")); err != nil {
		t.Fatal(err)
	}
	node.mu.Lock()
	firstWhois := node.pendingWhois[remote.Address()]
	queued := len(node.pendingUserMessages[remote.Address()])
	node.mu.Unlock()
	if firstWhois.IsZero() || queued != 1 {
		t.Fatalf("unknown message was not queued with WHOIS: requested=%v queued=%d", firstWhois, queued)
	}
	node.ProcessBackgroundTasks(firstWhois.Add(whoisRetryPeriod + time.Millisecond))
	node.mu.Lock()
	secondWhois := node.pendingWhois[remote.Address()]
	node.mu.Unlock()
	if !secondWhois.After(firstWhois) {
		t.Fatalf("WHOIS was not retried: first=%v second=%v", firstWhois, secondWhois)
	}

	node.mu.Lock()
	if err = node.addPeerLocked(remote, false); err != nil {
		node.mu.Unlock()
		t.Fatal(err)
	}
	node.mu.Unlock()
	if len(sent) < 2 {
		t.Fatalf("queued message was not sent after learning peer: packets=%d", len(sent))
	}
	wirePacket := sent[len(sent)-1]
	if wirePacket.remote != rootEndpoint {
		t.Fatalf("queued message relay endpoint = %s, want %s", wirePacket.remote, rootEndpoint)
	}
	packet, err := ParsePacket(wirePacket.data)
	if err != nil {
		t.Fatal(err)
	}
	key, err := remote.Agree(local)
	if err != nil {
		t.Fatal(err)
	}
	if err = packet.Dearmor(key[:]); err != nil {
		t.Fatal(err)
	}
	if err = packet.Uncompress(); err != nil {
		t.Fatal(err)
	}
	payload := packet.Payload()
	if packet.Verb() != VerbUserMessage || len(payload) != 14 || binary.BigEndian.Uint64(payload) != 0x123456789abcdef0 || string(payload[8:]) != "queued" {
		t.Fatalf("flushed user message: verb=%d payload=%x", packet.Verb(), payload)
	}
	node.mu.Lock()
	queued = len(node.pendingUserMessages[remote.Address()])
	_, pendingWhois := node.pendingWhois[remote.Address()]
	node.mu.Unlock()
	if queued != 0 || pendingWhois {
		t.Fatalf("learned peer retained pending state: queued=%d whois=%t", queued, pendingWhois)
	}
}

func TestKnownPeerPacketWaitsForUsablePath(t *testing.T) {
	local, err := ParseIdentity(knownGoodIdentity)
	if err != nil {
		t.Fatal(err)
	}
	remote, err := GenerateIdentity()
	if err != nil {
		t.Fatal(err)
	}
	var sent []sentWirePacket
	node, err := NewNode(NodeConfig{
		Identity: local,
		Sender: WireSenderFunc(func(_ int64, endpoint netip.AddrPort, packet []byte) error {
			sent = append(sent, sentWirePacket{remote: endpoint, data: append([]byte(nil), packet...)})
			return nil
		}),
	})
	if err != nil {
		t.Fatal(err)
	}
	node.mu.Lock()
	if err = node.addPeerLocked(remote, false); err != nil {
		node.mu.Unlock()
		t.Fatal(err)
	}
	node.planet.Roots = nil
	node.mu.Unlock()
	if err = node.SendUserMessage(remote.Address(), 1, []byte("queued for path")); err != nil {
		t.Fatal(err)
	}
	node.mu.Lock()
	queued := len(node.pendingTransmits)
	node.mu.Unlock()
	if queued != 1 || len(sent) != 0 {
		t.Fatalf("initial send: queued=%d sent=%d", queued, len(sent))
	}

	now := time.Now()
	endpoint := netip.MustParseAddrPort("198.51.100.70:9993")
	node.mu.Lock()
	peer := node.peers[remote.Address()]
	peer.paths[pathKey{localSocket: 4, endpoint: endpoint}] = &peerPathState{lastReceive: now, priority: 1}
	peer.lastReceive = now
	node.lastRootContact = now
	node.mu.Unlock()
	node.ProcessBackgroundTasks(now)
	node.mu.Lock()
	queued = len(node.pendingTransmits)
	node.mu.Unlock()
	if queued != 0 || len(sent) == 0 || sent[0].remote != endpoint {
		t.Fatalf("retried send: queued=%d sent=%d packets=%v", queued, len(sent), sent)
	}
}

func TestPendingTransmitQueueOverwritesAndExpires(t *testing.T) {
	local, err := ParseIdentity(knownGoodIdentity)
	if err != nil {
		t.Fatal(err)
	}
	remote, err := GenerateIdentity()
	if err != nil {
		t.Fatal(err)
	}
	node, err := NewNode(NodeConfig{Identity: local, Sender: WireSenderFunc(func(int64, netip.AddrPort, []byte) error { return nil })})
	if err != nil {
		t.Fatal(err)
	}
	node.mu.Lock()
	if err = node.addPeerLocked(remote, false); err != nil {
		node.mu.Unlock()
		t.Fatal(err)
	}
	node.planet.Roots = nil
	var firstPacketID, lastPacketID uint64
	for i := 0; i < maxPendingTransmits+1; i++ {
		packet, packetErr := NewPacket(remote.Address(), local.Address(), VerbUserMessage)
		if packetErr != nil {
			node.mu.Unlock()
			t.Fatal(packetErr)
		}
		_ = packet.Append(byte(i))
		if i == 0 {
			firstPacketID = packet.PacketID()
		}
		lastPacketID = packet.PacketID()
		if sendErr := node.sendPacketLocked(node.peers[remote.Address()], packet, true); sendErr != nil {
			node.mu.Unlock()
			t.Fatal(sendErr)
		}
	}
	queued := len(node.pendingTransmits)
	oldestID := node.pendingTransmits[0].packet.PacketID()
	newestID := node.pendingTransmits[len(node.pendingTransmits)-1].packet.PacketID()
	createdAt := node.pendingTransmits[0].createdAt
	node.lastRootContact = createdAt.Add(pendingTransmitExpiration + time.Second)
	node.mu.Unlock()
	if queued != maxPendingTransmits || oldestID == firstPacketID || newestID != lastPacketID {
		t.Fatalf("pending transmit ring: queued=%d oldest=%x first=%x newest=%x last=%x", queued, oldestID, firstPacketID, newestID, lastPacketID)
	}
	node.ProcessBackgroundTasks(createdAt.Add(pendingTransmitExpiration + time.Second))
	node.mu.Lock()
	queued = len(node.pendingTransmits)
	node.mu.Unlock()
	if queued != 0 {
		t.Fatalf("expired pending transmits = %d", queued)
	}
}

func TestPeerDiscoveryRetriesOnlyMatchingPendingTransmits(t *testing.T) {
	local, err := ParseIdentity(knownGoodIdentity)
	if err != nil {
		t.Fatal(err)
	}
	first, err := GenerateIdentity()
	if err != nil {
		t.Fatal(err)
	}
	second, err := GenerateIdentity()
	if err != nil {
		t.Fatal(err)
	}
	var sent []sentWirePacket
	node, err := NewNode(NodeConfig{
		Identity: local,
		Sender: WireSenderFunc(func(_ int64, endpoint netip.AddrPort, packet []byte) error {
			sent = append(sent, sentWirePacket{remote: endpoint, data: append([]byte(nil), packet...)})
			return nil
		}),
	})
	if err != nil {
		t.Fatal(err)
	}
	now := time.Now()
	firstEndpoint := netip.MustParseAddrPort("198.51.100.101:9993")
	secondEndpoint := netip.MustParseAddrPort("198.51.100.102:9993")
	node.mu.Lock()
	if err = node.addPeerLocked(first, false); err != nil {
		node.mu.Unlock()
		t.Fatal(err)
	}
	if err = node.addPeerLocked(second, false); err != nil {
		node.mu.Unlock()
		t.Fatal(err)
	}
	node.addPeerPathLocked(node.peers[first.Address()], pathKey{endpoint: firstEndpoint}, &peerPathState{lastReceive: now, priority: 1}, now)
	node.addPeerPathLocked(node.peers[second.Address()], pathKey{endpoint: secondEndpoint}, &peerPathState{lastReceive: now, priority: 1}, now)
	for _, destination := range []Address{first.Address(), second.Address()} {
		packet, packetErr := NewPacket(destination, local.Address(), VerbUserMessage)
		if packetErr != nil {
			node.mu.Unlock()
			t.Fatal(packetErr)
		}
		node.enqueuePendingTransmitLocked(packet, true, noFlowID, now)
	}
	node.flushPeerQueuesLocked(first.Address(), now)
	queued := append([]pendingTransmit(nil), node.pendingTransmits...)
	node.mu.Unlock()
	if len(sent) != 1 || sent[0].remote != firstEndpoint {
		t.Fatalf("peer wakeup sent packets = %+v, want only %s", sent, firstEndpoint)
	}
	if len(queued) != 1 || queued[0].packet.Destination() != second.Address() {
		t.Fatalf("pending transmits after peer wakeup = %+v, want only %s", queued, second.Address())
	}
}

func TestPendingTransmitSendFailureClearsRequestTracking(t *testing.T) {
	local, err := GenerateIdentity()
	if err != nil {
		t.Fatal(err)
	}
	remote, err := GenerateIdentity()
	if err != nil {
		t.Fatal(err)
	}
	wantErr := errors.New("send failed")
	node, err := NewNode(NodeConfig{
		Identity: local,
		Sender: WireSenderFunc(func(int64, netip.AddrPort, []byte) error {
			return wantErr
		}),
	})
	if err != nil {
		t.Fatal(err)
	}
	now := time.Now()
	node.mu.Lock()
	if err = node.addPeerLocked(remote, false); err != nil {
		node.mu.Unlock()
		t.Fatal(err)
	}
	packet, packetErr := NewPacket(remote.Address(), local.Address(), VerbExtFrame)
	if packetErr != nil {
		node.mu.Unlock()
		t.Fatal(packetErr)
	}
	request := pendingRequest{verb: VerbExtFrame, peer: remote.Address(), sentAt: now}
	node.pending[packet.PacketID()] = request
	node.enqueuePendingTransmitLocked(packet, true, noFlowID, now)
	endpoint := netip.MustParseAddrPort("198.51.100.103:9993")
	node.addPeerPathLocked(node.peers[remote.Address()], pathKey{endpoint: endpoint}, &peerPathState{lastReceive: now, priority: 1}, now)
	node.retryPendingTransmitsLocked(remote.Address(), now)
	queued, pending := len(node.pendingTransmits), len(node.pending)
	node.mu.Unlock()
	if queued != 0 || pending != 0 {
		t.Fatalf("failed deferred send retained queued=%d pending=%d", queued, pending)
	}
}

func TestWhoisRequestForUnknownIdentityIsForwardedUpstream(t *testing.T) {
