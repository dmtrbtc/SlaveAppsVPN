func TestPeerIdentityRunsCallbacksFromCacheLoad(t *testing.T) {
	local, _ := ParseIdentity(knownGoodIdentity)
	remote, _ := GenerateIdentity()
	store := NewMemoryStore()
	first, err := NewNode(NodeConfig{
		Identity: local,
		Store:    store,
		Sender:   WireSenderFunc(func(int64, netip.AddrPort, []byte) error { return nil }),
	})
	if err != nil {
		t.Fatal(err)
	}
	first.mu.Lock()
	if err = first.addPeerLocked(remote, false); err != nil {
		first.mu.Unlock()
		t.Fatal(err)
	}
	first.savePeerLocked(first.peers[remote.Address()])
	first.mu.Unlock()
	var events []Event
	second, err := NewNode(NodeConfig{
		Identity: local,
		Store:    store,
		Sender:   WireSenderFunc(func(int64, netip.AddrPort, []byte) error { return nil }),
		OnEvent:  func(event Event) { events = append(events, event) },
	})
	if err != nil {
		t.Fatal(err)
	}
	events = nil
	identity, ok := second.PeerIdentity(remote.Address())
	if !ok || identity.PublicString() != remote.PublicString() {
		t.Fatalf("cached identity=%s ok=%t", identity.PublicString(), ok)
	}
	if len(events) != 1 || events[0].Type != EventPeerIdentityLearned || events[0].PeerAddress != remote.Address() || events[0].PeerRole != PeerRoleLeaf {
		t.Fatalf("cache-load events = %+v", events)
	}
}

