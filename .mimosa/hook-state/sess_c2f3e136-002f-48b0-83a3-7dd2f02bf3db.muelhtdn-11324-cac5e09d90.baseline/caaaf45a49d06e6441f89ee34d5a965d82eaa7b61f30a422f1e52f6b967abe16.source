func TestPendingUnknownPacketsAreBoundedAndExpired(t *testing.T) {
	identity, err := ParseIdentity(knownGoodIdentity)
	if err != nil {
		t.Fatal(err)
	}
	node, err := NewNode(NodeConfig{Identity: identity, Sender: WireSenderFunc(func(int64, netip.AddrPort, []byte) error { return nil })})
	if err != nil {
		t.Fatal(err)
	}
	now := time.Now()
	for i := 1; i <= maxPendingIncomingPackets+8; i++ {
		packet, packetErr := NewPacket(identity.Address(), NewAddress(uint64(i)), VerbFrame)
		if packetErr != nil {
			t.Fatal(packetErr)
		}
		_ = node.ProcessWirePacket(0, netip.MustParseAddrPort("198.51.100.2:9993"), packet.Bytes(), now)
	}
	node.mu.Lock()
	count := node.pendingIncomingCountLocked()
	node.mu.Unlock()
	if count != maxPendingIncomingPackets {
		t.Fatalf("pending unknown packet count = %d", count)
	}
	node.ProcessBackgroundTasks(now.Add(pendingIncomingExpiration + time.Second))
	node.mu.Lock()
	count = node.pendingIncomingCountLocked()
	node.mu.Unlock()
	if count != 0 {
		t.Fatalf("expired unknown packets retained: %d", count)
	}
}

