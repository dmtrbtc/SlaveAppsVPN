	if network, _ := node.Network(networkID); network.Status != NetworkStatusOK {
		t.Fatalf("untrusted peer changed network status to %d", network.Status)
	}
}

func TestRefreshFailedNetworkMakesRepeatedFailureObservable(t *testing.T) {
	local, _ := ParseIdentity(knownGoodIdentity)
	controller, err := GenerateIdentity()
	if err != nil {
		t.Fatal(err)
	}
	networkID := controller.Address().Uint64()<<24 | 0x1234
	var events []EventType
	node, err := NewNode(NodeConfig{
		Identity: local,
		Sender:   WireSenderFunc(func(int64, netip.AddrPort, []byte) error { return nil }),
		OnEvent: func(event Event) {
			if event.NetworkID == networkID {
				events = append(events, event.Type)
			}
		},
	})
	if err != nil {
		t.Fatal(err)
	}
	defer node.Close()
	node.mu.Lock()
	if err = node.addPeerLocked(controller, false); err != nil {
		node.mu.Unlock()
		t.Fatal(err)
	}
	network := newNetwork(networkID)
	network.Status = NetworkStatusAccessDenied
	network.Authentication = NetworkAuthenticationInfo{AuthenticationURL: "stale"}
	node.networks[networkID] = network
	node.unlockAndRunCallbacks()

	refresh := func(authenticationURL string) {
		t.Helper()
		if refreshErr := node.RefreshNetwork(networkID); refreshErr != nil {
			t.Fatalf("RefreshNetwork() error = %v", refreshErr)
		}
		snapshot, ok := node.Network(networkID)
		if !ok || snapshot.Status != NetworkStatusAccessDenied || snapshot.Authentication.AuthenticationURL != authenticationURL {
			t.Fatalf("network after refresh = %+v, ok=%t", snapshot, ok)
		}
	}
	reject := func() {
		t.Helper()
		packet, packetErr := NewPacket(local.Address(), controller.Address(), VerbError)
		if packetErr != nil {
			t.Fatal(packetErr)
		}
		_ = packet.Append(byte(VerbNetworkConfigRequest))
		_ = packet.AppendUint64(1)
		_ = packet.Append(0x07)
		_ = packet.AppendUint64(networkID)
		node.mu.Lock()
		packetErr = node.handleErrorLocked(node.peers[controller.Address()], packet, time.Now())
		node.unlockAndRunCallbacks()
		if packetErr != nil {
			t.Fatal(packetErr)
		}
	}

	refresh("stale")
	reject()
	reject()
	if len(events) != 2 || events[0] != EventNetworkConfigPending || events[1] != EventNetworkAccessDenied {
		t.Fatalf("events after repeated response = %v", events)
	}
	refresh("")
	reject()
	if len(events) != 4 || events[2] != EventNetworkConfigPending || events[3] != EventNetworkAccessDenied {
		t.Fatalf("events after explicit retry = %v", events)
	}

	node.mu.Lock()
	peer := node.peers[controller.Address()]
	peer.paths[pathKey{localSocket: 0, endpoint: netip.MustParseAddrPort("198.51.100.30:9993")}] = &peerPathState{lastReceive: time.Now(), priority: 1}
	node.sender = WireSenderFunc(func(int64, netip.AddrPort, []byte) error { return errors.New("send failed") })
	node.mu.Unlock()
	if err = node.RefreshNetwork(networkID); err == nil {
		t.Fatal("RefreshNetwork() succeeded after a wire send failure")
	}
	snapshot, ok := node.Network(networkID)
	if !ok || snapshot.Status != NetworkStatusAccessDenied {
		t.Fatalf("network after failed send = %+v, ok=%t", snapshot, ok)
	}
	reject()
	if len(events) != 5 || events[4] != EventNetworkConfigPending {
		t.Fatalf("events after failed send = %v", events)
	}
}

func TestAuthenticationErrorExposesSSOInfo(t *testing.T) {
	local, _ := ParseIdentity(knownGoodIdentity)
	controller, _ := GenerateIdentity()
	networkID := controller.Address().Uint64()<<24 | 0x1234
	var event Event
	events := 0
	node, err := NewNode(NodeConfig{
		Identity: local,
		Sender:   WireSenderFunc(func(int64, netip.AddrPort, []byte) error { return nil }),
		OnEvent: func(candidate Event) {
			if candidate.Type == EventNetworkAuthenticationRequired {
				event = candidate
				events++
			}
		},
	})
	if err != nil {
		t.Fatal(err)
	}
	auth, _ := appendDictionaryUint(nil, "aV", 1)
	auth, _ = appendDictionaryEntry(auth, "iU", []byte("https://issuer.example"))
	auth, _ = appendDictionaryEntry(auth, "aCID", []byte("client"))
	node.mu.Lock()
	_ = node.addPeerLocked(controller, false)
	node.networks[networkID] = newNetwork(networkID)
	packet, _ := NewPacket(local.Address(), controller.Address(), VerbError)
	_ = packet.Append(byte(VerbNOP))
	_ = packet.AppendUint64(1)
	_ = packet.Append(0x09)
	_ = packet.AppendUint64(networkID)
	_ = packet.AppendUint16(uint16(len(auth)))
	_ = packet.Append(auth...)
	err = node.handleErrorLocked(node.peers[controller.Address()], packet, time.Now())
	node.unlockAndRunCallbacks()
	if err != nil || events != 1 || event.Authentication.Version != 1 || event.Authentication.IssuerURL != "https://issuer.example" || event.Authentication.ClientID != "client" || event.Authentication.Provider != "default" {
		t.Fatalf("authentication event=%+v err=%v", event, err)
	}
	node.mu.Lock()
	err = node.handleErrorLocked(node.peers[controller.Address()], packet, time.Now())
	node.unlockAndRunCallbacks()
	if err != nil || events != 1 {
		t.Fatalf("duplicate authentication error emitted %d events: %v", events, err)
	}
}

func TestMalformedAuthenticationErrorDoesNotChangeNetworkState(t *testing.T) {
	local, _ := ParseIdentity(knownGoodIdentity)
	controller, _ := GenerateIdentity()
	networkID := controller.Address().Uint64()<<24 | 0x1234
	events := 0
	node, err := NewNode(NodeConfig{
		Identity: local,
		Sender:   WireSenderFunc(func(int64, netip.AddrPort, []byte) error { return nil }),
		OnEvent: func(event Event) {
			if event.Type == EventNetworkAuthenticationRequired {
				events++
			}
		},
	})
	if err != nil {
		t.Fatal(err)
	}
	missingURL, _ := appendDictionaryUint(nil, "aV", 0)
	unknownVersion, _ := appendDictionaryUint(nil, "aV", 2)
	tests := []struct {
		name string
		auth []byte
	}{
		{name: "truncated", auth: []byte{0, 2, 'x'}},
		{name: "v0-missing-url", auth: binary.BigEndian.AppendUint16(nil, uint16(len(missingURL)))},
		{name: "unknown-version", auth: binary.BigEndian.AppendUint16(nil, uint16(len(unknownVersion)))},
	}
	tests[1].auth = append(tests[1].auth, missingURL...)
	tests[2].auth = append(tests[2].auth, unknownVersion...)

	node.mu.Lock()
	_ = node.addPeerLocked(controller, false)
	peer := node.peers[controller.Address()]
	for _, test := range tests {
		network := newNetwork(networkID)
		node.networks[networkID] = network
		packet, _ := NewPacket(local.Address(), controller.Address(), VerbError)
		_ = packet.Append(byte(VerbNOP))
		_ = packet.AppendUint64(1)
		_ = packet.Append(0x09)
		_ = packet.AppendUint64(networkID)
		_ = packet.Append(test.auth...)
		if err = node.handleErrorLocked(peer, packet, time.Now()); err != nil {
			node.mu.Unlock()
			t.Fatalf("%s: %v", test.name, err)
		}
		if network.Status != NetworkStatusRequestingConfiguration {
			node.mu.Unlock()
			t.Fatalf("%s changed network status to %d", test.name, network.Status)
		}
	}
	node.unlockAndRunCallbacks()
	if events != 0 {
		t.Fatalf("malformed authentication errors emitted %d events", events)
	}
}

func TestTruncatedErrorDoesNotRefreshPeerOrConsumePendingRequest(t *testing.T) {
	local, remote, node, _ := newTestNodeWithPeer(t)
	const packetID = uint64(0x0102030405060708)
	node.mu.Lock()
	node.pending[packetID] = pendingRequest{verb: VerbFrame, peer: remote.Address(), sentAt: time.Now()}
	node.mu.Unlock()
	packet, err := NewPacket(local.Address(), remote.Address(), VerbError)
	if err != nil {
		t.Fatal(err)
	}
	_ = packet.Append(byte(VerbFrame))
	_ = packet.AppendUint64(packetID)
	_ = packet.Append(0x06) // NEED_MEMBERSHIP_CERTIFICATE requires a network ID.
	key, err := local.Agree(remote)
	if err != nil {
		t.Fatal(err)
	}
	if err = packet.Armor(key[:], true); err != nil {
		t.Fatal(err)
	}
	if err = node.ProcessWirePacket(0, netip.MustParseAddrPort("198.51.100.60:9993"), packet.Bytes(), time.Now()); !errors.Is(err, ErrInvalidPacket) {
		t.Fatalf("truncated ERROR result = %v", err)
	}
	node.mu.Lock()
	lastReceive := node.peers[remote.Address()].lastReceive
	_, pending := node.pending[packetID]
	node.mu.Unlock()
	if !lastReceive.IsZero() || !pending {
		t.Fatalf("truncated ERROR changed state: last=%v pending=%t", lastReceive, pending)
	}
}

func TestAuthenticatedUnwantedUnicastErrorStillRefreshesPeer(t *testing.T) {
	local, remote, node, _ := newTestNodeWithPeer(t)
	const networkID = uint64(0x1234567890abcdef)
	node.mu.Lock()
	network := newNetwork(networkID)
	network.Status = NetworkStatusOK
	network.Config = NetworkConfigData{NetworkID: networkID, Type: NetworkTypePublic}
	node.networks[networkID] = network
	node.mu.Unlock()
	packet, err := NewPacket(local.Address(), remote.Address(), VerbError)
	if err != nil {
		t.Fatal(err)
	}
	_ = packet.Append(byte(VerbMulticastFrame))
	_ = packet.AppendUint64(1)
	_ = packet.Append(0x08)
	_ = packet.AppendUint64(networkID)
	unicast := NewMAC(0x020000000001).Bytes()
	_ = packet.Append(unicast[:]...)
	_ = packet.AppendUint32(0)
	key, err := local.Agree(remote)
	if err != nil {
		t.Fatal(err)
	}
	if err = packet.Armor(key[:], true); err != nil {
		t.Fatal(err)
	}
	now := time.Now()
	if err = node.ProcessWirePacket(0, netip.MustParseAddrPort("198.51.100.62:9993"), packet.Bytes(), now); err != nil {
		t.Fatal(err)
	}
	node.mu.Lock()
	lastReceive := node.peers[remote.Address()].lastReceive
	node.mu.Unlock()
	if !lastReceive.Equal(now) {
		t.Fatalf("authenticated unwanted-unicast last receive = %v, want %v", lastReceive, now)
	}
}

