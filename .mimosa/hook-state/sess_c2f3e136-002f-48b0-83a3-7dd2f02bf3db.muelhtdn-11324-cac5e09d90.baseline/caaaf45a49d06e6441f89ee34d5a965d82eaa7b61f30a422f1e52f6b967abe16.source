func TestNodeCloseRejectsProtocolWork(t *testing.T) {
	identity, err := ParseIdentity(knownGoodIdentity)
	if err != nil {
		t.Fatal(err)
	}
	node, err := NewNode(NodeConfig{
		Identity: identity,
		Sender:   WireSenderFunc(func(int64, netip.AddrPort, []byte) error { return nil }),
	})
	if err != nil {
		t.Fatal(err)
	}
	if err = node.Close(); err != nil {
		t.Fatal(err)
	}
	if err = node.Close(); err != nil {
		t.Fatalf("second Close() error = %v", err)
	}
	const networkID = uint64(0x1234567890abcdef)
	if err = node.Join(networkID); !errors.Is(err, ErrNodeClosed) {
		t.Fatalf("Join() after Close() error = %v", err)
	}
	if err = node.SendFrame(networkID, NewMAC(0xffffffffffff), EtherTypeIPv4, []byte{1}); !errors.Is(err, ErrNodeClosed) {
		t.Fatalf("SendFrame() after Close() error = %v", err)
	}
	if err = node.ProcessWirePacket(AnyLocalSocket, netip.MustParseAddrPort("192.0.2.1:9993"), nil, time.Now()); !errors.Is(err, ErrNodeClosed) {
		t.Fatalf("ProcessWirePacket() after Close() error = %v", err)
	}
	backgroundDone := make(chan struct{})
	go func() {
		node.RunBackgroundTasks(context.Background())
		close(backgroundDone)
	}()
	select {
	case <-backgroundDone:
	case <-time.After(time.Second):
		t.Fatal("RunBackgroundTasks did not stop after Close")
	}
}

func TestNetworkConfigRequestReturnsUnsupported(t *testing.T) {
	local, remote, node, sent := newTestNodeWithPeer(t)
	const networkID = uint64(0x1234567890abcdef)
	packet, err := NewPacket(local.Address(), remote.Address(), VerbNetworkConfigRequest)
	if err != nil {
		t.Fatal(err)
	}
	_ = packet.AppendUint64(networkID)
	key, err := local.Agree(remote)
	if err != nil {
		t.Fatal(err)
	}
	if err = packet.Armor(key[:], true); err != nil {
		t.Fatal(err)
	}
	endpoint := netip.MustParseAddrPort("192.0.2.10:9993")
	if err = node.ProcessWirePacket(3, endpoint, packet.Bytes(), time.Now()); err != nil {
		t.Fatal(err)
	}
	for _, wire := range *sent {
		response, parseErr := ParsePacket(wire.data)
		if parseErr != nil || response.Dearmor(key[:]) != nil || response.Verb() != VerbError {
			continue
		}
		payload := response.Payload()
		if len(payload) == 18 && payload[0] == byte(VerbNetworkConfigRequest) && binary.BigEndian.Uint64(payload[1:9]) == packet.PacketID() && payload[9] == 0x05 && binary.BigEndian.Uint64(payload[10:]) == networkID {
			return
		}
	}
	t.Fatal("unsupported NETWORK_CONFIG_REQUEST response was not sent")
}

func TestRunBackgroundTasksStopsWithContext(t *testing.T) {
	sent := make(chan struct{}, 1)
	node, err := NewNode(NodeConfig{
		Sender: WireSenderFunc(func(int64, netip.AddrPort, []byte) error {
			select {
			case sent <- struct{}{}:
			default:
			}
			return nil
		}),
	})
	if err != nil {
		t.Fatal(err)
	}
	ctx, cancel := context.WithCancel(context.Background())
	done := make(chan struct{})
	go func() {
		node.RunBackgroundTasks(ctx)
		close(done)
	}()
	select {
	case <-sent:
	case <-time.After(time.Second):
		t.Fatal("background runner did not process initial root contact")
	}
	cancel()
	select {
	case <-done:
	case <-time.After(time.Second):
		t.Fatal("background runner did not stop after cancellation")
	}
}

func TestNodeSendsAuthenticatedRootHello(t *testing.T) {
	identity, err := ParseIdentity(knownGoodIdentity)
	if err != nil {
		t.Fatal(err)
	}
	var sent []sentWirePacket
	node, err := NewNode(NodeConfig{
		Identity: identity,
		Sender: WireSenderFunc(func(_ int64, remote netip.AddrPort, packet []byte) error {
			sent = append(sent, sentWirePacket{remote: remote, data: append([]byte(nil), packet...)})
			return nil
		}),
	})
	if err != nil {
		t.Fatal(err)
	}
	now := time.Unix(1700000000, 0)
	node.ProcessBackgroundTasks(now)
	if len(sent) == 0 {
		t.Fatal("node did not contact a root")
	}
	planet, _ := DefaultPlanet()
	rootByAddress := make(map[Address]Identity)
	for _, root := range planet.Roots {
		rootByAddress[root.Identity.Address()] = root.Identity
	}
	packet, err := ParsePacket(sent[0].data)
	if err != nil {
		t.Fatal(err)
	}
	if packet.Verb() != VerbHello || packet.Source() != identity.Address() {
		t.Fatalf("unexpected HELLO header: verb=%d source=%s", packet.Verb(), packet.Source())
	}
	root, ok := rootByAddress[packet.Destination()]
	if !ok {
		t.Fatalf("destination %s is not a root", packet.Destination())
	}
	key, err := identity.Agree(root)
	if err != nil {
		t.Fatal(err)
	}
	if err := packet.Dearmor(key[:]); err != nil {
		t.Fatalf("root HELLO authentication failed: %v", err)
	}
	if packet.Payload()[0] != ProtocolVersion {
		t.Fatalf("protocol version = %d", packet.Payload()[0])
	}
}

func TestEncryptedHelloAppliesBeforePeerProtocolIsKnown(t *testing.T) {
	identity, _ := ParseIdentity(knownGoodIdentity)
	root, _ := GenerateIdentity()
	var sent []byte
	node, err := NewNode(NodeConfig{
		Identity:       identity,
		EncryptedHello: true,
		Sender: WireSenderFunc(func(_ int64, _ netip.AddrPort, packet []byte) error {
			sent = append([]byte(nil), packet...)
			return nil
		}),
	})
	if err != nil {
		t.Fatal(err)
	}
	node.mu.Lock()
	if err = node.addPeerLocked(root, true); err != nil {
		node.mu.Unlock()
		t.Fatal(err)
	}
	err = node.sendHelloLocked(root.Address(), netip.MustParseAddrPort("192.0.2.1:9993"), time.Now())
	node.mu.Unlock()
	if err != nil {
		t.Fatal(err)
	}
	packet, err := ParsePacket(sent)
	if err != nil {
		t.Fatal(err)
	}
	if !packet.ExtendedArmor() {
		t.Fatal("initial HELLO did not use extended armor")
	}
}

