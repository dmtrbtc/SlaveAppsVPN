func TestQoSMeasurementUpdatesPathQuality(t *testing.T) {
	now := time.Now()
	key := pathKey{endpoint: netip.MustParseAddrPort("192.0.2.1:9993")}
	path := &peerPathState{qosOutgoing: make(map[uint64]time.Time)}
	peer := &peer{paths: map[pathKey]*peerPathState{key: path}, bondFlows: make(map[int32]bondFlow)}
	node := &Node{bondingPolicy: BondingBalanceAware}
	packet, err := NewPacket(NewAddress(1), NewAddress(2), VerbQoSMeasurement)
	if err != nil {
		t.Fatal(err)
	}
	for i, roundTrip := range []time.Duration{40, 60, 80, 100} {
		packetID := uint64(123 + i)
		path.qosOutgoing[packetID] = now.Add(-roundTrip * time.Millisecond)
		var record [10]byte
		qosByteOrder.PutUint64(record[:8], packetID)
		qosByteOrder.PutUint16(record[8:], 20)
		_ = packet.Append(record[:]...)
	}
	if err = node.handleQoSMeasurementLocked(peer, key, packet, now); err != nil {
		t.Fatal(err)
	}
	if path.bondLatency != 25*time.Millisecond || absDuration(path.jitter-12909944*time.Nanosecond) > time.Microsecond || !path.lastQoSReceive.Equal(now) {
		t.Fatalf("QoS quality = latency %s receive %s", path.bondLatency, path.lastQoSReceive)
	}
	if len(path.qosOutgoing) != 0 {
		t.Fatalf("%d acknowledged QoS samples were retained", len(path.qosOutgoing))
	}
}

func TestQoSLatencyUsesLast64Samples(t *testing.T) {
	path := new(peerPathState)
	for i := 0; i <= qosLatencyWindowSize; i++ {
		recordQoSLatencySample(path, time.Duration(i)*time.Millisecond)
	}
	if len(path.qosLatencySamples) != qosLatencyWindowSize || path.bondLatency != 32500*time.Microsecond {
		t.Fatalf("QoS window = %d samples, mean %s", len(path.qosLatencySamples), path.bondLatency)
	}
	const wantJitter = 18618987 * time.Nanosecond
	if absDuration(path.jitter-wantJitter) > time.Microsecond {
		t.Fatalf("QoS window jitter = %s, want %s", path.jitter, wantJitter)
	}
}

func absDuration(value time.Duration) time.Duration {
	if value < 0 {
		return -value
	}
	return value
}

func TestBalanceAwareNormalizesEachMetricAcrossBond(t *testing.T) {
	now := time.Now()
	first := pathKey{localSocket: 0, endpoint: netip.MustParseAddrPort("192.0.2.10:9993")}
	second := pathKey{localSocket: 1, endpoint: netip.MustParseAddrPort("198.51.100.10:9993")}
	peer := &peer{paths: map[pathKey]*peerPathState{
		first:  {lastReceive: now, loss: 0.1},
		second: {lastReceive: now, bondLatency: 100 * time.Millisecond, loss: 0.05},
	}}
	options := defaultBondingOptions()
	options.Quality = BondingQuality{
		LatencyMax: 100 * time.Millisecond, JitterMax: time.Millisecond,
		PacketLossMax: 0.1, PacketErrorMax: 0.1,
		LatencyWeight: 0.5, PacketLossWeight: 0.5,
	}
	node := &Node{}
	node.estimateBondQualityLocked(peer, []pathKey{first, second}, options)
	if got := peer.paths[first].bondQuality; got < 0.52 || got > 0.54 {
		t.Fatalf("relative first-path quality = %f, want about 0.527", got)
	}
	if got := peer.paths[second].bondQuality; got < 0.46 || got > 0.48 {
		t.Fatalf("relative second-path quality = %f, want about 0.473", got)
	}
}

func TestBondQualityExcludesUnbondedSparePaths(t *testing.T) {
	now := time.Now()
	first := pathKey{localSocket: 1, endpoint: netip.MustParseAddrPort("192.0.2.20:9993")}
	second := pathKey{localSocket: 2, endpoint: netip.MustParseAddrPort("198.51.100.20:9993")}
	spare := pathKey{localSocket: 3, endpoint: netip.MustParseAddrPort("203.0.113.20:9993")}
	peer := &peer{paths: map[pathKey]*peerPathState{
		first:  {lastReceive: now},
		second: {lastReceive: now},
		spare:  {lastReceive: now},
	}}
	options := defaultBondingOptions()
	options.Links = []BondingLink{
		{Name: "first", LocalSockets: []int64{1}, Capacity: 1},
		{Name: "second", LocalSockets: []int64{2}, Capacity: 1},
		{Name: "spare", LocalSockets: []int64{3}, Capacity: 1, Mode: BondingLinkSpare},
	}
	node := &Node{}
	paths := node.maintainBondLocked(peer, BondingBalanceAware, options, now)
	if len(paths) != 2 || containsPath(paths, spare) {
		t.Fatalf("bonded paths = %v, want the two primary paths", paths)
	}
	if quality := peer.paths[first].bondQuality + peer.paths[second].bondQuality; math.Abs(quality-1) > 1e-9 {
		t.Fatalf("bonded relative quality total = %f, want 1", quality)
	}
}

func TestBalanceAwareFallsBackToHighestRelativeQuality(t *testing.T) {
	first := pathKey{localSocket: 0, endpoint: netip.MustParseAddrPort("192.0.2.11:9993")}
	second := pathKey{localSocket: 1, endpoint: netip.MustParseAddrPort("198.51.100.11:9993")}
	peer := &peer{paths: map[pathKey]*peerPathState{
		first:  {bondAvoid: true, bondCapacity: 0.25, bondQuality: 0.8},
		second: {bondAvoid: true, bondCapacity: 1, bondQuality: 0.2},
	}}
	for flowID := int32(0); flowID < 32; flowID++ {
		if selected := awareBondPath(peer, []pathKey{first, second}, flowID); selected != first {
			t.Fatalf("all-avoided fallback selected %v, want highest-quality path", selected)
		}
	}
}

func TestQoSMeasurementGeneration(t *testing.T) {
	local, err := GenerateIdentity()
	if err != nil {
		t.Fatal(err)
	}
	remote, err := GenerateIdentity()
	if err != nil {
		t.Fatal(err)
	}
	endpoint := netip.MustParseAddrPort("192.0.2.1:9993")
	var wire []byte
	node, err := NewNode(NodeConfig{
		Identity:      local,
		BondingPolicy: BondingBalanceXOR,
		Sender: WireSenderFunc(func(_ int64, _ netip.AddrPort, packet []byte) error {
			wire = append([]byte(nil), packet...)
			return nil
		}),
	})
	if err != nil {
		t.Fatal(err)
	}
	now := time.Now()
	node.mu.Lock()
	if err = node.addPeerLocked(remote, false); err != nil {
		node.mu.Unlock()
		t.Fatal(err)
	}
	peer := node.peers[remote.Address()]
	key := pathKey{endpoint: endpoint}
	peer.paths[key] = &peerPathState{
		lastReceive: now,
		qosIncoming: map[uint64]time.Time{123: now.Add(-20 * time.Millisecond)},
	}
	node.sendQoSMeasurementsLocked(peer, now)
	node.mu.Unlock()
	if len(wire) == 0 {
		t.Fatal("QoS measurement was not sent")
	}
	packet, err := ParsePacket(wire)
	if err != nil {
		t.Fatal(err)
	}
	keyMaterial, err := local.Agree(remote)
	if err != nil {
		t.Fatal(err)
	}
	if err = packet.Dearmor(keyMaterial[:]); err != nil {
		t.Fatal(err)
	}
	if packet.Verb() != VerbQoSMeasurement || len(packet.Payload()) != 10 || qosByteOrder.Uint64(packet.Payload()) != 123 || qosByteOrder.Uint16(packet.Payload()[8:]) != 20 {
		t.Fatalf("QoS packet = verb %d payload %x", packet.Verb(), packet.Payload())
	}
}

func TestExcludedBondPathDoesNotParticipateInMonitoring(t *testing.T) {
	local, err := GenerateIdentity()
	if err != nil {
		t.Fatal(err)
	}
	remote, err := GenerateIdentity()
	if err != nil {
		t.Fatal(err)
	}
	options, err := normalizeBondingOptions(BondingOptions{Links: []BondingLink{{
		Name: "allowed", LocalSockets: []int64{1},
	}}})
	if err != nil {
		t.Fatal(err)
	}
	var sent []sentWirePacket
	node, err := NewNode(NodeConfig{
		Identity: local, BondingPolicy: BondingBalanceXOR, BondingOptions: options,
		Sender: WireSenderFunc(func(_ int64, endpoint netip.AddrPort, packet []byte) error {
			sent = append(sent, sentWirePacket{remote: endpoint, data: append([]byte(nil), packet...)})
			return nil
		}),
	})
	if err != nil {
		t.Fatal(err)
	}
	now := time.Now()
	allowed := pathKey{localSocket: 1, endpoint: netip.MustParseAddrPort("192.0.2.1:9993")}
	excluded := pathKey{localSocket: 2, endpoint: netip.MustParseAddrPort("198.51.100.1:9993")}
	node.mu.Lock()
	if err = node.addPeerLocked(remote, false); err != nil {
		node.mu.Unlock()
		t.Fatal(err)
	}
	peer := node.peers[remote.Address()]
	peer.protocol = ProtocolVersion
	peer.lastReceive = now
	peer.paths[allowed] = &peerPathState{lastReceive: now, qosIncoming: map[uint64]time.Time{1: now.Add(-time.Millisecond)}}
	peer.paths[excluded] = &peerPathState{lastReceive: now, qosIncoming: map[uint64]time.Time{3: now.Add(-time.Millisecond)}}

	packet, err := NewPacket(local.Address(), remote.Address(), VerbFrame)
	if err != nil {
		node.mu.Unlock()
		t.Fatal(err)
	}
	node.recordIncomingBondPacketLocked(peer, excluded, packet, noFlowID, now)
	node.recordOutgoingBondPacketLocked(peer, excluded, 5, 0, VerbFrame, noFlowID, now)
	node.sendQoSMeasurementsLocked(peer, now)
	excludedOutgoing := len(peer.paths[excluded].qosOutgoing)
	node.mu.Unlock()

	if excludedOutgoing != 0 {
		t.Fatalf("excluded bond path recorded %d outgoing QoS samples", excludedOutgoing)
	}
	if len(sent) != 1 || sent[0].remote != allowed.endpoint {
		t.Fatalf("QoS destinations = %+v, want only %s", sent, allowed.endpoint)
	}

	sent = nil
	node.mu.Lock()
	peer.paths[allowed].lastReceive = now.Add(-options.FailoverInterval)
	peer.paths[excluded].lastReceive = now.Add(-options.FailoverInterval)
	peer.paths[allowed].lastProbe = now.Add(-options.FailoverInterval)
	peer.paths[excluded].lastProbe = now.Add(-options.FailoverInterval)
	peer.lastNontrivialReceive = time.Time{}
	node.lastRootContact = now
	node.mu.Unlock()
	node.ProcessBackgroundTasks(now)
	if len(sent) != 1 || sent[0].remote != allowed.endpoint {
		t.Fatalf("bond probe destinations = %+v, want only %s", sent, allowed.endpoint)
	}
}

func TestBroadcastSendRetainsOnlySuccessfulPendingPacketIDs(t *testing.T) {
	local, err := GenerateIdentity()
	if err != nil {
		t.Fatal(err)
	}
	remote, err := GenerateIdentity()
	if err != nil {
		t.Fatal(err)
	}
	wantErr := errors.New("send failed")
	failingEndpoint := netip.MustParseAddrPort("198.51.100.10:9993")
	var successfulPacketID uint64
	var attempts []sentWirePacket
	node, err := NewNode(NodeConfig{
		Identity:      local,
		BondingPolicy: BondingBroadcast,
		PhysicalPaths: []PhysicalPathConfig{{Network: netip.MustParsePrefix("192.0.2.0/24"), TrustedPathID: 7}},
		Sender: WireSenderFunc(func(_ int64, endpoint netip.AddrPort, packet []byte) error {
			attempts = append(attempts, sentWirePacket{remote: endpoint, data: append([]byte(nil), packet...)})
			if endpoint == failingEndpoint {
				return wantErr
			}
			successfulPacketID = binary.BigEndian.Uint64(packet)
			return nil
		}),
	})
	if err != nil {
		t.Fatal(err)
	}
	now := time.Now()
	node.mu.Lock()
	if err = node.addPeerLocked(remote, false); err != nil {
		node.mu.Unlock()
		t.Fatal(err)
	}
	peer := node.peers[remote.Address()]
	peer.protocol = ProtocolVersion
	successfulPath := pathKey{localSocket: 1, endpoint: netip.MustParseAddrPort("192.0.2.10:9993")}
	failingPath := pathKey{localSocket: 2, endpoint: failingEndpoint}
	node.addPeerPathLocked(peer, failingPath, &peerPathState{lastReceive: now, priority: 1}, now)
	node.addPeerPathLocked(peer, successfulPath, &peerPathState{lastReceive: now, priority: 1}, now)
	selectedPaths := node.activeDirectPeerPathsLocked(peer, time.Now())
	if len(selectedPaths) != 2 {
		node.mu.Unlock()
		t.Fatalf("active broadcast paths = %v, peer paths = %+v", selectedPaths, peer.paths)
	}
	packet, packetErr := NewPacket(remote.Address(), local.Address(), VerbFrame)
	if packetErr != nil {
		node.mu.Unlock()
		t.Fatal(packetErr)
	}
	broadcastPaths := node.bondedPathsLocked(peer, packet.Verb(), noFlowID, packet.PacketID(), time.Now(), nil)
	if len(broadcastPaths) != 2 {
		node.mu.Unlock()
		t.Fatalf("broadcast paths = %v, policy = %v, root = %t, verb = %v", broadcastPaths, node.bondingPolicyForPeerLocked(peer), peer.root, packet.Verb())
	}
	request := pendingRequest{verb: VerbFrame, peer: remote.Address(), sentAt: now}
	node.pending[packet.PacketID()] = request
	sendErr := node.sendPacketLocked(peer, packet, true)
	pending := make(map[uint64]pendingRequest, len(node.pending))
	for packetID, tracked := range node.pending {
		pending[packetID] = tracked
	}
	node.mu.Unlock()
	if sendErr != nil {
		t.Fatalf("partially successful broadcast error = %v", sendErr)
	}
	tracked := pending[successfulPacketID]
	if successfulPacketID == 0 || len(pending) != 1 || tracked.verb != request.verb || tracked.peer != request.peer || tracked.replyPaths == nil || len(tracked.replyPaths.remaining) != 1 {
		t.Fatalf("pending requests = %+v, successful packet = %x, attempts = %+v", pending, successfulPacketID, attempts)
	}
}

func TestBroadcastPendingRequestAcceptsEverySuccessfulReply(t *testing.T) {
	local, err := GenerateIdentity()
	if err != nil {
		t.Fatal(err)
	}
	remote, err := GenerateIdentity()
	if err != nil {
		t.Fatal(err)
	}
	var sentPacketIDs []uint64
	node, err := NewNode(NodeConfig{
		Identity:      local,
		BondingPolicy: BondingBroadcast,
		Sender: WireSenderFunc(func(_ int64, _ netip.AddrPort, packet []byte) error {
			sentPacketIDs = append(sentPacketIDs, binary.BigEndian.Uint64(packet))
			return nil
		}),
	})
	if err != nil {
		t.Fatal(err)
	}
	now := time.Now()
	node.mu.Lock()
	if err = node.addPeerLocked(remote, false); err != nil {
		node.mu.Unlock()
		t.Fatal(err)
	}
	peer := node.peers[remote.Address()]
	peer.protocol = ProtocolVersion
	first := pathKey{localSocket: 1, endpoint: netip.MustParseAddrPort("192.0.2.20:9993")}
	second := pathKey{localSocket: 2, endpoint: netip.MustParseAddrPort("198.51.100.20:9993")}
	node.addPeerPathLocked(peer, first, &peerPathState{lastReceive: now, priority: 1}, now)
	node.addPeerPathLocked(peer, second, &peerPathState{lastReceive: now, priority: 1}, now)
	request, packetErr := NewPacket(remote.Address(), local.Address(), VerbExtFrame)
	if packetErr != nil {
		node.mu.Unlock()
		t.Fatal(packetErr)
	}
	const networkID = uint64(0x1234567890abcdef)
	pending := pendingRequest{verb: VerbExtFrame, peer: remote.Address(), networkID: networkID, sentAt: now}
	node.pending[request.PacketID()] = pending
	if err = node.sendPacketLocked(peer, request, true); err != nil {
		node.mu.Unlock()
		t.Fatal(err)
	}
	if len(sentPacketIDs) != 2 || sentPacketIDs[0] != sentPacketIDs[1] {
		node.mu.Unlock()
		t.Fatalf("broadcast packet IDs = %x", sentPacketIDs)
	}
	sentPacketID := sentPacketIDs[0]
	tracked, ok := node.pending[sentPacketID]
	if !ok || tracked.replyPaths == nil || len(tracked.replyPaths.remaining) != 2 {
		node.mu.Unlock()
		t.Fatalf("broadcast pending = %+v, found = %t", tracked, ok)
	}
	reply, replyErr := NewPacket(local.Address(), remote.Address(), VerbOK)
	if replyErr == nil {
		replyErr = reply.Append(byte(VerbExtFrame))
	}
	if replyErr == nil {
		replyErr = reply.AppendUint64(sentPacketID)
	}
	if replyErr == nil {
		replyErr = reply.AppendUint64(networkID)
	}
	if replyErr != nil {
		node.mu.Unlock()
		t.Fatal(replyErr)
	}
	if err = node.handleOKLocked(first.localSocket, first.endpoint, peer, reply, now); err != nil {
		node.mu.Unlock()
		t.Fatal(err)
	}
	tracked, ok = node.pending[sentPacketID]
	if !ok || tracked.replyPaths == nil || len(tracked.replyPaths.remaining) != 1 {
		node.mu.Unlock()
		t.Fatalf("pending after first reply = %+v, found = %t", tracked, ok)
	}
	if err = node.handleOKLocked(first.localSocket, first.endpoint, peer, reply, now); err != nil {
		node.mu.Unlock()
		t.Fatal(err)
	}
	tracked, ok = node.pending[sentPacketID]
	if !ok || tracked.replyPaths == nil || len(tracked.replyPaths.remaining) != 1 {
		node.mu.Unlock()
		t.Fatalf("duplicate reply consumed another path: pending=%+v found=%t", tracked, ok)
	}
	if err = node.handleOKLocked(second.localSocket, second.endpoint, peer, reply, now); err != nil {
		node.mu.Unlock()
		t.Fatal(err)
	}
	_, ok = node.pending[sentPacketID]
	node.mu.Unlock()
	if ok {
		t.Fatal("pending request remained after every successful copy replied")
	}
}

func TestProtocolErrorDoesNotConsumeBroadcastExpectation(t *testing.T) {
	local, err := GenerateIdentity()
	if err != nil {
		t.Fatal(err)
	}
	remote, err := GenerateIdentity()
	if err != nil {
		t.Fatal(err)
	}
	node, err := NewNode(NodeConfig{
		Identity: local,
		Sender:   WireSenderFunc(func(int64, netip.AddrPort, []byte) error { return nil }),
	})
	if err != nil {
		t.Fatal(err)
	}
	first := pathKey{localSocket: 1, endpoint: netip.MustParseAddrPort("192.0.2.30:9993")}
	second := pathKey{localSocket: 2, endpoint: netip.MustParseAddrPort("198.51.100.30:9993")}
	request, err := NewPacket(remote.Address(), local.Address(), VerbExtFrame)
	if err != nil {
		t.Fatal(err)
	}
	reply, err := NewPacket(local.Address(), remote.Address(), VerbError)
	if err == nil {
		err = reply.Append(byte(VerbExtFrame))
	}
	if err == nil {
		err = reply.AppendUint64(request.PacketID())
	}
	if err == nil {
		err = reply.Append(0x01)
	}
	if err != nil {
		t.Fatal(err)
	}
	node.mu.Lock()
	if err = node.addPeerLocked(remote, false); err != nil {
		node.mu.Unlock()
		t.Fatal(err)
	}
	peer := node.peers[remote.Address()]
	node.pending[request.PacketID()] = pendingRequest{
		verb:   VerbExtFrame,
		peer:   remote.Address(),
		sentAt: time.Now(),
		replyPaths: &pendingReplyPaths{remaining: map[pathKey]struct{}{
			first:  {},
			second: {},
		}},
	}
	err = node.handleErrorLocked(peer, reply, time.Now())
	if err == nil {
		err = node.handleErrorLocked(peer, reply, time.Now())
	}
	tracked, ok := node.pending[request.PacketID()]
	node.mu.Unlock()
	if err != nil {
		t.Fatal(err)
	}
	if !ok || tracked.replyPaths == nil || len(tracked.replyPaths.remaining) != 2 {
		t.Fatalf("protocol ERROR consumed pending request: %+v", tracked)
	}
}
