func TestBondingPathSelection(t *testing.T) {
	now := time.Now()
	first := pathKey{localSocket: 0, endpoint: netip.MustParseAddrPort("192.0.2.1:9993")}
	second := pathKey{localSocket: 1, endpoint: netip.MustParseAddrPort("198.51.100.1:9993")}
	peer := &peer{
		paths: map[pathKey]*peerPathState{
			first:  {lastReceive: now, latency: 20 * time.Millisecond},
			second: {lastReceive: now, latency: 30 * time.Millisecond},
		},
		bondFlows: make(map[int32]bondFlow),
	}
	node := &Node{}

	node.bondingPolicy = BondingBroadcast
	if paths := node.bondedPathsLocked(peer, VerbFrame, noFlowID, 1, now, nil); len(paths) != 2 {
		t.Fatalf("broadcast FRAME selected %d paths", len(paths))
	}
	if paths := node.bondedPathsLocked(peer, VerbEcho, noFlowID, 1, now, nil); len(paths) != 1 {
		t.Fatalf("broadcast ECHO selected %d paths", len(paths))
	}
	node.bondingPolicy = BondingNone
	node.peerPaths = map[Address]PeerPathConfig{
		peer.identity.Address(): {BondingPolicy: BondingBroadcast, BondingPolicySet: true},
	}
	if paths := node.bondedPathsLocked(peer, VerbFrame, noFlowID, 1, now, nil); len(paths) != 2 {
		t.Fatalf("peer-specific broadcast selected %d paths", len(paths))
	}
	node.peerPaths = nil

	node.bondingPolicy = BondingBalanceXOR
	selected := node.bondedPathsLocked(peer, VerbFrame, 1234, 1, now, nil)
	again := node.bondedPathsLocked(peer, VerbFrame, 1234, 2, now.Add(time.Second), nil)
	if len(selected) != 1 || len(again) != 1 || selected[0] != again[0] {
		t.Fatalf("balance-xor did not keep flow affinity: %v then %v", selected, again)
	}

	peer.bondRRIndex, peer.bondRRPackets = 0, 0
	node.bondingPolicy = BondingBalanceRoundRobin
	for i := 0; i < int(bondRoundRobinPackets); i++ {
		paths := node.bondedPathsLocked(peer, VerbFrame, noFlowID, uint64(i), now, nil)
		if len(paths) != 1 || paths[0] != first {
			t.Fatalf("round-robin packet %d selected %v", i, paths)
		}
	}
	if paths := node.bondedPathsLocked(peer, VerbFrame, noFlowID, 65, now, nil); len(paths) != 1 || paths[0] != second {
		t.Fatalf("round-robin did not rotate after %d packets: %v", bondRoundRobinPackets, paths)
	}
}

func TestActiveBackupFailoverHysteresis(t *testing.T) {
	now := time.Unix(1000, 0)
	first := pathKey{localSocket: 0, endpoint: netip.MustParseAddrPort("192.0.2.1:9993")}
	second := pathKey{localSocket: 1, endpoint: netip.MustParseAddrPort("198.51.100.1:9993")}
	options := defaultBondingOptions()
	options.UpDelay = 2 * time.Second
	options.DownDelay = time.Second
	options.LinkSelectMethod = BondingLinkSelectFailure
	peer := &peer{paths: map[pathKey]*peerPathState{
		first:  {lastReceive: now, latency: time.Millisecond},
		second: {lastReceive: now, latency: 20 * time.Millisecond},
	}, bondFlows: make(map[int32]bondFlow)}
	node := &Node{bondingPolicy: BondingActiveBackup, bondingOptions: options}
	if selected := node.bondedPathsLocked(peer, VerbFrame, noFlowID, 1, now, nil); len(selected) != 1 || selected[0] != first {
		t.Fatalf("initial active-backup path = %v", selected)
	}

	stable := now.Add(16 * time.Second)
	peer.paths[first].lastReceive = stable
	peer.paths[second].lastReceive = stable
	node.maintainBondLocked(peer, BondingActiveBackup, options, stable)
	fail := stable.Add(options.FailoverInterval + options.DownDelay)
	peer.paths[second].lastReceive = fail
	if selected := node.bondedPathsLocked(peer, VerbFrame, noFlowID, 2, fail, nil); len(selected) != 1 || selected[0] != second {
		t.Fatalf("failed active path did not switch: %v", selected)
	}

	recovered := fail.Add(time.Second)
	peer.paths[first].lastReceive = recovered
	node.maintainBondLocked(peer, BondingActiveBackup, options, recovered)
	if peer.paths[first].bondEligible {
		t.Fatal("recovered path ignored up-delay")
	}
	recovered = recovered.Add(options.UpDelay)
	peer.paths[first].lastReceive = recovered
	node.maintainBondLocked(peer, BondingActiveBackup, options, recovered)
	if !peer.paths[first].bondEligible || peer.bondActive != second {
		t.Fatalf("recovered path eligibility=%t active=%v", peer.paths[first].bondEligible, peer.bondActive)
	}
}

func TestActiveBackupFailureSelectsHighestScoredPath(t *testing.T) {
	now := time.Unix(1000, 0)
	active := pathKey{localSocket: 0, endpoint: netip.MustParseAddrPort("192.0.2.1:9993")}
	poor := pathKey{localSocket: 1, endpoint: netip.MustParseAddrPort("198.51.100.1:9993")}
	best := pathKey{localSocket: 2, endpoint: netip.MustParseAddrPort("203.0.113.1:9993")}
	options := defaultBondingOptions()
	options.LinkSelectMethod = BondingLinkSelectFailure
	peer := &peer{paths: map[pathKey]*peerPathState{
		active: {lastReceive: now},
		poor:   {lastReceive: now, bondLatency: options.Quality.LatencyMax},
		best:   {lastReceive: now},
	}, bondFlows: make(map[int32]bondFlow)}
	node := &Node{bondingPolicy: BondingActiveBackup, bondingOptions: options}
	node.maintainBondLocked(peer, BondingActiveBackup, options, now)
	if peer.bondActive != active {
		t.Fatalf("initial active path = %v, want %v", peer.bondActive, active)
	}
	later := now.Add(bondOptimizeInterval + options.FailoverInterval)
	peer.paths[poor].lastReceive = later
	peer.paths[best].lastReceive = later
	node.maintainBondLocked(peer, BondingActiveBackup, options, later)
	if peer.bondActive != best {
		t.Fatalf("failed active path selected %v, want highest-scored %v", peer.bondActive, best)
	}
}

func TestActiveBackupAlwaysReselectsPrimary(t *testing.T) {
	now := time.Now()
	primary := pathKey{localSocket: 0, endpoint: netip.MustParseAddrPort("192.0.2.1:9993")}
	spare := pathKey{localSocket: 1, endpoint: netip.MustParseAddrPort("198.51.100.1:9993")}
	options, err := normalizeBondingOptions(BondingOptions{Links: []BondingLink{
		{Name: "primary", LocalSockets: []int64{0}, Mode: BondingLinkPrimary, FailoverTo: "spare"},
		{Name: "spare", LocalSockets: []int64{1}, Mode: BondingLinkSpare},
	}})
	if err != nil {
		t.Fatal(err)
	}
	peer := &peer{paths: map[pathKey]*peerPathState{
		primary: {lastReceive: now}, spare: {lastReceive: now},
	}, bondFlows: make(map[int32]bondFlow)}
	node := &Node{bondingPolicy: BondingActiveBackup, bondingOptions: options}
	node.maintainBondLocked(peer, BondingActiveBackup, options, now)
	if peer.bondActive != primary {
		t.Fatalf("initial active path = %v", peer.bondActive)
	}
	later := now.Add(bondOptimizeInterval + options.FailoverInterval)
	peer.paths[spare].lastReceive = later
	node.maintainBondLocked(peer, BondingActiveBackup, options, later)
	if peer.bondActive != spare {
		t.Fatalf("failed primary did not select spare: %v", peer.bondActive)
	}
	peer.paths[primary].lastReceive = later.Add(time.Second)
	peer.paths[spare].lastReceive = later.Add(time.Second)
	node.maintainBondLocked(peer, BondingActiveBackup, options, later.Add(time.Second))
	if peer.bondActive != primary {
		t.Fatalf("recovered primary was not reselected: %v", peer.bondActive)
	}
}

func TestActiveBackupExplicitFailoverReselectsPrimaryWhenOptimizing(t *testing.T) {
	now := time.Unix(1000, 0)
	primary := pathKey{localSocket: 0, endpoint: netip.MustParseAddrPort("192.0.2.1:9993")}
	spare := pathKey{localSocket: 1, endpoint: netip.MustParseAddrPort("198.51.100.1:9993")}
	options, err := normalizeBondingOptions(BondingOptions{
		LinkSelectMethod: BondingLinkSelectOptimize,
		Links: []BondingLink{
			{Name: "primary", LocalSockets: []int64{0}, Mode: BondingLinkPrimary, FailoverTo: "spare"},
			{Name: "spare", LocalSockets: []int64{1}, Mode: BondingLinkSpare},
		},
	})
	if err != nil {
		t.Fatal(err)
	}
	peer := &peer{paths: map[pathKey]*peerPathState{
		primary: {lastReceive: now, bondLatency: options.Quality.LatencyMax},
		spare:   {lastReceive: now},
	}, bondFlows: make(map[int32]bondFlow)}
	node := &Node{bondingPolicy: BondingActiveBackup, bondingOptions: options}
	node.maintainBondLocked(peer, BondingActiveBackup, options, now)
	if peer.bondActive != primary {
		t.Fatalf("initial active path = %v, want primary", peer.bondActive)
	}

	failedAt := now.Add(bondOptimizeInterval + options.FailoverInterval)
	peer.paths[spare].lastReceive = failedAt
	node.maintainBondLocked(peer, BondingActiveBackup, options, failedAt)
	if peer.bondActive != spare {
		t.Fatalf("failed primary selected %v, want spare", peer.bondActive)
	}

	recoveredAt := failedAt.Add(bondOptimizeInterval + time.Second)
	peer.paths[primary].lastReceive = recoveredAt
	peer.paths[spare].lastReceive = recoveredAt
	node.maintainBondLocked(peer, BondingActiveBackup, options, recoveredAt)
	if peer.bondActive != primary {
		t.Fatalf("explicit optimize failover retained %v, want recovered primary", peer.bondActive)
	}
}

func TestBondingCustomRoundRobinAndLinkPreference(t *testing.T) {
	now := time.Now()
	v4 := pathKey{localSocket: 0, endpoint: netip.MustParseAddrPort("192.0.2.1:9993")}
	v6 := pathKey{localSocket: 1, endpoint: netip.MustParseAddrPort("[2001:db8::1]:9993")}
	spare := pathKey{localSocket: 2, endpoint: netip.MustParseAddrPort("198.51.100.1:9993")}
	one := 1
	options, err := normalizeBondingOptions(BondingOptions{
		PacketsPerLink: &one,
		Links: []BondingLink{
			{Name: "primary", LocalSockets: []int64{0, 1}, IPPreference: 46},
			{Name: "spare", LocalSockets: []int64{2}, Mode: BondingLinkSpare},
		},
	})
	if err != nil {
		t.Fatal(err)
	}
	peer := &peer{paths: map[pathKey]*peerPathState{
		v4: {lastReceive: now}, v6: {lastReceive: now}, spare: {lastReceive: now},
	}, bondFlows: make(map[int32]bondFlow)}
	node := &Node{bondingPolicy: BondingBalanceRoundRobin, bondingOptions: options}
	for i := uint64(0); i < 3; i++ {
		selected := node.bondedPathsLocked(peer, VerbFrame, noFlowID, i, now, nil)
		if len(selected) != 1 || selected[0] != v4 {
			t.Fatalf("preferred link selection %d = %v", i, selected)
		}
	}
}

func TestBondingCustomRoundRobinRunLength(t *testing.T) {
	now := time.Now()
	first := pathKey{localSocket: 0, endpoint: netip.MustParseAddrPort("192.0.2.1:9993")}
	second := pathKey{localSocket: 1, endpoint: netip.MustParseAddrPort("198.51.100.1:9993")}
	one := 1
	options, err := normalizeBondingOptions(BondingOptions{PacketsPerLink: &one})
	if err != nil {
		t.Fatal(err)
	}
	peer := &peer{paths: map[pathKey]*peerPathState{
		first: {lastReceive: now}, second: {lastReceive: now},
	}, bondFlows: make(map[int32]bondFlow)}
	node := &Node{bondingPolicy: BondingBalanceRoundRobin, bondingOptions: options}
	if selected := node.bondedPathsLocked(peer, VerbFrame, noFlowID, 1, now, nil); len(selected) != 1 || selected[0] != first {
		t.Fatalf("first RR run selected %v", selected)
	}
	if selected := node.bondedPathsLocked(peer, VerbFrame, noFlowID, 2, now, nil); len(selected) != 1 || selected[0] != second {
		t.Fatalf("second RR run selected %v", selected)
	}
}

func TestBalanceAwareUsesLinkCapacity(t *testing.T) {
	now := time.Now()
	slow := pathKey{localSocket: 0, endpoint: netip.MustParseAddrPort("192.0.2.1:9993")}
	fast := pathKey{localSocket: 1, endpoint: netip.MustParseAddrPort("198.51.100.1:9993")}
	options, err := normalizeBondingOptions(BondingOptions{Links: []BondingLink{
		{Name: "slow", LocalSockets: []int64{0}, Capacity: 1},
		{Name: "fast", LocalSockets: []int64{1}, Capacity: 3},
	}})
	if err != nil {
		t.Fatal(err)
	}
	peer := &peer{paths: map[pathKey]*peerPathState{
		slow: {lastReceive: now, bondLatency: time.Millisecond}, fast: {lastReceive: now, bondLatency: time.Millisecond},
	}, bondFlows: make(map[int32]bondFlow)}
	node := &Node{bondingPolicy: BondingBalanceAware, bondingOptions: options}
	counts := map[pathKey]int{}
	var slowFlow int32
	for flowID := int32(1); flowID <= 512; flowID++ {
		selected := node.bondedPathsLocked(peer, VerbFrame, flowID, uint64(flowID), now, nil)
		counts[selected[0]]++
		if selected[0] == slow && slowFlow == 0 {
			slowFlow = flowID
		}
	}
	if counts[fast] <= 2*counts[slow] {
		t.Fatalf("capacity weighting selected slow=%d fast=%d", counts[slow], counts[fast])
	}
	peer.paths[slow].bondLatency = options.Quality.LatencyMax + time.Millisecond
	selected := node.bondedPathsLocked(peer, VerbFrame, slowFlow, 1000, now.Add(bondMaintenancePeriod), nil)
	if len(selected) != 1 || selected[0] != fast {
		t.Fatalf("flow on avoided path was not reassigned: %v", selected)
	}
}

func TestActiveBackupPathNegotiation(t *testing.T) {
	local, err := GenerateIdentity()
	if err != nil {
		t.Fatal(err)
	}
	remote, err := GenerateIdentity()
	if err != nil {
		t.Fatal(err)
	}
	now := time.Now()
	first := pathKey{localSocket: 0, endpoint: netip.MustParseAddrPort("192.0.2.1:9993")}
	second := pathKey{localSocket: 1, endpoint: netip.MustParseAddrPort("198.51.100.1:9993")}
	options := defaultBondingOptions()
	options.LinkSelectMethod = BondingLinkSelectOptimize
	var sentPath pathKey
	var wire []byte
	node, err := NewNode(NodeConfig{
		Identity: local, BondingPolicy: BondingActiveBackup, BondingOptions: options,
		Sender: WireSenderFunc(func(localSocket int64, remote netip.AddrPort, packet []byte) error {
			sentPath = pathKey{localSocket: localSocket, endpoint: remote}
			wire = append([]byte(nil), packet...)
			return nil
		}),
	})
	if err != nil {
		t.Fatal(err)
	}
	node.mu.Lock()
	if err = node.addPeerLocked(remote, false); err != nil {
		node.mu.Unlock()
		t.Fatal(err)
	}
	peer := node.peers[remote.Address()]
	peer.paths[first] = &peerPathState{lastReceive: now, latency: time.Millisecond}
	peer.paths[second] = &peerPathState{lastReceive: now, latency: time.Millisecond}
	node.maintainBondLocked(peer, BondingActiveBackup, options, now)
	peer.paths[first].bondPacketsIn = 10
	peer.paths[second].bondPacketsOut = 10
	peer.bondLastNegotiation = now.Add(-bondOptimizeInterval)
	node.processBondNegotiationLocked(peer, options, now)
	node.mu.Unlock()
	if sentPath != second || len(wire) == 0 {
		t.Fatalf("negotiation sent via %v with %d bytes", sentPath, len(wire))
	}
	packet, err := ParsePacket(wire)
	if err != nil {
		t.Fatal(err)
	}
	key, err := local.Agree(remote)
	if err != nil {
		t.Fatal(err)
	}
	if err = packet.Dearmor(key[:]); err != nil {
		t.Fatal(err)
	}
	if packet.Verb() != VerbPathNegotiation || len(packet.Payload()) != 2 {
		t.Fatalf("negotiation packet verb=%d payload=%x", packet.Verb(), packet.Payload())
	}

	node.mu.Lock()
	peer.bondLastNegotiation = now
	peer.bondLocalUtility = -1
	reply, _ := NewPacket(local.Address(), remote.Address(), VerbPathNegotiation)
	_ = reply.AppendUint16(1)
	if err = node.handlePathNegotiationLocked(peer, second, reply, now.Add(time.Second)); err != nil {
		node.mu.Unlock()
		t.Fatal(err)
	}
	node.maintainBondLocked(peer, BondingActiveBackup, options, now.Add(time.Second))
	active := peer.bondActive
	node.mu.Unlock()
	if active != second {
		t.Fatalf("negotiated active path = %v, want %v", active, second)
	}
}

func TestFrameFlowID(t *testing.T) {
	ipv4 := make([]byte, 24)
	ipv4[0], ipv4[9] = 0x45, 17
	ipv4[20], ipv4[21], ipv4[22], ipv4[23] = 0x12, 0x34, 0x56, 0x78
	frame := Frame{EtherType: EtherTypeIPv4, Payload: ipv4}
	if got, want := frameFlowID(frame), int32(0x1234^0x5678^17); got != want {
		t.Fatalf("IPv4 flow ID = %d, want %d", got, want)
	}

	ipv6 := make([]byte, 52)
	ipv6[0], ipv6[6] = 0x60, 0 // hop-by-hop extension
	ipv6[40], ipv6[41] = 6, 0
	ipv6[48], ipv6[49], ipv6[50], ipv6[51] = 0x12, 0x34, 0x56, 0x78
	frame = Frame{EtherType: EtherTypeIPv6, Payload: ipv6}
	if got, want := frameFlowID(frame), int32(0x1234^0x5678^6); got != want {
		t.Fatalf("IPv6 flow ID = %d, want %d", got, want)
	}

	fragmented := make([]byte, 56)
	fragmented[0], fragmented[6] = 0x60, 44
	fragmented[40] = 17
	fragmented[48], fragmented[49], fragmented[50], fragmented[51] = 0x12, 0x34, 0x56, 0x78
	if got := frameFlowID(Frame{EtherType: EtherTypeIPv6, Payload: fragmented}); got != noFlowID {
		t.Fatalf("fragmented IPv6 flow ID = %d, want no flow", got)
	}

	mobility := make([]byte, 52)
	mobility[0], mobility[6] = 0x60, 135
	mobility[40], mobility[41] = 17, 0
	mobility[48], mobility[49], mobility[50], mobility[51] = 0x12, 0x34, 0x56, 0x78
	if got, want := frameFlowID(Frame{EtherType: EtherTypeIPv6, Payload: mobility}), int32(0x1234^0x5678^17); got != want {
		t.Fatalf("IPv6 mobility flow ID = %d, want %d", got, want)
	}
}

func TestIncomingEvenPacketIDStillLearnsBondFlow(t *testing.T) {
	now := time.Now()
	key := pathKey{localSocket: 1, endpoint: netip.MustParseAddrPort("198.51.100.55:9993")}
	peer := &peer{
		paths:     map[pathKey]*peerPathState{key: {lastReceive: now}},
		bondFlows: make(map[int32]bondFlow),
	}
	node := &Node{bondingPolicy: BondingBalanceXOR}
	packet, err := NewPacket(NewAddress(1), NewAddress(2), VerbFrame)
	if err != nil {
		t.Fatal(err)
	}
	packet.data[7] &^= 1
	const flowID = int32(1234)
	node.recordIncomingBondPacketLocked(peer, key, packet, flowID, now)
	flow, ok := peer.bondFlows[flowID]
	if !ok || flow.path != key || !flow.lastActive.Equal(now) {
		t.Fatalf("even packet flow = %+v, present=%t", flow, ok)
	}
	if len(peer.paths[key].qosIncoming) != 0 {
		t.Fatal("even packet ID was incorrectly added to QoS sampling")
	}
}

