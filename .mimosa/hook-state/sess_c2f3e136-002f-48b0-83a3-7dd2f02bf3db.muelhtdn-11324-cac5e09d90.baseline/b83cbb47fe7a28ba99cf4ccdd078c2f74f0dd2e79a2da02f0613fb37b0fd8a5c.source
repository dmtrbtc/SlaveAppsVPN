package main

import (
	"bytes"
	"context"
	"encoding/binary"
	"encoding/hex"
	"encoding/json"
	"errors"
	"flag"
	"fmt"
	"io"
	"net"
	"net/netip"
	"sync"
	"time"

	zerotier "github.com/metacubex/zerotier-go"
	"github.com/metacubex/zerotier-go/iplink"
)

const (
	// udpProtocol is the IP protocol number assigned to UDP.
	udpProtocol = byte(17)
	// udpHeaderSize is the fixed size of a UDP header.
	udpHeaderSize = 8
)

// udpProbeResult reports one request/reply UDP exchange.
type udpProbeResult struct {
	Node     string         `json:"node"`
	Network  string         `json:"network"`
	Source   string         `json:"source"`
	Target   string         `json:"target"`
	Status   string         `json:"status"`
	Attempts int            `json:"attempts"`
	RTT      time.Duration  `json:"rtt,omitempty"`
	Response []byte         `json:"response,omitempty"`
	Path     pathDiagnostic `json:"path"`
}

// runUDP joins a network and exchanges one UDP datagram with a remote service.
func runUDP(args []string, stdout, stderr io.Writer) (int, error) {
	flags := flag.NewFlagSet("udp", flag.ContinueOnError)
	flags.SetOutput(stderr)
	var options onlineOptions
	addOnlineFlags(flags, &options)
	networkText := flags.String("network", "", "16-digit network ID")
	targetText := flags.String("target", "", "IPv4 or IPv6 destination")
	port := flags.Int("port", 0, "UDP destination port")
	sendText := flags.String("send", "zerotier-go ztprobe", "datagram payload")
	expectText := flags.String("expect", "", "exact expected response; empty accepts any response")
	attempts := flags.Int("count", 3, "maximum datagram attempts")
	interval := flags.Duration("interval", time.Second, "delay between attempts")
	peerText := flags.String("peer", "", "expected 10-digit ZeroTier peer address")
	requireDirect := flags.Bool("require-direct", false, "require an active direct path to the expected peer")
	if err := flags.Parse(args); err != nil {
		return exitUsage, err
	}
	networkID, err := parseNetworkOption(*networkText, flags.NArg(), options.timeout)
	if err != nil {
		return exitUsage, err
	}
	target, err := netip.ParseAddr(*targetText)
	if err != nil || target.IsUnspecified() || target.IsMulticast() || *port < 1 || *port > 65535 || *attempts <= 0 || *interval <= 0 {
		return exitUsage, errors.New("udp requires a unicast -target, a -port from 1 to 65535, a positive -count, and a positive -interval")
	}
	if *peerText != "" {
		if _, err = zerotier.ParseAddress(*peerText); err != nil {
			return exitUsage, err
		}
	}
	ctx, cancel := context.WithTimeout(context.Background(), options.timeout)
	defer cancel()
	probe, code, err := startNetworkProbe(ctx, options, networkID, target, stdout, stderr)
	if err != nil {
		return code, err
	}
	defer probe.Close()
	result, probeErr := probe.runtime.probeUDP(ctx, probe.network.Config, target, uint16(*port), []byte(*sendText), []byte(*expectText), *expectText != "", *attempts, *interval)
	diagnostic, pathErr := diagnosePath(ctx, probe.runtime.node, probe.network.Config, target, *peerText, *requireDirect)
	result.Path = diagnostic
	if options.json {
		_ = json.NewEncoder(stdout).Encode(result)
	} else {
		fmt.Fprintf(stdout, "node=%s network=%s source=%s target=%s status=%s attempts=%d rtt=%s response=%q response-hex=%s\n",
			result.Node, result.Network, result.Source, result.Target, result.Status, result.Attempts, result.RTT, result.Response, hex.EncodeToString(result.Response))
		printPathDiagnostic(stdout, diagnostic)
	}
	if probeErr != nil {
		return exitProbeFailed, probeErr
	}
	if pathErr != nil {
		return exitProbeFailed, pathErr
	}
	return exitOK, nil
}

// probeUDP sends bounded UDP retries and waits for a matching response or ICMP
// error.
func (p *probeRuntime) probeUDP(ctx context.Context, config zerotier.NetworkConfigData, target netip.Addr, targetPort uint16, payload, expected []byte, checkExpected bool, maximumAttempts int, interval time.Duration) (udpProbeResult, error) {
	result := udpProbeResult{
		Node: p.node.Address().String(), Network: fmt.Sprintf("%016x", config.NetworkID),
		Target: netip.AddrPortFrom(target, targetPort).String(), Status: "timeout",
	}
	p.linkMu.RLock()
	link := p.link
	p.linkMu.RUnlock()
	if link == nil {
		return result, errors.New("ZeroTier IP link is unavailable")
	}
	source, err := link.SourceFor(target)
	if err != nil {
		return result, err
	}
	sourcePort, err := randomEphemeralPort()
	if err != nil {
		return result, err
	}
	result.Source = netip.AddrPortFrom(source, sourcePort).String()
	packet := udpPacket(source, target, sourcePort, targetPort, payload)
	if len(packet) == 0 || len(packet) > int(config.MTU) {
		return result, fmt.Errorf("UDP packet size %d is invalid for network MTU %d", len(packet), config.MTU)
	}
	var lastSent time.Time
	send := func() error {
		if err := link.WritePacket(packet); err != nil {
			return err
		}
		lastSent = time.Now()
		result.Attempts++
		return nil
	}
	if err = send(); err != nil {
		return result, err
	}
	ticker := time.NewTicker(interval)
	defer ticker.Stop()
	retry := ticker.C
	if maximumAttempts == 1 {
		retry = nil
	}
	for {
		select {
		case inbound := <-p.packets:
			response, ok := parseUDPReply(inbound, source, target, sourcePort, targetPort)
			if ok {
				if checkExpected && !bytes.Equal(response, expected) {
					continue
				}
				result.Status, result.Response, result.RTT = "reply", append([]byte(nil), response...), time.Since(lastSent)
				return result, nil
			}
			if remoteErr, isError := parseProbeICMPError(inbound); isError && matchUDPICMPError(remoteErr, source, target, sourcePort, targetPort) {
				result.Status = "icmp-error"
				return result, remoteErr
			}
		case err := <-p.linkErrs:
			return result, err
		case <-retry:
			if result.Attempts >= maximumAttempts {
				retry = nil
				continue
			}
			if err = send(); err != nil {
				return result, err
			}
		case <-ctx.Done():
			return result, fmt.Errorf("UDP probe to %s timed out after %d attempts: %w", result.Target, result.Attempts, ctx.Err())
		}
	}
}

// udpPacket builds an IPv4 or IPv6 packet containing one UDP datagram.
func udpPacket(source, target netip.Addr, sourcePort, targetPort uint16, payload []byte) []byte {
	source, target = source.Unmap(), target.Unmap()
	maximumPayload := 65527
	if source.Is4() {
		maximumPayload = 65507
	}
	if !source.IsValid() || !target.IsValid() || source.Is4() != target.Is4() || len(payload) > maximumPayload {
		return nil
	}
	udp := make([]byte, udpHeaderSize+len(payload))
	binary.BigEndian.PutUint16(udp[0:2], sourcePort)
	binary.BigEndian.PutUint16(udp[2:4], targetPort)
	binary.BigEndian.PutUint16(udp[4:6], uint16(len(udp)))
	copy(udp[8:], payload)
	udpChecksum := transportChecksum(source, target, udpProtocol, udp)
	if udpChecksum == 0 {
		udpChecksum = 0xffff
	}
	binary.BigEndian.PutUint16(udp[6:8], udpChecksum)
	if source.Is4() {
		packet := make([]byte, 20+len(udp))
		packet[0] = 0x45
		binary.BigEndian.PutUint16(packet[2:4], uint16(len(packet)))
		binary.BigEndian.PutUint16(packet[6:8], 0x4000)
		packet[8], packet[9] = 64, udpProtocol
		copy(packet[12:16], source.AsSlice())
		copy(packet[16:20], target.AsSlice())
		binary.BigEndian.PutUint16(packet[10:12], checksum(packet[:20]))
		copy(packet[20:], udp)
		return packet
	}
	packet := make([]byte, 40+len(udp))
	packet[0] = 0x60
	binary.BigEndian.PutUint16(packet[4:6], uint16(len(udp)))
	packet[6], packet[7] = udpProtocol, 64
	copy(packet[8:24], source.AsSlice())
	copy(packet[24:40], target.AsSlice())
	copy(packet[40:], udp)
	return packet
}

// parseUDPReply validates a UDP response against one connected probe tuple.
func parseUDPReply(packet []byte, source, target netip.Addr, sourcePort, targetPort uint16) ([]byte, bool) {
	packetSource, packetTarget, udp, ok := ipProtocolPayload(packet, udpProtocol)
	if !ok || packetSource != target.Unmap() || packetTarget != source.Unmap() || len(udp) < udpHeaderSize ||
		binary.BigEndian.Uint16(udp[0:2]) != targetPort || binary.BigEndian.Uint16(udp[2:4]) != sourcePort {
		return nil, false
	}
	length := int(binary.BigEndian.Uint16(udp[4:6]))
	if length < udpHeaderSize || length > len(udp) {
		return nil, false
	}
	checksumValue := binary.BigEndian.Uint16(udp[6:8])
	if packetSource.Is6() && checksumValue == 0 || checksumValue != 0 && transportChecksum(packetSource, packetTarget, udpProtocol, udp[:length]) != 0 {
		return nil, false
	}
	return udp[udpHeaderSize:length], true
}

// matchUDPICMPError verifies that an ICMP error quotes this UDP tuple.
func matchUDPICMPError(remoteErr probeICMPError, source, target netip.Addr, sourcePort, targetPort uint16) bool {
	if !remoteErr.Matches(source, target, udpProtocol) || len(remoteErr.QuotedPayload) < 4 {
		return false
	}
	return binary.BigEndian.Uint16(remoteErr.QuotedPayload[0:2]) == sourcePort && binary.BigEndian.Uint16(remoteErr.QuotedPayload[2:4]) == targetPort
}

// udpProbeConn adapts one connected raw UDP tuple to net.Conn for the standard
// library DNS resolver.
type udpProbeConn struct {
	ctx        context.Context
	runtime    *probeRuntime
	link       *iplink.Link
	source     netip.Addr
	target     netip.Addr
	sourcePort uint16
	targetPort uint16

	mu            sync.Mutex
	readDeadline  time.Time
	writeDeadline time.Time
	closed        bool
	closeOnce     sync.Once
	closedCh      chan struct{}
	readChangedCh chan struct{}
}

// newUDPProbeConn creates a connected UDP adapter through link.
func newUDPProbeConn(ctx context.Context, runtime *probeRuntime, link *iplink.Link, target netip.AddrPort) (*udpProbeConn, error) {
	source, err := link.SourceFor(target.Addr())
	if err != nil {
		return nil, err
	}
	sourcePort, err := randomEphemeralPort()
	if err != nil {
		return nil, err
	}
	return &udpProbeConn{
		ctx: ctx, runtime: runtime, link: link, source: source, target: target.Addr(),
		sourcePort: sourcePort, targetPort: target.Port(), closedCh: make(chan struct{}), readChangedCh: make(chan struct{}),
	}, nil
}

// Read waits for one matching UDP response datagram.
func (c *udpProbeConn) Read(buffer []byte) (int, error) {
	deadline, closed, changed := c.readState()
	if closed {
		return 0, net.ErrClosed
	}
	timer, timeout := deadlineTimer(deadline)
	defer func() {
		if timer != nil {
			timer.Stop()
		}
	}()
	for {
		select {
		case packet := <-c.runtime.packets:
			payload, ok := parseUDPReply(packet, c.source, c.target, c.sourcePort, c.targetPort)
			if ok {
				return copy(buffer, payload), nil
			}
			if remoteErr, isError := parseProbeICMPError(packet); isError && matchUDPICMPError(remoteErr, c.source, c.target, c.sourcePort, c.targetPort) {
				return 0, remoteErr
			}
		case err := <-c.runtime.linkErrs:
			return 0, err
		case <-timeout:
			return 0, probeTimeoutError{}
		case <-c.ctx.Done():
			return 0, c.ctx.Err()
		case <-c.closedCh:
			return 0, net.ErrClosed
		case <-changed:
			if timer != nil {
				if !timer.Stop() {
					select {
					case <-timer.C:
					default:
					}
				}
			}
			deadline, closed, changed = c.readState()
			if closed {
				return 0, net.ErrClosed
			}
			timer, timeout = deadlineTimer(deadline)
		}
	}
}

// Write sends one UDP datagram to the connected destination.
func (c *udpProbeConn) Write(payload []byte) (int, error) {
	deadline, closed := c.writeState()
	if closed {
		return 0, net.ErrClosed
	}
	if !deadline.IsZero() && time.Now().After(deadline) {
		return 0, probeTimeoutError{}
	}
	packet := udpPacket(c.source, c.target, c.sourcePort, c.targetPort, payload)
	if len(packet) == 0 {
		return 0, errors.New("invalid UDP DNS packet")
	}
	if err := c.link.WritePacket(packet); err != nil {
		return 0, err
	}
	return len(payload), nil
}

// ReadFrom implements net.PacketConn so net.Resolver uses UDP DNS framing.
func (c *udpProbeConn) ReadFrom(buffer []byte) (int, net.Addr, error) {
	n, err := c.Read(buffer)
	return n, c.RemoteAddr(), err
}

// WriteTo implements net.PacketConn for the connected DNS server. The supplied
// address must match the connection's fixed remote endpoint when present.
func (c *udpProbeConn) WriteTo(payload []byte, address net.Addr) (int, error) {
	if address != nil && address.String() != c.RemoteAddr().String() {
		return 0, errors.New("UDP probe connection cannot change remote address")
	}
	return c.Write(payload)
}

// Close marks the lightweight connected adapter closed.
func (c *udpProbeConn) Close() error {
	c.closeOnce.Do(func() {
		c.mu.Lock()
		c.closed = true
		c.mu.Unlock()
		close(c.closedCh)
	})
	return nil
}

// LocalAddr returns the managed source endpoint.
func (c *udpProbeConn) LocalAddr() net.Addr {
	return net.UDPAddrFromAddrPort(netip.AddrPortFrom(c.source, c.sourcePort))
}

// RemoteAddr returns the managed DNS server endpoint.
func (c *udpProbeConn) RemoteAddr() net.Addr {
	return net.UDPAddrFromAddrPort(netip.AddrPortFrom(c.target, c.targetPort))
}

// SetDeadline sets both read and write deadlines.
func (c *udpProbeConn) SetDeadline(deadline time.Time) error {
	c.mu.Lock()
	if c.closed {
		c.mu.Unlock()
		return net.ErrClosed
	}
	changed := c.readChangedCh
	c.readDeadline, c.writeDeadline = deadline, deadline
	c.readChangedCh = make(chan struct{})
	c.mu.Unlock()
	close(changed)
	return nil
}

// SetReadDeadline sets the next Read deadline.
func (c *udpProbeConn) SetReadDeadline(deadline time.Time) error {
	c.mu.Lock()
	if c.closed {
		c.mu.Unlock()
		return net.ErrClosed
	}
	changed := c.readChangedCh
	c.readDeadline = deadline
	c.readChangedCh = make(chan struct{})
	c.mu.Unlock()
	close(changed)
	return nil
}

// SetWriteDeadline sets the next Write deadline.
func (c *udpProbeConn) SetWriteDeadline(deadline time.Time) error {
	c.mu.Lock()
	if c.closed {
		c.mu.Unlock()
		return net.ErrClosed
	}
	c.writeDeadline = deadline
	c.mu.Unlock()
	return nil
}

// readState returns the current read deadline, closed state, and notification
// channel for subsequent deadline changes.
func (c *udpProbeConn) readState() (time.Time, bool, <-chan struct{}) {
	c.mu.Lock()
	defer c.mu.Unlock()
	return c.readDeadline, c.closed, c.readChangedCh

}

// writeState returns the current write deadline and closed state.
func (c *udpProbeConn) writeState() (time.Time, bool) {
	c.mu.Lock()
	defer c.mu.Unlock()
	return c.writeDeadline, c.closed
}

// deadlineTimer converts a net.Conn deadline into a selectable timer channel.
func deadlineTimer(deadline time.Time) (*time.Timer, <-chan time.Time) {
	if deadline.IsZero() {
		return nil, nil
	}
	delay := time.Until(deadline)
	if delay < 0 {
		delay = 0
	}
	timer := time.NewTimer(delay)
	return timer, timer.C
}

// probeTimeoutError implements the timeout form expected by net package users.
type probeTimeoutError struct{}

// Error returns the timeout message.
func (probeTimeoutError) Error() string { return "ZeroTier probe timed out" }

// Timeout reports that the operation reached a deadline.
func (probeTimeoutError) Timeout() bool { return true }

// Temporary reports that retrying the operation may succeed.
func (probeTimeoutError) Temporary() bool { return true }
