package main

import (
	"context"
	"crypto/rand"
	"encoding/binary"
	"encoding/json"
	"errors"
	"flag"
	"fmt"
	"io"
	"io/fs"
	"net/netip"
	"os"
	"path/filepath"
	"strings"
	"sync"
	"time"

	zerotier "github.com/metacubex/zerotier-go"
	"github.com/metacubex/zerotier-go/iplink"
	zttransport "github.com/metacubex/zerotier-go/transport"
)

const (
	// exitOK reports successful command completion.
	exitOK = iota
	// exitError reports an operational or internal error.
	exitError
	// exitUsage reports invalid command-line arguments.
	exitUsage
	// exitNotReady reports that the joined network did not become ready.
	exitNotReady
	// exitAuthentication reports that the network requires external
	// authentication.
	exitAuthentication
	// exitProbeFailed reports that the requested network probe failed.
	exitProbeFailed
	// networkRefreshRetryInterval bounds active configuration retries while a
	// diagnostic waits for a fresh controller response.
	networkRefreshRetryInterval = 5 * time.Second
	// probeEphemeralPortFirst is the first IANA dynamic client port.
	probeEphemeralPortFirst = 49152
	// probeEphemeralPortCount is the size of the IANA dynamic port range.
	probeEphemeralPortCount = 1 << 14
)

func main() {
	os.Exit(run(os.Args[1:], os.Stdout, os.Stderr))
}

// run dispatches one ztprobe subcommand and maps errors to exit codes.
func run(args []string, stdout, stderr io.Writer) int {
	if len(args) == 0 {
		printUsage(stderr)
		return exitUsage
	}
	var err error
	var code int
	switch args[0] {
	case "config":
		code, err = runConfig(args[1:], stdout, stderr)
	case "node":
		code, err = runNode(args[1:], stdout, stderr)
	case "join":
		code, err = runJoin(args[1:], stdout, stderr)
	case "ping":
		code, err = runPing(args[1:], stdout, stderr)
	case "tcp":
		code, err = runTCP(args[1:], stdout, stderr)
	case "http":
		code, err = runHTTP(args[1:], stdout, stderr)
	case "udp":
		code, err = runUDP(args[1:], stdout, stderr)
	case "dns":
		code, err = runDNS(args[1:], stdout, stderr)
	case "mtu":
		code, err = runMTU(args[1:], stdout, stderr)
	case "fallback":
		code, err = runFallback(args[1:], stdout, stderr)
	case "watch":
		code, err = runWatch(args[1:], stdout, stderr)
	case "restart":
		code, err = runRestart(args[1:], stdout, stderr)
	case "help", "-h", "--help":
		printUsage(stdout)
		return exitOK
	default:
		printUsage(stderr)
		return exitUsage
	}
	if err != nil {
		fmt.Fprintln(stderr, err)
	}
	return code
}

// printUsage writes the supported ztprobe command forms.
func printUsage(w io.Writer) {
	fmt.Fprintln(w, "usage: ztprobe <config|node|join|ping|tcp|http|udp|dns|mtu|fallback|watch|restart> [options]")
	fmt.Fprintln(w, "  config <file>              parse a cached network configuration")
	fmt.Fprintln(w, "  node [options]             verify planet/root UDP connectivity")
	fmt.Fprintln(w, "  join -network ID [options] verify controller configuration")
	fmt.Fprintln(w, "  ping -network ID -target IP [options] probe the real iplink path")
	fmt.Fprintln(w, "  tcp -network ID -target IP -port PORT [options] probe a TCP port through iplink")
	fmt.Fprintln(w, "  http -network ID -url URL [options] perform a real HTTP/1.1 request through iplink")
	fmt.Fprintln(w, "  udp -network ID -target IP -port PORT [options] exchange one UDP datagram through iplink")
	fmt.Fprintln(w, "  dns -network ID -name NAME [options] resolve a name through managed DNS")
	fmt.Fprintln(w, "  mtu -network ID -target IP [options] probe overlay fragmentation and MTU")
	fmt.Fprintln(w, "  fallback [options]          verify root connectivity through forced TCP fallback")
	fmt.Fprintln(w, "  watch -network ID [options] monitor lifecycle, configuration, and path recovery")
	fmt.Fprintln(w, "  restart -network ID [options] verify repeated state-backed node restarts")
}

// runConfig parses and summarizes a serialized network configuration.
func runConfig(args []string, stdout, stderr io.Writer) (int, error) {
	flags := flag.NewFlagSet("config", flag.ContinueOnError)
	flags.SetOutput(stderr)
	jsonOutput := flags.Bool("json", false, "emit JSON")
	if err := flags.Parse(args); err != nil {
		return exitUsage, err
	}
	if flags.NArg() != 1 {
		return exitUsage, errors.New("config requires exactly one file")
	}
	data, err := os.ReadFile(flags.Arg(0))
	if err != nil {
		return exitError, err
	}
	config, err := zerotier.ParseNetworkConfig(data)
	if err != nil {
		return exitError, err
	}
	printNetworkConfig(stdout, config, *jsonOutput)
	return exitOK, nil
}

// stringList accumulates values from a repeatable command-line flag.
type stringList []string

// String formats accumulated flag values as a comma-separated list.
func (l *stringList) String() string { return strings.Join(*l, ",") }

// Set appends one repeated string flag value.
func (l *stringList) Set(value string) error {
	*l = append(*l, value)
	return nil
}

// onlineOptions contains physical runtime flags shared by online commands.
type onlineOptions struct {
	stateDir string
	timeout  time.Duration
	planet   string
	orbits   stringList
	json     bool
	mode     physicalProbeMode
	relay    string
}

// physicalProbeMode selects the transport path exercised by a command.
type physicalProbeMode uint8

const (
	// physicalProbeDirectUDP requires the shared UDP transport used for direct
	// path and hole-punch diagnostics.
	physicalProbeDirectUDP physicalProbeMode = iota
	// physicalProbeTCPFallback disables UDP and requires the TCP relay.
	physicalProbeTCPFallback
)

// addOnlineFlags registers physical transport and state flags shared by online
// commands.
func addOnlineFlags(flags *flag.FlagSet, options *onlineOptions) {
	flags.StringVar(&options.stateDir, "state", filepath.Join(os.TempDir(), "zerotier-go-probe"), "persistent state directory")
	flags.DurationVar(&options.timeout, "timeout", 30*time.Second, "operation timeout")
	flags.StringVar(&options.planet, "planet", "", "private planet file")
	flags.Var(&options.orbits, "orbit", "moon world,seed pair; repeatable")
	flags.BoolVar(&options.json, "json", false, "emit JSON")
}

// runNode starts a node and reports its current identity and peer status.
func runNode(args []string, stdout, stderr io.Writer) (int, error) {
	flags := flag.NewFlagSet("node", flag.ContinueOnError)
	flags.SetOutput(stderr)
	var options onlineOptions
	addOnlineFlags(flags, &options)
	if err := flags.Parse(args); err != nil {
		return exitUsage, err
	}
	if flags.NArg() != 0 || options.timeout <= 0 {
		return exitUsage, errors.New("node accepts no positional arguments and requires a positive timeout")
	}
	runtime, err := newProbeRuntime(options, stderr)
	if err != nil {
		return exitError, err
	}
	defer runtime.Close()
	if err = runtime.Start(); err != nil {
		return exitError, err
	}
	ctx, cancel := context.WithTimeout(context.Background(), options.timeout)
	defer cancel()
	if err = runtime.waitOnline(ctx); err != nil {
		return exitNotReady, err
	}
	printNodeStatus(stdout, runtime, options.json)
	return exitOK, nil
}

// runJoin starts a node, joins a network, and waits for usable configuration.
func runJoin(args []string, stdout, stderr io.Writer) (int, error) {
	flags := flag.NewFlagSet("join", flag.ContinueOnError)
	flags.SetOutput(stderr)
	var options onlineOptions
	addOnlineFlags(flags, &options)
	networkText := flags.String("network", "", "16-digit network ID")
	if err := flags.Parse(args); err != nil {
		return exitUsage, err
	}
	networkID, err := parseNetworkOption(*networkText, flags.NArg(), options.timeout)
	if err != nil {
		return exitUsage, err
	}
	runtime, err := newProbeRuntime(options, stderr)
	if err != nil {
		return exitError, err
	}
	defer runtime.Close()
	if err = runtime.Start(); err != nil {
		return exitError, err
	}
	if err = runtime.node.Join(networkID); err != nil {
		return exitError, err
	}
	ctx, cancel := context.WithTimeout(context.Background(), options.timeout)
	defer cancel()
	network, err := runtime.waitNetwork(ctx, networkID)
	if err != nil {
		if network.Status == zerotier.NetworkStatusAuthenticationRequired {
			printNetworkStatus(stdout, network, options.json)
			return exitAuthentication, err
		}
		return exitNotReady, err
	}
	if options.json {
		_ = json.NewEncoder(stdout).Encode(map[string]interface{}{"network": fmt.Sprintf("%016x", network.ID), "status": network.Status, "last_config_receive": network.LastConfigReceive, "authentication": network.Authentication, "config": summarizeNetworkConfig(network.Config), "peers": runtime.node.Peers()})
	} else {
		printNetworkStatus(stdout, network, false)
		printPeers(stdout, runtime.node.Peers(), false)
	}
	return exitOK, nil
}

// parseNetworkOption resolves the network ID supplied by flag or position.
func parseNetworkOption(value string, positional int, timeout time.Duration) (uint64, error) {
	if positional != 0 || value == "" || timeout <= 0 {
		return 0, errors.New("a 16-digit -network, no positional arguments, and a positive timeout are required")
	}
	return zerotier.ParseNetworkID(value)
}

// networkProbe owns a ready L3 probe runtime, its configured link, and the
// operation deadline shared by one diagnostic command.
type networkProbe struct {
	runtime *probeRuntime
	network zerotier.Network
}

// startNetworkRuntime creates the shared runtime and L3 link, starts physical
// I/O, and joins networkID without waiting for controller configuration.
func startNetworkRuntime(options onlineOptions, networkID uint64, stderr io.Writer) (*networkProbe, error) {
	runtime, err := newProbeRuntime(options, stderr)
	if err != nil {
		return nil, err
	}
	success := false
	defer func() {
		if !success {
			runtime.Close()
		}
	}()
	link, err := iplink.New(networkID, runtime.node)
	if err != nil {
		return nil, err
	}
	runtime.SetLink(link)
	if err = runtime.Start(); err != nil {
		return nil, err
	}
	if err = runtime.node.Join(networkID); err != nil {
		return nil, err
	}
	success = true
	return &networkProbe{runtime: runtime}, nil
}

// startNetworkProbe starts a node, joins networkID, applies its configuration,
// and validates that target is reachable through the resulting L3 routes.
func startNetworkProbe(ctx context.Context, options onlineOptions, networkID uint64, target netip.Addr, stdout, stderr io.Writer) (*networkProbe, int, error) {
	probe, err := startNetworkRuntime(options, networkID, stderr)
	if err != nil {
		return nil, exitError, err
	}
	success := false
	defer func() {
		if !success {
			probe.Close()
		}
	}()
	code, err := probe.waitReady(ctx, networkID, target, stdout, options.json)
	if err != nil {
		return nil, code, err
	}
	success = true
	return probe, exitOK, nil
}

// waitReady waits for fresh controller configuration, applies it to iplink,
// and optionally validates one destination.
func (p *networkProbe) waitReady(ctx context.Context, networkID uint64, target netip.Addr, stdout io.Writer, jsonOutput bool) (int, error) {
	network, err := p.runtime.waitNetwork(ctx, networkID)
	if err != nil {
		if network.Status == zerotier.NetworkStatusAuthenticationRequired {
			printNetworkStatus(stdout, network, jsonOutput)
			return exitAuthentication, err
		}
		return exitNotReady, err
	}
	p.runtime.linkMu.RLock()
	link := p.runtime.link
	p.runtime.linkMu.RUnlock()
	if link == nil {
		return exitError, errors.New("ZeroTier IP link is unavailable")
	}
	if err = link.ApplyNetworkConfig(network.Config); err != nil {
		return exitError, err
	}
	if target.IsValid() {
		if err = link.ValidateDestination(target); err != nil {
			return exitProbeFailed, err
		}
	}
	p.network = network
	return exitOK, nil
}

// Close closes the diagnostic runtime.
func (p *networkProbe) Close() {
	p.runtime.Close()
}

// pathDiagnostic describes how a requested peer is currently reached.
type pathDiagnostic struct {
	Address  string               `json:"address,omitempty"`
	Mode     string               `json:"mode"`
	Peer     *zerotier.PeerStatus `json:"peer,omitempty"`
	Surfaces []netip.AddrPort     `json:"surfaces,omitempty"`
}

// diagnosePath resolves an explicit or managed-IPv6 peer and snapshots its
// physical path. When requireDirect is set it waits for an active direct path.
func diagnosePath(ctx context.Context, node *zerotier.Node, config zerotier.NetworkConfigData, target netip.Addr, peerText string, requireDirect bool) (pathDiagnostic, error) {
	result := pathDiagnostic{Mode: "unknown", Surfaces: node.SurfaceAddresses()}
	var address zerotier.Address
	var err error
	if peerText != "" {
		address, err = zerotier.ParseAddress(peerText)
		if err != nil {
			return result, err
		}
	} else if target.Is6() {
		if address, _ = zerotier.AddressFromRFC4193(config.NetworkID, target); address.IsZero() {
			address, _ = zerotier.AddressFromSixPlane(config.NetworkID, target)
		}
	}
	if address.IsZero() {
		if requireDirect {
			return result, errors.New("-require-direct needs -peer for a target that does not encode a ZeroTier address")
		}
		return result, nil
	}
	result.Address = address.String()
	ticker := time.NewTicker(50 * time.Millisecond)
	defer ticker.Stop()
	for {
		for _, peer := range node.Peers() {
			if peer.Address != address {
				continue
			}
			candidate := peer
			result.Peer = &candidate
			for _, path := range peer.Paths {
				if path.Active {
					result.Mode = "direct"
					return result, nil
				}
			}
			result.Mode = "relay"
			if !requireDirect {
				return result, nil
			}
		}
		if !requireDirect {
			return result, nil
		}
		select {
		case <-ticker.C:
			result.Surfaces = node.SurfaceAddresses()
		case <-ctx.Done():
			return result, fmt.Errorf("peer %s did not establish a direct path: %w", address, ctx.Err())
		}
	}
}

// printPathDiagnostic writes a peer path snapshot after an L3 probe.
func printPathDiagnostic(w io.Writer, diagnostic pathDiagnostic) {
	if diagnostic.Address == "" {
		return
	}
	fmt.Fprintf(w, "peer=%s mode=%s surfaces=%v\n", diagnostic.Address, diagnostic.Mode, diagnostic.Surfaces)
	if diagnostic.Peer != nil {
		printPeerPaths(w, diagnostic.Peer.Paths)
	}
}

// probeRuntime owns the state, transport, node, and L3 link used by a command.
type probeRuntime struct {
	options  onlineOptions
	node     *zerotier.Node
	wire     *zttransport.Transport
	ctx      context.Context
	cancel   context.CancelFunc
	linkMu   sync.RWMutex
	link     *iplink.Link
	packets  chan []byte
	linkErrs chan error
	events   chan zerotier.Event
}

// newProbeRuntime constructs and starts the state, transport, node, and IP link
// used by online commands.
func newProbeRuntime(options onlineOptions, stderr io.Writer) (*probeRuntime, error) {
	if err := os.MkdirAll(options.stateDir, 0700); err != nil {
		return nil, err
	}
	store, err := zerotier.NewFileStore(directoryFS{directory: options.stateDir, stderr: stderr})
	if err != nil {
		return nil, err
	}
	var planet *zerotier.World
	if options.planet != "" {
		data, readErr := os.ReadFile(options.planet)
		if readErr != nil {
			return nil, readErr
		}
		world, parseErr := zerotier.ParsePlanet(data)
		if parseErr != nil {
			return nil, parseErr
		}
		planet = &world
	}
	transportConfig := zttransport.Config{
		Dialer:           zttransport.NetDialer{},
		SharedUDP:        true,
		RequireSharedUDP: true,
		PrimaryPort:      0,
		SecondaryPort:    -1,
		TCPFallbackMode:  zttransport.TCPFallbackDisabled,
		TCPFallbackRelay: options.relay,
		Log: func(_ zttransport.LogLevel, format string, arguments ...interface{}) {
			if stderr != nil {
				fmt.Fprintf(stderr, "transport: "+format+"\n", arguments...)
			}
		},
	}
	if options.mode == physicalProbeTCPFallback {
		transportConfig.SharedUDP = false
		transportConfig.RequireSharedUDP = false
		transportConfig.TCPFallbackMode = zttransport.TCPFallbackForce
	}
	wireTransport, err := zttransport.New(transportConfig)
	if err != nil {
		return nil, err
	}
	ctx, cancel := context.WithCancel(context.Background())
	runtime := &probeRuntime{
		options: options, wire: wireTransport, ctx: ctx, cancel: cancel,
		packets: make(chan []byte, 256), linkErrs: make(chan error, 8), events: make(chan zerotier.Event, 256),
	}
	node, err := zerotier.NewNode(zerotier.NodeConfig{
		Store: store, Sender: wireTransport, Planet: planet, DirectPaths: wireTransport.DirectPaths,
		OnFrame: runtime.handleFrame,
		OnEvent: runtime.handleEvent,
		OnNetworkConfig: func(config zerotier.NetworkConfigData) {
			runtime.linkMu.RLock()
			link := runtime.link
			runtime.linkMu.RUnlock()
			if link != nil {
				if applyErr := link.ApplyNetworkConfig(config); applyErr != nil {
					select {
					case runtime.linkErrs <- applyErr:
					default:
					}
				}
			}
		},
	})
	if err != nil {
		cancel()
		_ = wireTransport.Close()
		return nil, err
	}
	runtime.node = node
	for _, orbit := range options.orbits {
		worldText, seedText, ok := strings.Cut(orbit, ",")
		if !ok || strings.Contains(seedText, ",") {
			runtime.Close()
			return nil, errors.New("orbit must be world,seed")
		}
		world, seed, parseErr := zerotier.ParseOrbit(worldText, seedText)
		if parseErr != nil {
			runtime.Close()
			return nil, parseErr
		}
		if parseErr = node.Orbit(world, seed); parseErr != nil {
			runtime.Close()
			return nil, parseErr
		}
	}
	return runtime, nil
}

// SetLink attaches the L3 link used to deliver frames from the node callback.
func (p *probeRuntime) SetLink(link *iplink.Link) {
	p.linkMu.Lock()
	p.link = link
	p.linkMu.Unlock()
}

// Start starts the physical transport and background protocol tasks.
func (p *probeRuntime) Start() error {
	if err := p.wire.Start(p.ctx, p.node); err != nil {
		return err
	}
	v4, _ := p.listeningAddresses()
	if p.options.mode == physicalProbeDirectUDP && !v4.IsValid() {
		return errors.New("IPv4 UDP is unavailable")
	}
	go p.node.RunBackgroundTasks(p.ctx)
	p.linkMu.RLock()
	link := p.link
	p.linkMu.RUnlock()
	if link != nil {
		go link.RunBackgroundTasks(p.ctx)
	}
	return nil
}

// handleEvent queues one node lifecycle event for diagnostic commands.
func (p *probeRuntime) handleEvent(event zerotier.Event) {
	select {
	case p.events <- event:
	default:
		select {
		case p.linkErrs <- errors.New("ZeroTier diagnostic event queue overflow"):
		default:
		}
	}
}

// handleFrame converts an inbound virtual frame to an IP packet for probes.
func (p *probeRuntime) handleFrame(frame zerotier.Frame) {
	p.linkMu.RLock()
	link := p.link
	p.linkMu.RUnlock()
	if link == nil {
		return
	}
	packet, err := link.HandleFrame(frame)
	if err != nil {
		select {
		case p.linkErrs <- err:
		default:
		}
		return
	}
	if packet != nil {
		select {
		case p.packets <- append([]byte(nil), packet...):
		default:
		}
	}
}

// listeningAddresses returns the bound primary IPv4 and IPv6 endpoints.
func (p *probeRuntime) listeningAddresses() (v4, v6 netip.AddrPort) {
	for _, address := range p.wire.LocalAddresses() {
		if address.Addr().Is4() {
			v4 = address
		} else if address.Addr().Is6() {
			v6 = address
		}
	}
	return
}

// waitOnline waits for root connectivity or context cancellation.
func (p *probeRuntime) waitOnline(ctx context.Context) error {
	ticker := time.NewTicker(100 * time.Millisecond)
	defer ticker.Stop()
	for {
		if p.node.Online() {
			return nil
		}
		select {
		case <-ticker.C:
		case <-ctx.Done():
			return fmt.Errorf("node %s did not become online: %w", p.node.Address(), ctx.Err())
		}
	}
}

// waitNetwork waits for ready, denied, missing, or authentication-required
// network state.
func (p *probeRuntime) waitNetwork(ctx context.Context, networkID uint64) (zerotier.Network, error) {
	ticker := time.NewTicker(100 * time.Millisecond)
	defer ticker.Stop()
	refresh := time.NewTicker(networkRefreshRetryInterval)
	defer refresh.Stop()
	for {
		network, ok := p.node.Network(networkID)
		if ok {
			switch network.Status {
			case zerotier.NetworkStatusOK:
				if !network.LastConfigReceive.IsZero() {
					return network, nil
				}
			case zerotier.NetworkStatusAuthenticationRequired:
				loginURL, loginErr := network.Authentication.LoginURL()
				if loginErr != nil {
					return network, fmt.Errorf("network authentication required: %w", loginErr)
				}
				return network, fmt.Errorf("network authentication required: %s", loginURL)
			case zerotier.NetworkStatusAccessDenied:
				return network, errors.New("network access denied")
			case zerotier.NetworkStatusNotFound:
				return network, errors.New("network not found")
			}
		}
		select {
		case err := <-p.linkErrs:
			return network, err
		case <-ticker.C:
		case <-refresh.C:
			_ = p.node.RefreshNetwork(networkID)
		case <-ctx.Done():
			return network, fmt.Errorf("network %016x did not become ready: %w", networkID, ctx.Err())
		}
	}
}

// checksum computes the Internet checksum used by ICMPv4.
func checksum(data []byte) uint16 {
	var sum uint32
	for len(data) >= 2 {
		sum += uint32(binary.BigEndian.Uint16(data))
		data = data[2:]
	}
	if len(data) != 0 {
		sum += uint32(data[0]) << 8
	}
	for sum>>16 != 0 {
		sum = sum&0xffff + sum>>16
	}
	return ^uint16(sum)
}

// transportChecksum computes an IPv4 or IPv6 upper-layer checksum with its IP
// pseudo-header.
func transportChecksum(source, target netip.Addr, protocol byte, payload []byte) uint16 {
	source, target = source.Unmap(), target.Unmap()
	if source.Is4() && target.Is4() {
		pseudo := make([]byte, 12+len(payload))
		copy(pseudo[0:4], source.AsSlice())
		copy(pseudo[4:8], target.AsSlice())
		pseudo[9] = protocol
		binary.BigEndian.PutUint16(pseudo[10:12], uint16(len(payload)))
		copy(pseudo[12:], payload)
		return checksum(pseudo)
	}
	if source.Is6() && target.Is6() {
		pseudo := make([]byte, 40+len(payload))
		copy(pseudo[0:16], source.AsSlice())
		copy(pseudo[16:32], target.AsSlice())
		binary.BigEndian.PutUint32(pseudo[32:36], uint32(len(payload)))
		pseudo[39] = protocol
		copy(pseudo[40:], payload)
		return checksum(pseudo)
	}
	return 0
}

// randomEphemeralPort returns a source port from the IANA dynamic range.
func randomEphemeralPort() (uint16, error) {
	var raw [2]byte
	if _, err := io.ReadFull(rand.Reader, raw[:]); err != nil {
		return 0, err
	}
	return uint16(probeEphemeralPortFirst + int(binary.BigEndian.Uint16(raw[:]))%probeEphemeralPortCount), nil
}

// ipProtocolPayload validates an IPv4 or IPv6 packet and returns the requested
// upper-layer payload, including support for common IPv6 extension headers.
func ipProtocolPayload(packet []byte, protocol byte) (netip.Addr, netip.Addr, []byte, bool) {
	if len(packet) < 1 {
		return netip.Addr{}, netip.Addr{}, nil, false
	}
	switch packet[0] >> 4 {
	case 4:
		if len(packet) < 20 || packet[9] != protocol {
			return netip.Addr{}, netip.Addr{}, nil, false
		}
		headerSize := int(packet[0]&0x0f) * 4
		totalSize := int(binary.BigEndian.Uint16(packet[2:4]))
		if headerSize < 20 || totalSize < headerSize || totalSize > len(packet) ||
			binary.BigEndian.Uint16(packet[6:8])&0x3fff != 0 || checksum(packet[:headerSize]) != 0 {
			return netip.Addr{}, netip.Addr{}, nil, false
		}
		source := netip.AddrFrom4([4]byte(packet[12:16]))
		target := netip.AddrFrom4([4]byte(packet[16:20]))
		return source, target, packet[headerSize:totalSize], true
	case 6:
		if len(packet) < 40 {
			return netip.Addr{}, netip.Addr{}, nil, false
		}
		end := 40 + int(binary.BigEndian.Uint16(packet[4:6]))
		if end > len(packet) {
			return netip.Addr{}, netip.Addr{}, nil, false
		}
		source := netip.AddrFrom16([16]byte(packet[8:24]))
		target := netip.AddrFrom16([16]byte(packet[24:40]))
		next, offset := packet[6], 40
		for offset <= end {
			if next == protocol {
				return source, target, packet[offset:end], true
			}
			switch next {
			case 0, 43, 60, 135:
				if end-offset < 8 {
					return netip.Addr{}, netip.Addr{}, nil, false
				}
				nextHeader := packet[offset]
				length := (int(packet[offset+1]) + 1) * 8
				if length > end-offset {
					return netip.Addr{}, netip.Addr{}, nil, false
				}
				next, offset = nextHeader, offset+length
			case 44:
				if end-offset < 8 || binary.BigEndian.Uint16(packet[offset+2:offset+4]) != 0 {
					return netip.Addr{}, netip.Addr{}, nil, false
				}
				next, offset = packet[offset], offset+8
			case 51:
				if end-offset < 8 {
					return netip.Addr{}, netip.Addr{}, nil, false
				}
				nextHeader := packet[offset]
				length := (int(packet[offset+1]) + 2) * 4
				if length > end-offset {
					return netip.Addr{}, netip.Addr{}, nil, false
				}
				next, offset = nextHeader, offset+length
			default:
				return netip.Addr{}, netip.Addr{}, nil, false
			}
		}
	}
	return netip.Addr{}, netip.Addr{}, nil, false
}

// printNodeStatus writes a node status in human-readable or JSON form.
func printNodeStatus(w io.Writer, runtime *probeRuntime, jsonOutput bool) {
	v4, v6 := runtime.listeningAddresses()
	status := map[string]interface{}{
		"node": runtime.node.Address().String(), "online": runtime.node.Online(), "udp4": v4.String(),
		"surfaces": runtime.node.SurfaceAddresses(), "peers": runtime.node.Peers(),
	}
	if v6.IsValid() {
		status["udp6"] = v6.String()
	}
	if jsonOutput {
		_ = json.NewEncoder(w).Encode(status)
		return
	}
	fmt.Fprintf(w, "node=%s online=%t udp4=%s", runtime.node.Address(), runtime.node.Online(), v4)
	if v6.IsValid() {
		fmt.Fprintf(w, " udp6=%s", v6)
	}
	fmt.Fprintf(w, " surfaces=%v\n", runtime.node.SurfaceAddresses())
	printPeers(w, runtime.node.Peers(), false)
}

// printNetworkConfig writes a network configuration in human-readable or JSON
// form.
func printNetworkConfig(w io.Writer, config zerotier.NetworkConfigData, jsonOutput bool) {
	if jsonOutput {
		_ = json.NewEncoder(w).Encode(summarizeNetworkConfig(config))
		return
	}
	fmt.Fprintf(w, "network=%016x name=%q mtu=%d multicast=%d assigned=%v routes=%v dns-domain=%q dns=%v rules=%d capabilities=%d\n",
		config.NetworkID, config.Name, config.MTU, config.MulticastLimit, config.Assigned, config.Routes, config.DNSDomain, config.DNSServers, len(config.Rules), len(config.Capabilities))
}

// printNetworkStatus writes network state in human-readable or JSON form.
func printNetworkStatus(w io.Writer, network zerotier.Network, jsonOutput bool) {
	if jsonOutput {
		_ = json.NewEncoder(w).Encode(map[string]interface{}{"network": fmt.Sprintf("%016x", network.ID), "status": network.Status, "last_config_receive": network.LastConfigReceive, "authentication": network.Authentication, "config": summarizeNetworkConfig(network.Config)})
		return
	}
	loginURL, _ := network.Authentication.LoginURL()
	fmt.Fprintf(w, "network=%016x status=%d config-received=%s auth-url=%q\n", network.ID, network.Status, network.LastConfigReceive.Format(time.RFC3339Nano), loginURL)
	printNetworkConfig(w, network.Config, false)
}

// networkConfigSummary is the stable CLI projection of network configuration.
type networkConfigSummary struct {
	Network      string                  `json:"network"`
	Name         string                  `json:"name"`
	MTU          uint32                  `json:"mtu"`
	Multicast    uint32                  `json:"multicast_limit"`
	Assigned     []netip.Prefix          `json:"assigned"`
	Routes       []zerotier.NetworkRoute `json:"routes"`
	DNS          []netip.AddrPort        `json:"dns"`
	DNSDomain    string                  `json:"dns_domain"`
	RuleCount    int                     `json:"rule_count"`
	Rules        []zerotier.NetworkRule  `json:"rules,omitempty"`
	Capabilities int                     `json:"capability_count"`
}

// summarizeNetworkConfig converts a configuration to its stable CLI view.
func summarizeNetworkConfig(config zerotier.NetworkConfigData) networkConfigSummary {
	return networkConfigSummary{
		Network: fmt.Sprintf("%016x", config.NetworkID), Name: config.Name, MTU: config.MTU, Multicast: config.MulticastLimit,
		Assigned: config.Assigned, Routes: config.Routes, DNS: config.DNSServers, DNSDomain: config.DNSDomain,
		RuleCount: len(config.Rules), Rules: config.Rules, Capabilities: len(config.Capabilities),
	}
}

// printPeers writes peer path status in human-readable or JSON form.
func printPeers(w io.Writer, peers []zerotier.PeerStatus, jsonOutput bool) {
	if jsonOutput {
		_ = json.NewEncoder(w).Encode(map[string]interface{}{"peers": peers})
		return
	}
	for _, peer := range peers {
		fmt.Fprintf(w, "peer=%s role=%s protocol=%d version=%d.%d.%d\n", peer.Address, peer.Role, peer.Protocol, peer.VersionMajor, peer.VersionMinor, peer.VersionRevision)
		printPeerPaths(w, peer.Paths)
	}
}

// printPeerPaths writes physical peer paths with explicit field names.
func printPeerPaths(w io.Writer, paths []zerotier.PeerPath) {
	for _, path := range paths {
		fmt.Fprintf(w, "  endpoint=%s socket=%d active=%t preferred=%t priority=%d last-send=%s last-receive=%s latency=%s jitter=%s loss=%.4f error=%.4f trusted=%d\n",
			path.Endpoint, path.LocalSocket, path.Active, path.Preferred, path.Priority,
			path.LastSend.Format(time.RFC3339Nano), path.LastReceive.Format(time.RFC3339Nano), path.Latency, path.Jitter, path.PacketLoss, path.PacketError, path.TrustedPathID)
	}
}

// Close stops transport and node tasks and waits for callback workers.
func (p *probeRuntime) Close() {
	if p.cancel != nil {
		p.cancel()
	}
	if p.wire != nil {
		_ = p.wire.Close()
		p.wire.Wait()
	}
	if p.node != nil {
		_ = p.node.Close()
	}
}

// directoryFS adapts one host directory to zerotier.StateFS for ztprobe.
type directoryFS struct {
	directory string
	stderr    io.Writer
}

// Open opens a state object below the configured root directory.
func (f directoryFS) Open(name string) (fs.File, error) {
	return os.Open(filepath.Join(f.directory, filepath.FromSlash(name)))
}

// WriteFile writes a state object below the configured root directory.
func (f directoryFS) WriteFile(name string, data []byte, perm fs.FileMode) error {
	path := filepath.Join(f.directory, filepath.FromSlash(name))
	if err := os.MkdirAll(filepath.Dir(path), 0700); err != nil {
		if f.stderr != nil {
			fmt.Fprintf(f.stderr, "state write %s: %v\n", name, err)
		}
		return err
	}
	err := os.WriteFile(path, data, perm)
	if err != nil && f.stderr != nil {
		fmt.Fprintf(f.stderr, "state write %s: %v\n", name, err)
	}
	return err
}

// Remove removes a state object below the configured root directory.
func (f directoryFS) Remove(name string) error {
	err := os.Remove(filepath.Join(f.directory, filepath.FromSlash(name)))
	if err != nil && !errors.Is(err, fs.ErrNotExist) && f.stderr != nil {
		fmt.Fprintf(f.stderr, "state remove %s: %v\n", name, err)
	}
	return err
}
