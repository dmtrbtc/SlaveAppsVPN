}

func TestValidateMulticastAndBroadcastPolicy(t *testing.T) {
	const networkID = uint64(0x17d709436c04d6bc)
	sender := &recordingSender{address: zerotier.NewAddress(0x0f1b56d269)}
	link, err := New(networkID, sender)
	if err != nil {
		t.Fatal(err)
	}
	if err = link.ApplyNetworkConfig(zerotier.NetworkConfigData{
		NetworkID: networkID, MulticastLimit: 1,
		Assigned: []netip.Prefix{netip.MustParsePrefix("fd00::1/64")},
	}); err != nil {
		t.Fatal(err)
	}
	if err = link.ValidateDestination(netip.MustParseAddr("ff02::1")); err != nil {
		t.Fatalf("managed IPv6 multicast was rejected: %v", err)
	}
	if err = link.ValidateDestination(netip.MustParseAddr("ff01::1234")); err == nil {
		t.Fatal("IPv6 interface-local multicast was accepted for link output")
	}
	if err = link.ValidateDestination(netip.MustParseAddr("239.1.2.3")); err == nil {
		t.Fatal("IPv4 multicast was accepted without a managed IPv4 address")
	}
	if err = link.ApplyNetworkConfig(zerotier.NetworkConfigData{
		NetworkID: networkID,
		Assigned:  []netip.Prefix{netip.MustParsePrefix("192.0.2.1/24")},
	}); err != nil {
		t.Fatal(err)
	}
	multicast := ipv4Packet(netip.MustParseAddr("192.0.2.1"), netip.MustParseAddr("239.1.2.3"), 17)
	if err = link.WritePacket(multicast); err == nil {
		t.Fatal("IPv4 multicast packet was sent while multicast was disabled")
	}
	broadcast := ipv4Packet(netip.MustParseAddr("192.0.2.1"), netip.MustParseAddr("192.0.2.255"), 17)
	if err = link.ApplyNetworkConfig(zerotier.NetworkConfigData{
		NetworkID: networkID, Flags: zerotier.NetworkConfigFlagEnableBroadcast,
		Assigned: []netip.Prefix{netip.MustParsePrefix("192.0.2.1/24")},
	}); err != nil {
		t.Fatal(err)
	}
	if err = link.ValidateDestination(netip.MustParseAddr("192.0.2.255")); err == nil {
		t.Fatal("broadcast was accepted while ZeroTier multicast was disabled")
	}
	if err = link.WritePacket(broadcast); err == nil {
		t.Fatal("broadcast packet was sent while ZeroTier multicast was disabled")
	}
	if err = link.ApplyNetworkConfig(zerotier.NetworkConfigData{
		NetworkID: networkID, MulticastLimit: 1,
		Assigned: []netip.Prefix{netip.MustParsePrefix("192.0.2.1/24")},
	}); err != nil {
		t.Fatal(err)
	}
	if err = link.ValidateDestination(netip.MustParseAddr("192.0.2.255")); err == nil {
		t.Fatal("directed broadcast was accepted while broadcast was disabled")
	}
	if err = link.WritePacket(broadcast); err == nil {
		t.Fatal("directed broadcast packet was sent while broadcast was disabled")
	}
	if err = link.ApplyNetworkConfig(zerotier.NetworkConfigData{
		NetworkID: networkID, MulticastLimit: 1, Flags: zerotier.NetworkConfigFlagEnableBroadcast,
		Assigned: []netip.Prefix{netip.MustParsePrefix("192.0.2.1/24")},
	}); err != nil {
		t.Fatal(err)
	}
	if err = link.ValidateDestination(netip.MustParseAddr("192.0.2.255")); err != nil {
		t.Fatalf("enabled directed broadcast was rejected: %v", err)
	}
	if err = link.WritePacket(broadcast); err != nil {
		t.Fatalf("enabled directed broadcast packet was rejected: %v", err)
	}
	if len(sender.frames) != 1 || !sender.frames[0].destination.IsBroadcast() {
		t.Fatalf("enabled broadcast frames = %#v", sender.frames)
	}
}

func TestMembershipSurvivesTemporaryMulticastDisable(t *testing.T) {
	const networkID = uint64(0x17d709436c04d6bc)
	sender := &recordingSender{address: zerotier.NewAddress(0x0f1b56d269)}
	link, err := New(networkID, sender)
	if err != nil {
		t.Fatal(err)
	}
	config := zerotier.NetworkConfigData{
		NetworkID: networkID,
		Assigned:  []netip.Prefix{netip.MustParsePrefix("192.0.2.10/24")},
	}
	if err = link.ApplyNetworkConfig(config); err != nil {
		t.Fatal(err)
	}
	group := netip.MustParseAddr("239.6.7.8")
	report := igmpv3ReportPacket(netip.MustParseAddr("192.0.2.10"), group, 4, nil)
	if err = link.WritePacket(report); err == nil {
		t.Fatal("membership report was transmitted while multicast was disabled")
	}
	want, _ := multicastGroupForIP(group)
	if !sender.subscriptions[want] {
		t.Fatal("disabled multicast policy discarded local membership state")
	}
	config.MulticastLimit = 32
	if err = link.ApplyNetworkConfig(config); err != nil {
		t.Fatal(err)
	}
	if !sender.subscriptions[want] {
		t.Fatal("membership was not retained when multicast became available")
	}
}

func TestInterfaceGenerationChangeDiscardsReportedMemberships(t *testing.T) {
	const networkID = uint64(0x17d709436c04d6bc)
	for _, test := range []struct {
		name   string
		update func(zerotier.NetworkConfigData) zerotier.NetworkConfigData
	}{
		{
			name: "managed addresses",
			update: func(config zerotier.NetworkConfigData) zerotier.NetworkConfigData {
				config.Assigned = []netip.Prefix{netip.MustParsePrefix("192.0.2.20/24")}
				return config
			},
		},
		{
			name: "MTU",
			update: func(config zerotier.NetworkConfigData) zerotier.NetworkConfigData {
				config.MTU = 1300
				return config
			},
		},
	} {
		t.Run(test.name, func(t *testing.T) {
			sender := &recordingSender{address: zerotier.NewAddress(0x0f1b56d269)}
			link, err := New(networkID, sender)
			if err != nil {
				t.Fatal(err)
			}
			config := zerotier.NetworkConfigData{
				NetworkID: networkID, MTU: 1400, MulticastLimit: 32,
				Assigned: []netip.Prefix{netip.MustParsePrefix("192.0.2.10/24")},
			}
			if err = link.ApplyNetworkConfig(config); err != nil {
				t.Fatal(err)
			}
			group := netip.MustParseAddr("239.10.11.12")
			report := legacyIGMPPacket(netip.MustParseAddr("192.0.2.10"), group, group, 0x16, 0, true)
			if err = link.WritePacket(report); err != nil {
				t.Fatal(err)
			}
			multicastGroup, _ := multicastGroupForIP(group)
			if !sender.subscriptions[multicastGroup] {
				t.Fatal("membership report did not subscribe the group")
			}
			if err = link.ApplyNetworkConfig(test.update(config)); err != nil {
				t.Fatal(err)
			}
			if sender.subscriptions[multicastGroup] {
				t.Fatal("new L3 interface generation retained an old reported membership")
			}
			link.mu.RLock()
			_, retained := link.reportedMemberships[group]
			link.mu.RUnlock()
			if retained {
				t.Fatal("new L3 interface generation retained old report state")
			}
		})
	}
}

func TestNetworkConfigurationRefreshRestoresNodeSubscriptions(t *testing.T) {
	const networkID = uint64(0x17d709436c04d6bc)
	sender := &recordingSender{address: zerotier.NewAddress(0x0f1b56d269)}
	link, err := New(networkID, sender)
	if err != nil {
		t.Fatal(err)
	}
	config := zerotier.NetworkConfigData{
		NetworkID: networkID, MulticastLimit: 32,
		Assigned: []netip.Prefix{netip.MustParsePrefix("192.0.2.10/24")},
	}
	if err = link.ApplyNetworkConfig(config); err != nil {
		t.Fatal(err)
	}
	dynamic := netip.MustParseAddr("239.8.9.10")
	report := legacyIGMPPacket(netip.MustParseAddr("192.0.2.10"), dynamic, dynamic, 0x16, 0, true)
	if err = link.WritePacket(report); err != nil {
		t.Fatal(err)
	}
	automaticGroup, _ := multicastGroupForIP(netip.MustParseAddr("224.0.0.1"))
	dynamicGroup, _ := multicastGroupForIP(dynamic)
	// Replacing a Node's Network object loses its subscription map while the
	// longer-lived Link still has the same desired interface state.
	sender.subscriptions = make(map[zerotier.MulticastGroup]bool)
	if err = link.ApplyNetworkConfig(config); err != nil {
		t.Fatal(err)
	}
	if !sender.subscriptions[automaticGroup] || !sender.subscriptions[dynamicGroup] {
		t.Fatalf("subscriptions after configuration refresh = %v", sender.subscriptions)
	}
}

func TestWritePacketValidatesMTUAndHeaderLength(t *testing.T) {
	const networkID = uint64(0x17d709436c04d6bc)
	link, err := New(networkID, &recordingSender{address: zerotier.NewAddress(0x0f1b56d269)})
	if err != nil {
		t.Fatal(err)
	}
	if err = link.ApplyNetworkConfig(zerotier.NetworkConfigData{
		NetworkID: networkID, MTU: zerotier.MinNetworkMTU,
		Assigned: []netip.Prefix{netip.MustParsePrefix("192.0.2.1/24")},
	}); err != nil {
		t.Fatal(err)
	}
	packet := make([]byte, zerotier.MinNetworkMTU+1)
	packet[0] = 0x45
	binary.BigEndian.PutUint16(packet[2:4], uint16(len(packet)))
	copy(packet[12:16], netip.MustParseAddr("192.0.2.1").AsSlice())
	copy(packet[16:20], netip.MustParseAddr("192.0.2.2").AsSlice())
	if err = link.WritePacket(packet); err == nil {
		t.Fatal("packet larger than the network MTU was accepted")
	}
	packet = ipv4Packet(netip.MustParseAddr("192.0.2.1"), netip.MustParseAddr("192.0.2.2"), 17)
	binary.BigEndian.PutUint16(packet[2:4], uint16(len(packet)-1))
	if err = link.WritePacket(packet); err == nil {
		t.Fatal("IPv4 packet with an inconsistent total length was accepted")
	}
	link.mu.RLock()
	pendingCount, pendingPackets, pendingBytes := len(link.neighborPending), link.pendingNeighborPackets, link.pendingNeighborBytes
	link.mu.RUnlock()
	if pendingCount != 0 || pendingPackets != 0 || pendingBytes != 0 {
		t.Fatalf("invalid packets entered neighbor queue: destinations=%d packets=%d bytes=%d", pendingCount, pendingPackets, pendingBytes)
	}
}

