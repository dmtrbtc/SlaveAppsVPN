	if err != nil {
		t.Fatal(err)
	}
	link.now = func() time.Time { return now }
	if err = link.ApplyNetworkConfig(zerotier.NetworkConfigData{
		NetworkID: networkID, MulticastLimit: 32,
		Assigned: []netip.Prefix{netip.PrefixFrom(local, 24)},
	}); err != nil {
		t.Fatal(err)
	}
	if err = link.WritePacket(legacyIGMPPacket(local, group, group, 0x16, 0, true)); err != nil {
		t.Fatal(err)
	}
	query := legacyIGMPPacket(querier, netip.MustParseAddr("224.0.0.1"), netip.IPv4Unspecified(), 0x11, 10, true)
	if _, err = link.HandleFrame(zerotier.Frame{NetworkID: networkID, EtherType: zerotier.EtherTypeIPv4, Payload: query}); err != nil {
