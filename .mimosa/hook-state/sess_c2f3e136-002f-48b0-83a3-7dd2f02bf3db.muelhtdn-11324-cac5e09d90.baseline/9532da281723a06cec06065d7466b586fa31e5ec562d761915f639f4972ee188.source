func TestOverlappingQueriesDoNotExtendMembershipDeadline(t *testing.T) {
	const networkID = uint64(0x17d709436c04d6bc)
	local := netip.MustParseAddr("192.0.2.10")
	querier := netip.MustParseAddr("192.0.2.20")
	group := netip.MustParseAddr("239.41.42.43")
	link, err := New(networkID, &recordingSender{address: zerotier.NewAddress(0x0f1b56d269)})
	if err != nil {
		t.Fatal(err)
	}
	now := time.Unix(1000, 0)
	link.now = func() time.Time { return now }
	if err = link.ApplyNetworkConfig(zerotier.NetworkConfigData{
		NetworkID: networkID, MulticastLimit: 32, Assigned: []netip.Prefix{netip.PrefixFrom(local, 24)},
	}); err != nil {
		t.Fatal(err)
	}
	report := legacyIGMPPacket(local, group, group, 0x16, 0, true)
	if err = link.WritePacket(report); err != nil {
		t.Fatal(err)
	}
	now = now.Add(time.Second)
	shortQuery := igmpV3GeneralQueryPacket(querier, 20, 3, 10, nil)
	if _, err = link.HandleFrame(zerotier.Frame{NetworkID: networkID, EtherType: zerotier.EtherTypeIPv4, Payload: shortQuery}); err != nil {
		t.Fatal(err)
	}
	want := now.Add(34 * time.Second)
	now = now.Add(time.Second)
	longQuery := legacyIGMPPacket(querier, netip.MustParseAddr("224.0.0.1"), netip.IPv4Unspecified(), 0x11, 0, false)
	if _, err = link.HandleFrame(zerotier.Frame{NetworkID: networkID, EtherType: zerotier.EtherTypeIPv4, Payload: longQuery}); err != nil {
		t.Fatal(err)
	}
	link.mu.RLock()
	deadline := link.reportedMemberships[group].queryDeadline
	link.mu.RUnlock()
	if !deadline.Equal(want) {
		t.Fatalf("overlapping Query moved deadline to %v, want %v", deadline, want)
	}
	now = now.Add(time.Second)
	if err = link.WritePacket(report); err != nil {
		t.Fatal(err)
	}
	link.mu.RLock()
	deadline = link.reportedMemberships[group].queryDeadline
	link.mu.RUnlock()
	if !deadline.IsZero() {
		t.Fatalf("local Report did not clear Query deadline %v", deadline)
	}
}

func TestGeneralQueryAtReportTimestampStartsMembershipDeadline(t *testing.T) {
	const networkID = uint64(0x17d709436c04d6bc)
	now := time.Unix(1700000000, 0)
	local := netip.MustParseAddr("192.0.2.10")
	querier := netip.MustParseAddr("192.0.2.1")
