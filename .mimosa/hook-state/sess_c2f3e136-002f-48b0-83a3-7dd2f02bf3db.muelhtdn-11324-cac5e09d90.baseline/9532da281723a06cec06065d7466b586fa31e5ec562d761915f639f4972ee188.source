package iplink

import (
	"bytes"
	"context"
	"encoding/binary"
	"errors"
	"net/netip"
	"sync"
	"testing"
	"time"

	zerotier "github.com/metacubex/zerotier-go"
)

type recordedFrame struct {
	networkID   uint64
	destination zerotier.MAC
	etherType   uint16
	payload     []byte
}

type recordingSender struct {
	address           zerotier.Address
	frames            []recordedFrame
	subscriptions     map[zerotier.MulticastGroup]bool
	subscribeErr      error
	unsubscribeErr    error
	subscribeErrors   map[zerotier.MulticastGroup]error
	unsubscribeErrors map[zerotier.MulticastGroup]error
}

type blockingSender struct {
	address zerotier.Address
	started chan struct{}
	release chan struct{}
	once    sync.Once
}

// frameOnlySender models an L3 embedding whose frame path has no optional
// ZeroTier multicast subscription support.
type frameOnlySender struct {
	address zerotier.Address
	frames  []recordedFrame
}

func (s *frameOnlySender) Address() zerotier.Address { return s.address }

func (s *frameOnlySender) SendFrame(networkID uint64, destination zerotier.MAC, etherType uint16, payload []byte) error {
	s.frames = append(s.frames, recordedFrame{
		networkID: networkID, destination: destination, etherType: etherType,
		payload: append([]byte(nil), payload...),
	})
	return nil
}

func (s *blockingSender) Address() zerotier.Address { return s.address }

func (s *blockingSender) SendFrame(uint64, zerotier.MAC, uint16, []byte) error {
	s.once.Do(func() { close(s.started) })
	<-s.release
	return nil
}

func (s *recordingSender) SubscribeMulticast(_ uint64, group zerotier.MulticastGroup) error {
	if s.subscribeErr != nil {
		return s.subscribeErr
	}
	if err := s.subscribeErrors[group]; err != nil {
		return err
	}
	if s.subscriptions == nil {
		s.subscriptions = make(map[zerotier.MulticastGroup]bool)
	}
	s.subscriptions[group] = true
	return nil
}

func (s *recordingSender) UnsubscribeMulticast(_ uint64, group zerotier.MulticastGroup) error {
	if s.unsubscribeErr != nil {
		return s.unsubscribeErr
	}
	if err := s.unsubscribeErrors[group]; err != nil {
		return err
	}
	delete(s.subscriptions, group)
	return nil
}

func (s *recordingSender) Address() zerotier.Address { return s.address }

func (s *recordingSender) SendFrame(networkID uint64, destination zerotier.MAC, etherType uint16, payload []byte) error {
	s.frames = append(s.frames, recordedFrame{
		networkID:   networkID,
		destination: destination,
		etherType:   etherType,
		payload:     append([]byte(nil), payload...),
	})
	return nil
}

func TestRouteSelection(t *testing.T) {
	const networkID = uint64(0x17d709436c04d6bc)
	link, err := New(networkID, &recordingSender{address: zerotier.NewAddress(0x0f1b56d269)})
	if err != nil {
		t.Fatal(err)
	}
	if err = link.ApplyNetworkConfig(zerotier.NetworkConfigData{
		NetworkID: networkID,
		Assigned:  []netip.Prefix{netip.MustParsePrefix("192.168.192.7/24")},
		Routes: []zerotier.NetworkRoute{
			{Target: netip.MustParsePrefix("0.0.0.0/0"), Via: netip.MustParseAddr("192.168.192.254"), Metric: 100},
			{Target: netip.MustParsePrefix("10.0.0.0/8"), Via: netip.MustParseAddr("192.168.192.1"), Metric: 10},
		},
	}); err != nil {
		t.Fatal(err)
	}
	if nextHop, ok := link.routeFor(netip.MustParseAddr("10.20.30.40")); !ok || nextHop != netip.MustParseAddr("192.168.192.1") {
		t.Fatalf("specific route next hop = %s, valid=%t", nextHop, ok)
	}
	if nextHop, ok := link.routeFor(netip.MustParseAddr("192.168.192.8")); !ok || nextHop != netip.MustParseAddr("192.168.192.8") {
		t.Fatalf("managed subnet next hop = %s, valid=%t", nextHop, ok)
	}
}

func TestSourceForUsesRouteNextHop(t *testing.T) {
	const networkID = uint64(0x17d709436c04d6bc)
	link, err := New(networkID, &recordingSender{address: zerotier.NewAddress(0x0f1b56d269)})
	if err != nil {
		t.Fatal(err)
	}
	if err = link.ApplyNetworkConfig(zerotier.NetworkConfigData{
		NetworkID: networkID,
		Assigned: []netip.Prefix{
			netip.MustParsePrefix("192.0.2.10/24"),
			netip.MustParsePrefix("198.51.100.10/24"),
		},
		Routes: []zerotier.NetworkRoute{{
			Target: netip.MustParsePrefix("203.0.113.0/24"),
			Via:    netip.MustParseAddr("198.51.100.1"),
		}},
	}); err != nil {
		t.Fatal(err)
	}
	source, err := link.SourceFor(netip.MustParseAddr("203.0.113.8"))
	if err != nil || source != netip.MustParseAddr("198.51.100.10") {
		t.Fatalf("source = %s, err = %v", source, err)
	}
}

func TestApplyNetworkConfigWaitsForActiveWrite(t *testing.T) {
	const networkID = uint64(0x17d709436c04d6bc)
	sender := &blockingSender{
		address: zerotier.NewAddress(0x0f1b56d269),
		started: make(chan struct{}),
		release: make(chan struct{}),
	}
	link, err := New(networkID, sender)
	if err != nil {
		t.Fatal(err)
	}
	if err = link.ApplyNetworkConfig(zerotier.NetworkConfigData{
		NetworkID: networkID,
		Assigned:  []netip.Prefix{netip.MustParsePrefix("192.0.2.1/24")},
	}); err != nil {
		t.Fatal(err)
	}
	writeDone := make(chan error, 1)
	go func() {
		writeDone <- link.WritePacket(ipv4Packet(netip.MustParseAddr("192.0.2.1"), netip.MustParseAddr("192.0.2.2"), 17))
	}()
	select {
	case <-sender.started:
	case <-time.After(time.Second):
		t.Fatal("packet write did not reach frame sender")
	}
	applyDone := make(chan error, 1)
	go func() {
		applyDone <- link.ApplyNetworkConfig(zerotier.NetworkConfigData{
			NetworkID: networkID,
			Assigned:  []netip.Prefix{netip.MustParsePrefix("198.51.100.1/24")},
		})
	}()
	select {
	case err = <-applyDone:
		t.Fatalf("configuration changed during an active write: %v", err)
	case <-time.After(50 * time.Millisecond):
	}
	close(sender.release)
	if err = <-writeDone; err != nil {
		t.Fatal(err)
	}
	if err = <-applyDone; err != nil {
		t.Fatal(err)
	}
	link.mu.Lock()
	pendingCount, pendingPackets, pendingBytes := len(link.neighborPending), link.pendingNeighborPackets, link.pendingNeighborBytes
	link.mu.Unlock()
	if pendingCount != 0 || pendingPackets != 0 || pendingBytes != 0 {
		t.Fatalf("old neighbor state survived configuration change: destinations=%d packets=%d bytes=%d", pendingCount, pendingPackets, pendingBytes)
	}
}

func TestManagedRouteNormalization(t *testing.T) {
	const networkID = uint64(0x17d709436c04d6bc)
	link, err := New(networkID, &recordingSender{address: zerotier.NewAddress(0x0f1b56d269)})
	if err != nil {
		t.Fatal(err)
	}
	if err = link.ApplyNetworkConfig(zerotier.NetworkConfigData{
		NetworkID: networkID,
		Assigned:  []netip.Prefix{netip.MustParsePrefix("192.0.2.10/24")},
		Routes: []zerotier.NetworkRoute{
			{Target: netip.MustParsePrefix("192.0.2.0/24"), Via: netip.MustParseAddr("192.0.2.1")},
			{Target: netip.MustParsePrefix("198.51.100.0/24"), Via: netip.MustParseAddr("192.0.2.10")},
			{Target: netip.MustParsePrefix("203.0.113.0/24"), Via: netip.MustParseAddr("fd00::1")},
			{Target: netip.MustParsePrefix("10.0.0.0/8"), Via: netip.MustParseAddr("224.0.0.1")},
			{Target: netip.MustParsePrefix("172.16.0.0/12"), Via: netip.IPv4Unspecified()},
		},
	}); err != nil {
		t.Fatal(err)
	}
	if nextHop, ok := link.routeFor(netip.MustParseAddr("192.0.2.20")); !ok || nextHop != netip.MustParseAddr("192.0.2.20") {
		t.Fatalf("assigned prefix was not kept on-link: nextHop=%s valid=%t", nextHop, ok)
	}
	for _, destination := range []string{"198.51.100.1", "203.0.113.1", "10.0.0.1"} {
		if nextHop, ok := link.routeFor(netip.MustParseAddr(destination)); ok {
			t.Fatalf("invalid route for %s was retained with next hop %s", destination, nextHop)
		}
	}
	if nextHop, ok := link.routeFor(netip.MustParseAddr("172.16.1.1")); !ok || nextHop != netip.MustParseAddr("172.16.1.1") {
		t.Fatalf("unspecified gateway was not normalized to on-link: nextHop=%s valid=%t", nextHop, ok)
	}
}

func TestManagedIPv6UsesDirectMappingWhenEnabled(t *testing.T) {
	const networkID = uint64(0x17d709436c04d6bc)
	localAddress := zerotier.NewAddress(0x0f1b56d269)
	remoteAddress := zerotier.NewAddress(0x46a9a1d071)
	tests := []struct {
		name        string
		local       netip.Prefix
		destination netip.Addr
	}{
		{
			name:        "RFC4193",
			local:       zerotier.RFC4193Address(networkID, localAddress),
			destination: zerotier.RFC4193Address(networkID, remoteAddress).Addr(),
		},
		{
			name:        "6plane",
			local:       zerotier.SixPlaneAddress(networkID, localAddress),
			destination: zerotier.SixPlaneAddress(networkID, remoteAddress).Addr(),
		},
	}
	for _, test := range tests {
		t.Run(test.name, func(t *testing.T) {
			link, err := New(networkID, &recordingSender{address: localAddress})
			if err != nil {
				t.Fatal(err)
			}
			config := zerotier.NetworkConfigData{NetworkID: networkID, Assigned: []netip.Prefix{test.local}}
			if err = link.ApplyNetworkConfig(config); err != nil {
				t.Fatal(err)
			}
			if err = link.ValidateDestination(test.destination); err != nil {
				t.Fatal(err)
			}
			if _, ok := link.managedIPv6MAC(test.destination); ok {
				t.Fatal("managed IPv6 destination used direct mapping with NDP emulation disabled")
			}
			config.Flags = zerotier.NetworkConfigFlagEnableIPv6NDPEmulation
			if err = link.ApplyNetworkConfig(config); err != nil {
				t.Fatal(err)
			}
			if err = link.ValidateDestination(test.destination); err != nil {
				t.Fatal(err)
			}
			mac, ok := link.managedIPv6MAC(test.destination)
			if !ok || mac != zerotier.MACForAddress(remoteAddress, networkID) {
				t.Fatalf("managed IPv6 MAC = %s, valid=%t", mac, ok)
			}
		})
	}
}

func TestIPv4ARPResolution(t *testing.T) {
	const networkID = uint64(0x17d709436c04d6bc)
	localAddress := zerotier.NewAddress(0x0f1b56d269)
	remoteAddress := zerotier.NewAddress(0x46a9a1d071)
	sender := &recordingSender{address: localAddress}
	link, err := New(networkID, sender)
	if err != nil {
		t.Fatal(err)
	}
	link.now = func() time.Time { return time.Unix(1700000000, 0) }
	if err = link.ApplyNetworkConfig(zerotier.NetworkConfigData{
		NetworkID: networkID,
		Assigned:  []netip.Prefix{netip.MustParsePrefix("192.168.192.7/24")},
	}); err != nil {
		t.Fatal(err)
	}

	packet := ipv4Packet(netip.MustParseAddr("192.168.192.7"), netip.MustParseAddr("192.168.192.8"), 17)
	if err = link.WritePacket(packet); err != nil {
		t.Fatal(err)
	}
	if len(sender.frames) != 1 || sender.frames[0].etherType != zerotier.EtherTypeARP || sender.frames[0].destination != zerotier.NewMAC(0xffffffffffff) {
		t.Fatalf("unexpected ARP request: %+v", sender.frames)
	}
	if target := netip.AddrFrom4([4]byte(sender.frames[0].payload[24:28])); target != netip.MustParseAddr("192.168.192.8") {
		t.Fatalf("ARP target = %s", target)
	}

	remoteMAC := zerotier.MACForAddress(remoteAddress, networkID)
	reply := arpPacket(2, remoteMAC, netip.MustParseAddr("192.168.192.8"), zerotier.MACForAddress(localAddress, networkID), netip.MustParseAddr("192.168.192.7"))
	if _, err = link.HandleFrame(zerotier.Frame{NetworkID: networkID, Source: remoteMAC, Destination: zerotier.MACForAddress(localAddress, networkID), EtherType: zerotier.EtherTypeARP, Payload: reply}); err != nil {
		t.Fatal(err)
	}
	if len(sender.frames) != 2 || sender.frames[1].etherType != zerotier.EtherTypeIPv4 || sender.frames[1].destination != remoteMAC || !bytes.Equal(sender.frames[1].payload, packet) {
		t.Fatalf("pending IPv4 packet was not flushed: %+v", sender.frames)
	}

	request := arpPacket(1, remoteMAC, netip.MustParseAddr("192.168.192.8"), 0, netip.MustParseAddr("192.168.192.7"))
	if _, err = link.HandleFrame(zerotier.Frame{NetworkID: networkID, Source: remoteMAC, Destination: zerotier.NewMAC(0xffffffffffff), EtherType: zerotier.EtherTypeARP, Payload: request}); err != nil {
		t.Fatal(err)
	}
	last := sender.frames[len(sender.frames)-1]
	if last.etherType != zerotier.EtherTypeARP || last.destination != remoteMAC || binary.BigEndian.Uint16(last.payload[6:8]) != 2 {
		t.Fatalf("unexpected ARP reply: %+v", last)
	}
}

func TestIPv4UsesPacketSourceForARPAndMapsBroadcastMulticast(t *testing.T) {
	const networkID = uint64(0x17d709436c04d6bc)
	sender := &recordingSender{address: zerotier.NewAddress(0x0f1b56d269)}
	link, err := New(networkID, sender)
	if err != nil {
		t.Fatal(err)
	}
	link.now = func() time.Time { return time.Unix(1700000000, 0) }
	if err = link.ApplyNetworkConfig(zerotier.NetworkConfigData{
		NetworkID: networkID, MulticastLimit: 32, Flags: zerotier.NetworkConfigFlagEnableBroadcast,
		Assigned: []netip.Prefix{
			netip.MustParsePrefix("10.0.0.1/24"),
			netip.MustParsePrefix("192.168.1.1/24"),
		},
	}); err != nil {
		t.Fatal(err)
	}
	packet := ipv4Packet(netip.MustParseAddr("192.168.1.1"), netip.MustParseAddr("192.168.1.20"), 17)
	if err = link.WritePacket(packet); err != nil {
		t.Fatal(err)
	}
	if got := netip.AddrFrom4([4]byte(sender.frames[0].payload[14:18])); got != netip.MustParseAddr("192.168.1.1") {
		t.Fatalf("ARP sender address = %s", got)
	}

	sender.frames = nil
	broadcast := ipv4Packet(netip.MustParseAddr("192.168.1.1"), netip.MustParseAddr("192.168.1.255"), 17)
	if err = link.WritePacket(broadcast); err != nil {
		t.Fatal(err)
	}
	if len(sender.frames) != 1 || !sender.frames[0].destination.IsBroadcast() {
		t.Fatalf("subnet broadcast frame = %+v", sender.frames)
	}

	sender.frames = nil
	multicastAddress := netip.MustParseAddr("239.1.2.3")
	multicast := ipv4Packet(netip.MustParseAddr("192.168.1.1"), multicastAddress, 17)
	if err = link.WritePacket(multicast); err != nil {
		t.Fatal(err)
	}
	wantMAC := zerotier.NewMAC(0x01005e010203)
	if len(sender.frames) != 1 || sender.frames[0].destination != wantMAC {
		t.Fatalf("IPv4 multicast destination = %v", sender.frames)
	}
	if sender.subscriptions[zerotier.MulticastGroup{MAC: wantMAC}] {
		t.Fatal("sending multicast data created a persistent subscription")
	}
}

func TestNeighborResolutionBackgroundRetryAndExpiration(t *testing.T) {
	const networkID = uint64(0x17d709436c04d6bc)
	base := time.Unix(1700000000, 0)
	sender := &recordingSender{address: zerotier.NewAddress(0x0f1b56d269)}
	link, err := New(networkID, sender)
	if err != nil {
		t.Fatal(err)
	}
	link.now = func() time.Time { return base }
	if err = link.ApplyNetworkConfig(zerotier.NetworkConfigData{
		NetworkID: networkID,
		Assigned:  []netip.Prefix{netip.MustParsePrefix("192.0.2.10/24")},
	}); err != nil {
		t.Fatal(err)
	}
	packet := ipv4Packet(netip.MustParseAddr("192.0.2.10"), netip.MustParseAddr("192.0.2.20"), 17)
	if err = link.WritePacket(packet); err != nil {
		t.Fatal(err)
	}
	if len(sender.frames) != 1 || sender.frames[0].etherType != zerotier.EtherTypeARP {
		t.Fatalf("initial resolution frames = %+v", sender.frames)
	}
	if err = link.ProcessBackgroundTasks(base.Add(neighborRequestPeriod)); err != nil {
		t.Fatal(err)
	}
	if len(sender.frames) != 2 || sender.frames[1].etherType != zerotier.EtherTypeARP {
		t.Fatalf("neighbor resolution was not retried: %+v", sender.frames)
	}
	if err = link.ProcessBackgroundTasks(base.Add(pendingNeighborExpiration)); err != nil {
		t.Fatal(err)
	}
	link.mu.RLock()
	pending := len(link.neighborPending)
	link.mu.RUnlock()
	if pending != 0 || len(sender.frames) != 2 {
		t.Fatalf("expired resolution pending=%d frames=%d", pending, len(sender.frames))
	}
}

func TestStaleIPv4NeighborRemainsUsableWhileRefreshing(t *testing.T) {
	const networkID = uint64(0x17d709436c04d6bc)
	base := time.Unix(1700000000, 0)
	now := base.Add(neighborCacheRefreshAfter)
	localIP := netip.MustParseAddr("192.0.2.10")
	remoteIP := netip.MustParseAddr("192.0.2.20")
	remoteMAC := zerotier.NewMAC(0x020000000020)
	sender := &recordingSender{address: zerotier.NewAddress(0x0f1b56d269)}
	link, err := New(networkID, sender)
	if err != nil {
		t.Fatal(err)
	}
	link.now = func() time.Time { return now }
	if err = link.ApplyNetworkConfig(zerotier.NetworkConfigData{
		NetworkID: networkID,
		Assigned:  []netip.Prefix{netip.PrefixFrom(localIP, 24)},
	}); err != nil {
		t.Fatal(err)
	}
	link.neighborCache[remoteIP] = neighborEntry{mac: remoteMAC, deadline: now}
	packet := ipv4Packet(localIP, remoteIP, 17)

	if err = link.WritePacket(packet); err != nil {
		t.Fatal(err)
	}
	if len(sender.frames) != 1 || sender.frames[0].destination != remoteMAC || sender.frames[0].etherType != zerotier.EtherTypeIPv4 {
		t.Fatalf("stale neighbor send frames = %+v", sender.frames)
	}
	entry := link.neighborCache[remoteIP]
	if entry.state != neighborDelay || entry.deadline != now.Add(neighborDelayProbeTime) || entry.probes != 0 || len(link.neighborPending) != 0 {
		t.Fatalf("stale neighbor state = %+v, pending=%d", entry, len(link.neighborPending))
	}

	if err = link.ProcessBackgroundTasks(now.Add(neighborDelayProbeTime - time.Millisecond)); err != nil {
		t.Fatal(err)
	}
	if len(sender.frames) != 1 {
		t.Fatalf("probe sent before delay expired: %+v", sender.frames)
	}
	now = now.Add(neighborDelayProbeTime)
	if err = link.ProcessBackgroundTasks(now); err != nil {
		t.Fatal(err)
	}
	if len(sender.frames) != 2 || sender.frames[1].destination != remoteMAC || sender.frames[1].etherType != zerotier.EtherTypeARP {
		t.Fatalf("unicast ARP probe frames = %+v", sender.frames)
	}
	entry = link.neighborCache[remoteIP]
	if entry.state != neighborProbe || entry.probes != 1 || entry.deadline != now.Add(neighborRequestPeriod) {
		t.Fatalf("probed neighbor state = %+v", entry)
	}

	if err = link.learnNeighbor(remoteIP, remoteMAC, true); err != nil {
		t.Fatal(err)
	}
	entry = link.neighborCache[remoteIP]
	if entry.state != neighborReachable || entry.probes != 0 || entry.deadline != now.Add(neighborCacheRefreshAfter) {
		t.Fatalf("refreshed neighbor state = %+v", entry)
	}
	now = now.Add(neighborCacheRefreshAfter - time.Second)
	framesBefore := len(sender.frames)
	if err = link.WritePacket(packet); err != nil {
		t.Fatal(err)
	}
	if len(sender.frames) != framesBefore+1 || sender.frames[framesBefore].etherType != zerotier.EtherTypeIPv4 {
		t.Fatalf("fresh neighbor unexpectedly refreshed: %+v", sender.frames[framesBefore:])
	}
}

func TestStaleIPv6NeighborRemainsUsableWhileRefreshing(t *testing.T) {
	const networkID = uint64(0x17d709436c04d6bc)
	base := time.Unix(1700000000, 0)
	now := base.Add(neighborCacheRefreshAfter)
	localIP := netip.MustParseAddr("fd00::10")
	remoteIP := netip.MustParseAddr("fd00::20")
	remoteMAC := zerotier.NewMAC(0x020000000020)
	sender := &recordingSender{address: zerotier.NewAddress(0x0f1b56d269)}
	link, err := New(networkID, sender)
	if err != nil {
		t.Fatal(err)
	}
	link.now = func() time.Time { return now }
	if err = link.ApplyNetworkConfig(zerotier.NetworkConfigData{
		NetworkID: networkID,
		Assigned:  []netip.Prefix{netip.PrefixFrom(localIP, 64)},
	}); err != nil {
		t.Fatal(err)
	}
	link.neighborCache[remoteIP] = neighborEntry{mac: remoteMAC, deadline: now}
	packet := ipv6Packet(localIP, remoteIP, 17, []byte{1})

	if err = link.WritePacket(packet); err != nil {
		t.Fatal(err)
	}
	if len(sender.frames) != 1 || sender.frames[0].destination != remoteMAC || sender.frames[0].etherType != zerotier.EtherTypeIPv6 {
		t.Fatalf("stale neighbor send frames = %+v", sender.frames)
	}
	if len(link.neighborPending) != 0 {
		t.Fatalf("stale neighbor created %d pending resolutions", len(link.neighborPending))
	}

	now = now.Add(neighborDelayProbeTime)
	if err = link.ProcessBackgroundTasks(now); err != nil {
		t.Fatal(err)
	}
	if len(sender.frames) != 2 || sender.frames[1].destination != remoteMAC || sender.frames[1].etherType != zerotier.EtherTypeIPv6 || len(sender.frames[1].payload) < 41 || sender.frames[1].payload[6] != 58 || sender.frames[1].payload[40] != 135 || !bytes.Equal(sender.frames[1].payload[24:40], remoteIP.AsSlice()) {
		t.Fatalf("unicast NDP probe frames = %+v", sender.frames)
	}
	if err = link.learnNeighbor(remoteIP, remoteMAC, true); err != nil {
		t.Fatal(err)
	}
	entry := link.neighborCache[remoteIP]
	if entry.state != neighborReachable || entry.probes != 0 || entry.deadline != now.Add(neighborCacheRefreshAfter) {
		t.Fatalf("refreshed IPv6 neighbor state = %+v", entry)
	}
}

func TestStaleNeighborProbeFailureRestartsResolution(t *testing.T) {
	const networkID = uint64(0x17d709436c04d6bc)
	now := time.Unix(1700000000, 0)
	localIP := netip.MustParseAddr("192.0.2.10")
	remoteIP := netip.MustParseAddr("192.0.2.20")
	remoteMAC := zerotier.NewMAC(0x020000000020)
	sender := &recordingSender{address: zerotier.NewAddress(0x0f1b56d269)}
	link, err := New(networkID, sender)
	if err != nil {
		t.Fatal(err)
	}
	link.now = func() time.Time { return now }
	if err = link.ApplyNetworkConfig(zerotier.NetworkConfigData{
		NetworkID: networkID,
		Assigned:  []netip.Prefix{netip.PrefixFrom(localIP, 24)},
	}); err != nil {
		t.Fatal(err)
	}
	link.neighborCache[remoteIP] = neighborEntry{mac: remoteMAC, deadline: now}
	packet := ipv4Packet(localIP, remoteIP, 17)
	if err = link.WritePacket(packet); err != nil {
		t.Fatal(err)
	}

	now = now.Add(neighborDelayProbeTime)
	for probe := 0; probe < neighborMaximumProbes; probe++ {
		if err = link.ProcessBackgroundTasks(now); err != nil {
			t.Fatal(err)
		}
		if len(sender.frames) != probe+2 || sender.frames[probe+1].destination != remoteMAC || sender.frames[probe+1].etherType != zerotier.EtherTypeARP {
			t.Fatalf("probe %d frames = %+v", probe+1, sender.frames)
		}
		now = now.Add(neighborRequestPeriod)
	}
	if err = link.ProcessBackgroundTasks(now); err != nil {
		t.Fatal(err)
	}
	if _, exists := link.neighborCache[remoteIP]; exists {
		t.Fatal("failed neighbor mapping remains cached")
	}
	if len(sender.frames) != neighborMaximumProbes+1 {
		t.Fatalf("failure emitted an extra probe: %+v", sender.frames)
	}

	if err = link.WritePacket(packet); err != nil {
		t.Fatal(err)
	}
	pending := link.neighborPending[remoteIP]
	last := sender.frames[len(sender.frames)-1]
	if len(pending.packets) != 1 || pending.requestedAt != now || last.etherType != zerotier.EtherTypeARP || !last.destination.IsBroadcast() {
		t.Fatalf("restarted resolution pending=%+v frame=%+v", pending, last)
	}
}

func TestRunBackgroundTasksStopsWithContext(t *testing.T) {
	const networkID = uint64(0x17d709436c04d6bc)
	link, err := New(networkID, &recordingSender{address: zerotier.NewAddress(0x0f1b56d269)})
	if err != nil {
		t.Fatal(err)
	}
	ctx, cancel := context.WithCancel(context.Background())
	done := make(chan struct{})
	go func() {
		link.RunBackgroundTasks(ctx)
		close(done)
	}()
	cancel()
	select {
	case <-done:
	case <-time.After(time.Second):
		t.Fatal("background tasks did not stop after cancellation")
	}
}

func TestPendingNeighborQueueHasGlobalByteLimit(t *testing.T) {
	const networkID = uint64(0x17d709436c04d6bc)
	base := time.Unix(1700000000, 0)
	link, err := New(networkID, &recordingSender{address: zerotier.NewAddress(0x0f1b56d269)})
	if err != nil {
		t.Fatal(err)
	}
	link.now = func() time.Time { return base }
	if err = link.ApplyNetworkConfig(zerotier.NetworkConfigData{
		NetworkID: networkID,
		MTU:       zerotier.MaxNetworkMTU,
		Assigned:  []netip.Prefix{netip.MustParsePrefix("10.0.0.1/8")},
	}); err != nil {
		t.Fatal(err)
	}
	packet := make([]byte, zerotier.MaxNetworkMTU)
	packet[0] = 0x45
	binary.BigEndian.PutUint16(packet[2:4], uint16(len(packet)))
	copy(packet[12:16], netip.MustParseAddr("10.0.0.1").AsSlice())
	packet[16] = 10
	var queueErr error
	for destination := 2; destination < 256 && queueErr == nil; destination++ {
		packet[19] = byte(destination)
		for count := 0; count < 64; count++ {
			queueErr = link.WritePacket(packet)
			if queueErr != nil {
				break
			}
		}
	}
	if queueErr == nil {
		t.Fatal("unresolved neighbor queue exceeded its byte limit")
	}
	link.mu.RLock()
	queuedPackets, queuedBytes := link.pendingNeighborPackets, link.pendingNeighborBytes
	link.mu.RUnlock()
	if queuedBytes > maxPendingNeighborBytes || queuedBytes <= maxPendingNeighborBytes-len(packet) {
		t.Fatalf("unresolved neighbor queue bytes = %d", queuedBytes)
	}
	if queuedPackets == 0 || queuedPackets > maxPendingNeighborPackets {
		t.Fatalf("unresolved neighbor queue packets = %d", queuedPackets)
	}
	if err = link.ProcessBackgroundTasks(base.Add(pendingNeighborExpiration)); err != nil {
		t.Fatal(err)
	}
	link.mu.RLock()
	queuedPackets, queuedBytes, pendingCount := link.pendingNeighborPackets, link.pendingNeighborBytes, len(link.neighborPending)
	link.mu.RUnlock()
	if queuedPackets != 0 || queuedBytes != 0 || pendingCount != 0 {
		t.Fatalf("expired neighbor queue retained destinations=%d packets=%d bytes=%d", pendingCount, queuedPackets, queuedBytes)
	}
}

func TestPendingNeighborQueueHasPerDestinationByteLimit(t *testing.T) {
	const networkID = uint64(0x17d709436c04d6bc)
	link, err := New(networkID, &recordingSender{address: zerotier.NewAddress(0x0f1b56d269)})
	if err != nil {
		t.Fatal(err)
	}
	if err = link.ApplyNetworkConfig(zerotier.NetworkConfigData{
		NetworkID: networkID,
		MTU:       zerotier.MaxNetworkMTU,
		Assigned:  []netip.Prefix{netip.MustParsePrefix("10.0.0.1/8")},
	}); err != nil {
		t.Fatal(err)
	}
	packet := make([]byte, zerotier.MaxNetworkMTU)
	packet[0] = 0x45
	binary.BigEndian.PutUint16(packet[2:4], uint16(len(packet)))
	copy(packet[12:16], netip.MustParseAddr("10.0.0.1").AsSlice())
	copy(packet[16:20], netip.MustParseAddr("10.0.0.2").AsSlice())
	for err == nil {
		err = link.WritePacket(packet)
	}
	link.mu.RLock()
	pending := link.neighborPending[netip.MustParseAddr("10.0.0.2")]
	queuedPackets, queuedBytes := link.pendingNeighborPackets, link.pendingNeighborBytes
	link.mu.RUnlock()
	if pending.bytes > maxPendingNeighborBytesPerDestination || pending.bytes <= maxPendingNeighborBytesPerDestination-len(packet) {
		t.Fatalf("destination queue bytes = %d", pending.bytes)
	}
	if queuedPackets != len(pending.packets) || queuedBytes != pending.bytes {
		t.Fatalf("queue accounting: destination=%d packets=%d bytes=%d/%d", len(pending.packets), queuedPackets, queuedBytes, pending.bytes)
	}
}

func TestPendingNeighborQueuePreservesLargeBurstWithinPacketLimit(t *testing.T) {
	const (
		networkID   = uint64(0x17d709436c04d6bc)
		packetCount = 12288
	)
	base := time.Unix(1700000000, 0)
	sender := &recordingSender{address: zerotier.NewAddress(0x0f1b56d269)}
	link, err := New(networkID, sender)
	if err != nil {
		t.Fatal(err)
	}
	link.now = func() time.Time { return base }
	if err = link.ApplyNetworkConfig(zerotier.NetworkConfigData{
		NetworkID: networkID,
		Assigned:  []netip.Prefix{netip.MustParsePrefix("192.0.2.1/24")},
	}); err != nil {
		t.Fatal(err)
	}
	packet := ipv4Packet(netip.MustParseAddr("192.0.2.1"), netip.MustParseAddr("192.0.2.2"), 6)
	for index := 0; index < packetCount; index++ {
		if err = link.WritePacket(packet); err != nil {
			t.Fatalf("WritePacket %d: %v", index, err)
		}
	}
	link.mu.RLock()
	pending := link.neighborPending[netip.MustParseAddr("192.0.2.2")]
	queuedPackets, queuedBytes := link.pendingNeighborPackets, link.pendingNeighborBytes
	link.mu.RUnlock()
	if len(pending.packets) != packetCount {
		t.Fatalf("queued packets = %d, want %d", len(pending.packets), packetCount)
	}
	if queuedPackets != packetCount {
		t.Fatalf("global queued packets = %d, want %d", queuedPackets, packetCount)
	}
	if queuedBytes != packetCount*len(packet) {
		t.Fatalf("queued bytes = %d, want %d", queuedBytes, packetCount*len(packet))
	}
	for index := packetCount; index < maxPendingPacketsPerDestination; index++ {
		if err = link.WritePacket(packet); err != nil {
			t.Fatalf("WritePacket %d: %v", index, err)
		}
	}
	if err = link.WritePacket(packet); err == nil {
		t.Fatal("unresolved destination accepted a packet beyond its limit")
	}
	link.mu.RLock()
	pending = link.neighborPending[netip.MustParseAddr("192.0.2.2")]
	queuedPackets, queuedBytes = link.pendingNeighborPackets, link.pendingNeighborBytes
	link.mu.RUnlock()
	if len(pending.packets) != maxPendingPacketsPerDestination || queuedPackets != maxPendingPacketsPerDestination || queuedBytes != maxPendingPacketsPerDestination*len(packet) {
		t.Fatalf("bounded queue: destination=%d packets=%d bytes=%d", len(pending.packets), queuedPackets, queuedBytes)
	}
	if len(sender.frames) != 1 || sender.frames[0].etherType != zerotier.EtherTypeARP {
		t.Fatalf("resolution frames = %+v", sender.frames)
	}
}

func TestPendingNeighborQueueHasGlobalPacketLimit(t *testing.T) {
	const networkID = uint64(0x17d709436c04d6bc)
	base := time.Unix(1700000000, 0)
	link, err := New(networkID, &recordingSender{address: zerotier.NewAddress(0x0f1b56d269)})
	if err != nil {
		t.Fatal(err)
	}
	link.now = func() time.Time { return base }
	if err = link.ApplyNetworkConfig(zerotier.NetworkConfigData{
		NetworkID: networkID,
		Assigned:  []netip.Prefix{netip.MustParsePrefix("192.0.2.1/24")},
	}); err != nil {
		t.Fatal(err)
	}
	source := netip.MustParseAddr("192.0.2.1")
	destinations := []netip.Addr{
		netip.MustParseAddr("192.0.2.2"),
		netip.MustParseAddr("192.0.2.3"),
		netip.MustParseAddr("192.0.2.4"),
	}
	for index := 0; index < maxPendingNeighborPackets; index++ {
		packet := ipv4Packet(source, destinations[index%len(destinations)], 17)
		if err = link.WritePacket(packet); err != nil {
			t.Fatalf("WritePacket %d: %v", index, err)
		}
	}
	if err = link.WritePacket(ipv4Packet(source, destinations[0], 17)); err == nil {
		t.Fatal("unresolved neighbor queue accepted a packet beyond its global limit")
	}
	link.mu.RLock()
	queuedPackets, queuedBytes := link.pendingNeighborPackets, link.pendingNeighborBytes
	link.mu.RUnlock()
	if queuedPackets != maxPendingNeighborPackets || queuedBytes != maxPendingNeighborPackets*20 {
		t.Fatalf("global packet limit: packets=%d bytes=%d", queuedPackets, queuedBytes)
	}
}

func TestApplyNetworkConfigRollsBackOnMulticastFailure(t *testing.T) {
	const networkID = uint64(0x17d709436c04d6bc)
	wantErr := errors.New("automatic subscribe failed")
	sender := &recordingSender{address: zerotier.NewAddress(0x0f1b56d269), subscribeErr: wantErr}
	link, err := New(networkID, sender)
	if err != nil {
		t.Fatal(err)
	}
	err = link.ApplyNetworkConfig(zerotier.NetworkConfigData{
		NetworkID: networkID,
		Assigned:  []netip.Prefix{netip.MustParsePrefix("192.0.2.10/24")},
	})
	if !errors.Is(err, wantErr) {
		t.Fatalf("ApplyNetworkConfig error = %v", err)
	}
	link.mu.RLock()
	configured := link.configured
	assigned := len(link.assigned)
	automatic := len(link.automaticSubscriptions)
	link.mu.RUnlock()
	if configured || assigned != 0 || automatic != 0 {
		t.Fatalf("failed config retained configured=%t assigned=%d automatic=%d", configured, assigned, automatic)
	}
}

func TestApplyNetworkConfigRollsBackInterfaceGenerationOnMulticastFailure(t *testing.T) {
	const networkID = uint64(0x17d709436c04d6bc)
	oldAddress := netip.MustParsePrefix("192.0.2.10/24")
	newAddress := netip.MustParsePrefix("198.51.100.10/24")
	dynamicAddress := netip.MustParseAddr("239.22.23.24")
	dynamicGroup, _ := multicastGroupForIP(dynamicAddress)
	wantErr := errors.New("dynamic unsubscribe failed")
	sender := &recordingSender{address: zerotier.NewAddress(0x0f1b56d269)}
	link, err := New(networkID, sender)
	if err != nil {
		t.Fatal(err)
	}
	oldConfig := zerotier.NetworkConfigData{
		NetworkID: networkID, MTU: 1400, MulticastLimit: 32,
		Assigned: []netip.Prefix{oldAddress},
	}
	if err = link.ApplyNetworkConfig(oldConfig); err != nil {
		t.Fatal(err)
	}
	link.applyLegacyMembership(dynamicAddress, true)
	if !sender.subscriptions[dynamicGroup] {
		t.Fatal("dynamic membership was not subscribed before the update")
	}
	sender.unsubscribeErrors = map[zerotier.MulticastGroup]error{dynamicGroup: wantErr}
	newConfig := oldConfig
	newConfig.Assigned = []netip.Prefix{newAddress}
	if err = link.ApplyNetworkConfig(newConfig); !errors.Is(err, wantErr) {
		t.Fatalf("ApplyNetworkConfig error = %v, want %v", err, wantErr)
	}
	link.configMu.RLock()
	configuredAddress := link.assigned[0]
	link.configMu.RUnlock()
	link.mu.RLock()
	_, membershipRetained := link.reportedMemberships[dynamicAddress]
	_, activeRetained := link.activeMulticast[dynamicGroup]
	link.mu.RUnlock()
	if configuredAddress != oldAddress || !membershipRetained || !activeRetained || !sender.subscriptions[dynamicGroup] {
		t.Fatalf("failed update retained address=%s membership=%t active=%t subscribed=%t",
			configuredAddress, membershipRetained, activeRetained, sender.subscriptions[dynamicGroup])
	}
	delete(sender.unsubscribeErrors, dynamicGroup)
	if err = link.ApplyNetworkConfig(newConfig); err != nil {
		t.Fatalf("retry ApplyNetworkConfig: %v", err)
	}
	link.mu.RLock()
	_, membershipRetained = link.reportedMemberships[dynamicAddress]
	_, activeRetained = link.activeMulticast[dynamicGroup]
	link.mu.RUnlock()
	if membershipRetained || activeRetained || sender.subscriptions[dynamicGroup] {
		t.Fatalf("successful update retained membership=%t active=%t subscribed=%t",
			membershipRetained, activeRetained, sender.subscriptions[dynamicGroup])
	}
}

func TestApplyNetworkConfigRollsBackNewAutomaticSubscriptionFailure(t *testing.T) {
	const networkID = uint64(0x17d709436c04d6bc)
	oldAddress := netip.MustParsePrefix("fe80::10/64")
	newAddress := netip.MustParsePrefix("fe80::20/64")
	oldSolicited := solicitedNodeMulticast(oldAddress.Addr())
	newSolicited := solicitedNodeMulticast(newAddress.Addr())
	oldGroup, _ := multicastGroupForIP(oldSolicited)
	newGroup, _ := multicastGroupForIP(newSolicited)
	wantErr := errors.New("new solicited-node subscribe failed")
	sender := &recordingSender{address: zerotier.NewAddress(0x0f1b56d269)}
	link, err := New(networkID, sender)
	if err != nil {
		t.Fatal(err)
	}
	oldConfig := zerotier.NetworkConfigData{
		NetworkID: networkID, MTU: 1400, MulticastLimit: 32,
		Assigned: []netip.Prefix{oldAddress},
	}
	if err = link.ApplyNetworkConfig(oldConfig); err != nil {
		t.Fatal(err)
	}
	sender.subscribeErrors = map[zerotier.MulticastGroup]error{newGroup: wantErr}
	newConfig := oldConfig
	newConfig.Assigned = []netip.Prefix{newAddress}
	if err = link.ApplyNetworkConfig(newConfig); !errors.Is(err, wantErr) {
		t.Fatalf("ApplyNetworkConfig error = %v, want %v", err, wantErr)
	}
	link.configMu.RLock()
	configuredAddress := link.assigned[0]
	link.configMu.RUnlock()
	link.mu.RLock()
	_, oldActive := link.activeMulticast[oldGroup]
	_, newActive := link.activeMulticast[newGroup]
	link.mu.RUnlock()
	if configuredAddress != oldAddress || !oldActive || newActive || !sender.subscriptions[oldGroup] || sender.subscriptions[newGroup] {
		t.Fatalf("failed update retained address=%s old=%t/%t new=%t/%t",
			configuredAddress, oldActive, sender.subscriptions[oldGroup], newActive, sender.subscriptions[newGroup])
	}
	delete(sender.subscribeErrors, newGroup)
	if err = link.ApplyNetworkConfig(newConfig); err != nil {
		t.Fatalf("retry ApplyNetworkConfig: %v", err)
	}
	if sender.subscriptions[oldGroup] || !sender.subscriptions[newGroup] {
		t.Fatalf("successful update subscriptions old=%t new=%t", sender.subscriptions[oldGroup], sender.subscriptions[newGroup])
	}
}

func TestFrameSenderWithoutMulticastSubscriptionSupport(t *testing.T) {
	const networkID = uint64(0x17d709436c04d6bc)
	sender := &frameOnlySender{address: zerotier.NewAddress(0x0f1b56d269)}
	link, err := New(networkID, sender)
	if err != nil {
		t.Fatal(err)
	}
	if err = link.ApplyNetworkConfig(zerotier.NetworkConfigData{
		NetworkID: networkID, MulticastLimit: 32,
		Assigned: []netip.Prefix{
			netip.MustParsePrefix("192.0.2.10/24"),
			netip.MustParsePrefix("fe80::10/64"),
		},
	}); err != nil {
		t.Fatal(err)
	}
	group := netip.MustParseAddr("239.32.33.34")
	report := legacyIGMPPacket(netip.MustParseAddr("192.0.2.10"), group, group, 0x16, 0, true)
	if err = link.WritePacket(report); err != nil {
		t.Fatal(err)
	}
	if len(sender.frames) != 1 || sender.frames[0].destination != zerotier.NewMAC(0x01005e202122) || !bytes.Equal(sender.frames[0].payload, report) {
		t.Fatalf("frame-only multicast output = %+v", sender.frames)
	}
	if err = link.ProcessBackgroundTasks(time.Now()); err != nil {
		t.Fatal(err)
	}
}

func TestReportedMulticastSubscriptionFailureIsRetried(t *testing.T) {
	const networkID = uint64(0x17d709436c04d6bc)
	sender := &recordingSender{address: zerotier.NewAddress(0x0f1b56d269)}
	link, err := New(networkID, sender)
	if err != nil {
		t.Fatal(err)
	}
	if err = link.ApplyNetworkConfig(zerotier.NetworkConfigData{
		NetworkID: networkID,
		Assigned:  []netip.Prefix{netip.MustParsePrefix("192.0.2.10/24")},
	}); err != nil {
		t.Fatal(err)
	}
	wantErr := errors.New("temporary multicast failure")
	sender.subscribeErr = wantErr
	group := netip.MustParseAddr("239.1.2.3")
	link.applyLegacyMembership(group, true)
	zeroTierGroup, _ := multicastGroupForIP(group)
	if sender.subscriptions[zeroTierGroup] {
		t.Fatal("failed reported membership was marked subscribed")
	}
	sender.subscribeErr = nil
	if err = link.ProcessBackgroundTasks(time.Now()); err != nil {
		t.Fatal(err)
	}
	if !sender.subscriptions[zeroTierGroup] {
		t.Fatal("background maintenance did not retry the reported membership")
	}
}

func TestIPv6NeighborDiscovery(t *testing.T) {
	const networkID = uint64(0x17d709436c04d6bc)
	localIP := netip.MustParseAddr("fd00::1")
	remoteIP := netip.MustParseAddr("fd00::2")
	localAddress := zerotier.NewAddress(0x0f1b56d269)
	remoteAddress := zerotier.NewAddress(0x46a9a1d071)
	sender := &recordingSender{address: localAddress}
	link, err := New(networkID, sender)
	if err != nil {
		t.Fatal(err)
	}
	link.now = func() time.Time { return time.Unix(1700000000, 0) }
	if err = link.ApplyNetworkConfig(zerotier.NetworkConfigData{
		NetworkID: networkID,
		Assigned:  []netip.Prefix{netip.MustParsePrefix("fd00::1/64")},
	}); err != nil {
		t.Fatal(err)
	}
	packet := ipv6Packet(localIP, remoteIP, 17, []byte{1, 2, 3, 4})
	if err = link.WritePacket(packet); err != nil {
		t.Fatal(err)
	}
	if len(sender.frames) != 1 || sender.frames[0].destination != zerotier.NewMAC(0x3333ff000002) || sender.frames[0].payload[40] != 135 {
		t.Fatalf("neighbor solicitation = %+v", sender.frames)
	}

	remoteMAC := zerotier.MACForAddress(remoteAddress, networkID)
	icmp := make([]byte, 32)
	icmp[0] = 136
	binary.BigEndian.PutUint32(icmp[4:8], 0x60000000)
	copy(icmp[8:24], remoteIP.AsSlice())
	icmp[24], icmp[25] = 2, 1
	remoteMACBytes := remoteMAC.Bytes()
	copy(icmp[26:32], remoteMACBytes[:])
	advertisement := makeIPv6ICMPPacket(remoteIP, localIP, icmp)
	if _, err = link.HandleFrame(zerotier.Frame{NetworkID: networkID, Source: remoteMAC, Destination: zerotier.MACForAddress(localAddress, networkID), EtherType: zerotier.EtherTypeIPv6, Payload: advertisement}); err != nil {
		t.Fatal(err)
	}
	if len(sender.frames) != 2 || sender.frames[1].destination != remoteMAC || !bytes.Equal(sender.frames[1].payload, packet) {
		t.Fatalf("pending IPv6 packet was not flushed: %+v", sender.frames)
	}
}

func TestIPv6NeighborSolicitationGetsAdvertisement(t *testing.T) {
	const networkID = uint64(0x17d709436c04d6bc)
	localIP := netip.MustParseAddr("fd00::1")
	remoteIP := netip.MustParseAddr("fd00::2")
	localAddress := zerotier.NewAddress(0x0f1b56d269)
	remoteAddress := zerotier.NewAddress(0x46a9a1d071)
	sender := &recordingSender{address: localAddress}
	link, err := New(networkID, sender)
	if err != nil {
		t.Fatal(err)
	}
	if err = link.ApplyNetworkConfig(zerotier.NetworkConfigData{NetworkID: networkID, Assigned: []netip.Prefix{netip.MustParsePrefix("fd00::1/64")}}); err != nil {
		t.Fatal(err)
	}
	remoteMAC := zerotier.MACForAddress(remoteAddress, networkID)
	icmp := make([]byte, 32)
	icmp[0] = 135
	copy(icmp[8:24], localIP.AsSlice())
	icmp[24], icmp[25] = 1, 1
	remoteMACBytes := remoteMAC.Bytes()
	copy(icmp[26:32], remoteMACBytes[:])
	solicitation := makeIPv6ICMPPacket(remoteIP, solicitedNodeMulticast(localIP), icmp)
	if _, err = link.HandleFrame(zerotier.Frame{NetworkID: networkID, Source: remoteMAC, Destination: ipv6MulticastMAC(solicitedNodeMulticast(localIP)), EtherType: zerotier.EtherTypeIPv6, Payload: solicitation}); err != nil {
		t.Fatal(err)
	}
	if len(sender.frames) != 1 || sender.frames[0].destination != remoteMAC || sender.frames[0].payload[40] != 136 {
		t.Fatalf("neighbor advertisement = %+v", sender.frames)
	}
}

func TestIPv6DuplicateAddressDetectionGetsUnsolicitedAdvertisement(t *testing.T) {
	const networkID = uint64(0x17d709436c04d6bc)
	localIP := netip.MustParseAddr("fd00::1")
	localAddress := zerotier.NewAddress(0x0f1b56d269)
	remoteMAC := zerotier.MACForAddress(zerotier.NewAddress(0x46a9a1d071), networkID)
	sender := &recordingSender{address: localAddress}
	link, err := New(networkID, sender)
	if err != nil {
		t.Fatal(err)
	}
	if err = link.ApplyNetworkConfig(zerotier.NetworkConfigData{NetworkID: networkID, Assigned: []netip.Prefix{netip.MustParsePrefix("fd00::1/64")}}); err != nil {
		t.Fatal(err)
	}
	icmp := make([]byte, 24)
	icmp[0] = 135
	copy(icmp[8:24], localIP.AsSlice())
	solicitation := makeIPv6ICMPPacket(netip.IPv6Unspecified(), solicitedNodeMulticast(localIP), icmp)
	if _, err = link.HandleFrame(zerotier.Frame{NetworkID: networkID, Source: remoteMAC, Destination: ipv6MulticastMAC(solicitedNodeMulticast(localIP)), EtherType: zerotier.EtherTypeIPv6, Payload: solicitation}); err != nil {
		t.Fatal(err)
	}
	if len(sender.frames) != 1 {
		t.Fatalf("duplicate-address response frames = %d", len(sender.frames))
	}
	response := sender.frames[0]
	if response.destination != ipv6MulticastMAC(netip.MustParseAddr("ff02::1")) || binary.BigEndian.Uint32(response.payload[44:48]) != 0x20000000 {
		t.Fatalf("duplicate-address advertisement destination=%s flags=%08x", response.destination, binary.BigEndian.Uint32(response.payload[44:48]))
	}
}

func TestIPv6NeighborDiscoveryBehindExtensionHeader(t *testing.T) {
	const networkID = uint64(0x17d709436c04d6bc)
	localIP := netip.MustParseAddr("fd00::1")
	remoteIP := netip.MustParseAddr("fd00::2")
	remoteMAC := zerotier.MACForAddress(zerotier.NewAddress(0x46a9a1d071), networkID)
	sender := &recordingSender{address: zerotier.NewAddress(0x0f1b56d269)}
	link, err := New(networkID, sender)
	if err != nil {
		t.Fatal(err)
	}
	if err = link.ApplyNetworkConfig(zerotier.NetworkConfigData{NetworkID: networkID, Assigned: []netip.Prefix{netip.MustParsePrefix("fd00::1/64")}}); err != nil {
		t.Fatal(err)
	}
	icmp := make([]byte, 32)
	icmp[0] = 135
	copy(icmp[8:24], localIP.AsSlice())
	icmp[24], icmp[25] = 1, 1
	remoteMACBytes := remoteMAC.Bytes()
	copy(icmp[26:32], remoteMACBytes[:])
	destination := solicitedNodeMulticast(localIP)
	binary.BigEndian.PutUint16(icmp[2:4], icmpv6Checksum(remoteIP, destination, icmp))
	hopByHop := []byte{58, 0, 5, 2, 0, 0, 1, 0}
	packet := ipv6Packet(remoteIP, destination, 0, append(hopByHop, icmp...))
	packet[7] = 255
	if _, err = link.HandleFrame(zerotier.Frame{
		NetworkID: networkID, Source: remoteMAC, Destination: ipv6MulticastMAC(destination),
		EtherType: zerotier.EtherTypeIPv6, Payload: packet,
	}); err != nil {
		t.Fatal(err)
	}
	if len(sender.frames) != 1 || sender.frames[0].destination != remoteMAC || sender.frames[0].payload[40] != 136 {
		t.Fatalf("extension-header neighbor solicitation was not answered: %+v", sender.frames)
	}
	sender.frames = nil
	atomic := ipv6AtomicFragment(packet)
	if returned, handleErr := link.HandleFrame(zerotier.Frame{
		NetworkID: networkID, Source: remoteMAC, Destination: ipv6MulticastMAC(destination),
		EtherType: zerotier.EtherTypeIPv6, Payload: atomic,
	}); handleErr != nil || returned != nil {
		t.Fatalf("atomic neighbor solicitation returned packet=%x error=%v", returned, handleErr)
	}
	if len(sender.frames) != 0 {
		t.Fatalf("atomic neighbor solicitation produced %d response frames", len(sender.frames))
	}
}

func TestNDPRejectsMalformedOptions(t *testing.T) {
	const networkID = uint64(0x17d709436c04d6bc)
	localIP := netip.MustParseAddr("fd00::1")
	remoteIP := netip.MustParseAddr("fd00::2")
	remoteMAC := zerotier.MACForAddress(zerotier.NewAddress(0x46a9a1d071), networkID)
	sender := &recordingSender{address: zerotier.NewAddress(0x0f1b56d269)}
	link, err := New(networkID, sender)
	if err != nil {
		t.Fatal(err)
	}
	if err = link.ApplyNetworkConfig(zerotier.NetworkConfigData{NetworkID: networkID, Assigned: []netip.Prefix{netip.MustParsePrefix("fd00::1/64")}}); err != nil {
		t.Fatal(err)
	}
	icmp := make([]byte, 32)
	icmp[0] = 135
	copy(icmp[8:24], localIP.AsSlice())
	icmp[24] = 1 // A zero-length option invalidates the complete message.
	destination := solicitedNodeMulticast(localIP)
	packet := makeIPv6ICMPPacket(remoteIP, destination, icmp)
	if _, err = link.HandleFrame(zerotier.Frame{
		NetworkID: networkID, Source: remoteMAC, Destination: ipv6MulticastMAC(destination),
		EtherType: zerotier.EtherTypeIPv6, Payload: packet,
	}); err != nil {
		t.Fatal(err)
	}
	link.mu.RLock()
	_, learned := link.neighborCache[remoteIP]
	link.mu.RUnlock()
	if len(sender.frames) != 0 || learned {
		t.Fatalf("malformed NDP option produced frames=%d learned=%t", len(sender.frames), learned)
	}
}

func TestNeighborAdvertisementHonorsOverride(t *testing.T) {
	const networkID = uint64(0x17d709436c04d6bc)
	localIP := netip.MustParseAddr("fd00::1")
	remoteIP := netip.MustParseAddr("fd00::2")
	oldMAC := zerotier.MACForAddress(zerotier.NewAddress(0x46a9a1d071), networkID)
	newMAC := zerotier.MACForAddress(zerotier.NewAddress(0x123456789a), networkID)
	link, err := New(networkID, &recordingSender{address: zerotier.NewAddress(0x0f1b56d269)})
	if err != nil {
		t.Fatal(err)
	}
	if err = link.ApplyNetworkConfig(zerotier.NetworkConfigData{NetworkID: networkID, Assigned: []netip.Prefix{netip.MustParsePrefix("fd00::1/64")}}); err != nil {
		t.Fatal(err)
	}
	if err = link.learnNeighbor(remoteIP, oldMAC, true); err != nil {
		t.Fatal(err)
	}
	advertise := func(flags uint32) {
		t.Helper()
		icmp := make([]byte, 32)
		icmp[0] = 136
		binary.BigEndian.PutUint32(icmp[4:8], flags)
		copy(icmp[8:24], remoteIP.AsSlice())
		icmp[24], icmp[25] = 2, 1
		newMACBytes := newMAC.Bytes()
		copy(icmp[26:32], newMACBytes[:])
		packet := makeIPv6ICMPPacket(remoteIP, localIP, icmp)
		if _, handleErr := link.HandleFrame(zerotier.Frame{
			NetworkID: networkID, Source: newMAC, Destination: zerotier.MACForAddress(zerotier.NewAddress(0x0f1b56d269), networkID),
			EtherType: zerotier.EtherTypeIPv6, Payload: packet,
		}); handleErr != nil {
			t.Fatal(handleErr)
		}
	}
	advertise(0)
	link.mu.RLock()
	entry := link.neighborCache[remoteIP]
	link.mu.RUnlock()
	if entry.mac != oldMAC {
		t.Fatalf("advertisement without Override replaced %s with %s", oldMAC, entry.mac)
	}
	advertise(0x20000000)
	link.mu.RLock()
	entry = link.neighborCache[remoteIP]
	link.mu.RUnlock()
	if entry.mac != newMAC {
		t.Fatalf("advertisement with Override retained %s", entry.mac)
	}
}

func TestHandleFrameReturnsIPPacket(t *testing.T) {
	const networkID = uint64(0x17d709436c04d6bc)
	link, err := New(networkID, &recordingSender{address: zerotier.NewAddress(0x0f1b56d269)})
	if err != nil {
		t.Fatal(err)
	}
	payload := []byte{0x45, 0, 0, 20}
	packet, err := link.HandleFrame(zerotier.Frame{NetworkID: networkID, EtherType: zerotier.EtherTypeIPv4, Payload: payload})
	if err != nil || !bytes.Equal(packet, payload) {
		t.Fatalf("packet=%x err=%v", packet, err)
	}
	packet, err = link.HandleFrame(zerotier.Frame{NetworkID: networkID + 1, EtherType: zerotier.EtherTypeIPv4, Payload: payload})
	if err != nil || packet != nil {
		t.Fatalf("foreign network frame returned packet=%x err=%v", packet, err)
	}
}

