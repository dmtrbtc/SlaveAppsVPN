func TestMulticastMACSubscriptionReferenceCounting(t *testing.T) {
	const networkID = uint64(0x17d709436c04d6bc)
	sender := &recordingSender{address: zerotier.NewAddress(0x0f1b56d269)}
	link, err := New(networkID, sender)
	if err != nil {
		t.Fatal(err)
	}
	first := netip.MustParseAddr("224.1.2.3")
	second := netip.MustParseAddr("225.1.2.3")
	group, _ := multicastGroupForIP(first)
	if secondGroup, _ := multicastGroupForIP(second); secondGroup != group {
		t.Fatal("test addresses do not share an Ethernet multicast mapping")
	}
	link.applyLegacyMembership(first, true)
	link.applyLegacyMembership(second, true)
	link.applyLegacyMembership(first, false)
	if !sender.subscriptions[group] {
		t.Fatal("shared Ethernet multicast group was removed while one IP mapping remained")
	}
	link.applyLegacyMembership(second, false)
	if sender.subscriptions[group] {
		t.Fatal("Ethernet multicast group remained after its last IP mapping was removed")
	}
}

func TestReportedMulticastSubscriptionStateIsBounded(t *testing.T) {
	const networkID = uint64(0x17d709436c04d6bc)
	link, err := New(networkID, &recordingSender{address: zerotier.NewAddress(0x0f1b56d269)})
	if err != nil {
		t.Fatal(err)
	}
	link.mu.Lock()
	for index := 0; index < maxMulticastGroups; index++ {
		address := netip.AddrFrom4([4]byte{239, 0, byte(index >> 8), byte(index)})
		link.reportedMemberships[address] = &reportedMulticastFilter{exclude: true}
	}
	link.mu.Unlock()
	newGroup := netip.MustParseAddr("239.1.0.1")
	link.applyLegacyMembership(newGroup, true)
	link.mu.Lock()
	_, retained := link.reportedMemberships[newGroup]
	link.mu.Unlock()
	if retained {
		t.Fatal("reported multicast subscription table exceeded its bound")
	}
}

func TestReportedMulticastSharingMACDoesNotConsumeNodeCapacity(t *testing.T) {
	const networkID = uint64(0x17d709436c04d6bc)
	link, err := New(networkID, &recordingSender{address: zerotier.NewAddress(0x0f1b56d269)})
	if err != nil {
		t.Fatal(err)
	}
	link.mu.Lock()
	for index := 0; index < maxMulticastGroups; index++ {
		address := netip.AddrFrom4([4]byte{239, 0, byte(index >> 8), byte(index)})
		group, _ := multicastGroupForIP(address)
		link.automaticSubscriptions[address] = group
	}
	link.mu.Unlock()
	// A second IP address that maps to an already active multicast MAC does
	// not consume another Node subscription and remains independently tracked.
	colliding := netip.MustParseAddr("239.128.0.0")
	link.applyLegacyMembership(colliding, true)
	link.mu.Lock()
	_, retained := link.reportedMemberships[colliding]
	link.mu.Unlock()
	if !retained {
		t.Fatal("IP multicast group sharing an active MAC was rejected")
	}
}

func TestReportedMulticastBatchReusesReleasedCapacity(t *testing.T) {
	const networkID = uint64(0x17d709436c04d6bc)
	sender := &recordingSender{address: zerotier.NewAddress(0x0f1b56d269), subscriptions: make(map[zerotier.MulticastGroup]bool)}
	link, err := New(networkID, sender)
	if err != nil {
		t.Fatal(err)
	}
	var removed netip.Addr
	link.mu.Lock()
	for index := 0; index < maxMulticastGroups; index++ {
		address := netip.AddrFrom4([4]byte{239, 0, byte(index >> 8), byte(index)})
		if index == 0 {
			removed = address
		}
		group, _ := multicastGroupForIP(address)
		link.reportedMemberships[address] = &reportedMulticastFilter{exclude: true}
		link.activeMulticast[group] = struct{}{}
		sender.subscriptions[group] = true
	}
	link.mu.Unlock()
	added := netip.MustParseAddr("239.1.0.1")
	source := netip.MustParseAddr("192.0.2.1")
	link.applyMembershipRecords([]reportedMembershipRecord{
		{group: removed, recordType: 3},
		{group: added, recordType: 5, sources: []netip.Addr{source}},
	})
	removedGroup, _ := multicastGroupForIP(removed)
	addedGroup, _ := multicastGroupForIP(added)
	link.mu.Lock()
	_, oldRetained := link.reportedMemberships[removed]
	newFilter := link.reportedMemberships[added]
	activeCount := len(link.activeMulticast)
	link.mu.Unlock()
	if oldRetained || newFilter == nil || !newFilter.active() {
		t.Fatalf("batch replacement retained old=%v new=%+v", oldRetained, newFilter)
	}
	if activeCount != maxMulticastGroups || sender.subscriptions[removedGroup] || !sender.subscriptions[addedGroup] {
		t.Fatalf("batch replacement active=%d removed=%v added=%v", activeCount, sender.subscriptions[removedGroup], sender.subscriptions[addedGroup])
	}
}

func TestMulticastReconciliationIsolatesGroupFailures(t *testing.T) {
	const networkID = uint64(0x17d709436c04d6bc)
	failingAddress := netip.MustParseAddr("239.3.0.1")
	removedAddress := netip.MustParseAddr("239.3.0.2")
	addedAddress := netip.MustParseAddr("239.3.0.3")
	failingGroup, _ := multicastGroupForIP(failingAddress)
	removedGroup, _ := multicastGroupForIP(removedAddress)
	addedGroup, _ := multicastGroupForIP(addedAddress)
	wantErr := errors.New("one multicast group failed")
	sender := &recordingSender{
		address:           zerotier.NewAddress(0x0f1b56d269),
		subscriptions:     map[zerotier.MulticastGroup]bool{failingGroup: true, removedGroup: true},
		unsubscribeErrors: map[zerotier.MulticastGroup]error{failingGroup: wantErr},
	}
	link, err := New(networkID, sender)
	if err != nil {
		t.Fatal(err)
	}
	link.mu.Lock()
	link.activeMulticast[failingGroup] = struct{}{}
	link.activeMulticast[removedGroup] = struct{}{}
	link.reportedMemberships[addedAddress] = &reportedMulticastFilter{exclude: true}
	err = link.syncMulticastGroupsLocked()
	_, failingActive := link.activeMulticast[failingGroup]
	_, removedActive := link.activeMulticast[removedGroup]
	_, addedActive := link.activeMulticast[addedGroup]
	link.mu.Unlock()
	if !errors.Is(err, wantErr) {
		t.Fatalf("reconciliation error = %v, want %v", err, wantErr)
	}
	if !failingActive || removedActive || !addedActive || sender.subscriptions[removedGroup] || !sender.subscriptions[addedGroup] {
		t.Fatalf("isolated reconciliation = failing %v removed %v added %v sender %v", failingActive, removedActive, addedActive, sender.subscriptions)
	}
	delete(sender.unsubscribeErrors, failingGroup)
	link.mu.Lock()
	err = link.syncMulticastGroupsLocked()
	_, failingActive = link.activeMulticast[failingGroup]
	link.mu.Unlock()
	if err != nil || failingActive || sender.subscriptions[failingGroup] {
		t.Fatalf("reconciliation retry = active %v sender %v error %v", failingActive, sender.subscriptions[failingGroup], err)
	}
}

func TestMLDv2ReportBehindHopByHopHeader(t *testing.T) {
	const networkID = uint64(0x17d709436c04d6bc)
	sender := &recordingSender{address: zerotier.NewAddress(0x0f1b56d269)}
	link, err := New(networkID, sender)
	if err != nil {
		t.Fatal(err)
	}
	if err = link.ApplyNetworkConfig(zerotier.NetworkConfigData{NetworkID: networkID, MulticastLimit: 32, Assigned: []netip.Prefix{netip.MustParsePrefix("fd00::1/64")}}); err != nil {
		t.Fatal(err)
	}
	reported := netip.MustParseAddr("ff05::1234")
	icmp := make([]byte, 28)
	icmp[0] = 143
	binary.BigEndian.PutUint16(icmp[6:8], 1)
	icmp[8] = 4
	copy(icmp[12:28], reported.AsSlice())
	source := netip.IPv6Unspecified()
	target := netip.MustParseAddr("ff02::16")
	binary.BigEndian.PutUint16(icmp[2:4], icmpv6Checksum(source, target, icmp))
	hopByHop := []byte{58, 0, 5, 2, 0, 0, 1, 0}
	packet := ipv6Packet(source, target, 0, append(hopByHop, icmp...))
	packet[7] = 1
	if err = link.WritePacket(packet); err != nil {
		t.Fatal(err)
	}
	group, _ := multicastGroupForIP(reported)
	if !sender.subscriptions[group] {
		t.Fatalf("MLDv2 group %s was not subscribed", reported)
	}
}

func TestMembershipSnoopingAcceptsAdditionalData(t *testing.T) {
	const networkID = uint64(0x17d709436c04d6bc)
	local4 := netip.MustParseAddr("192.0.2.10")
	local6 := netip.MustParseAddr("fe80::10")
	group4 := netip.MustParseAddr("239.41.0.1")
	group6 := netip.MustParseAddr("ff05::4101")
	legacyGroup4 := netip.MustParseAddr("239.41.0.2")
	legacyGroup6 := netip.MustParseAddr("ff05::4102")
	sender := &recordingSender{address: zerotier.NewAddress(0x0f1b56d269)}
	link, err := New(networkID, sender)
	if err != nil {
		t.Fatal(err)
	}
	if err = link.ApplyNetworkConfig(zerotier.NetworkConfigData{
		NetworkID: networkID, MulticastLimit: 32,
		Assigned: []netip.Prefix{netip.PrefixFrom(local4, 24), netip.PrefixFrom(local6, 64)},
	}); err != nil {
		t.Fatal(err)
	}

	report4 := igmpv3ReportPacket(local4, group4, 4, nil)
	report4 = append(report4, 1, 2, 3, 4)
	binary.BigEndian.PutUint16(report4[2:4], uint16(len(report4)))
	report4[10], report4[11] = 0, 0
	binary.BigEndian.PutUint16(report4[10:12], internetChecksum(report4[:24]))
	igmp := report4[24:]
	igmp[2], igmp[3] = 0, 0
	binary.BigEndian.PutUint16(igmp[2:4], internetChecksum(igmp))
	if err = link.WritePacket(report4); err != nil {
		t.Fatal(err)
	}
	want4, _ := multicastGroupForIP(group4)
	if !sender.subscriptions[want4] {
		t.Fatal("IGMPv3 report Additional Data prevented subscription")
	}

	icmp := make([]byte, 36)
	icmp[0], icmp[8] = 143, 4
	binary.BigEndian.PutUint16(icmp[6:8], 1)
	copy(icmp[12:28], group6.AsSlice())
	copy(icmp[28:], []byte{1, 2, 3, 4, 5, 6, 7, 8})
	target6 := netip.MustParseAddr("ff02::16")
	binary.BigEndian.PutUint16(icmp[2:4], icmpv6Checksum(local6, target6, icmp))
	hopByHop := []byte{58, 0, 5, 2, 0, 0, 1, 0}
	report6 := ipv6Packet(local6, target6, 0, append(hopByHop, icmp...))
	report6[7] = 1
	if err = link.WritePacket(report6); err != nil {
		t.Fatal(err)
	}
	want6, _ := multicastGroupForIP(group6)
	if !sender.subscriptions[want6] {
		t.Fatal("MLDv2 report Additional Data prevented subscription")
	}

	legacy4 := legacyIGMPPacket(local4, legacyGroup4, legacyGroup4, 0x16, 0, true)
	headerLength := int(legacy4[0]&0x0f) * 4
	legacy4 = append(legacy4, 5, 6, 7, 8)
	binary.BigEndian.PutUint16(legacy4[2:4], uint16(len(legacy4)))
	legacy4[10], legacy4[11] = 0, 0
	binary.BigEndian.PutUint16(legacy4[10:12], internetChecksum(legacy4[:headerLength]))
	legacyIGMP := legacy4[headerLength:]
	legacyIGMP[2], legacyIGMP[3] = 0, 0
	binary.BigEndian.PutUint16(legacyIGMP[2:4], internetChecksum(legacyIGMP))
	if err = link.WritePacket(legacy4); err != nil {
		t.Fatal(err)
	}
	wantLegacy4, _ := multicastGroupForIP(legacyGroup4)
	if !sender.subscriptions[wantLegacy4] {
		t.Fatal("IGMPv2 report Additional Data prevented subscription")
	}

	legacy6 := mldV1Packet(local6, legacyGroup6, legacyGroup6, 131)
	legacy6 = append(legacy6, 1, 2, 3, 4, 5, 6, 7, 8)
	binary.BigEndian.PutUint16(legacy6[4:6], uint16(len(legacy6)-40))
	legacyICMP := legacy6[48:]
	legacyICMP[2], legacyICMP[3] = 0, 0
	binary.BigEndian.PutUint16(legacyICMP[2:4], icmpv6Checksum(local6, legacyGroup6, legacyICMP))
	if err = link.WritePacket(legacy6); err != nil {
		t.Fatal(err)
	}
	wantLegacy6, _ := multicastGroupForIP(legacyGroup6)
	if !sender.subscriptions[wantLegacy6] {
		t.Fatal("MLDv1 report Additional Data prevented subscription")
	}
}

func TestUnknownMembershipRecordsDoNotBlockLaterRecords(t *testing.T) {
	const networkID = uint64(0x17d709436c04d6bc)
	local4 := netip.MustParseAddr("192.0.2.10")
	local6 := netip.MustParseAddr("fe80::10")
	group4 := netip.MustParseAddr("239.42.0.1")
	group6 := netip.MustParseAddr("ff05::4201")
	sender := &recordingSender{address: zerotier.NewAddress(0x0f1b56d269)}
	link, err := New(networkID, sender)
	if err != nil {
		t.Fatal(err)
	}
	if err = link.ApplyNetworkConfig(zerotier.NetworkConfigData{
		NetworkID: networkID, MulticastLimit: 32,
		Assigned: []netip.Prefix{netip.PrefixFrom(local4, 24), netip.PrefixFrom(local6, 64)},
	}); err != nil {
		t.Fatal(err)
	}

	igmp := make([]byte, 28)
	igmp[0], igmp[8], igmp[20] = 0x22, 99, 4
	binary.BigEndian.PutUint16(igmp[6:8], 2)
	binary.BigEndian.PutUint16(igmp[10:12], 1)
	copy(igmp[12:16], netip.MustParseAddr("239.42.0.9").AsSlice())
	copy(igmp[16:20], netip.MustParseAddr("239.1.2.3").AsSlice())
	copy(igmp[24:28], group4.AsSlice())
	binary.BigEndian.PutUint16(igmp[2:4], internetChecksum(igmp))
	report4 := make([]byte, 24+len(igmp))
	report4[0], report4[8], report4[9] = 0x46, 1, 2
	copy(report4[12:16], local4.AsSlice())
	copy(report4[16:20], netip.MustParseAddr("224.0.0.22").AsSlice())
	copy(report4[20:24], []byte{148, 4, 0, 0})
	copy(report4[24:], igmp)
	binary.BigEndian.PutUint16(report4[2:4], uint16(len(report4)))
	binary.BigEndian.PutUint16(report4[10:12], internetChecksum(report4[:24]))
	if err = link.WritePacket(report4); err != nil {
		t.Fatal(err)
	}
	want4, _ := multicastGroupForIP(group4)
	if !sender.subscriptions[want4] {
		t.Fatal("unknown IGMPv3 record blocked a later recognized record")
	}

	icmp := make([]byte, 64)
	icmp[0], icmp[8], icmp[44] = 143, 99, 4
	binary.BigEndian.PutUint16(icmp[6:8], 2)
	binary.BigEndian.PutUint16(icmp[10:12], 1)
	copy(icmp[12:28], netip.MustParseAddr("ff05::4209").AsSlice())
	copy(icmp[28:44], netip.MustParseAddr("ff05::ffff").AsSlice())
	copy(icmp[48:64], group6.AsSlice())
	target6 := netip.MustParseAddr("ff02::16")
	binary.BigEndian.PutUint16(icmp[2:4], icmpv6Checksum(local6, target6, icmp))
	hopByHop := []byte{58, 0, 5, 2, 0, 0, 1, 0}
	report6 := ipv6Packet(local6, target6, 0, append(hopByHop, icmp...))
	report6[7] = 1
	if err = link.WritePacket(report6); err != nil {
		t.Fatal(err)
	}
	want6, _ := multicastGroupForIP(group6)
	if !sender.subscriptions[want6] {
		t.Fatal("unknown MLDv2 record blocked a later recognized record")
	}
}

func TestMembershipRouterAlertValidation(t *testing.T) {
	if routerAlert, valid := ipv4MembershipOptions(nil); routerAlert || !valid {
		t.Fatalf("empty IPv4 options = alert %v valid %v", routerAlert, valid)
	}
	if !ipv4MembershipRouterAlert([]byte{148, 4, 0, 0, 1, 0, 0, 0}) {
		t.Fatal("valid IPv4 Router Alert with padding was rejected")
	}
	if _, valid := ipv4MembershipOptions([]byte{131, 3, 4, 0}); valid {
		t.Fatal("IPv4 source-route option was accepted for membership traffic")
	}
	if ipv4MembershipRouterAlert([]byte{148, 4, 0, 0, 0x44, 4, 0}) {
		t.Fatal("IPv4 Router Alert accepted a malformed trailing option")
	}
	if ipv4MembershipRouterAlert([]byte{148, 4, 0, 0, 148, 4, 0, 0}) {
		t.Fatal("duplicate IPv4 Router Alert was accepted")
	}

	packet := make([]byte, 48)
	packet[6], packet[40], packet[41] = 0, 58, 0
	copy(packet[42:48], []byte{5, 2, 0, 0, 1, 0})
	if !ipv6MembershipRouterAlert(packet) {
		t.Fatal("valid IPv6 Router Alert with PadN was rejected")
	}
	copy(packet[42:48], []byte{5, 2, 0, 0, 0x22, 7})
	if ipv6MembershipRouterAlert(packet) {
		t.Fatal("IPv6 Router Alert accepted a malformed trailing option")
	}
	packet = make([]byte, 56)
	packet[6], packet[40], packet[41] = 0, 58, 1
	copy(packet[42:56], []byte{5, 2, 0, 0, 5, 2, 0, 0, 1, 4, 0, 0, 0, 0})
	if ipv6MembershipRouterAlert(packet) {
		t.Fatal("duplicate IPv6 Router Alert was accepted")
	}
}

func TestMulticastGroupForIPValidatesIPv6FlagsAndScope(t *testing.T) {
	for _, address := range []string{
		"ff02::1234",
		"ff32::1234",
		"ff72::1234",
	} {
		if _, valid := multicastGroupForIP(netip.MustParseAddr(address)); !valid {
			t.Fatalf("valid IPv6 multicast group %s was rejected", address)
		}
	}
	for _, address := range []string{
		"ff00::1234", // Scope zero is reserved.
		"ff01::1234", // Interface-local traffic cannot enter ZeroTier.
		"ff0f::1234", // Scope fifteen is reserved.
		"ff22::1234", // P requires T.
		"ff42::1234", // R requires P.
		"ff82::1234", // The high flag bit is reserved.
	} {
		if _, valid := multicastGroupForIP(netip.MustParseAddr(address)); valid {
			t.Fatalf("invalid IPv6 multicast group %s was accepted", address)
		}
	}
}

func TestInboundLegacyReportsAreConsumedBeforeL3Suppression(t *testing.T) {
	const networkID = uint64(0x17d709436c04d6bc)
	link, err := New(networkID, &recordingSender{address: zerotier.NewAddress(0x0f1b56d269)})
	if err != nil {
		t.Fatal(err)
	}
	if err = link.ApplyNetworkConfig(zerotier.NetworkConfigData{
		NetworkID: networkID, MulticastLimit: 32,
		Assigned: []netip.Prefix{netip.MustParsePrefix("192.0.2.10/24"), netip.MustParsePrefix("fe80::10/64")},
	}); err != nil {
		t.Fatal(err)
	}
	group4 := netip.MustParseAddr("239.11.12.13")
	report4 := legacyIGMPPacket(netip.MustParseAddr("192.0.2.20"), group4, group4, 0x16, 0, true)
	frame4 := zerotier.Frame{NetworkID: networkID, EtherType: zerotier.EtherTypeIPv4, Payload: report4}
	if packet, handleErr := link.HandleFrame(frame4); handleErr != nil || packet != nil {
		t.Fatalf("valid IGMPv2 Report returned packet=%x error=%v", packet, handleErr)
	}
	paddedReport4 := append(append([]byte(nil), report4...), make([]byte, 46-len(report4))...)
	if packet, handleErr := link.HandleFrame(zerotier.Frame{NetworkID: networkID, EtherType: zerotier.EtherTypeIPv4, Payload: paddedReport4}); handleErr != nil || packet != nil {
		t.Fatalf("padded IGMPv2 Report returned packet=%x error=%v", packet, handleErr)
	}
	report4[len(report4)-1] ^= 1
	if packet, handleErr := link.HandleFrame(frame4); handleErr != nil || !bytes.Equal(packet, report4) {
		t.Fatalf("invalid IGMPv2 Report returned packet=%x error=%v", packet, handleErr)
	}
	otherGroup4 := netip.MustParseAddr("239.11.12.14")
	if err = link.WritePacket(legacyIGMPPacket(netip.MustParseAddr("192.0.2.10"), otherGroup4, otherGroup4, 0x16, 0, true)); err != nil {
		t.Fatal(err)
	}
	crossTarget4 := legacyIGMPPacket(netip.MustParseAddr("192.0.2.20"), otherGroup4, group4, 0x16, 0, true)
	if packet, handleErr := link.HandleFrame(zerotier.Frame{NetworkID: networkID, EtherType: zerotier.EtherTypeIPv4, Payload: crossTarget4}); handleErr != nil || packet != nil {
		t.Fatalf("cross-group IGMPv2 Report returned packet=%x error=%v", packet, handleErr)
	}

	group6 := netip.MustParseAddr("ff05::1234")
	report6 := mldV1Packet(netip.MustParseAddr("fe80::20"), group6, group6, 131)
	frame6 := zerotier.Frame{NetworkID: networkID, EtherType: zerotier.EtherTypeIPv6, Payload: report6}
	if packet, handleErr := link.HandleFrame(frame6); handleErr != nil || packet != nil {
		t.Fatalf("valid MLDv1 Report returned packet=%x error=%v", packet, handleErr)
	}
	atomicReport6 := ipv6AtomicFragment(mldV1Packet(netip.MustParseAddr("fe80::20"), group6, group6, 131))
	if packet, handleErr := link.HandleFrame(zerotier.Frame{NetworkID: networkID, EtherType: zerotier.EtherTypeIPv6, Payload: atomicReport6}); handleErr != nil || packet != nil {
		t.Fatalf("atomic MLDv1 Report returned packet=%x error=%v", packet, handleErr)
	}
	report6[len(report6)-1] ^= 1
	if packet, handleErr := link.HandleFrame(frame6); handleErr != nil || !bytes.Equal(packet, report6) {
		t.Fatalf("invalid MLDv1 Report returned packet=%x error=%v", packet, handleErr)
	}
	otherGroup6 := netip.MustParseAddr("ff05::1235")
	if err = link.WritePacket(mldV1Packet(netip.MustParseAddr("fe80::10"), otherGroup6, otherGroup6, 131)); err != nil {
		t.Fatal(err)
	}
	crossTarget6 := mldV1Packet(netip.MustParseAddr("fe80::20"), otherGroup6, group6, 131)
	if packet, handleErr := link.HandleFrame(zerotier.Frame{NetworkID: networkID, EtherType: zerotier.EtherTypeIPv6, Payload: crossTarget6}); handleErr != nil || packet != nil {
		t.Fatalf("cross-group MLDv1 Report returned packet=%x error=%v", packet, handleErr)
	}
}

func TestIPv6PayloadDoesNotInterpretZeroLengthFramePadding(t *testing.T) {
	packet := mldGeneralQueryPacket(netip.MustParseAddr("fe80::20"), 1000, 2, 125, true, nil)
	binary.BigEndian.PutUint16(packet[4:6], 0)
	if payload, protocol, fragmented, ok := ipv6Payload(packet); ok || payload != nil || protocol != 0 || fragmented {
		t.Fatalf("zero-length IPv6 payload = %x, protocol %d, fragmented %v, valid %v", payload, protocol, fragmented, ok)
	}
}

func TestIPv6PayloadRejectsInvalidExtensionOrder(t *testing.T) {
	query := mldGeneralQueryPacket(netip.MustParseAddr("fe80::20"), 1000, 2, 125, true, nil)
	misordered := make([]byte, len(query)+8)
	copy(misordered[:40], query[:40])
	misordered[6] = 60
	copy(misordered[40:48], []byte{0, 0, 1, 0, 0, 0, 0, 0})
	copy(misordered[48:], query[40:])
	binary.BigEndian.PutUint16(misordered[4:6], uint16(len(misordered)-40))
	if _, _, _, valid := ipv6Payload(misordered); valid {
		t.Fatal("Hop-by-Hop header after Destination Options was accepted")
	}

	duplicateFragment := ipv6AtomicFragment(ipv6AtomicFragment(query))
	duplicateFragment[48] = 44
	if _, _, _, valid := ipv6Payload(duplicateFragment); valid {
		t.Fatal("duplicate IPv6 Fragment Header was accepted")
	}

	badOption := insertIPv6Extension(query, 60, []byte{58, 0, 0x40, 0, 1, 0, 0, 0})
	if _, _, _, valid := ipv6Payload(badOption); valid {
		t.Fatal("discard-class IPv6 Destination Option was accepted")
	}
	activeRoute := insertIPv6Extension(query, 43, []byte{58, 0, 0, 1, 0, 0, 0, 0})
	if _, _, _, valid := ipv6Payload(activeRoute); valid {
		t.Fatal("IPv6 Routing Header with Segments Left was accepted")
	}
}

func TestMembershipExpiresOnlyAfterUnansweredQuery(t *testing.T) {
	const networkID = uint64(0x17d709436c04d6bc)
	now := time.Unix(1000, 0)
	sender := &recordingSender{address: zerotier.NewAddress(0x0f1b56d269)}
	link, err := New(networkID, sender)
	if err != nil {
		t.Fatal(err)
	}
	link.now = func() time.Time { return now }
	if err = link.ApplyNetworkConfig(zerotier.NetworkConfigData{
		NetworkID: networkID, MulticastLimit: 32,
		Assigned: []netip.Prefix{netip.MustParsePrefix("192.0.2.10/24")},
	}); err != nil {
		t.Fatal(err)
	}
	group := netip.MustParseAddr("239.21.22.23")
	report := legacyIGMPPacket(netip.MustParseAddr("192.0.2.10"), group, group, 0x12, 0, false)
	if err = link.WritePacket(report); err != nil {
		t.Fatal(err)
	}
	want, _ := multicastGroupForIP(group)
	now = now.Add(24 * time.Hour)
	if err = link.ProcessBackgroundTasks(now); err != nil {
		t.Fatal(err)
	}
	if !sender.subscriptions[want] {
		t.Fatal("IGMPv1 membership expired without evidence from a Query")
	}
	queryAt := now
	query := legacyIGMPPacket(netip.MustParseAddr("192.0.2.20"), netip.MustParseAddr("224.0.0.1"), netip.IPv4Unspecified(), 0x11, 0, false)
	paddedQuery := append(append([]byte(nil), query...), make([]byte, 46-len(query))...)
	if packet, handleErr := link.HandleFrame(zerotier.Frame{NetworkID: networkID, EtherType: zerotier.EtherTypeIPv4, Payload: paddedQuery}); handleErr != nil || !bytes.Equal(packet, paddedQuery) {
		t.Fatalf("IGMPv1 Query returned packet=%x error=%v", packet, handleErr)
	}
	membershipInterval := time.Duration(membershipDefaultRobustness)*membershipDefaultQueryInterval + 2*membershipDefaultResponseTime
	now = queryAt.Add(membershipInterval)
	if err = link.ProcessBackgroundTasks(now); err != nil {
		t.Fatal(err)
	}
	if sender.subscriptions[want] {
		t.Fatal("unanswered General Query retained stale membership")
	}

	now = now.Add(time.Second)
	if err = link.WritePacket(report); err != nil {
		t.Fatal(err)
	}
	queryAt = now.Add(time.Second)
	now = queryAt
	if _, err = link.HandleFrame(zerotier.Frame{NetworkID: networkID, EtherType: zerotier.EtherTypeIPv4, Payload: query}); err != nil {
		t.Fatal(err)
	}
	now = now.Add(time.Second)
	if err = link.WritePacket(report); err != nil {
		t.Fatal(err)
	}
	now = queryAt.Add(membershipInterval)
	if err = link.ProcessBackgroundTasks(now); err != nil {
		t.Fatal(err)
	}
	if !sender.subscriptions[want] {
		t.Fatal("response during the membership interval was expired")
	}
}

func TestGeneralQueryMembershipIntervals(t *testing.T) {
	const networkID = uint64(0x17d709436c04d6bc)
	local4 := netip.MustParseAddr("192.0.2.10")
	querier4 := netip.MustParseAddr("192.0.2.20")
	group4 := netip.MustParseAddr("239.21.22.23")
	local6 := netip.MustParseAddr("fe80::10")
	querier6 := netip.MustParseAddr("fe80::20")
	group6 := netip.MustParseAddr("ff05::1234")
	allSystems := netip.MustParseAddr("224.0.0.1")
	tests := []struct {
		name     string
		v6       bool
		query    []byte
		interval time.Duration
	}{
		{
			name:     "IGMPv1",
			query:    legacyIGMPPacket(querier4, allSystems, netip.IPv4Unspecified(), 0x11, 0, false),
			interval: 2*membershipDefaultQueryInterval + 2*membershipDefaultResponseTime,
		},
		{
			name:     "IGMPv2",
			query:    legacyIGMPPacket(querier4, allSystems, netip.IPv4Unspecified(), 0x11, 50, true),
			interval: 2*membershipDefaultQueryInterval + 10*time.Second,
		},
		{
			name:     "IGMPv3",
			query:    igmpV3GeneralQueryPacket(querier4, 20, 3, 10, []byte{0xde, 0xad, 0xbe, 0xef}),
			interval: 34 * time.Second,
		},
		{
			name:     "MLDv1",
			v6:       true,
			query:    mldGeneralQueryPacket(querier6, 3000, 0, 0, false, nil),
			interval: 2*membershipDefaultQueryInterval + 3*time.Second,
		},
		{
			name:     "MLDv2",
			v6:       true,
			query:    mldGeneralQueryPacket(querier6, 2000, 3, 10, true, []byte{0xde, 0xad, 0xbe, 0xef}),
			interval: 32 * time.Second,
		},
	}
	for _, test := range tests {
		t.Run(test.name, func(t *testing.T) {
			now := time.Unix(1000, 0)
			sender := &recordingSender{address: zerotier.NewAddress(0x0f1b56d269)}
			link, err := New(networkID, sender)
			if err != nil {
				t.Fatal(err)
			}
			link.now = func() time.Time { return now }
			if err = link.ApplyNetworkConfig(zerotier.NetworkConfigData{
				NetworkID: networkID, MulticastLimit: 32,
				Assigned: []netip.Prefix{netip.PrefixFrom(local4, 24), netip.PrefixFrom(local6, 64)},
			}); err != nil {
				t.Fatal(err)
			}
			group := group4
			report := legacyIGMPPacket(local4, group4, group4, 0x16, 0, true)
			etherType := uint16(zerotier.EtherTypeIPv4)
			if test.v6 {
				group = group6
				report = mldV1Packet(local6, group6, group6, 131)
				etherType = zerotier.EtherTypeIPv6
			}
			if err = link.WritePacket(report); err != nil {
				t.Fatal(err)
			}
			now = now.Add(time.Second)
			if packet, handleErr := link.HandleFrame(zerotier.Frame{NetworkID: networkID, EtherType: etherType, Payload: test.query}); handleErr != nil || !bytes.Equal(packet, test.query) {
				t.Fatalf("General Query returned packet=%x error=%v", packet, handleErr)
			}
			link.mu.RLock()
			deadline := link.reportedMemberships[group].queryDeadline
			link.mu.RUnlock()
			wantDeadline := now.Add(test.interval)
			if !deadline.Equal(wantDeadline) {
				t.Fatalf("membership deadline = %v, want %v", deadline, wantDeadline)
			}
			zeroTierGroup, _ := multicastGroupForIP(group)
			if err = link.ProcessBackgroundTasks(wantDeadline.Add(-time.Nanosecond)); err != nil {
				t.Fatal(err)
			}
			if !sender.subscriptions[zeroTierGroup] {
				t.Fatal("membership expired before its standards-based interval")
			}
			if err = link.ProcessBackgroundTasks(wantDeadline); err != nil {
				t.Fatal(err)
			}
			if sender.subscriptions[zeroTierGroup] {
				t.Fatal("unanswered membership remained at its expiry deadline")
			}
		})
	}
}

func TestOnlyValidGeneralQueriesAgeMembership(t *testing.T) {
	const networkID = uint64(0x17d709436c04d6bc)
	local := netip.MustParseAddr("192.0.2.10")
	querier := netip.MustParseAddr("192.0.2.20")
	group := netip.MustParseAddr("239.31.32.33")
	link, err := New(networkID, &recordingSender{address: zerotier.NewAddress(0x0f1b56d269)})
	if err != nil {
		t.Fatal(err)
	}
	now := time.Unix(1000, 0)
	link.now = func() time.Time { return now }
	if err = link.ApplyNetworkConfig(zerotier.NetworkConfigData{
		NetworkID: networkID, MulticastLimit: 32, Assigned: []netip.Prefix{netip.PrefixFrom(local, 24)},
	}); err != nil {
		t.Fatal(err)
	}
	if err = link.WritePacket(legacyIGMPPacket(local, group, group, 0x16, 0, true)); err != nil {
		t.Fatal(err)
	}
	now = now.Add(time.Second)
	missingAlert := legacyIGMPPacket(querier, netip.MustParseAddr("224.0.0.1"), netip.IPv4Unspecified(), 0x11, 100, false)
	groupSpecific := legacyIGMPPacket(querier, group, group, 0x11, 100, true)
	badChecksum := append([]byte(nil), missingAlert...)
	badChecksum[len(badChecksum)-1] ^= 1
	reservedFlag := legacyIGMPPacket(querier, netip.MustParseAddr("224.0.0.1"), netip.IPv4Unspecified(), 0x11, 100, true)
	binary.BigEndian.PutUint16(reservedFlag[6:8], binary.BigEndian.Uint16(reservedFlag[6:8])|0x8000)
	binary.BigEndian.PutUint16(reservedFlag[10:12], 0)
	binary.BigEndian.PutUint16(reservedFlag[10:12], internetChecksum(reservedFlag[:int(reservedFlag[0]&0x0f)*4]))
	for name, query := range map[string][]byte{
		"missing Router Alert": missingAlert,
		"group specific":       groupSpecific,
		"bad checksum":         badChecksum,
		"reserved IPv4 flag":   reservedFlag,
	} {
		t.Run(name, func(t *testing.T) {
			if packet, handleErr := link.HandleFrame(zerotier.Frame{NetworkID: networkID, EtherType: zerotier.EtherTypeIPv4, Payload: query}); handleErr != nil || !bytes.Equal(packet, query) {
				t.Fatalf("Query returned packet=%x error=%v", packet, handleErr)
			}
			link.mu.RLock()
			deadline := link.reportedMemberships[group].queryDeadline
			link.mu.RUnlock()
			if !deadline.IsZero() {
				t.Fatalf("non-General or invalid Query set deadline %v", deadline)
			}
		})
	}
}

func TestMembershipReportRejectsReservedIPv4Flag(t *testing.T) {
	const networkID = uint64(0x17d709436c04d6bc)
	sender := &recordingSender{address: zerotier.NewAddress(0x0f1b56d269)}
	link, err := New(networkID, sender)
	if err != nil {
		t.Fatal(err)
	}
	if err = link.ApplyNetworkConfig(zerotier.NetworkConfigData{
		NetworkID: networkID, MulticastLimit: 32,
		Assigned: []netip.Prefix{netip.MustParsePrefix("192.0.2.10/24")},
	}); err != nil {
		t.Fatal(err)
	}
	group := netip.MustParseAddr("239.52.53.54")
	report := legacyIGMPPacket(netip.MustParseAddr("192.0.2.10"), group, group, 0x16, 0, true)
	binary.BigEndian.PutUint16(report[6:8], binary.BigEndian.Uint16(report[6:8])|0x8000)
	binary.BigEndian.PutUint16(report[10:12], 0)
	binary.BigEndian.PutUint16(report[10:12], internetChecksum(report[:int(report[0]&0x0f)*4]))
	if err = link.WritePacket(report); err != nil {
