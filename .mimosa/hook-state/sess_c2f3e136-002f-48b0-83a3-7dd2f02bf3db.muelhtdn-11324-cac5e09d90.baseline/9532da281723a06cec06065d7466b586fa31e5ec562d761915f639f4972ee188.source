		}
	}
}

func FuzzMembershipPacketHandling(f *testing.F) {
	local4 := netip.MustParseAddr("192.0.2.10")
	local6 := netip.MustParseAddr("fe80::10")
	group4 := netip.MustParseAddr("239.10.11.12")
	group6 := netip.MustParseAddr("ff02::1011")
	querier4 := netip.MustParseAddr("192.0.2.1")
	querier6 := netip.MustParseAddr("fe80::1")
	f.Add(byte(0), legacyIGMPPacket(local4, group4, group4, 0x16, 0, true))
	f.Add(byte(0), igmpv3ReportPacket(local4, group4, 4, []netip.Addr{querier4}))
	f.Add(byte(0), mldV1Packet(local6, group6, group6, 131))
	f.Add(byte(1), legacyIGMPPacket(querier4, netip.MustParseAddr("224.0.0.1"), netip.IPv4Unspecified(), 0x11, 10, true))
	f.Add(byte(1), mldGeneralQueryPacket(querier6, 1000, 2, 125, true, nil))
	f.Fuzz(func(t *testing.T, inbound byte, packet []byte) {
		const networkID = uint64(0x17d709436c04d6bc)
		sender := &recordingSender{address: zerotier.NewAddress(0x0f1b56d269)}
		link, err := New(networkID, sender)
		if err != nil {
			t.Fatal(err)
		}
		if err = link.ApplyNetworkConfig(zerotier.NetworkConfigData{
			NetworkID: networkID, MTU: zerotier.MaxNetworkMTU, MulticastLimit: 32,
			Assigned: []netip.Prefix{netip.PrefixFrom(local4, 24), netip.PrefixFrom(local6, 64)},
		}); err != nil {
			t.Fatal(err)
		}
		if inbound&1 == 0 {
			_ = link.WritePacket(packet)
			return
		}
		etherType := uint16(0)
		if len(packet) != 0 {
			switch packet[0] >> 4 {
			case 4:
				etherType = zerotier.EtherTypeIPv4
			case 6:
				etherType = zerotier.EtherTypeIPv6
			}
		}
		_, _ = link.HandleFrame(zerotier.Frame{NetworkID: networkID, EtherType: etherType, Payload: packet})
	})
}

func arpPacket(operation uint16, senderMAC zerotier.MAC, senderIP netip.Addr, targetMAC zerotier.MAC, targetIP netip.Addr) []byte {
	payload := make([]byte, 28)
	binary.BigEndian.PutUint16(payload[0:2], 1)
	binary.BigEndian.PutUint16(payload[2:4], zerotier.EtherTypeIPv4)
	payload[4], payload[5] = 6, 4
	binary.BigEndian.PutUint16(payload[6:8], operation)
	senderMACBytes := senderMAC.Bytes()
	copy(payload[8:14], senderMACBytes[:])
	copy(payload[14:18], senderIP.AsSlice())
	targetMACBytes := targetMAC.Bytes()
	copy(payload[18:24], targetMACBytes[:])
	copy(payload[24:28], targetIP.AsSlice())
	return payload
}

func ipv4Packet(source, destination netip.Addr, protocol byte) []byte {
	packet := make([]byte, 20)
	packet[0], packet[9] = 0x45, protocol
	binary.BigEndian.PutUint16(packet[2:4], uint16(len(packet)))
	copy(packet[12:16], source.AsSlice())
	copy(packet[16:20], destination.AsSlice())
	return packet
}

func legacyIGMPPacket(source, target, group netip.Addr, messageType, responseCode byte, routerAlert bool) []byte {
	igmp := make([]byte, 8)
	igmp[0], igmp[1] = messageType, responseCode
	copy(igmp[4:8], group.AsSlice())
	binary.BigEndian.PutUint16(igmp[2:4], internetChecksum(igmp))
	headerLength := 20
	if routerAlert {
		headerLength = 24
	}
	packet := make([]byte, headerLength+len(igmp))
	packet[0], packet[8], packet[9] = 0x45, 1, 2
	if routerAlert {
		packet[0] = 0x46
		copy(packet[20:24], []byte{148, 4, 0, 0})
	}
	binary.BigEndian.PutUint16(packet[2:4], uint16(len(packet)))
	copy(packet[12:16], source.AsSlice())
	copy(packet[16:20], target.AsSlice())
	binary.BigEndian.PutUint16(packet[10:12], internetChecksum(packet[:headerLength]))
	copy(packet[headerLength:], igmp)
	return packet
}

func igmpV3GeneralQueryPacket(source netip.Addr, responseCode, robustness, queryInterval byte, additional []byte) []byte {
	igmp := make([]byte, 12+len(additional))
	igmp[0], igmp[1], igmp[8], igmp[9] = 0x11, responseCode, robustness&7, queryInterval
	copy(igmp[12:], additional)
	binary.BigEndian.PutUint16(igmp[2:4], internetChecksum(igmp))
	packet := make([]byte, 24+len(igmp))
	packet[0], packet[8], packet[9] = 0x46, 1, 2
	copy(packet[12:16], source.AsSlice())
	copy(packet[16:20], netip.MustParseAddr("224.0.0.1").AsSlice())
	copy(packet[20:24], []byte{148, 4, 0, 0})
	copy(packet[24:], igmp)
	binary.BigEndian.PutUint16(packet[2:4], uint16(len(packet)))
	binary.BigEndian.PutUint16(packet[10:12], internetChecksum(packet[:24]))
	return packet
}

func mldV1Packet(source, target, group netip.Addr, messageType byte) []byte {
	icmp := make([]byte, 24)
	icmp[0] = messageType
	copy(icmp[8:24], group.AsSlice())
	binary.BigEndian.PutUint16(icmp[2:4], icmpv6Checksum(source, target, icmp))
	hopByHop := []byte{58, 0, 5, 2, 0, 0, 1, 0}
	packet := ipv6Packet(source, target, 0, append(hopByHop, icmp...))
	packet[7] = 1
	return packet
}

func mldGeneralQueryPacket(source netip.Addr, responseCode uint16, robustness, queryInterval byte, v2 bool, additional []byte) []byte {
	target := netip.MustParseAddr("ff02::1")
	length := 24
	if v2 {
		length = 28
	}
	icmp := make([]byte, length+len(additional))
	icmp[0] = 130
	binary.BigEndian.PutUint16(icmp[4:6], responseCode)
	if v2 {
		icmp[24], icmp[25] = robustness&7, queryInterval
	}
	copy(icmp[length:], additional)
	binary.BigEndian.PutUint16(icmp[2:4], icmpv6Checksum(source, target, icmp))
	hopByHop := []byte{58, 0, 5, 2, 0, 0, 1, 0}
	packet := ipv6Packet(source, target, 0, append(hopByHop, icmp...))
	packet[7] = 1
	return packet
}

// ipv6AtomicFragment inserts an RFC 8200 atomic Fragment header after the
// mandatory Hop-by-Hop header used by the MLD test packet.
func ipv6AtomicFragment(packet []byte) []byte {
	fragmented := make([]byte, len(packet)+8)
	copy(fragmented[:48], packet[:48])
	fragmented[40] = 44
	fragmented[48] = 58
	copy(fragmented[56:], packet[48:])
	binary.BigEndian.PutUint16(fragmented[4:6], uint16(len(fragmented)-40))
	return fragmented
}

// insertIPv6Extension places one eight-byte header after an MLD packet's
// mandatory Hop-by-Hop header.
func insertIPv6Extension(packet []byte, extension byte, header []byte) []byte {
	result := make([]byte, len(packet)+len(header))
	copy(result[:48], packet[:48])
	result[40] = extension
	copy(result[48:48+len(header)], header)
	copy(result[48+len(header):], packet[48:])
	binary.BigEndian.PutUint16(result[4:6], uint16(len(result)-40))
	return result
}

func igmpv3ReportPacket(source, group netip.Addr, recordType byte, sources []netip.Addr) []byte {
	igmp := make([]byte, 16+4*len(sources))
	igmp[0], igmp[8] = 0x22, recordType
	binary.BigEndian.PutUint16(igmp[6:8], 1)
	binary.BigEndian.PutUint16(igmp[10:12], uint16(len(sources)))
	copy(igmp[12:16], group.AsSlice())
	offset := 16
	for _, address := range sources {
		copy(igmp[offset:offset+4], address.AsSlice())
		offset += 4
	}
	binary.BigEndian.PutUint16(igmp[2:4], internetChecksum(igmp))
	packet := make([]byte, 24+len(igmp))
	packet[0], packet[8], packet[9] = 0x46, 1, 2
	copy(packet[12:16], source.AsSlice())
	copy(packet[16:20], netip.MustParseAddr("224.0.0.22").AsSlice())
	copy(packet[20:24], []byte{148, 4, 0, 0})
	copy(packet[24:], igmp)
	binary.BigEndian.PutUint16(packet[2:4], uint16(len(packet)))
	binary.BigEndian.PutUint16(packet[10:12], internetChecksum(packet[:24]))
	return packet
}

func ipv6Packet(source, destination netip.Addr, nextHeader byte, payload []byte) []byte {
	packet := make([]byte, 40+len(payload))
	packet[0], packet[6], packet[7] = 0x60, nextHeader, 64
	binary.BigEndian.PutUint16(packet[4:6], uint16(len(payload)))
	copy(packet[8:24], source.AsSlice())
	copy(packet[24:40], destination.AsSlice())
	copy(packet[40:], payload)
	return packet
}
