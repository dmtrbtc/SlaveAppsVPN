func TestSourceFilteredReportsReleaseLastMulticastSubscription(t *testing.T) {
	const networkID = uint64(0x17d709436c04d6bc)
	sender := &recordingSender{address: zerotier.NewAddress(0x0f1b56d269)}
	link, err := New(networkID, sender)
	if err != nil {
		t.Fatal(err)
	}
	if err = link.ApplyNetworkConfig(zerotier.NetworkConfigData{NetworkID: networkID, MulticastLimit: 32, Assigned: []netip.Prefix{netip.MustParsePrefix("192.0.2.10/24")}}); err != nil {
		t.Fatal(err)
	}
	group := netip.MustParseAddr("239.1.2.3")
	first := netip.MustParseAddr("192.0.2.20")
	second := netip.MustParseAddr("192.0.2.21")
	want, _ := multicastGroupForIP(group)
	write := func(recordType byte, sources ...netip.Addr) {
		t.Helper()
		packet := igmpv3ReportPacket(netip.MustParseAddr("192.0.2.10"), group, recordType, sources)
		if writeErr := link.WritePacket(packet); writeErr != nil {
			t.Fatal(writeErr)
		}
	}
	write(5, first, second) // ALLOW_NEW_SOURCES
	if !sender.subscriptions[want] {
		t.Fatal("source-specific join did not subscribe the multicast group")
	}
	malformed := igmpv3ReportPacket(netip.MustParseAddr("192.0.2.10"), group, 6, []netip.Addr{first, second})
	headerLength := int(malformed[0]&0x0f) * 4
	igmp := malformed[headerLength:]
	binary.BigEndian.PutUint16(igmp[6:8], 2)
	igmp[2], igmp[3] = 0, 0
	binary.BigEndian.PutUint16(igmp[2:4], internetChecksum(igmp))
	if err = link.WritePacket(malformed); err != nil {
		t.Fatal(err)
	}
	if !sender.subscriptions[want] {
		t.Fatal("records preceding a truncated report tail were applied")
	}
	write(6, first) // BLOCK_OLD_SOURCES
	if !sender.subscriptions[want] {
		t.Fatal("removing one of two sources removed the group subscription")
	}
	write(6, second)
	if sender.subscriptions[want] {
		t.Fatal("removing the final INCLUDE source retained the group subscription")
	}
	write(4) // CHANGE_TO_EXCLUDE_MODE {}
	if !sender.subscriptions[want] {
		t.Fatal("any-source transition did not subscribe the group")
	}
	write(3) // CHANGE_TO_INCLUDE_MODE {}
	if sender.subscriptions[want] {
		t.Fatal("empty INCLUDE transition retained the group subscription")
	}
	link.mu.Lock()
	_, retained := link.reportedMemberships[group]
	link.mu.Unlock()
	if retained {
		t.Fatal("inactive source-filter state retained a historical group")
	}

	write(1, first)
	write(6, first)
	if !sender.subscriptions[want] {
		t.Fatal("partial current-state INCLUDE allowed an unsafe final unsubscribe")
	}
	write(3)
	if sender.subscriptions[want] {
		t.Fatal("authoritative empty transition did not clear a partial snapshot")
	}

	write(5, first) // Establish an exact INCLUDE snapshot.
	write(1, second)
	write(6, first, second)
	if !sender.subscriptions[want] {
		t.Fatal("current-state INCLUDE after an exact snapshot allowed an unsafe unsubscribe")
	}
	write(3)
	if sender.subscriptions[want] {
		t.Fatal("authoritative leave did not clear the conservative current-state snapshot")
	}

	write(5, first) // Establish an exact INCLUDE snapshot again.
	write(3, second)
	link.mu.Lock()
	filter := link.reportedMemberships[group]
	_, retainedFirst := filter.sources[first]
	_, retainedSecond := filter.sources[second]
	incomplete := filter.incomplete
	link.mu.Unlock()
	if retainedFirst || !retainedSecond || !incomplete {
		t.Fatalf("CHANGE_TO_INCLUDE replacement = first %t second %t incomplete %t", retainedFirst, retainedSecond, incomplete)
	}
	write(6, second)
	if !sender.subscriptions[want] {
		t.Fatal("split CHANGE_TO_INCLUDE allowed an unsafe final unsubscribe")
	}
	write(3)
	if sender.subscriptions[want] {
		t.Fatal("empty CHANGE_TO_INCLUDE did not clear split transition state")
	}
}

func TestIGMPMembershipReportsAcceptUnspecifiedSourceOnly(t *testing.T) {
	const networkID = uint64(0x17d709436c04d6bc)
	sender := &recordingSender{address: zerotier.NewAddress(0x0f1b56d269)}
	link, err := New(networkID, sender)
	if err != nil {
		t.Fatal(err)
	}
	if err = link.ApplyNetworkConfig(zerotier.NetworkConfigData{NetworkID: networkID, MulticastLimit: 32, Assigned: []netip.Prefix{netip.MustParsePrefix("192.0.2.10/24")}}); err != nil {
		t.Fatal(err)
	}
	group := netip.MustParseAddr("239.4.5.6")
	zeroSource := igmpv3ReportPacket(netip.IPv4Unspecified(), group, 4, nil)
	if err = link.WritePacket(zeroSource); err != nil {
		t.Fatal(err)
	}
	want, _ := multicastGroupForIP(group)
	if !sender.subscriptions[want] {
		t.Fatal("zero-source IGMP Membership Report did not subscribe the group")
	}
	link.applyMembershipRecords([]reportedMembershipRecord{{group: group, recordType: 3}})
	invalidSource := igmpv3ReportPacket(netip.MustParseAddr("0.1.2.3"), group, 4, nil)
	if err = link.WritePacket(invalidSource); err != nil {
		t.Fatal(err)
	}
	if sender.subscriptions[want] {
		t.Fatal("nonzero 0/8 IGMP Membership Report was accepted")
	}
}

func TestMembershipSnoopingRejectsMalformedPackets(t *testing.T) {
	const networkID = uint64(0x17d709436c04d6bc)
	local4 := netip.MustParseAddr("192.0.2.10")
	local6 := netip.MustParseAddr("fe80::10")
	group4 := netip.MustParseAddr("239.40.0.1")
	group6 := netip.MustParseAddr("ff05::4001")
	sender := &recordingSender{address: zerotier.NewAddress(0x0f1b56d269)}
	link, err := New(networkID, sender)
	if err != nil {
		t.Fatal(err)
	}
	if err = link.ApplyNetworkConfig(zerotier.NetworkConfigData{
		NetworkID: networkID, MulticastLimit: 32,
		Assigned: []netip.Prefix{netip.PrefixFrom(local4, 24), netip.PrefixFrom(local6, 64)},
	}); err != nil {
		t.Fatal(err)
	}
	want4, _ := multicastGroupForIP(group4)
	want6, _ := multicastGroupForIP(group6)
	assertInactive := func(group zerotier.MulticastGroup) {
		t.Helper()
		if sender.subscriptions[group] {
			t.Fatalf("malformed membership packet activated %v", group)
		}
	}

	badHeader := legacyIGMPPacket(local4, group4, group4, 0x16, 0, true)
	badHeader[1] ^= 1
	if err = link.WritePacket(badHeader); err != nil {
		t.Fatal(err)
	}
	assertInactive(want4)

	invalidSource := igmpv3ReportPacket(local4, group4, 4, []netip.Addr{netip.MustParseAddr("239.1.2.3")})
	if err = link.WritePacket(invalidSource); err != nil {
		t.Fatal(err)
	}
	assertInactive(want4)

	assertInactive(want6)
}

func TestReportedMulticastSourceTrackingIsBounded(t *testing.T) {
	const networkID = uint64(0x17d709436c04d6bc)
	sender := &recordingSender{address: zerotier.NewAddress(0x0f1b56d269)}
	link, err := New(networkID, sender)
	if err != nil {
		t.Fatal(err)
	}
	if err = link.ApplyNetworkConfig(zerotier.NetworkConfigData{NetworkID: networkID, Assigned: []netip.Prefix{netip.MustParsePrefix("10.0.0.1/8")}}); err != nil {
		t.Fatal(err)
	}
	group := netip.MustParseAddr("239.2.3.4")
	sources := make([]netip.Addr, maxReportedMulticastSources+1)
	for index := range sources {
		sources[index] = netip.AddrFrom4([4]byte{10, byte(index >> 8), byte(index), 2})
	}
	link.applyMembershipRecords([]reportedMembershipRecord{{group: group, recordType: 5, sources: sources}})
	link.mu.Lock()
	filter := link.reportedMemberships[group]
	retained, incomplete := len(filter.sources), filter.incomplete
	link.mu.Unlock()
	if retained != maxReportedMulticastSources || !incomplete {
		t.Fatalf("bounded report filter = %d sources incomplete=%v", retained, incomplete)
	}
	link.applyMembershipRecords([]reportedMembershipRecord{{group: group, recordType: 6, sources: sources}})
	want, _ := multicastGroupForIP(group)
	if !sender.subscriptions[want] {
		t.Fatal("overflowed source tracking allowed an unsafe unsubscribe")
	}
	link.applyMembershipRecords([]reportedMembershipRecord{{group: group, recordType: 3}})
	if sender.subscriptions[want] {
		t.Fatal("authoritative empty INCLUDE transition retained the group")
	}
}

func TestValidateIPv4RouteRequiresManagedIPv4Address(t *testing.T) {
	const networkID = uint64(0x17d709436c04d6bc)
	link, err := New(networkID, &recordingSender{address: zerotier.NewAddress(0x0f1b56d269)})
	if err != nil {
