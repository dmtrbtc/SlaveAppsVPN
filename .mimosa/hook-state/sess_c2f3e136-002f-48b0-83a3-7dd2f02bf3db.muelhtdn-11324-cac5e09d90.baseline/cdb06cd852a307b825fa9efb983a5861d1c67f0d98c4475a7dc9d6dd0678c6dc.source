package zerotier

import (
	"encoding/binary"
	"encoding/hex"
	"testing"
)

func TestCertificateOfMembershipVerificationAndAgreement(t *testing.T) {
	controller, err := GenerateIdentity()
	if err != nil {
		t.Fatal(err)
	}
	memberA, err := GenerateIdentity()
	if err != nil {
		t.Fatal(err)
	}
	memberB, err := GenerateIdentity()
	if err != nil {
		t.Fatal(err)
	}
	networkID := controller.Address().Uint64()<<24 | 0x1234
	certificateA := makeTestCOM(t, controller, memberA, networkID, 1000000)
	certificateB := makeTestCOM(t, controller, memberB, networkID, 1000100)

	parsed, consumed, err := ParseCertificateOfMembership(certificateA.raw)
	if err != nil {
		t.Fatal(err)
	}
	if consumed != len(certificateA.raw) || !parsed.Verify(controller) {
		t.Fatal("controller signature did not verify")
	}
	if parsed.NetworkID() != networkID || parsed.IssuedTo() != memberA.Address() {
		t.Fatalf("unexpected certificate fields: network=%016x member=%s", parsed.NetworkID(), parsed.IssuedTo())
	}
	if !parsed.AgreesWith(certificateB, memberB) {
		t.Fatal("certificates issued under the same membership policy did not agree")
	}
	certificateB.Qualifiers[3].Value++
	if parsed.AgreesWith(certificateB, memberB) {
		t.Fatal("certificate with a mismatched identity hash was accepted")
	}
}

func TestLegacyCertificateOfMembershipString(t *testing.T) {
	controller, err := GenerateIdentity()
	if err != nil {
		t.Fatal(err)
	}
	member, err := GenerateIdentity()
	if err != nil {
		t.Fatal(err)
	}
	networkID := controller.Address().Uint64()<<24 | 0x1234
	certificate := makeTestCOM(t, controller, member, networkID, 1000000)
	legacy := "1:" + hex.EncodeToString(certificate.signedData()) + ":" + certificate.SignedBy.String() + ":" + hex.EncodeToString(certificate.Signature[:])
	parsed, err := parseCertificateOfMembershipString(legacy)
	if err != nil {
		t.Fatal(err)
	}
	if !parsed.Verify(controller) || parsed.NetworkID() != networkID || parsed.IssuedTo() != member.Address() {
		t.Fatalf("legacy certificate = network %016x member %s signer %s", parsed.NetworkID(), parsed.IssuedTo(), parsed.SignedBy)
	}
	fromBinary, consumed, err := ParseCertificateOfMembership(parsed.Bytes())
	if err != nil || consumed != len(parsed.Bytes()) || !fromBinary.Verify(controller) {
		t.Fatalf("legacy certificate binary conversion: consumed=%d err=%v", consumed, err)
	}
}

func TestCertificateOfMembershipAgreementUsesLastDuplicateQualifier(t *testing.T) {
	member, err := GenerateIdentity()
	if err != nil {
		t.Fatal(err)
	}
	hash := member.publicKeyHash()
	wanted := binary.BigEndian.Uint64(hash[:8])
	template := CertificateOfMembership{Qualifiers: []COMQualifier{{ID: 3, Value: wanted}}}
	certificate := CertificateOfMembership{Qualifiers: []COMQualifier{
		{ID: 3, Value: wanted + 1},
		{ID: 3, Value: wanted},
		{ID: 4, Value: binary.BigEndian.Uint64(hash[8:16])},
		{ID: 5, Value: binary.BigEndian.Uint64(hash[16:24])},
		{ID: 6, Value: binary.BigEndian.Uint64(hash[24:32])},
	}}
	if !template.AgreesWith(certificate, member) {
		t.Fatal("agreement did not use the last repeated qualifier")
	}
	certificate.Qualifiers[1].Value++
	if template.AgreesWith(certificate, member) {
		t.Fatal("agreement ignored the last repeated qualifier")
	}
}

func TestCertificateOfMembershipAgreementAllocations(t *testing.T) {
	controller, err := GenerateIdentity()
	if err != nil {
		t.Fatal(err)
	}
	member, err := GenerateIdentity()
	if err != nil {
		t.Fatal(err)
	}
	networkID := controller.Address().Uint64()<<24 | 0x1234
	certificate := makeTestCOM(t, controller, member, networkID, 1000000)
	publicKeyHash := member.publicKeyHash()
	if allocations := testing.AllocsPerRun(1000, func() {
		if !certificate.agreesWithPublicKeyHash(certificate, publicKeyHash) {
			t.Fatal("certificate did not agree with itself")
		}
	}); allocations != 0 {
		t.Fatalf("agreement allocations = %v, want 0", allocations)
	}
}

func makeTestCOM(t *testing.T, controller, member Identity, networkID, timestamp uint64) CertificateOfMembership {
	t.Helper()
	hash := member.publicKeyHash()
	qualifiers := []COMQualifier{
		{ID: 0, Value: timestamp, MaxDelta: 1800000},
		{ID: 1, Value: networkID},
		{ID: 2, Value: member.Address().Uint64(), MaxDelta: ^uint64(0)},
	}
	for i := 0; i < 4; i++ {
		qualifiers = append(qualifiers, COMQualifier{ID: uint64(i + 3), Value: binary.BigEndian.Uint64(hash[i*8:]), MaxDelta: ^uint64(0)})
	}
	certificate := CertificateOfMembership{Qualifiers: qualifiers, SignedBy: controller.Address()}
	signature, err := controller.Sign(certificate.signedData())
	if err != nil {
		t.Fatal(err)
	}
	certificate.Signature = signature
	certificate.raw = []byte{1, 0, byte(len(qualifiers))}
	certificate.raw = append(certificate.raw, certificate.signedData()...)
	signer := controller.Address().Bytes()
	certificate.raw = append(certificate.raw, signer[:]...)
	certificate.raw = append(certificate.raw, signature[:]...)
	return certificate
}
