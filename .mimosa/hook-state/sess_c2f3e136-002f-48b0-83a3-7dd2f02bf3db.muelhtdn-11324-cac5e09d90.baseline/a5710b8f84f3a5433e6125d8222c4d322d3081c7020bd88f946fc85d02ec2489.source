func TestInvalidMulticastMACStillRefreshesAuthenticatedPeer(t *testing.T) {
	identity, remote, node, _ := newTestNodeWithPeer(t)
	const networkID = uint64(0x1234567890abcdef)
	node.mu.Lock()
	network := newNetwork(networkID)
	network.Status = NetworkStatusOK
	network.Config = NetworkConfigData{NetworkID: networkID, Type: NetworkTypePublic, MulticastLimit: 1, MTU: DefaultNetworkMTU}
	node.networks[networkID] = network
	node.mu.Unlock()

	packet, _ := NewPacket(identity.Address(), remote.Address(), VerbMulticastFrame)
	_ = packet.AppendUint64(networkID)
	_ = packet.Append(0)
	destination := MACForAddress(identity.Address(), networkID).Bytes()
	_ = packet.Append(destination[:]...)
	_ = packet.AppendUint32(0)
	_ = packet.AppendUint16(EtherTypeIPv4)
	_ = packet.Append(1)
	key, err := identity.Agree(remote)
	if err != nil {
		t.Fatal(err)
	}
	if err = packet.Armor(key[:], true); err != nil {
		t.Fatal(err)
	}
	if err = node.ProcessWirePacket(0, netip.MustParseAddrPort("198.51.100.55:9993"), packet.Bytes(), time.Now()); err != nil {
		t.Fatal(err)
	}
	node.mu.Lock()
	lastReceive := node.peers[remote.Address()].lastReceive
	node.mu.Unlock()
	if lastReceive.IsZero() {
		t.Fatal("invalid multicast frame did not refresh its authenticated peer")
	}
}

func TestExtFrameAcknowledgementFollowsOfficialValidation(t *testing.T) {
	identity, remoteIdentity, node, sent := newTestNodeWithPeer(t)
	const networkID = uint64(0x1234567890abcdef)
	node.mu.Lock()
	network := newNetwork(networkID)
	network.Status = NetworkStatusOK
	network.Config = NetworkConfigData{NetworkID: networkID, Type: NetworkTypePublic, Rules: []NetworkRule{{Type: ruleActionDrop}}}
	node.networks[networkID] = network
	node.mu.Unlock()
	key, err := remoteIdentity.Agree(identity)
	if err != nil {
		t.Fatal(err)
	}
	remote := netip.MustParseAddrPort("198.51.100.90:9993")

	run := func(name string, framePayload []byte, wantErr, wantACK bool) {
		t.Helper()
		*sent = nil
		packet, err := NewPacket(identity.Address(), remoteIdentity.Address(), VerbExtFrame)
		if err != nil {
			t.Fatal(err)
		}
		_ = packet.AppendUint64(networkID)
		_ = packet.Append(0x10)
		destination := MACForAddress(identity.Address(), networkID).Bytes()
		source := MACForAddress(remoteIdentity.Address(), networkID).Bytes()
		_ = packet.Append(destination[:]...)
		_ = packet.Append(source[:]...)
		_ = packet.AppendUint16(EtherTypeIPv4)
		_ = packet.Append(framePayload...)
		if name == "truncated" {
			packet.data = packet.data[:len(packet.data)-1]
		}
		if err = packet.Armor(key[:], true); err != nil {
			t.Fatal(err)
		}
		err = node.ProcessWirePacket(0, remote, packet.Bytes(), time.Now())
		if (err != nil) != wantErr {
			t.Fatalf("%s: error = %v", name, err)
		}
		foundACK := false
		for _, wire := range *sent {
			response, parseErr := ParsePacket(wire.data)
			if parseErr != nil || response.Dearmor(key[:]) != nil || response.Verb() != VerbOK {
				continue
			}
			payload := response.Payload()
			if len(payload) == 17 && Verb(payload[0]) == VerbExtFrame && binary.BigEndian.Uint64(payload[1:9]) == packet.PacketID() && binary.BigEndian.Uint64(payload[9:17]) == networkID {
				foundACK = true
			}
		}
		if foundACK != wantACK {
			t.Fatalf("%s: ACK = %t, want %t", name, foundACK, wantACK)
		}
	}

	run("header-only", nil, false, true)
	run("rule-drop", []byte{0x45}, false, true)
	run("truncated", nil, true, false)
}

func TestNeedCredentialsResponseUsesIncomingPath(t *testing.T) {
	identity, remoteIdentity, node, sent := newTestNodeWithPeer(t)
	const networkID = uint64(0x1234567890abcdef)
	now := time.Now()
	preferred := pathKey{localSocket: 1, endpoint: netip.MustParseAddrPort("198.51.100.91:9993")}
	incoming := pathKey{localSocket: 2, endpoint: netip.MustParseAddrPort("198.51.100.92:9993")}
	node.mu.Lock()
	peer := node.peers[remoteIdentity.Address()]
	node.addPeerPathLocked(peer, preferred, &peerPathState{lastReceive: now, latency: time.Millisecond, priority: 1}, now)
	node.addPeerPathLocked(peer, incoming, &peerPathState{lastReceive: now, latency: 100 * time.Millisecond, priority: 1}, now)
	network := newNetwork(networkID)
	network.Status = NetworkStatusOK
	network.Config = NetworkConfigData{NetworkID: networkID, Type: NetworkTypePrivate}
	node.networks[networkID] = network
	packet, err := NewPacket(identity.Address(), remoteIdentity.Address(), VerbFrame)
	if err == nil {
		err = packet.AppendUint64(networkID)
	}
	if err == nil {
		err = node.handleFrameLocked(incoming, packet, now)
	}
	node.mu.Unlock()
	if !errors.Is(err, errPacketRetry) {
		t.Fatalf("private frame error = %v, want retry", err)
	}
	if len(*sent) != 1 || (*sent)[0].remote != incoming.endpoint {
		t.Fatalf("credentials response path = %+v, want %s", *sent, incoming.endpoint)
	}
	key, err := identity.Agree(remoteIdentity)
	if err != nil {
		t.Fatal(err)
	}
	response, err := ParsePacket((*sent)[0].data)
	if err != nil || response.Dearmor(key[:]) != nil {
		t.Fatalf("decode credentials response: %v", err)
	}
	payload := response.Payload()
	if response.Verb() != VerbError || len(payload) != 18 || Verb(payload[0]) != VerbFrame || payload[9] != 0x06 || binary.BigEndian.Uint64(payload[10:]) != networkID {
		t.Fatalf("credentials response = verb %s payload %x", response.Verb(), payload)
	}
}

func TestMulticastFrameGatherResponseUsesIncomingPath(t *testing.T) {
	identity, remoteIdentity, node, sent := newTestNodeWithPeer(t)
	const networkID = uint64(0x1234567890abcdef)
	now := time.Now()
	preferred := pathKey{localSocket: 1, endpoint: netip.MustParseAddrPort("198.51.100.93:9993")}
	incoming := pathKey{localSocket: 2, endpoint: netip.MustParseAddrPort("198.51.100.94:9993")}
	group := MulticastGroup{MAC: NewMAC(0xffffffffffff), ADI: 0xc000020a}
	node.mu.Lock()
	peer := node.peers[remoteIdentity.Address()]
	node.addPeerPathLocked(peer, preferred, &peerPathState{lastReceive: now, latency: time.Millisecond, priority: 1}, now)
	node.addPeerPathLocked(peer, incoming, &peerPathState{lastReceive: now, latency: 100 * time.Millisecond, priority: 1}, now)
	network := newNetwork(networkID)
	network.Status = NetworkStatusOK
	network.Config = NetworkConfigData{NetworkID: networkID, Type: NetworkTypePublic, MulticastLimit: 4}
	network.multicastSubscriptions[group] = struct{}{}
	node.networks[networkID] = network
	packet, err := NewPacket(identity.Address(), remoteIdentity.Address(), VerbMulticastFrame)
	if err == nil {
		err = packet.AppendUint64(networkID)
	}
	if err == nil {
		err = packet.Append(0x02)
	}
	if err == nil {
		err = packet.AppendUint32(4)
	}
	mac := group.MAC.Bytes()
	if err == nil {
		err = packet.Append(mac[:]...)
	}
	if err == nil {
		err = packet.AppendUint32(group.ADI)
	}
	if err == nil {
		err = packet.AppendUint16(EtherTypeIPv4)
	}
	if err == nil {
		err = node.handleMulticastFrameLocked(incoming, peer, packet, now)
	}
	node.mu.Unlock()
	if err != nil {
		t.Fatal(err)
	}
	key, err := identity.Agree(remoteIdentity)
	if err != nil {
		t.Fatal(err)
	}
	found := false
	for _, wire := range *sent {
		response, parseErr := ParsePacket(wire.data)
		if parseErr != nil || response.Dearmor(key[:]) != nil || response.Verb() != VerbOK {
			continue
		}
		payload := response.Payload()
		if len(payload) < 39 || Verb(payload[0]) != VerbMulticastFrame || binary.BigEndian.Uint64(payload[1:9]) != packet.PacketID() {
			continue
		}
		if wire.remote != incoming.endpoint || binary.BigEndian.Uint16(payload[32:34]) == 0 {
			t.Fatalf("multicast gather response = remote %s payload %x", wire.remote, payload)
		}
		found = true
	}
	if !found {
		t.Fatalf("multicast gather response not sent on %s: %+v", incoming.endpoint, *sent)
	}
}

func TestPhysicalMTULimitsEveryWireFragment(t *testing.T) {
	local, err := GenerateIdentity()
	if err != nil {
		t.Fatal(err)
	}
	remote, err := GenerateIdentity()
	if err != nil {
		t.Fatal(err)
	}
	var packets [][]byte
	node, err := NewNode(NodeConfig{
		Identity:    local,
		PhysicalMTU: 600,
		Sender: WireSenderFunc(func(int64, netip.AddrPort, []byte) error {
			return nil
		}),
	})
	if err != nil {
		t.Fatal(err)
	}
	activateTestRootPath(t, node, time.Now())
	node.sender = WireSenderFunc(func(_ int64, _ netip.AddrPort, packet []byte) error {
		packets = append(packets, append([]byte(nil), packet...))
		return nil
	})
	const networkID = uint64(0x1234567890abcdef)
	node.mu.Lock()
	if err = node.addPeerLocked(remote, false); err != nil {
		node.mu.Unlock()
		t.Fatal(err)
	}
	network := newNetwork(networkID)
	network.Status = NetworkStatusOK
	network.Config = NetworkConfigData{NetworkID: networkID, Type: NetworkTypePublic, MTU: 2800, Rules: []NetworkRule{{Type: ruleActionAccept}}}
	node.networks[networkID] = network
	node.mu.Unlock()
	if err = node.SendFrame(networkID, MACForAddress(remote.Address(), networkID), EtherTypeIPv4, bytes.Repeat([]byte{0xa5}, 1500)); err != nil {
		t.Fatal(err)
	}
	if len(packets) < 2 || len(packets[0]) != 600 {
		t.Fatalf("unexpected physical-MTU fragmentation: %v", packetLengths(packets))
	}
	for _, packet := range packets {
		if len(packet) > 600 {
			t.Fatalf("wire fragment length = %d, want <= 600", len(packet))
		}
	}
}

func TestWireSenderCanRetainTransferredDatagrams(t *testing.T) {
	local, err := GenerateIdentity()
	if err != nil {
		t.Fatal(err)
	}
	remote, err := GenerateIdentity()
	if err != nil {
		t.Fatal(err)
	}
	var retained [][]byte
	var snapshots [][]byte
	node, err := NewNode(NodeConfig{
		Identity: local,
		Sender: WireSenderFunc(func(_ int64, _ netip.AddrPort, packet []byte) error {
			if len(packet) != cap(packet) {
				t.Fatalf("wire datagram len/cap = %d/%d", len(packet), cap(packet))
			}
			retained = append(retained, packet)
			snapshots = append(snapshots, append([]byte(nil), packet...))
			return nil
		}),
	})
	if err != nil {
		t.Fatal(err)
	}
	path := pathKey{localSocket: 7, endpoint: netip.MustParseAddrPort("192.0.2.1:9993")}
	packet, err := newPacketWithPayloadCapacity(remote.Address(), local.Address(), VerbFrame, 2800-PacketMinSize)
	if err == nil {
		payload := make([]byte, 2800-PacketMinSize)
		for index := range payload {
			payload[index] = byte(index)
		}
		err = packet.Append(payload...)
	}
	if err != nil {
		t.Fatal(err)
	}
	wantPacketID := packet.PacketID()
	node.mu.Lock()
	err = node.sendPacketViaPathLocked(&peer{identity: remote}, packet, false, path, false)
	node.mu.Unlock()
	if err != nil || len(retained) != 2 {
		t.Fatalf("send: datagrams=%d err=%v", len(retained), err)
	}
	if packet.PacketID() != wantPacketID || packet.Bytes() != nil {
		t.Fatalf("transferred packet state: id=%x bytes=%d", packet.PacketID(), len(packet.Bytes()))
	}
	runtime.GC()
	for index := range retained {
		if !bytes.Equal(retained[index], snapshots[index]) {
			t.Fatalf("retained datagram %d changed after a later send", index)
		}
	}
	fragmentByte := retained[1][0]
	retained[0][0] ^= 0xff
	if retained[1][0] != fragmentByte {
		t.Fatal("head and trailing fragment share mutable storage")
	}
	if packet.PacketID() != wantPacketID {
		t.Fatalf("sender mutation changed retained packet ID to %x", packet.PacketID())
	}
}

func TestControlOnlyFramesEstablishNetworkTrust(t *testing.T) {
	_, remote, node, _ := newTestNodeWithPeer(t)
	const networkID = uint64(0x1234567890abcdef)
	now := time.Now()
	node.mu.Lock()
	network := newNetwork(networkID)
	network.Status = NetworkStatusOK
	network.Config = NetworkConfigData{NetworkID: networkID, Type: NetworkTypePublic}
	node.networks[networkID] = network
	frame, _ := NewPacket(node.Address(), remote.Address(), VerbFrame)
	_ = frame.AppendUint64(networkID)
	if err := node.handleFrameLocked(pathKey{}, frame, now); err != nil {
		node.mu.Unlock()
		t.Fatal(err)
	}
	frameTrust := node.peers[remote.Address()].lastTrustEstablished
	node.peers[remote.Address()].lastTrustEstablished = time.Time{}
	gather, _ := NewPacket(node.Address(), remote.Address(), VerbMulticastGather)
	_ = gather.AppendUint64(networkID)
	_ = gather.Append(0)
	mac := NewMAC(0xffffffffffff).Bytes()
	_ = gather.Append(mac[:]...)
	_ = gather.AppendUint32(0)
	_ = gather.AppendUint32(0)
	if err := node.handleMulticastGatherLocked(pathKey{}, node.peers[remote.Address()], gather, now); err != nil {
		node.mu.Unlock()
		t.Fatal(err)
	}
	gatherTrust := node.peers[remote.Address()].lastTrustEstablished
	node.mu.Unlock()
	if frameTrust.IsZero() || gatherTrust.IsZero() {
		t.Fatalf("control-only trust: frame=%v gather=%v", frameTrust, gatherTrust)
	}
}

func TestUnknownNetworkTypeIsNotPublic(t *testing.T) {
	_, remote, node, _ := newTestNodeWithPeer(t)
	network := newNetwork(0x1234567890abcdef)
	network.Config = NetworkConfigData{NetworkID: network.ID, Type: NetworkType(2)}
	node.mu.Lock()
	allowed := network.allows(node.peers[remote.Address()])
	node.mu.Unlock()
	if allowed {
		t.Fatal("unknown network type bypassed private-network membership")
	}
}

func TestMulticastDisabledStillProcessesInlineMembership(t *testing.T) {
	local, _ := ParseIdentity(knownGoodIdentity)
	remote, _ := GenerateIdentity()
	controller, _ := GenerateIdentity()
	networkID := controller.Address().Uint64()<<24 | 0x1234
	node, err := NewNode(NodeConfig{Identity: local, Sender: WireSenderFunc(func(int64, netip.AddrPort, []byte) error { return nil })})
	if err != nil {
		t.Fatal(err)
	}
	localCOM := makeTestCOM(t, controller, local, networkID, uint64(time.Now().UnixMilli()))
	remoteCOM := makeTestCOM(t, controller, remote, networkID, localCOM.Timestamp())
	packet, _ := NewPacket(local.Address(), remote.Address(), VerbMulticastFrame)
	_ = packet.AppendUint64(networkID)
	_ = packet.Append(0x01)
	_ = packet.Append(remoteCOM.Bytes()...)
	destination := NewMAC(0xffffffffffff).Bytes()
	_ = packet.Append(destination[:]...)
	_ = packet.AppendUint32(0)
	_ = packet.AppendUint16(EtherTypeIPv4)
	node.mu.Lock()
	_ = node.addPeerLocked(controller, false)
	_ = node.addPeerLocked(remote, false)
	network := newNetwork(networkID)
	network.Status = NetworkStatusOK
	network.Config = NetworkConfigData{NetworkID: networkID, Type: NetworkTypePrivate, COM: &localCOM, MulticastLimit: 0}
	node.networks[networkID] = network
	err = node.handleMulticastFrameLocked(pathKey{}, node.peers[remote.Address()], packet, time.Now())
	_, memberAdded := network.members[remote.Address()]
	trusted := !node.peers[remote.Address()].lastTrustEstablished.IsZero()
	node.mu.Unlock()
	if err != nil || !memberAdded || trusted {
		t.Fatalf("disabled multicast inline COM: err=%v member=%t trusted=%t", err, memberAdded, trusted)
	}
}

func TestPrivateFrameRetriesAfterMembershipArrives(t *testing.T) {
	local, _ := ParseIdentity(knownGoodIdentity)
	remote, _ := GenerateIdentity()
	controller, _ := GenerateIdentity()
	networkID := controller.Address().Uint64()<<24 | 0x1234
	now := time.Now()
	localCOM := makeTestCOM(t, controller, local, networkID, uint64(now.UnixMilli()))
	remoteCOM := makeTestCOM(t, controller, remote, networkID, localCOM.Timestamp())
	var received []Frame
	node, err := NewNode(NodeConfig{
		Identity: local,
		Sender:   WireSenderFunc(func(int64, netip.AddrPort, []byte) error { return nil }),
		OnFrame:  func(frame Frame) { received = append(received, frame) },
	})
	if err != nil {
		t.Fatal(err)
	}
	node.mu.Lock()
	_ = node.addPeerLocked(controller, false)
	_ = node.addPeerLocked(remote, false)
	network := newNetwork(networkID)
	network.Status = NetworkStatusOK
	network.Config = NetworkConfigData{
		NetworkID: networkID,
		Type:      NetworkTypePrivate,
		COM:       &localCOM,
		Rules:     []NetworkRule{{Type: ruleActionAccept}},
	}
	node.networks[networkID] = network
	node.mu.Unlock()

	packet, _ := NewPacket(local.Address(), remote.Address(), VerbFrame)
	_ = packet.AppendUint64(networkID)
	_ = packet.AppendUint16(EtherTypeIPv4)
	_ = packet.Append(0x45)
	key, err := remote.Agree(local)
	if err != nil {
		t.Fatal(err)
	}
	if err = packet.Armor(key[:], true); err != nil {
		t.Fatal(err)
	}
	endpoint := netip.MustParseAddrPort("198.51.100.20:9993")
	if err = node.ProcessWirePacket(7, endpoint, packet.Bytes(), now); err != nil {
		t.Fatal(err)
	}
	node.mu.Lock()
	queuedBefore := len(node.pendingIncoming[remote.Address()])
	lastReceiveBefore := node.peers[remote.Address()].lastReceive
	if err = node.addMembershipLocked(network, remoteCOM); err != nil {
		node.mu.Unlock()
		t.Fatal(err)
	}
	node.mu.Unlock()
	if queuedBefore != 1 || !lastReceiveBefore.IsZero() || len(received) != 0 {
		t.Fatalf("deferred frame state: queued=%d lastReceive=%v received=%d", queuedBefore, lastReceiveBefore, len(received))
	}

	node.ProcessBackgroundTasks(now.Add(whoisRetryPeriod))
	node.mu.Lock()
	queuedAfter := len(node.pendingIncoming[remote.Address()])
	lastReceiveAfter := node.peers[remote.Address()].lastReceive
	node.mu.Unlock()
	if queuedAfter != 0 || lastReceiveAfter.IsZero() || len(received) != 1 || !bytes.Equal(received[0].Payload, []byte{0x45}) {
		t.Fatalf("retried frame state: queued=%d lastReceive=%v received=%v", queuedAfter, lastReceiveAfter, received)
	}
}
