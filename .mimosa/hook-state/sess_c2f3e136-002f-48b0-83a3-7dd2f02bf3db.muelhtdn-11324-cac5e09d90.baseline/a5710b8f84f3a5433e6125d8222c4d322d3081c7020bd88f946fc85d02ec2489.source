	"bytes"
	"encoding/binary"
	"errors"
	"net/netip"
	"runtime"
	"testing"
	"time"
)

func BenchmarkSendFragmentedFrame(b *testing.B) {
	local, err := ParseIdentity(knownGoodIdentity)
	if err != nil {
		b.Fatal(err)
	}
	remote, err := GenerateIdentity()
	if err != nil {
		b.Fatal(err)
	}
	var wireBytes int
	node, err := NewNode(NodeConfig{
		Identity: local,
		Sender: WireSenderFunc(func(_ int64, _ netip.AddrPort, packet []byte) error {
			wireBytes += len(packet)
			return nil
		}),
	})
	if err != nil {
		b.Fatal(err)
	}
	const networkID = uint64(0x1234567890abcdef)
	now := time.Now()
	node.mu.Lock()
	if err = node.addPeerLocked(remote, false); err != nil {
		node.mu.Unlock()
		b.Fatal(err)
	}
	peer := node.peers[remote.Address()]
	peer.protocol = ProtocolVersion
	peer.paths[pathKey{localSocket: 0, endpoint: netip.MustParseAddrPort("192.0.2.1:9993")}] = &peerPathState{
		lastReceive: now,
		latency:     time.Millisecond,
	}
	network := newNetwork(networkID)
	network.Status = NetworkStatusOK
	network.Config = NetworkConfigData{
		NetworkID: networkID,
		Type:      NetworkTypePublic,
		MTU:       2800,
		Rules:     []NetworkRule{{Type: ruleActionAccept}},
	}
	node.networks[networkID] = network
	node.mu.Unlock()
	payload := make([]byte, 2760)
	destination := MACForAddress(remote.Address(), networkID)
	b.SetBytes(int64(len(payload)))
	b.ReportAllocs()
	b.ResetTimer()
	for index := 0; index < b.N; index++ {
		if err = node.SendFrame(networkID, destination, EtherTypeIPv4, payload); err != nil {
			b.Fatal(err)
		}
	}
	runtime.KeepAlive(wireBytes)
}

func BenchmarkProcessFragmentedFrame(b *testing.B) {
	senderIdentity, err := GenerateIdentity()
	if err != nil {
		b.Fatal(err)
	}
	receiverIdentity, err := GenerateIdentity()
	if err != nil {
		b.Fatal(err)
	}
	const networkID = uint64(0x1234567890abcdef)
	var packets [][]byte
	sender, err := NewNode(NodeConfig{
		Identity: senderIdentity,
		Sender: WireSenderFunc(func(_ int64, _ netip.AddrPort, packet []byte) error {
			packets = append(packets, append([]byte(nil), packet...))
			return nil
		}),
	})
	if err != nil {
		b.Fatal(err)
	}
	configure := func(node *Node, remote Identity) {
		node.mu.Lock()
		defer node.mu.Unlock()
		if addErr := node.addPeerLocked(remote, false); addErr != nil {
			b.Fatal(addErr)
		}
		network := newNetwork(networkID)
		network.Status = NetworkStatusOK
		network.Config = NetworkConfigData{
			NetworkID: networkID,
			Type:      NetworkTypePublic,
			MTU:       2800,
			Rules:     []NetworkRule{{Type: ruleActionAccept}},
		}
		node.networks[networkID] = network
	}
	configure(sender, receiverIdentity)
	sender.mu.Lock()
	sender.peers[receiverIdentity.Address()].protocol = ProtocolVersion
	sender.peers[receiverIdentity.Address()].paths[pathKey{localSocket: 0, endpoint: netip.MustParseAddrPort("192.0.2.1:9993")}] = &peerPathState{
		lastReceive: time.Now(),
		latency:     time.Millisecond,
	}
	sender.mu.Unlock()
	payload := make([]byte, 2760)
	if err = sender.SendFrame(networkID, MACForAddress(receiverIdentity.Address(), networkID), EtherTypeIPv4, payload); err != nil {
		b.Fatal(err)
	}
	if len(packets) != 2 {
		b.Fatalf("wire fragments = %d, want 2", len(packets))
	}
	var received int
	receiver, err := NewNode(NodeConfig{
		Identity: receiverIdentity,
		Sender:   WireSenderFunc(func(int64, netip.AddrPort, []byte) error { return nil }),
		OnFrame:  func(Frame) { received++ },
	})
	if err != nil {
		b.Fatal(err)
	}
	configure(receiver, senderIdentity)
	remote := netip.MustParseAddrPort("192.0.2.1:9993")
	now := time.Now()
	b.SetBytes(int64(len(payload)))
	b.ReportAllocs()
	b.ResetTimer()
	for index := 0; index < b.N; index++ {
		if err = receiver.ProcessWirePacket(0, remote, packets[0], now); err != nil {
			b.Fatal(err)
		}
		if err = receiver.ProcessWirePacket(0, remote, packets[1], now); err != nil {
			b.Fatal(err)
		}
	}
	runtime.KeepAlive(received)
}

func TestFragmentedFrameRoundTrip(t *testing.T) {
	senderIdentity, err := GenerateIdentity()
	if err != nil {
		t.Fatal(err)
	}
	receiverIdentity, err := GenerateIdentity()
	if err != nil {
		t.Fatal(err)
	}
	const networkID = uint64(0x1234567890abcdef)
	var packets [][]byte
	sender, err := NewNode(NodeConfig{
		Identity: senderIdentity,
		Sender: WireSenderFunc(func(_ int64, _ netip.AddrPort, packet []byte) error {
			packets = append(packets, append([]byte(nil), packet...))
			return nil
		}),
	})
	if err != nil {
		t.Fatal(err)
	}
	sender.mu.Lock()
	if err := sender.addPeerLocked(receiverIdentity, false); err != nil {
		sender.mu.Unlock()
		t.Fatal(err)
	}
	sender.networks[networkID] = newNetwork(networkID)
	sender.networks[networkID].Status = NetworkStatusOK
	sender.networks[networkID].Config = NetworkConfigData{NetworkID: networkID, Type: NetworkTypePublic, MTU: 2800, Rules: []NetworkRule{{Type: ruleActionAccept}}}
	sender.mu.Unlock()
	activateTestRootPath(t, sender, time.Now())

	payload := bytes.Repeat([]byte{0xa5}, 2000)
	if err := sender.SendFrame(networkID, MACForAddress(receiverIdentity.Address(), networkID), EtherTypeIPv4, payload); err != nil {
		t.Fatal(err)
	}
	if len(packets) != 2 || len(packets[0]) != DefaultPhysicalMTU || packets[1][13] != 0xff {
		t.Fatalf("unexpected fragmentation: packet lengths=%v", packetLengths(packets))
	}

	var received Frame
	receiver, err := NewNode(NodeConfig{
		Identity: receiverIdentity,
		Sender:   WireSenderFunc(func(int64, netip.AddrPort, []byte) error { return nil }),
		OnFrame:  func(frame Frame) { received = frame },
	})
	if err != nil {
		t.Fatal(err)
	}
	receiver.mu.Lock()
	if err := receiver.addPeerLocked(senderIdentity, false); err != nil {
		receiver.mu.Unlock()
		t.Fatal(err)
	}
	receiver.networks[networkID] = newNetwork(networkID)
	receiver.networks[networkID].Status = NetworkStatusOK
	receiver.networks[networkID].Config = NetworkConfigData{NetworkID: networkID, Type: NetworkTypePublic, MTU: 2800, Rules: []NetworkRule{{Type: ruleActionAccept}}}
	receiver.mu.Unlock()

	remote := netip.MustParseAddrPort("192.0.2.1:9993")
	now := time.Unix(1700000000, 0)
	if err := receiver.ProcessWirePacket(0, remote, packets[1], now); err != nil {
		t.Fatal(err)
	}
	if len(received.Payload) != 0 {
		t.Fatal("frame was delivered before the head fragment")
	}
	if err := receiver.ProcessWirePacket(0, remote, packets[0], now); err != nil {
		t.Fatal(err)
	}
	if received.NetworkID != networkID || received.EtherType != EtherTypeIPv4 || !bytes.Equal(received.Payload, payload) {
		t.Fatal("reassembled frame did not match the sent frame")
	}
	for _, packet := range packets {
		for index := range packet {
			packet[index] = 0
		}
	}
	if !bytes.Equal(received.Payload, payload) {
		t.Fatal("retained frame payload aliases the caller's wire buffers")
	}
}

func TestCredentialsAreSplitAtPacketBoundary(t *testing.T) {
	identity, remoteIdentity, node, sent := newTestNodeWithPeer(t)
	const networkID = uint64(0x1234567890abcdef)
	endpoint := netip.MustParseAddrPort("192.0.2.80:9993")
	node.mu.Lock()
	peer := node.peers[remoteIdentity.Address()]
	peer.paths[pathKey{localSocket: AnyLocalSocket, endpoint: endpoint}] = &peerPathState{lastReceive: time.Now(), latency: time.Millisecond}
	network := newNetwork(networkID)
	network.Status = NetworkStatusOK
	network.Config = NetworkConfigData{NetworkID: networkID, Type: NetworkTypePublic}
	for i := 0; i < maxNetworkTags; i++ {
		network.Config.Tags = append(network.Config.Tags, Tag{NetworkID: networkID, Timestamp: 1, ID: uint32(i + 1), IssuedTo: identity.Address(), SignedBy: Controller(networkID)})
	}
	node.networks[networkID] = network
	err := node.sendCredentialsLocked(network, peer, time.Now())
	node.mu.Unlock()
	if err != nil {
		t.Fatal(err)
	}
	if len(*sent) < 2 {
		t.Fatalf("128 tags were not split: packets=%d", len(*sent))
	}
	key, err := identity.Agree(remoteIdentity)
	if err != nil {
		t.Fatal(err)
	}
	total := 0
	for _, wire := range *sent {
		packet, parseErr := ParsePacket(wire.data)
		if parseErr != nil {
			t.Fatal(parseErr)
		}
		if parseErr = packet.Dearmor(key[:]); parseErr != nil {
			t.Fatal(parseErr)
		}
		if parseErr = packet.Uncompress(); parseErr != nil {
			t.Fatal(parseErr)
		}
		payload := packet.Payload()
		if len(payload) < 7 || payload[0] != 0 || binary.BigEndian.Uint16(payload[1:3]) != 0 {
			prefixLen := len(payload)
			if prefixLen > 7 {
				prefixLen = 7
			}
			t.Fatalf("invalid split credential prefix: %x", payload[:prefixLen])
		}
		total += int(binary.BigEndian.Uint16(payload[3:5]))
	}
	if total != maxNetworkTags {
		t.Fatalf("split credentials contained %d tags", total)
	}
}

func TestMembershipIsRecheckedAgainstCurrentConfig(t *testing.T) {
	controller, _ := GenerateIdentity()
	local, _ := GenerateIdentity()
	remote, _ := GenerateIdentity()
	const networkID = uint64(0x1234567890abcdef)
	node, err := NewNode(NodeConfig{Identity: local, Sender: WireSenderFunc(func(int64, netip.AddrPort, []byte) error { return nil })})
	if err != nil {
		t.Fatal(err)
	}
	node.mu.Lock()
	_ = node.addPeerLocked(controller, false)
	_ = node.addPeerLocked(remote, false)
	network := newNetwork(networkID)
	network.Status = NetworkStatusOK
	localCOM := makeTestCOM(t, controller, local, networkID, 100)
	remoteCOM := makeTestCOM(t, controller, remote, networkID, 100)
	network.Config = NetworkConfigData{NetworkID: networkID, Type: NetworkTypePrivate, COM: &localCOM}
	network.members[remote.Address()] = remoteCOM
	if !network.allows(node.peers[remote.Address()]) {
		node.mu.Unlock()
		t.Fatal("matching COM was rejected")
	}
	updated := localCOM
	updated.Qualifiers = append([]COMQualifier(nil), localCOM.Qualifiers...)
	updated.Qualifiers[0].Value++
	updated.Qualifiers[0].MaxDelta = 0
	network.Config.COM = &updated
	allowed := network.allows(node.peers[remote.Address()])
	node.mu.Unlock()
	if allowed {
		t.Fatal("old COM remained valid after configuration changed")
	}
}

func TestOnlyExplicitPublicTypeBypassesPrivateMembership(t *testing.T) {
	_, remote, node, _ := newTestNodeWithPeer(t)
	network := newNetwork(0x1234567890abcdef)
	network.Config.Type = NetworkType(2)
	node.mu.Lock()
	allowed := network.allows(node.peers[remote.Address()])
	node.mu.Unlock()
	if allowed {
		t.Fatal("unknown network type was treated as public")
	}
}

func TestEffectiveMulticastLimitIsBounded(t *testing.T) {
	if got := effectiveMulticastLimit(^uint32(0)); got != maxMulticastGroupMembers {
		t.Fatalf("maximum multicast limit = %d, want %d", got, maxMulticastGroupMembers)
	}
	if got := effectiveMulticastLimit(123); got != 123 {
		t.Fatalf("ordinary multicast limit = %d, want 123", got)
	}
}

func TestPendingMulticastWaitsForPeerIdentity(t *testing.T) {
	identity, err := GenerateIdentity()
	if err != nil {
		t.Fatal(err)
	}
	member, err := GenerateIdentity()
	if err != nil {
		t.Fatal(err)
	}
	var sent int
	node, err := NewNode(NodeConfig{
		Identity: identity,
		Sender: WireSenderFunc(func(int64, netip.AddrPort, []byte) error {
			sent++
			return nil
		}),
	})
	if err != nil {
		t.Fatal(err)
	}
	const networkID = uint64(0x1234567890abcdef)
	group := MulticastGroup{MAC: NewMAC(0xffffffffffff), ADI: 0xc0000201}
	frame := Frame{NetworkID: networkID, Source: MACForAddress(identity.Address(), networkID), Destination: group.MAC, EtherType: EtherTypeARP, Payload: make([]byte, 28)}
	now := time.Unix(1700000000, 0)
	activateTestRootPath(t, node, now)
	node.mu.Lock()
	network := newNetwork(networkID)
	network.Status = NetworkStatusOK
	network.Config = NetworkConfigData{NetworkID: networkID, Type: NetworkTypePublic, MTU: 2800, MulticastLimit: 1, Rules: []NetworkRule{{Type: ruleActionAccept}}}
	network.multicast[group] = map[Address]time.Time{member.Address(): now}
	network.pendingMulticast[group] = []pendingMulticastFrame{{frame: frame, sent: make(map[Address]struct{}), createdAt: now}}
	node.networks[networkID] = network
	node.flushPendingMulticastLocked(network, group, now)
	if len(network.pendingMulticast[group]) != 1 {
		node.mu.Unlock()
		t.Fatal("pending multicast frame was discarded before WHOIS completed")
	}
	if err := node.addPeerLocked(member, false); err != nil {
		node.mu.Unlock()
		t.Fatal(err)
	}
	node.flushPendingMulticastLocked(network, group, now)
	pending := len(network.pendingMulticast[group])
	node.mu.Unlock()
	if pending != 0 || sent == 0 {
		t.Fatalf("pending=%d sent=%d after peer identity became available", pending, sent)
	}
}

func TestPendingMulticastRetriesWHOIS(t *testing.T) {
	identity, _ := GenerateIdentity()
	member, _ := GenerateIdentity()
	var sent int
	node, err := NewNode(NodeConfig{
		Identity: identity,
		Sender: WireSenderFunc(func(int64, netip.AddrPort, []byte) error {
			sent++
			return nil
		}),
	})
	if err != nil {
		t.Fatal(err)
	}
	const networkID = uint64(0x1234567890abcdef)
	group := MulticastGroup{MAC: NewMAC(0xffffffffffff), ADI: 0xc0000201}
	now := time.Unix(1700000000, 0)
	activateTestRootPath(t, node, now)
	node.mu.Lock()
	network := newNetwork(networkID)
	network.Config = NetworkConfigData{NetworkID: networkID, MulticastLimit: 1}
	network.multicast[group] = map[Address]time.Time{member.Address(): now}
	network.pendingMulticast[group] = []pendingMulticastFrame{{sent: make(map[Address]struct{}), createdAt: now}}
	node.networks[networkID] = network
	node.retryPendingWhoisLocked(now)
	first := sent
	node.retryPendingWhoisLocked(now.Add(whoisRetryPeriod))
	second := sent
	node.mu.Unlock()
	if first == 0 || second <= first {
		t.Fatalf("pending multicast WHOIS was not retried: first=%d second=%d", first, second)
	}
}

func TestPendingMulticastWHOISUsesFixedTargets(t *testing.T) {
	local, _ := GenerateIdentity()
	selected, _ := GenerateIdentity()
	later, _ := GenerateIdentity()
	node, err := NewNode(NodeConfig{
		Identity: local,
		Sender:   WireSenderFunc(func(int64, netip.AddrPort, []byte) error { return nil }),
	})
	if err != nil {
		t.Fatal(err)
	}
	const networkID = uint64(0x1234567890abcdef)
	group := MulticastGroup{MAC: NewMAC(0xffffffffffff), ADI: 0xc0000201}
	now := time.Unix(1700000000, 0)
	activateTestRootPath(t, node, now)
	node.mu.Lock()
	network := newNetwork(networkID)
	network.Config = NetworkConfigData{NetworkID: networkID, MulticastLimit: 1}
	network.multicast[group] = map[Address]time.Time{selected.Address(): now, later.Address(): now}
	network.pendingMulticast[group] = []pendingMulticastFrame{{
		sent:      make(map[Address]struct{}),
		targets:   map[Address]struct{}{selected.Address(): {}},
		createdAt: now,
	}}
	node.networks[networkID] = network
	node.retryPendingWhoisLocked(now)
	_, selectedRequested := node.pendingWhois[selected.Address()]
	_, laterRequested := node.pendingWhois[later.Address()]
	node.mu.Unlock()
	if !selectedRequested || laterRequested {
		t.Fatalf("fixed target WHOIS selected=%t later=%t", selectedRequested, laterRequested)
	}
}

func TestMulticastReplicatorRequiresActiveDirectPath(t *testing.T) {
	_, remoteIdentity, node, _ := newTestNodeWithPeer(t)
	const networkID = uint64(0x1234567890abcdef)
	network := newNetwork(networkID)
	network.Config = NetworkConfigData{
		NetworkID: networkID,
		Specialists: []uint64{
			specialistTypeMulticastReplicator | remoteIdentity.Address().Uint64(),
		},
	}
	node.mu.Lock()
	if replicator := node.bestMulticastReplicatorLocked(network, time.Now()); replicator != nil {
		node.mu.Unlock()
		t.Fatal("replicator without an active direct path was selected")
	}
	peer := node.peers[remoteIdentity.Address()]
	peer.paths[pathKey{localSocket: 0, endpoint: netip.MustParseAddrPort("192.0.2.20:9993")}] = &peerPathState{
		lastReceive: time.Now(),
		latency:     10 * time.Millisecond,
		priority:    1,
	}
	replicator := node.bestMulticastReplicatorLocked(network, time.Now())
	node.mu.Unlock()
	if replicator != peer {
		t.Fatal("replicator with an active direct path was not selected")
	}
}

func TestMulticastReplicatorIsNotFilteredAsReceiver(t *testing.T) {
	local, _ := GenerateIdentity()
	replicator, _ := GenerateIdentity()
	const networkID = uint64(0x1234567890abcdef)
	now := time.Now()
	var destinations []Address
	node, err := NewNode(NodeConfig{
		Identity: local,
		Sender: WireSenderFunc(func(_ int64, _ netip.AddrPort, data []byte) error {
			packet, parseErr := ParsePacket(data)
			if parseErr == nil {
				destinations = append(destinations, packet.Destination())
			}
			return nil
		}),
	})
	if err != nil {
		t.Fatal(err)
	}
	node.mu.Lock()
	if err = node.addPeerLocked(replicator, false); err != nil {
		node.mu.Unlock()
		t.Fatal(err)
	}
	node.peers[replicator.Address()].paths[pathKey{localSocket: 0, endpoint: netip.MustParseAddrPort("192.0.2.20:9993")}] = &peerPathState{
		lastReceive: now,
		latency:     10 * time.Millisecond,
		priority:    1,
	}
	replicatorBytes := replicator.Address().Bytes()
	network := newNetwork(networkID)
	network.Status = NetworkStatusOK
	network.Config = NetworkConfigData{
		NetworkID: networkID, Type: NetworkTypePublic, MTU: DefaultNetworkMTU, MulticastLimit: 1,
		Specialists: []uint64{specialistTypeMulticastReplicator | replicator.Address().Uint64()},
		Rules: []NetworkRule{
			{Type: ruleMatchDestZTAddress, Value: replicatorBytes[:]},
			{Type: ruleActionDrop},
			{Type: ruleActionAccept},
		},
	}
	node.networks[networkID] = network
	node.mu.Unlock()

	if err = node.SendFrame(networkID, NewMAC(0x01005e000001), EtherTypeIPv4, []byte{0x45}); err != nil {
		t.Fatal(err)
	}
	if len(destinations) != 1 || destinations[0] != replicator.Address() {
		t.Fatalf("multicast replicator destinations = %v, want %s", destinations, replicator.Address())
	}
}

func TestMulticastGatherRetriesUntilMembershipIsKnown(t *testing.T) {
	local, err := ParseIdentity(knownGoodIdentity)
	if err != nil {
		t.Fatal(err)
	}
	controller, err := GenerateIdentity()
	if err != nil {
		t.Fatal(err)
	}
	networkID := controller.Address().Uint64()<<24 | 0x123456
	for IsAdHocNetworkID(networkID) {
		controller, err = GenerateIdentity()
		if err != nil {
			t.Fatal(err)
		}
		networkID = controller.Address().Uint64()<<24 | 0x123456
	}
	key, err := controller.Agree(local)
	if err != nil {
		t.Fatal(err)
	}
	var sent []sentWirePacket
	node, err := NewNode(NodeConfig{
		Identity: local,
		Sender: WireSenderFunc(func(_ int64, remote netip.AddrPort, packet []byte) error {
			sent = append(sent, sentWirePacket{remote: remote, data: append([]byte(nil), packet...)})
			return nil
		}),
	})
	if err != nil {
		t.Fatal(err)
	}
	group := MulticastGroup{MAC: NewMAC(0xffffffffffff), ADI: 0xc0000201}
	now := time.Now()
	node.mu.Lock()
	network := newNetwork(networkID)
	network.Status = NetworkStatusOK
	network.Config = NetworkConfigData{NetworkID: networkID, Type: NetworkTypePublic, MulticastLimit: 32}
	node.networks[networkID] = network
	var relay *peer
	for _, candidate := range node.peers {
		if candidate.root {
			relay = candidate
			break
		}
	}
	if relay == nil {
		node.mu.Unlock()
		t.Fatal("node has no planet root")
	}
	relayEndpoint := netip.MustParseAddrPort("192.0.2.20:9993")
	node.addPeerPathLocked(relay, pathKey{localSocket: 0, endpoint: relayEndpoint}, &peerPathState{lastReceive: now, priority: 1}, now)
	relay.lastReceive = now
	if err = node.gatherMulticastLocked(network, group, 32, now); err != nil {
		node.mu.Unlock()
		t.Fatal(err)
	}
	if err = node.gatherMulticastLocked(network, group, 32, now.Add(time.Millisecond)); err != nil {
		node.mu.Unlock()
		t.Fatal(err)
	}
	if queued := len(node.pendingTransmits); queued != 2 {
		node.mu.Unlock()
		t.Fatalf("gathers queued without controller identity = %d, want 2", queued)
	}
	network.multicast[group] = map[Address]time.Time{NewAddress(1): now}
	if err = node.gatherMulticastLocked(network, group, 32, now.Add(2*time.Millisecond)); err != nil {
		node.mu.Unlock()
		t.Fatal(err)
	}
	if queued := len(node.pendingTransmits); queued != 2 {
		node.mu.Unlock()
		t.Fatalf("known membership bypassed gather rate limit: queued=%d", queued)
	}
	if err = node.addPeerLocked(controller, false); err != nil {
		node.mu.Unlock()
		t.Fatal(err)
	}
	queued := len(node.pendingTransmits)
	node.mu.Unlock()
	if queued != 0 {
		t.Fatalf("learned controller retained %d deferred gathers", queued)
	}
	gathers := 0
	for i, packet := range sent {
		parsed, parseErr := ParsePacket(packet.data)
		if parseErr != nil {
			t.Fatalf("parse packet %d: %v", i, parseErr)
		}
		if parsed.Destination() != controller.Address() || parsed.Dearmor(key[:]) != nil {
			continue
		}
		if parsed.Verb() != VerbMulticastGather {
			continue
		}
		gathers++
		if packet.remote != relayEndpoint {
			t.Fatalf("gather %d packet: verb=%v destination=%s remote=%s, want %s", i, parsed.Verb(), parsed.Destination(), packet.remote, relayEndpoint)
		}
	}
	if gathers != 2 {
		t.Fatalf("sent gathers = %d, want 2 (all packets=%d)", gathers, len(sent))
	}
}

func TestMulticastAtLimitStillReachesActiveBridge(t *testing.T) {
	local, _ := GenerateIdentity()
	member, _ := GenerateIdentity()
	bridge, _ := GenerateIdentity()
	var destinations []Address
	node, err := NewNode(NodeConfig{
		Identity: local,
		Sender: WireSenderFunc(func(_ int64, _ netip.AddrPort, data []byte) error {
			packet, parseErr := ParsePacket(data)
			if parseErr == nil {
				destinations = append(destinations, packet.Destination())
			}
			return nil
		}),
	})
	if err != nil {
		t.Fatal(err)
	}
	const networkID = uint64(0x1234567890abcdef)
	group := MulticastGroup{MAC: NewMAC(0xffffffffffff)}
	now := time.Now()
	activateTestRootPath(t, node, now)
	node.mu.Lock()
	if err = node.addPeerLocked(member, false); err != nil {
		node.mu.Unlock()
		t.Fatal(err)
	}
	network := newNetwork(networkID)
	network.Status = NetworkStatusOK
	network.Config = NetworkConfigData{
		NetworkID: networkID, Type: NetworkTypePublic, MulticastLimit: 1, Flags: NetworkConfigFlagEnableBroadcast,
		Specialists: []uint64{specialistTypeActiveBridge | bridge.Address().Uint64()},
		Rules:       []NetworkRule{{Type: ruleActionAccept}},
	}
	network.multicast[group] = map[Address]time.Time{member.Address(): now}
	node.networks[networkID] = network
	frame := Frame{NetworkID: networkID, Source: MACForAddress(local.Address(), networkID), Destination: group.MAC, EtherType: EtherTypeARP, Payload: make([]byte, 28)}
	if err = node.sendMulticastLocked(network, frame, now); err != nil {
		node.mu.Unlock()
		t.Fatal(err)
	}
	if len(network.pendingMulticast[group]) != 1 {
		node.mu.Unlock()
		t.Fatal("unknown active bridge was not retained after the member limit was reached")
	}
	if err = node.addPeerLocked(bridge, false); err != nil {
		node.mu.Unlock()
		t.Fatal(err)
	}
	pending := len(network.pendingMulticast[group])
	node.mu.Unlock()
	if pending != 0 {
		t.Fatalf("active bridge remained pending after WHOIS: %d", pending)
	}
	foundMember, foundBridge := false, false
	for _, destination := range destinations {
		foundMember = foundMember || destination == member.Address()
		foundBridge = foundBridge || destination == bridge.Address()
	}
	if !foundMember || !foundBridge {
		t.Fatalf("multicast destinations member=%t bridge=%t (%v)", foundMember, foundBridge, destinations)
	}
}

func TestMulticastAtLimitDoesNotExpandPendingTargets(t *testing.T) {
	local, _ := GenerateIdentity()
	selected, _ := GenerateIdentity()
	later, _ := GenerateIdentity()
	var destinations []Address
	node, err := NewNode(NodeConfig{
		Identity: local,
		Sender: WireSenderFunc(func(_ int64, _ netip.AddrPort, data []byte) error {
			packet, parseErr := ParsePacket(data)
			if parseErr == nil {
				destinations = append(destinations, packet.Destination())
			}
			return nil
		}),
	})
	if err != nil {
		t.Fatal(err)
	}
	const networkID = uint64(0x1234567890abcdef)
	group := MulticastGroup{MAC: NewMAC(0xffffffffffff)}
	now := time.Now()
	activateTestRootPath(t, node, now)
	node.mu.Lock()
	network := newNetwork(networkID)
	network.Status = NetworkStatusOK
	network.Config = NetworkConfigData{
		NetworkID: networkID, Type: NetworkTypePublic, MulticastLimit: 1, Flags: NetworkConfigFlagEnableBroadcast,
		Rules: []NetworkRule{{Type: ruleActionAccept}},
	}
	network.multicast[group] = map[Address]time.Time{selected.Address(): now}
	node.networks[networkID] = network
	frame := Frame{NetworkID: networkID, Source: MACForAddress(local.Address(), networkID), Destination: group.MAC, EtherType: EtherTypeARP, Payload: make([]byte, 28)}
	if err = node.sendMulticastLocked(network, frame, now); err != nil {
		node.mu.Unlock()
		t.Fatal(err)
	}
	if len(network.pendingMulticast[group]) != 1 {
		node.mu.Unlock()
		t.Fatal("unknown mature-group target was not retained")
	}
	destinations = nil
	if err = node.addPeerLocked(later, false); err != nil {
		node.mu.Unlock()
		t.Fatal(err)
	}
	network.multicast[group][later.Address()] = now
	node.flushPendingMulticastLocked(network, group, now)
	if err = node.addPeerLocked(selected, false); err != nil {
		node.mu.Unlock()
		t.Fatal(err)
	}
	pending := len(network.pendingMulticast[group])
	node.mu.Unlock()
	if pending != 0 {
		t.Fatalf("selected target remained pending after WHOIS: %d", pending)
	}
	if len(destinations) != 1 || destinations[0] != selected.Address() {
		t.Fatalf("pending multicast destinations = %v, want only %s", destinations, selected.Address())
	}
}

func TestMulticastReplicatorUsesSenderReplication(t *testing.T) {
	local, _ := GenerateIdentity()
	origin, _ := GenerateIdentity()
	member, _ := GenerateIdentity()
	bridge, _ := GenerateIdentity()
	var destinations []Address
	node, err := NewNode(NodeConfig{
		Identity: local,
		Sender: WireSenderFunc(func(_ int64, _ netip.AddrPort, data []byte) error {
			packet, parseErr := ParsePacket(data)
			if parseErr == nil {
				destinations = append(destinations, packet.Destination())
			}
			return nil
		}),
	})
	if err != nil {
		t.Fatal(err)
	}
	const networkID = uint64(0x1234567890abcdef)
	group := MulticastGroup{MAC: NewMAC(0xffffffffffff)}
	now := time.Now()
	activateTestRootPath(t, node, now)
	node.mu.Lock()
	for _, identity := range []Identity{origin, member, bridge} {
		if err = node.addPeerLocked(identity, false); err != nil {
			node.mu.Unlock()
			t.Fatal(err)
		}
	}
	network := newNetwork(networkID)
	network.Status = NetworkStatusOK
	network.Config = NetworkConfigData{
		NetworkID: networkID, Type: NetworkTypePublic, MulticastLimit: 1,
		Specialists: []uint64{
			specialistTypeMulticastReplicator | local.Address().Uint64(),
			specialistTypeActiveBridge | bridge.Address().Uint64(),
		},
		Rules: []NetworkRule{{Type: ruleActionAccept}},
	}
	network.multicast[group] = map[Address]time.Time{origin.Address(): now, member.Address(): now}
	node.networks[networkID] = network
	frame := Frame{NetworkID: networkID, Source: MACForAddress(origin.Address(), networkID), Destination: group.MAC, EtherType: EtherTypeIPv4, Payload: []byte{0x45}}
	node.replicateMulticastLocked(network, origin.Address(), group, frame, now)
	node.mu.Unlock()
	foundMember, foundBridge, foundOrigin := false, false, false
	for _, destination := range destinations {
		foundMember = foundMember || destination == member.Address()
		foundBridge = foundBridge || destination == bridge.Address()
		foundOrigin = foundOrigin || destination == origin.Address()
	}
	if !foundMember || !foundBridge || foundOrigin {
		t.Fatalf("replication member=%t bridge=%t origin=%t (%v)", foundMember, foundBridge, foundOrigin, destinations)
	}
}

func TestMulticastReplicatorOriginDoesNotMoveBridgesInsideLimit(t *testing.T) {
	local, _ := GenerateIdentity()
	origin, _ := GenerateIdentity()
	member, _ := GenerateIdentity()
	firstBridge, _ := GenerateIdentity()
	secondBridge, _ := GenerateIdentity()
	var destinations []Address
	node, err := NewNode(NodeConfig{
		Identity: local,
		Sender: WireSenderFunc(func(_ int64, _ netip.AddrPort, data []byte) error {
			packet, parseErr := ParsePacket(data)
			if parseErr == nil {
				destinations = append(destinations, packet.Destination())
			}
			return nil
		}),
	})
	if err != nil {
		t.Fatal(err)
	}
	const networkID = uint64(0x1234567890abcdef)
	group := MulticastGroup{MAC: NewMAC(0xffffffffffff)}
	now := time.Now()
	activateTestRootPath(t, node, now)
	node.mu.Lock()
	for _, identity := range []Identity{origin, member, firstBridge, secondBridge} {
		if err = node.addPeerLocked(identity, false); err != nil {
			node.mu.Unlock()
			t.Fatal(err)
		}
	}
	network := newNetwork(networkID)
	network.Status = NetworkStatusOK
	network.Config = NetworkConfigData{
		NetworkID: networkID, Type: NetworkTypePublic, MulticastLimit: 2,
		Specialists: []uint64{
			specialistTypeMulticastReplicator | local.Address().Uint64(),
			specialistTypeActiveBridge | firstBridge.Address().Uint64(),
			specialistTypeActiveBridge | secondBridge.Address().Uint64(),
		},
		Rules: []NetworkRule{{Type: ruleActionAccept}},
	}
	network.multicast[group] = map[Address]time.Time{origin.Address(): now, member.Address(): now}
	node.networks[networkID] = network
	frame := Frame{NetworkID: networkID, Source: MACForAddress(origin.Address(), networkID), Destination: group.MAC, EtherType: EtherTypeIPv4, Payload: []byte{0x45}}
	node.replicateMulticastLocked(network, origin.Address(), group, frame, now)
	node.mu.Unlock()
	want := map[Address]bool{member.Address(): false, firstBridge.Address(): false, secondBridge.Address(): false}
	for _, destination := range destinations {
		if _, ok := want[destination]; ok {
			want[destination] = true
		}
		if destination == origin.Address() {
			t.Fatalf("multicast was reflected to origin: %v", destinations)
		}
	}
	for destination, found := range want {
		if !found {
			t.Fatalf("multicast omitted %s: %v", destination, destinations)
		}
	}
}

