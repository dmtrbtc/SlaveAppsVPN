func TestMulticastLikeAndGatherRoundTrip(t *testing.T) {
	identity, err := ParseIdentity(knownGoodIdentity)
	if err != nil {
		t.Fatal(err)
	}
	remoteIdentity, err := GenerateIdentity()
	if err != nil {
		t.Fatal(err)
	}
	var sent [][]byte
	node, err := NewNode(NodeConfig{
		Identity: identity,
		Sender: WireSenderFunc(func(_ int64, _ netip.AddrPort, packet []byte) error {
			sent = append(sent, append([]byte(nil), packet...))
			return nil
		}),
	})
	if err != nil {
		t.Fatal(err)
	}
	const networkID = uint64(0x1234567890abcdef)
	group := MulticastGroup{MAC: NewMAC(0xffffffffffff), ADI: 0xc000020a}
	node.mu.Lock()
	if err := node.addPeerLocked(remoteIdentity, false); err != nil {
		node.mu.Unlock()
		t.Fatal(err)
	}
	network := newNetwork(networkID)
	network.Status = NetworkStatusOK
	network.Config = NetworkConfigData{
		NetworkID: networkID, Type: NetworkTypePublic, MTU: 2800, MulticastLimit: 4,
		Assigned: []netip.Prefix{netip.MustParsePrefix("192.0.2.10/24")},
		Rules:    []NetworkRule{{Type: ruleActionAccept}},
	}
	node.networks[networkID] = network
	node.mu.Unlock()
	key, err := remoteIdentity.Agree(identity)
	if err != nil {
		t.Fatal(err)
	}
	like, _ := NewPacket(identity.Address(), remoteIdentity.Address(), VerbMulticastLike)
	_ = like.AppendUint64(networkID)
	mac := group.MAC.Bytes()
	_ = like.Append(mac[:]...)
	_ = like.AppendUint32(group.ADI)
	if err := like.Armor(key[:], true); err != nil {
		t.Fatal(err)
	}
	now := time.Unix(1700000000, 0)
	remote := netip.MustParseAddrPort("198.51.100.10:9993")
	if err := node.ProcessWirePacket(0, remote, like.Bytes(), now); err != nil {
		t.Fatal(err)
	}
	node.mu.Lock()
	likedAt := node.networks[networkID].multicast[group][remoteIdentity.Address()]
	associatedAt := node.networks[networkID].associated[remoteIdentity.Address()]
	node.mu.Unlock()
	if !likedAt.Equal(now) {
		t.Fatal("MULTICAST_LIKE did not update the member cache")
	}
	if !associatedAt.Equal(now) {
		t.Fatal("MULTICAST_LIKE did not associate the authenticated network peer")
	}

	gather, _ := NewPacket(identity.Address(), remoteIdentity.Address(), VerbMulticastGather)
	_ = gather.AppendUint64(networkID)
	_ = gather.Append(0)
	_ = gather.Append(mac[:]...)
	_ = gather.AppendUint32(group.ADI)
	_ = gather.AppendUint32(4)
	if err := gather.Armor(key[:], true); err != nil {
		t.Fatal(err)
	}
	if err := node.ProcessWirePacket(0, remote, gather.Bytes(), now.Add(time.Millisecond)); err != nil {
		t.Fatal(err)
	}
	found := false
	for _, data := range sent {
		response, err := ParsePacket(data)
		if err != nil || response.Dearmor(key[:]) != nil || response.Verb() != VerbOK {
			continue
		}
		payload := response.Payload()
		if len(payload) < 38 || Verb(payload[0]) != VerbMulticastGather || binary.BigEndian.Uint16(payload[31:33]) == 0 {
			continue
		}
		address, err := AddressFromBytes(payload[33:38])
		if err == nil && address == identity.Address() {
			found = true
		}
	}
	if !found {
		t.Fatal("MULTICAST_GATHER response did not include the local subscription")
	}
}

func TestLocalFrameCallbackCanReenterNode(t *testing.T) {
	identity, _ := ParseIdentity(knownGoodIdentity)
	const networkID = uint64(0x1234567890abcdef)
	var reentered bool
	var node *Node
	node, _ = NewNode(NodeConfig{
		Identity: identity,
		Sender:   WireSenderFunc(func(int64, netip.AddrPort, []byte) error { return nil }),
		OnFrame: func(Frame) {
			_, reentered = node.Network(networkID)
		},
	})
	node.mu.Lock()
	network := newNetwork(networkID)
	network.Status = NetworkStatusOK
	network.Config = NetworkConfigData{NetworkID: networkID, Type: NetworkTypePublic, MTU: 2800, Rules: []NetworkRule{{Type: ruleActionAccept}}}
	node.networks[networkID] = network
	node.mu.Unlock()
	if err := node.SendFrame(networkID, MACForAddress(identity.Address(), networkID), EtherTypeIPv4, []byte{1}); err != nil {
		t.Fatal(err)
	}
	if !reentered {
		t.Fatal("frame callback could not reenter the node")
	}
}

func TestLocalFrameCallbackRetainsOwnedPayload(t *testing.T) {
	identity, _ := ParseIdentity(knownGoodIdentity)
	const networkID = uint64(0x1234567890abcdef)
	var received Frame
	node, err := NewNode(NodeConfig{
		Identity: identity,
		Sender:   WireSenderFunc(func(int64, netip.AddrPort, []byte) error { return nil }),
		OnFrame:  func(frame Frame) { received = frame },
	})
	if err != nil {
		t.Fatal(err)
	}
	node.mu.Lock()
	network := newNetwork(networkID)
	network.Status = NetworkStatusOK
	network.Config = NetworkConfigData{NetworkID: networkID, Type: NetworkTypePublic, MTU: 2800, Rules: []NetworkRule{{Type: ruleActionAccept}}}
	node.networks[networkID] = network
	node.mu.Unlock()
	payload := []byte{1, 2, 3}
	if err = node.SendFrame(networkID, MACForAddress(identity.Address(), networkID), EtherTypeIPv4, payload); err != nil {
		t.Fatal(err)
	}
	payload[0] = 9
	if !bytes.Equal(received.Payload, []byte{1, 2, 3}) {
		t.Fatalf("retained loopback payload = %v", received.Payload)
	}
}

func TestPendingFrameRetainsOwnedPayload(t *testing.T) {
	identity, _ := ParseIdentity(knownGoodIdentity)
	remote, err := GenerateIdentity()
	if err != nil {
		t.Fatal(err)
	}
	const networkID = uint64(0x1234567890abcdef)
	node, err := NewNode(NodeConfig{
		Identity: identity,
		Sender:   WireSenderFunc(func(int64, netip.AddrPort, []byte) error { return nil }),
	})
	if err != nil {
		t.Fatal(err)
	}
	node.mu.Lock()
	network := newNetwork(networkID)
	network.Status = NetworkStatusOK
	network.Config = NetworkConfigData{NetworkID: networkID, Type: NetworkTypePublic, MTU: 2800, Rules: []NetworkRule{{Type: ruleActionAccept}}}
	node.networks[networkID] = network
	node.mu.Unlock()
	payload := []byte{1, 2, 3}
	if err = node.SendFrame(networkID, MACForAddress(remote.Address(), networkID), EtherTypeIPv4, payload); err != nil {
		t.Fatal(err)
