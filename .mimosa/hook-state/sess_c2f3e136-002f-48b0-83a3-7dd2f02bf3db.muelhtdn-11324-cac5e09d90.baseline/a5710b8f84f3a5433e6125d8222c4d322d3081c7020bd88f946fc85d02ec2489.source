	node.networks[networkID] = network
	node.mu.Unlock()
	destination := MACForAddress(remote.Address(), networkID)
	for sequence := 0; sequence <= maxPendingFrames; sequence++ {
		payload := binary.BigEndian.AppendUint16(nil, uint16(sequence))
		if err = node.SendFrame(networkID, destination, EtherTypeIPv4, payload); err != nil {
			t.Fatalf("frame %d: %v", sequence, err)
		}
	}
	node.mu.Lock()
	pending := append([]pendingOutboundFrame(nil), node.pendingFrames[remote.Address()]...)
	node.mu.Unlock()
	if len(pending) != maxPendingFrames {
		t.Fatalf("pending frame count = %d, want %d", len(pending), maxPendingFrames)
	}
	first := binary.BigEndian.Uint16(pending[0].frame.Payload)
	last := binary.BigEndian.Uint16(pending[len(pending)-1].frame.Payload)
	if first != 1 || last != maxPendingFrames {
		t.Fatalf("retained frame range = %d..%d, want 1..%d", first, last, maxPendingFrames)
	}
}

func TestOutgoingTeeUsesExtendedFrame(t *testing.T) {
	senderIdentity, err := ParseIdentity(knownGoodIdentity)
	if err != nil {
		t.Fatal(err)
	}
	teeIdentity, err := GenerateIdentity()
	if err != nil {
		t.Fatal(err)
	}
	destinationIdentity, err := GenerateIdentity()
	if err != nil {
		t.Fatal(err)
	}
	var sent [][]byte
	node, err := NewNode(NodeConfig{
		Identity: senderIdentity,
		Sender: WireSenderFunc(func(_ int64, _ netip.AddrPort, packet []byte) error {
			sent = append(sent, append([]byte(nil), packet...))
			return nil
		}),
	})
	if err != nil {
		t.Fatal(err)
	}
	activateTestRootPath(t, node, time.Now())
	const networkID = uint64(0x1234567890abcdef)
	node.mu.Lock()
	if err := node.addPeerLocked(teeIdentity, false); err != nil {
		node.mu.Unlock()
		t.Fatal(err)
	}
	if err := node.addPeerLocked(destinationIdentity, false); err != nil {
		node.mu.Unlock()
		t.Fatal(err)
	}
	network := newNetwork(networkID)
	network.Status = NetworkStatusOK
	network.Config = NetworkConfigData{
		NetworkID: networkID, Type: NetworkTypePublic, MTU: 2800,
		Rules: []NetworkRule{
			{Type: ruleActionTee, Value: forwardRuleValue(teeIdentity.Address(), 12)},
			{Type: ruleActionAccept},
		},
	}
	node.networks[networkID] = network
	node.mu.Unlock()
	payload := bytes.Repeat([]byte{0x5a}, 20)
	if err := node.SendFrame(networkID, MACForAddress(destinationIdentity.Address(), networkID), EtherTypeIPv4, payload); err != nil {
		t.Fatal(err)
	}
	teeKey, err := teeIdentity.Agree(senderIdentity)
	if err != nil {
		t.Fatal(err)
	}
	destinationKey, err := destinationIdentity.Agree(senderIdentity)
	if err != nil {
		t.Fatal(err)
	}
	var foundTee, foundOriginal bool
	for _, data := range sent {
		packet, err := ParsePacket(data)
		if err != nil {
			continue
		}
		switch packet.Destination() {
		case teeIdentity.Address():
			if packet.Dearmor(teeKey[:]) == nil && packet.Verb() == VerbExtFrame && len(packet.Payload()) == 35 && packet.Payload()[8] == 0x02 {
				foundTee = true
			}
		case destinationIdentity.Address():
			if packet.Dearmor(destinationKey[:]) == nil && packet.Verb() == VerbFrame {
				foundOriginal = true
			}
		}
	}
	if !foundTee || !foundOriginal {
		t.Fatalf("TEE/original packets missing: tee=%t original=%t packets=%d", foundTee, foundOriginal, len(sent))
	}
}

func packetLengths(packets [][]byte) []int {
	lengths := make([]int, len(packets))
	for i := range packets {
		lengths[i] = len(packets[i])
	}
	return lengths
}

