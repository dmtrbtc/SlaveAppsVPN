func TestRemoteBridgeRouteLearnedAndUsed(t *testing.T) {
	local, _ := GenerateIdentity()
	bridge, _ := GenerateIdentity()
	const networkID = uint64(0x1234567890abcdef)
	lanMAC := NewMAC(0x001122334455)
	endpoint := netip.MustParseAddrPort("198.51.100.90:9993")
	var destinations []Address
	node, err := NewNode(NodeConfig{
		Identity: local,
		Sender: WireSenderFunc(func(_ int64, _ netip.AddrPort, data []byte) error {
			packet, parseErr := ParsePacket(data)
			if parseErr == nil {
				destinations = append(destinations, packet.Destination())
			}
			return nil
		}),
	})
	if err != nil {
		t.Fatal(err)
	}
	node.mu.Lock()
	if err = node.addPeerLocked(bridge, false); err != nil {
		node.mu.Unlock()
		t.Fatal(err)
	}
	node.peers[bridge.Address()].paths[pathKey{localSocket: 1, endpoint: endpoint}] = &peerPathState{lastReceive: time.Now(), priority: 1}
	network := newNetwork(networkID)
	network.Status = NetworkStatusOK
	network.Config = NetworkConfigData{
		NetworkID: networkID, Type: NetworkTypePublic, MTU: DefaultNetworkMTU,
		Specialists: []uint64{specialistTypeActiveBridge | bridge.Address().Uint64()},
		Rules:       []NetworkRule{{Type: ruleActionAccept}},
	}
	node.networks[networkID] = network
	node.mu.Unlock()

	packet, _ := NewPacket(local.Address(), bridge.Address(), VerbExtFrame)
	_ = packet.AppendUint64(networkID)
	_ = packet.Append(0)
	destination := MACForAddress(local.Address(), networkID).Bytes()
	source := lanMAC.Bytes()
	_ = packet.Append(destination[:]...)
	_ = packet.Append(source[:]...)
	_ = packet.AppendUint16(EtherTypeIPv4)
	_ = packet.Append(0x45)
	key, _ := bridge.Agree(local)
	_ = packet.Armor(key[:], true)
	if err = node.ProcessWirePacket(1, endpoint, packet.Bytes(), time.Now()); err != nil {
		t.Fatal(err)
	}
	node.mu.Lock()
	route := network.bridgeRoutes[lanMAC]
	node.mu.Unlock()
	if route.bridge != bridge.Address() {
		t.Fatalf("learned bridge = %s, want %s", route.bridge, bridge.Address())
	}
	destinations = nil
	if err = node.SendFrame(networkID, lanMAC, EtherTypeIPv4, []byte{0x45}); err != nil {
		t.Fatal(err)
	}
	if len(destinations) != 1 || destinations[0] != bridge.Address() {
		t.Fatalf("bridged frame destinations = %v", destinations)
	}
}

func TestBridgeReplicationFiltersEachReceiver(t *testing.T) {
	local, _ := GenerateIdentity()
	blocked, _ := GenerateIdentity()
	allowed, _ := GenerateIdentity()
	const networkID = uint64(0x1234567890abcdef)
	now := time.Now()
	var destinations []Address
	node, err := NewNode(NodeConfig{
		Identity: local,
		Sender: WireSenderFunc(func(_ int64, _ netip.AddrPort, data []byte) error {
			packet, parseErr := ParsePacket(data)
			if parseErr == nil {
				destinations = append(destinations, packet.Destination())
			}
			return nil
		}),
	})
	if err != nil {
		t.Fatal(err)
	}
	node.mu.Lock()
	for index, identity := range []Identity{blocked, allowed} {
		if err = node.addPeerLocked(identity, false); err != nil {
			node.mu.Unlock()
			t.Fatal(err)
		}
		endpoint := netip.AddrPortFrom(netip.MustParseAddr("198.51.100.91"), uint16(9993+index))
		node.peers[identity.Address()].paths[pathKey{localSocket: int64(index), endpoint: endpoint}] = &peerPathState{lastReceive: now, priority: 1}
	}
	blockedBytes := blocked.Address().Bytes()
	network := newNetwork(networkID)
	network.Status = NetworkStatusOK
	network.Config = NetworkConfigData{
		NetworkID: networkID, Type: NetworkTypePublic, MTU: DefaultNetworkMTU,
		Specialists: []uint64{
			specialistTypeActiveBridge | blocked.Address().Uint64(),
			specialistTypeActiveBridge | allowed.Address().Uint64(),
		},
		Rules: []NetworkRule{
			{Type: ruleMatchDestZTAddress, Value: blockedBytes[:]},
			{Type: ruleActionDrop},
			{Type: ruleActionAccept},
		},
	}
	node.networks[networkID] = network
	node.mu.Unlock()
	if err = node.SendFrame(networkID, NewMAC(0x001122334466), EtherTypeIPv4, []byte{0x45}); err != nil {
		t.Fatal(err)
	}
	foundBlocked, foundAllowed := false, false
	for _, destination := range destinations {
		foundBlocked = foundBlocked || destination == blocked.Address()
		foundAllowed = foundAllowed || destination == allowed.Address()
	}
	if foundBlocked || !foundAllowed {
		t.Fatalf("bridge receiver filtering blocked=%t allowed=%t destinations=%v", foundBlocked, foundAllowed, destinations)
	}
}

