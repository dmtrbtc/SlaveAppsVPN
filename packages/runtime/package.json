{
  "name": "@slave-vpn/runtime",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test test/geositeCategories.test.cjs test/lifecycle.test.cjs test/mihomoRollback.test.cjs",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "js-yaml": "^4.3.1",
    "@slave-vpn/config": "workspace:*",
    "@slave-vpn/dns": "workspace:*",
    "@slave-vpn/routing": "workspace:*",
    "@slave-vpn/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@slave-vpn/tsconfig": "workspace:*",
    "@types/node": "^22.10.5",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3"
  }
}
