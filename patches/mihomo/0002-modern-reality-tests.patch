+package outbound
+
+import (
+	"encoding/base64"
+	"strings"
+	"testing"
+)
+
+func TestRealityOptionsParsesMldsa65Verify(t *testing.T) {
+	encoded := base64.RawURLEncoding.EncodeToString(make([]byte, 1952))
+	config, err := (RealityOptions{
+		PublicKey:     strings.Repeat("A", 43),
+		Mldsa65Verify: encoded,
+	}).Parse()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(config.Mldsa65Verify) != 1952 {
+		t.Fatalf("unexpected ML-DSA-65 key size: %d", len(config.Mldsa65Verify))
+	}
+}
+
+func TestRealityOptionsRejectsMalformedMldsa65Verify(t *testing.T) {
+	_, err := (RealityOptions{
+		PublicKey:     strings.Repeat("A", 43),
+		Mldsa65Verify: "too-short",
+	}).Parse()
+	if err == nil {
+		t.Fatal("malformed ML-DSA-65 key accepted")
+	}
+}
