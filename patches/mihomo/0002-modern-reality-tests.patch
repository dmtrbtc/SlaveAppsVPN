+package tls
+
+import (
+	"bytes"
+	"testing"
+
+	"github.com/cloudflare/circl/sign/mldsa/mldsa65"
+)
+
+func TestApplyRealityClientVersion(t *testing.T) {
+	sessionID := make([]byte, 32)
+	applyRealityClientVersion(sessionID)
+	if !bytes.Equal(sessionID[:3], []byte{26, 9, 9}) {
+		t.Fatalf("unexpected REALITY client version: %v", sessionID[:3])
+	}
+}
+
+func TestVerifyMldsa65(t *testing.T) {
+	publicKey, privateKey, err := mldsa65.GenerateKey(nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	message := []byte("REALITY transcript")
+	signature := make([]byte, mldsa65.SignatureSize)
+	if err := mldsa65.SignTo(privateKey, message, nil, false, signature); err != nil {
+		t.Fatal(err)
+	}
+	if !verifyMldsa65(publicKey.Bytes(), message, signature) {
+		t.Fatal("valid ML-DSA-65 signature rejected")
+	}
+	signature[0] ^= 1
+	if verifyMldsa65(publicKey.Bytes(), message, signature) {
+		t.Fatal("invalid ML-DSA-65 signature accepted")
+	}
+}
